//@version=6
indicator("Quantum Bot — Gold Specialist", "QB GOLD", overlay=true,
          max_bars_back=500, max_labels_count=200, max_lines_count=100, max_boxes_count=100)

// ═══════════════════════════════════════════════════════════════════════
//  QUANTUM BOT — GOLD SPECIALIST  (XAUUSD, 15m recommended)
//  ─────────────────────────────────────────────────────────────────────
//  Six gold-specific signal modules, all firing JSON alerts to webhook:
//
//    A) gold-fvg      — FVG retest during London KZ / NY-Lon Overlap
//                       Needs: FVG fresh (<20 bars, <50% filled) + BOS
//
//    B) judas-swing   — PURE Asian-range sweep play (ZERO FVG dependency)
//                       Needs: wick > Asian H or L + close back inside
//
//    C) gold-sb       — FVG retest locked to 15-16 UTC Silver Bullet window
//                       Extended TPs (1.5R / 2.5R / 4R) for the 4pm move
//
//    D) reaction      — Psychological level bounce (gold round-number play)
//                       Needs: wick to 50-pt or 100-pt level + close away
//
//    M) frankfurt-orb — Frankfurt ORB (07:00-07:30 UTC range) SHORT only
//                       Best config locked: H1+H4 bearish + Asian lo break
//                       orbTPMult=0.75 · Wide SL  (PF 1.976, WR 63%)
//
//    H) ny-orb        — NY ORB (14:00-14:30 UTC range) both directions
//                       Best config locked: H1+H4 bias filter
//                       orbTPMult=0.75 · Wide SL
//
//  Engine: ADR gate, session gate, Asian range tracker, FRB/NYORB range
//  tracker, FVG pool, BOS tracker, HTF bias (H1/H4/D), CVD, key-time
//  flag, psych levels, status table — all gold-specific, XAUUSD-tuned.
// ═══════════════════════════════════════════════════════════════════════

// ─── WEBHOOK KEY (hardcoded — never move to input or it breaks alerts) ─
WEBHOOK_KEY = "x5YFG4TDJKqi2fVEbBHO0r3vUPgmZACk"

// ─── INPUTS ──────────────────────────────────────────────────────────
G_CORE = "Core"
modFVG        = input.bool(true,  "A) FVG Signal (gold-fvg)",  group=G_CORE)
modJudas      = input.bool(true,  "B) Judas Sweep — pure sweep, no FVG",  group=G_CORE)
modSB         = input.bool(true,  "C) Silver Bullet Signal",         group=G_CORE)
modPsych      = input.bool(true,  "D) Psychological Level Bounce",   group=G_CORE)
modPsychExt   = input.bool(true,  "D2) Psych Extended — outside kill zones (2/3 HTF required)", group=G_CORE)
modFRB        = input.bool(true,  "M) Frankfurt ORB — Short only, H1+H4 required",              group=G_CORE)
modNYORB      = input.bool(true,  "H) NY ORB — Both directions, H1+H4 required",                group=G_CORE)

G_FILT = "Filters"
// Per-signal ADR thresholds — each setup has different tolerance for range consumption.
// FVG/SB need room to run (block at 85%). Judas fires during build phase (block at 90%).
// Psych bounces are BEST at exhaustion — only block extreme outliers (block at 120%).
adrFVGMax      = input.float(0.85, "FVG / SB max ADR consumed",        group=G_FILT, minval=0.50, maxval=1.50, step=0.05,
                              tooltip="gold-fvg and gold-sb blocked above this. FVG needs room to run. 0.85 = 85%.")
adrJudasMax    = input.float(0.90, "Judas max ADR consumed",           group=G_FILT, minval=0.50, maxval=1.50, step=0.05,
                              tooltip="judas-swing fires during London build phase — allow extra room vs FVG. 0.90 = 90%.")
adrPsychMax    = input.float(1.20, "Psych bounce max ADR consumed",    group=G_FILT, minval=0.70, maxval=2.50, step=0.05,
                              tooltip="Psych reversal is BEST at exhaustion (90-100%+). Only block extreme extensions. 1.20 = 120%.")
atrLength      = input.int(14,    "ATR period",                        group=G_FILT, minval=2, maxval=50)
emaLength      = input.int(20,    "HTF bias EMA period",               group=G_FILT, minval=5, maxval=100)
fvgMinGapATR   = input.float(0.10,"FVG min gap (× ATR)",               group=G_FILT, minval=0.03, step=0.03)
fvgMaxFillPct  = input.float(0.50,"FVG max fill before entry fires",   group=G_FILT, minval=0.0, maxval=1.0, step=0.05)
fvgMaxAgeBars  = input.int(20,    "FVG max age (bars)",                 group=G_FILT, minval=4, maxval=100)
slMinH1ATR     = input.float(0.30,"SL min (× H1 ATR)",                 group=G_FILT, minval=0.1, step=0.05)
slMaxH1ATR     = input.float(3.00,"SL max (× H1 ATR)",                 group=G_FILT, minval=1.0, step=0.10)

G_VIS = "Visuals"
showPosBox    = input.bool(true, "Position box on fire",        group=G_VIS)
posBoxBars    = input.int(40,    "Position box width (bars)",   group=G_VIS, minval=5, maxval=200)
showStatusTbl = input.bool(true, "Corner status table",         group=G_VIS)
showFVGZones  = input.bool(true, "FVG zones on chart",          group=G_VIS)

// ─── HTF BIAS (H1 / H4 / D) ──────────────────────────────────────────
f_htfBias(int emaLen, int atrLen) =>
    e = ta.ema(close, emaLen)
    b = close[1] > e[1] ? 1 : close[1] < e[1] ? -1 : 0
    a = ta.atr(atrLen)
    [b, a]

[h1B, h1ATR] = request.security(syminfo.tickerid, "60",  f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[h4B, h4ATR] = request.security(syminfo.tickerid, "240", f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[hdB, hdATR] = request.security(syminfo.tickerid, "D",   f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)

atrVal = ta.atr(atrLength)

// ─── SESSION CONTEXT v17 ──────────────────────────────────────────────
_hourUtc    = hour(time, "UTC")
_minOfDay   = _hourUtc * 60 + minute(time, "UTC")
_dayOfWeek  = dayofweek(time, "UTC") - 1
_hm_tuesday = dayofweek(time, "UTC") == dayofweek.tuesday   // H/M locked: Tuesday only (WR 78%, PF 6.68)

_atr14d     = request.security(syminfo.tickerid, "D", ta.atr(14))
_todayOpen  = request.security(syminfo.tickerid, "D", open)
_todayHigh  = request.security(syminfo.tickerid, "D", high)
_todayLow   = request.security(syminfo.tickerid, "D", low)
_priorClose = request.security(syminfo.tickerid, "D", close[1])
_priorDayHi = request.security(syminfo.tickerid, "D", high[1])
_priorDayLo = request.security(syminfo.tickerid, "D", low[1])

_adrConsumed = _atr14d > 0 ? (_todayHigh - _todayLow) / _atr14d : 0.0
_gapRaw      = _todayOpen - _priorClose
_gapAtr      = _atr14d > 0 ? math.abs(_gapRaw) / _atr14d : 0.0
_gapSign     = _gapRaw > 0 ? 1 : _gapRaw < 0 ? -1 : 0
_gapDirLong  = _gapSign
_gapDirShort = _gapSign * -1
_priorDayPos = _todayOpen > _priorDayHi ? 1 : _todayOpen < _priorDayLo ? -1 : 0
// Gold key times: LBMA AM fix ~10:30 UTC ±45min, COMEX open ~13:30 UTC ±45min
_nearKeyTime = (_minOfDay >= 585 and _minOfDay <= 675) or (_minOfDay >= 765 and _minOfDay <= 855) ? 1 : 0

// ─── ADR TIER CLASSIFICATION ──────────────────────────────────────────────────
// Research-based tiers: 75-80% High-Prob, 90-100% Exhaustion,
// 150-200% News Extension, 250%+ Outlier. Each tier changes gates and TP targets.
_prevMonthMaxBar = request.security(syminfo.tickerid, "D", ta.highest(high - low, 22)[1])
_adrTierStr      = _adrConsumed >= 2.50 ? "OUTLIER" :
                   _adrConsumed >= 1.50 ? "NEWS-EXT" :
                   _adrConsumed >= 0.90 ? "EXHAUST" :
                   _adrConsumed >= 0.75 ? "HIGH-PROB" : "BUILDING"
// Quiet day flag: ADR < 75% → compress TP1 to conservative target (75% of ADR)
_adrQuiet        = _adrConsumed < 0.75
// Remaining space to 75% of ADR from today's extreme (used for TP cap on quiet days)
_adrRemainTo75   = math.max(0.0, _atr14d * 0.75 - (_todayHigh - _todayLow))

// ─── CVD ──────────────────────────────────────────────────────────────
_signedVol   = close > open ? volume : close < open ? -volume : 0.0
_newDay      = ta.change(time("D")) != 0

var float _cvdRunning = 0.0
_cvdRunning  := _cvdRunning + _signedVol
var float _cvdBase = 0.0
if _newDay
    _cvdBase := _cvdRunning - _signedVol
cvd       = _cvdRunning - _cvdBase
cvdMa     = ta.ema(cvd, 14)
cvdSlope  = cvd > cvd[1] and cvd > cvdMa ? "rising" : cvd < cvd[1] and cvd < cvdMa ? "falling" : "flat"

// ─── SESSION GATES (UTC) ──────────────────────────────────────────────
in_asian    = timeframe.isintraday and (_minOfDay >= 0    and _minOfDay < 480)   // 00-08 UTC
in_london   = timeframe.isintraday and (_minOfDay >= 480  and _minOfDay < 660)   // 08-11 UTC
in_overlap  = timeframe.isintraday and (_minOfDay >= 780  and _minOfDay < 1020)  // 13-17 UTC
in_sb_win       = timeframe.isintraday and (_minOfDay >= 900  and _minOfDay < 960)   // 15-16 UTC
in_kz           = in_london or in_overlap
in_frb_window   = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 450)  // 07:00-07:30 UTC range build
in_frb_trade    = timeframe.isintraday and (_minOfDay >= 450 and _minOfDay < 660)  // 07:30-11:00 UTC trade window
in_nyorb_window = timeframe.isintraday and (_minOfDay >= 840 and _minOfDay < 870)  // 14:00-14:30 UTC range build

string sess_label = in_sb_win ? "NY_PM" : in_overlap ? "NY_AM" : in_london ? "LONDON" : in_asian ? "ASIAN" : "OFF"

// Per-signal ADR gates — all use _adrConsumed[1] (previous bar) so the trigger
// bar's own wick cannot self-block its detection. adr_hard_ok uses the current
// bar intentionally: it is a live safety stop, not an opportunity gate.
adr_fvg_ok   = _adrConsumed[1] < adrFVGMax    // FVG + SB: needs room to extend (85%)
adr_judas_ok = _adrConsumed[1] < adrJudasMax  // Judas: London build phase (90%)
adr_psych_ok = _adrConsumed[1] < adrPsychMax  // Psych: exhaustion IS the edge (120%)
adr_hard_ok  = _adrConsumed    < 2.50         // Outlier safety stop — always reads live ADR

// ─── ASIAN RANGE TRACKING ─────────────────────────────────────────────
var float ar_hi     = na
var float ar_lo     = na
var bool  ar_locked = false

if _newDay
    ar_hi     := na
    ar_lo     := na
    ar_locked := false

if in_asian
    ar_hi := na(ar_hi) ? high : math.max(ar_hi, high)
    ar_lo := na(ar_lo) ? low  : math.min(ar_lo, low)

asian_ended = not in_asian and in_asian[1]
if asian_ended and not na(ar_hi)
    ar_locked := true

// ─── FRANKFURT ORB + NY ORB RANGE TRACKING ───────────────────────────
// ar_lo_prefrb: Asian low accumulated BEFORE the FRB window (00:00-07:00 UTC)
// Used by Signal M to verify close breaks below overnight Asian lows.
var float ar_lo_prefrb = na
var float frb_hi       = na
var float frb_lo       = na
var bool  frb_locked   = false
var bool  frb_done     = false
var float nyorb_hi     = na
var float nyorb_lo     = na
var bool  nyorb_locked = false
var bool  nyorb_done   = false

if _newDay
    ar_lo_prefrb := na
    frb_hi       := na
    frb_lo       := na
    frb_locked   := false
    frb_done     := false
    nyorb_hi     := na
    nyorb_lo     := na
    nyorb_locked := false
    nyorb_done   := false

if _minOfDay >= 0 and _minOfDay < 420
    ar_lo_prefrb := na(ar_lo_prefrb) ? low : math.min(ar_lo_prefrb, low)

if in_frb_window
    frb_hi := na(frb_hi) ? high : math.max(frb_hi, high)
    frb_lo := na(frb_lo) ? low  : math.min(frb_lo, low)

if not in_frb_window and in_frb_window[1] and not na(frb_hi)
    frb_locked := true

if in_nyorb_window
    nyorb_hi := na(nyorb_hi) ? high : math.max(nyorb_hi, high)
    nyorb_lo := na(nyorb_lo) ? low  : math.min(nyorb_lo, low)

if not in_nyorb_window and in_nyorb_window[1] and not na(nyorb_hi)
    nyorb_locked := true

// ─── BOS TRACKING ─────────────────────────────────────────────────────
// Lightweight: a "bullish BOS" = new confirmed swing high above the prior one
SWG = 3
var float _prev_sh   = na
var float _prev_sl   = na
var int   bos_bull_b = na
var int   bos_bear_b = na

_sh_now = ta.pivothigh(high, SWG, SWG)
_sl_now = ta.pivotlow(low,   SWG, SWG)

if not na(_sh_now)
    if not na(_prev_sh) and _sh_now > _prev_sh
        bos_bull_b := bar_index[SWG]
    _prev_sh := _sh_now

if not na(_sl_now)
    if not na(_prev_sl) and _sl_now < _prev_sl
        bos_bear_b := bar_index[SWG]
    _prev_sl := _sl_now

bos_bull_ok = not na(bos_bull_b) and (bar_index - bos_bull_b) <= 30
bos_bear_ok = not na(bos_bear_b) and (bar_index - bos_bear_b) <= 30

// ─── FVG POOL ─────────────────────────────────────────────────────────
var array<float> fU     = array.new<float>(0)
var array<float> fL     = array.new<float>(0)
var array<int>   fDir   = array.new<int>(0)
var array<int>   fBar   = array.new<int>(0)
var array<float> fFill  = array.new<float>(0)
var array<bool>  fFired = array.new<bool>(0)
var array<box>   fBoxes = array.new<box>(0)

// Detect new FVGs on every confirmed bar
if barstate.isconfirmed and atrVal > 0
    bull_fvg  = low > high[2]
    bear_fvg  = high < low[2]
    bull_gap  = bull_fvg ? (low - high[2]) : 0.0
    bear_gap  = bear_fvg ? (low[2] - high) : 0.0

    if bull_fvg and bull_gap >= atrVal * fvgMinGapATR
        array.push(fU, low)
        array.push(fL, high[2])
        array.push(fDir, 1)
        array.push(fBar, bar_index - 1)
        array.push(fFill, 0.0)
        array.push(fFired, false)
        bx = showFVGZones ?
             box.new(bar_index - 2, low, bar_index + fvgMaxAgeBars, high[2],
                     border_color=color.new(color.green, 40), border_width=1,
                     bgcolor=color.new(color.green, 86)) : na
        array.push(fBoxes, bx)

    if bear_fvg and bear_gap >= atrVal * fvgMinGapATR
        array.push(fU, low[2])
        array.push(fL, high)
        array.push(fDir, -1)
        array.push(fBar, bar_index - 1)
        array.push(fFill, 0.0)
        array.push(fFired, false)
        bx = showFVGZones ?
             box.new(bar_index - 2, low[2], bar_index + fvgMaxAgeBars, high,
                     border_color=color.new(color.red, 40), border_width=1,
                     bgcolor=color.new(color.red, 86)) : na
        array.push(fBoxes, bx)

    // Cap pool
    while array.size(fU) > 25
        old = array.shift(fBoxes)
        if not na(old)
            box.delete(old)
        array.shift(fU)
        array.shift(fL)
        array.shift(fDir)
        array.shift(fBar)
        array.shift(fFill)
        array.shift(fFired)

// Update fill percentages
if barstate.isconfirmed and array.size(fU) > 0
    for idx = array.size(fU) - 1 to 0
        u    = array.get(fU,    idx)
        l    = array.get(fL,    idx)
        d    = array.get(fDir,  idx)
        gsz  = u - l
        if gsz <= 0
            continue
        if d == 1 and low < u
            array.set(fFill, idx, math.min(1.0, math.max(0.0, u - math.max(l, low)) / gsz))
        if d == -1 and high > l
            array.set(fFill, idx, math.min(1.0, math.max(0.0, math.min(u, high) - l) / gsz))

// ─── ALERT BUILDER ────────────────────────────────────────────────────
f_buildAlert(string tmpl, string dir, float entry, float slP,
             float tp1, float tp2, float tp3,
             float zU, float zL, string zType,
             string sess, string tier, string conf,
             string filters, int minsIntoWin) =>
    slRisk  = math.abs(entry - slP)
    rr1     = slRisk > 0 ? math.abs(tp1 - entry) / slRisk : 0.0
    rr2     = slRisk > 0 ? math.abs(tp2 - entry) / slRisk : 0.0
    rr3     = slRisk > 0 ? math.abs(tp3 - entry) / slRisk : 0.0
    // FVG and SB-FVG entries wait for price to return to the zone (LIMIT).
    // All other signals fire at bar close = fill now (MARKET).
    _aStyle = (zType == "FVG" or zType == "SB-FVG") ? "retest" : "immediate"
    scGapDir = dir == "LONG" ? _gapDirLong : _gapDirShort
    cvdOk    = dir == "LONG" ? cvdSlope == "rising" : cvdSlope == "falling"
    dEmoji   = dir == "LONG" ? "🟢" : "🔴"
    readable = dEmoji + " " + syminfo.ticker + " · " + (dir == "LONG" ? "BUY" : "SELL") +
               " · " + str.upper(tmpl) + " · " + timeframe.period + "m · Tier " + tier +
               "\nZone: " + str.tostring(zL, format.mintick) + " – " + str.tostring(zU, format.mintick) +
               "\nFilters: " + filters + "\n---\n"
    head   = "{\"version\":\"2.3\",\"action\":\"trade\",\"template\":\"" + tmpl +
              "\",\"direction\":\"" + dir +
              "\",\"symbol\":\"" + syminfo.tickerid +
              "\",\"timeframe\":\"" + timeframe.period +
              "\",\"timestamp\":" + str.tostring(time)
    prices = ",\"entry\":\""  + str.tostring(entry, format.mintick) +
              "\",\"sl\":\""  + str.tostring(slP,   format.mintick) +
              "\",\"tp1\":\"" + str.tostring(tp1,   format.mintick) +
              "\",\"tp2\":\"" + str.tostring(tp2,   format.mintick) +
              "\",\"tp3\":\"" + str.tostring(tp3,   format.mintick) +
              "\",\"rr1\":"   + str.tostring(rr1,   "0.00") +
              ",\"rr2\":"     + str.tostring(rr2,   "0.00") +
              ",\"rr3\":"     + str.tostring(rr3,   "0.00")
    zone   = ",\"zoneUpper\":\"" + str.tostring(zU, format.mintick) +
              "\",\"zoneLower\":\"" + str.tostring(zL, format.mintick) +
              "\",\"zoneType\":\"" + zType + "\""
    htf    = ",\"activeSession\":\"" + sess +
              "\",\"htfTier\":\"" + tier +
              "\",\"htfBias\":\"" + str.tostring(h1B) + "/" + str.tostring(h4B) + "/" + str.tostring(hdB) +
              "\",\"htfBiasAlign\":" + str.tostring(tier == "A" ? 1 : 0) +
              ",\"htfConfluence\":\"" + conf + "\""
    ctx    = ",\"window\":\"" + sess +
              "\",\"swept\":\"\",\"impulseATR\":\"0.00\"" +
              ",\"filters\":\"" + filters + "\"" +
              ",\"cvdSlope\":\"" + cvdSlope + "\"" +
              ",\"cvdConfirms\":" + str.tostring(cvdOk) +
              ",\"cvdDivergence\":\"none\",\"cvdLowTrust\":false" +
              ",\"barOpen\":\""  + str.tostring(open,  format.mintick) + "\"" +
              ",\"barHigh\":\""  + str.tostring(high,  format.mintick) + "\"" +
              ",\"barLow\":\""   + str.tostring(low,   format.mintick) + "\"" +
              ",\"barClose\":\"" + str.tostring(close, format.mintick) + "\"" +
              ",\"adrConsumed\":\"" + str.tostring(_adrConsumed,  "#.####") + "\"" +
              ",\"adrTier\":\""    + _adrTierStr                              + "\"" +
              ",\"gapAtr\":\""      + str.tostring(_gapAtr,        "#.####") + "\"" +
              ",\"gapDir\":\""      + str.tostring(scGapDir)                 + "\"" +
              ",\"priorDayPos\":\"" + str.tostring(_priorDayPos)             + "\"" +
              ",\"hourUtc\":\""     + str.tostring(_hourUtc)                 + "\"" +
              ",\"dayOfWeek\":\""   + str.tostring(_dayOfWeek)               + "\"" +
              ",\"nearKeyTime\":\"" + str.tostring(_nearKeyTime)             + "\"" +
              ",\"ibSide\":\"null\",\"ibPosition\":\"-1\",\"first15mDir\":\"0\"" +
              ",\"minsIntoWindow\":" + str.tostring(minsIntoWin) +
              ",\"actualStyle\":\"" + _aStyle + "\"" +
              ",\"apiKey\":\"" + WEBHOOK_KEY + "\"}"
    readable + head + prices + zone + htf + ctx

f_drawPosBox(float e, float slP, float tp3) =>
    r = bar_index + posBoxBars
    box.new(bar_index, math.max(e, tp3), r, math.min(e, tp3),
            border_color=color.new(color.teal, 50), bgcolor=color.new(color.teal, 88))
    box.new(bar_index, math.max(e, slP), r, math.min(e, slP),
            border_color=color.new(color.red,  55), bgcolor=color.new(color.red,  90))
    line.new(bar_index, e, r, e, color=color.new(color.gray, 10), style=line.style_dashed, width=1)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL A — Gold FVG  (template: gold-fvg)
// ─────────────────────────────────────────────────────────────────────
// During London KZ or NY-Lon Overlap, price retests a fresh FVG that
// has recent BOS in the same direction. SL beyond the FVG proximal edge.
// ═══════════════════════════════════════════════════════════════════════

if modFVG and barstate.isconfirmed and in_kz and adr_fvg_ok and adr_hard_ok and not na(h1ATR) and h1ATR > 0 and array.size(fU) > 0
    firedA = false
    for idx = array.size(fU) - 1 to 0
        if firedA or array.get(fFired, idx)
            continue
        u       = array.get(fU,    idx)
        l       = array.get(fL,    idx)
        d       = array.get(fDir,  idx)
        birth   = array.get(fBar,  idx)
        fillPct = array.get(fFill, idx)

        if (bar_index - birth) > fvgMaxAgeBars or fillPct > fvgMaxFillPct
            continue

        // Price enters FVG zone (retest)
        touch = d == 1 ? (low <= u and high >= l) : (high >= l and low <= u)
        if not touch
            continue

        // BOS in same direction required
        if not ((d == 1 and bos_bull_ok) or (d == -1 and bos_bear_ok))
            continue

        dirStr = d == 1 ? "LONG" : "SHORT"
        h1ok   = h1B == d
        h4ok   = h4B == d
        hdok   = hdB == d
        aligned = h1ok or h4ok or hdok
        tier   = aligned ? "A" : "B"
        conf   = (h1ok ? "h1" : "") + (h4ok ? (h1ok ? "+h4" : "h4") : "") + (hdok ? ((h1ok or h4ok) ? "+D" : "D") : "")
        if str.length(conf) == 0
            conf := "counter-bias"

        buf      = math.max(0.20 * atrVal, 0.08 * h1ATR)
        entryP   = d == 1 ? l : u           // proximal edge (near price)
        slP      = d == 1 ? l - buf : u + buf
        slDist   = math.abs(entryP - slP)
        slH1     = slDist / h1ATR

        if slDist <= 0 or slH1 < slMinH1ATR or slH1 > slMaxH1ATR
            continue

        // Quiet-day TP compression: if ADR < 75% and market has little room left,
        // pull TP1 back to 0.75R to lock in gains before session slows down.
        tp1Mult = (_adrQuiet and _adrRemainTo75 > 0 and _adrRemainTo75 < slDist * 1.5) ? 0.75 : 1.0
        tp1 = d == 1 ? entryP + slDist * tp1Mult : entryP - slDist * tp1Mult
        tp2 = d == 1 ? entryP + slDist * 2.0 : entryP - slDist * 2.0
        tp3 = d == 1 ? entryP + slDist * 3.0 : entryP - slDist * 3.0

        slSide = d == 1 ? slP < entryP : slP > entryP
        tpSide = d == 1 ? tp1 > entryP : tp1 < entryP
        if not (slSide and tpSide)
            continue

        array.set(fFired, idx, true)
        firedA := true

        minsIn  = in_london ? math.max(0, _minOfDay - 480) : math.max(0, _minOfDay - 780)
        fStr    = "FVG✓ BOS✓" + (aligned ? " H1✓" : " H1✗") +
                  " ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%" +
                  (_nearKeyTime == 1 ? " KEY-TIME" : "")

        alert(f_buildAlert("gold-specialist", dirStr, entryP, slP, tp1, tp2, tp3,
                            u, l, "FVG", sess_label, tier, conf, fStr, minsIn),
              alert.freq_once_per_bar)

        if showPosBox
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL B — Judas Sweep  (template: judas-swing)
// ─────────────────────────────────────────────────────────────────────
// Pure sweep play — NO FVG dependency whatsoever.
// Logic: London open sweeps Asian H or L and CLOSES BACK INSIDE the range.
// Entry: limit at the Asian level that was swept.
// SL: beyond the sweep wick + buffer.
// This fires purely on price action; Signal A (FVG) is a completely
// separate setup with its own detection pool.
// One signal per sweep direction per day.
// ═══════════════════════════════════════════════════════════════════════

var bool judas_hi_done = false
var bool judas_lo_done = false

if _newDay
    judas_hi_done := false
    judas_lo_done := false

if modJudas and barstate.isconfirmed and in_london and ar_locked and adr_judas_ok and adr_hard_ok
    if not na(ar_hi) and not na(ar_lo) and not na(h1ATR) and h1ATR > 0
        aRef = nz(atrVal, h1ATR)

        // SHORT: swept Asian high, closed back inside → expect move down
        if not judas_hi_done and high > ar_hi and close < ar_hi
            sweepSz = high - ar_hi
            if sweepSz >= aRef * 0.15
                entryP  = ar_hi
                buf     = aRef * 0.20
                slP     = high + buf
                slDist  = math.abs(entryP - slP)
                slH1    = slDist / h1ATR
                if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
                    tp1 = entryP - slDist * 1.0
                    tp2 = entryP - slDist * 2.0
                    tp3 = entryP - slDist * 3.0
                    judas_hi_done := true
                    tier = (h1B == -1 or h4B == -1 or hdB == -1) ? "A" : "B"
                    fStr = "SWEEP✓ CLOSE-INSIDE✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
                    alert(f_buildAlert("gold-specialist", "SHORT", entryP, slP, tp1, tp2, tp3,
                                        ar_hi + 1, ar_hi - 1, "Asian-H",
                                        "LONDON", tier, "judas-hi-sweep", fStr,
                                        math.max(0, _minOfDay - 480)),
                          alert.freq_once_per_bar)
                    label.new(bar_index, high, "⚡ Judas SHORT",
                              style=label.style_label_down, color=color.new(color.red, 5),
                              textcolor=color.white, size=size.small)
                    if showPosBox
                        f_drawPosBox(entryP, slP, tp3)

        // LONG: swept Asian low, closed back inside → expect move up
        if not judas_lo_done and low < ar_lo and close > ar_lo
            sweepSz = ar_lo - low
            if sweepSz >= aRef * 0.15
                entryP  = ar_lo
                buf     = aRef * 0.20
                slP     = low - buf
                slDist  = math.abs(entryP - slP)
                slH1    = slDist / h1ATR
                if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
                    tp1 = entryP + slDist * 1.0
                    tp2 = entryP + slDist * 2.0
                    tp3 = entryP + slDist * 3.0
                    judas_lo_done := true
                    tier = (h1B == 1 or h4B == 1 or hdB == 1) ? "A" : "B"
                    fStr = "SWEEP✓ CLOSE-INSIDE✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
                    alert(f_buildAlert("gold-specialist", "LONG", entryP, slP, tp1, tp2, tp3,
                                        ar_lo + 1, ar_lo - 1, "Asian-L",
                                        "LONDON", tier, "judas-lo-sweep", fStr,
                                        math.max(0, _minOfDay - 480)),
                          alert.freq_once_per_bar)
                    label.new(bar_index, low, "⚡ Judas LONG",
                              style=label.style_label_up, color=color.new(color.teal, 5),
                              textcolor=color.white, size=size.small)
                    if showPosBox
                        f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL C — Silver Bullet  (template: gold-sb)
// ─────────────────────────────────────────────────────────────────────
// 15-16 UTC only. FVG retest inside the window. One trade per day.
// TPs extended slightly vs FVG signal (1.5R / 2.5R / 4R) to capture
// the typical 15-16 UTC directional move.
// ═══════════════════════════════════════════════════════════════════════

var bool sb_done = false
if _newDay
    sb_done := false

if modSB and barstate.isconfirmed and in_sb_win and not sb_done and adr_fvg_ok and adr_hard_ok
    if not na(h1ATR) and h1ATR > 0 and array.size(fU) > 0
        firedC = false
        for idx = array.size(fU) - 1 to 0
            if firedC or array.get(fFired, idx)
                continue
            u       = array.get(fU,    idx)
            l       = array.get(fL,    idx)
            d       = array.get(fDir,  idx)
            birth   = array.get(fBar,  idx)
            fillPct = array.get(fFill, idx)

            if (bar_index - birth) > 48 or fillPct > 0.50
                continue

            touch = d == 1 ? (low <= u and high >= l) : (high >= l and low <= u)
            if not touch
                continue

            dirStr  = d == 1 ? "LONG" : "SHORT"
            aligned = (d == 1 and (h1B == 1 or h4B == 1 or hdB == 1)) or (d == -1 and (h1B == -1 or h4B == -1 or hdB == -1))
            tier    = aligned ? "A" : "B"

            buf    = math.max(0.20 * atrVal, 0.08 * h1ATR)
            entryP = d == 1 ? l : u
            slP    = d == 1 ? l - buf : u + buf
            slDist = math.abs(entryP - slP)
            slH1   = slDist / h1ATR

            if slDist <= 0 or slH1 < slMinH1ATR or slH1 > slMaxH1ATR
                continue

            // Quiet-day TP compression: pull TP1 from 1.5R → 1.0R when little room remains
            tp1Mult_sb = (_adrQuiet and _adrRemainTo75 > 0 and _adrRemainTo75 < slDist * 1.5) ? 1.0 : 1.5
            tp1 = d == 1 ? entryP + slDist * tp1Mult_sb : entryP - slDist * tp1Mult_sb
            tp2 = d == 1 ? entryP + slDist * 2.5 : entryP - slDist * 2.5
            tp3 = d == 1 ? entryP + slDist * 4.0 : entryP - slDist * 4.0

            if not (d == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
                continue

            array.set(fFired, idx, true)
            sb_done  := true
            firedC   := true

            fStr = "SB-FVG✓" + (aligned ? " H1✓" : " H1✗") +
                   " ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("gold-specialist", dirStr, entryP, slP, tp1, tp2, tp3,
                                u, l, "SB-FVG", "NY_PM", tier, "sb-fvg", fStr,
                                math.max(0, _minOfDay - 900)),
                  alert.freq_once_per_bar)

            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL D — Psychological Level Bounce  (template: reaction)
// ─────────────────────────────────────────────────────────────────────
// Gold respects round numbers far more than other instruments.
// Key levels: every 50 points (3000, 3050, 3100, 3150 …)
// Major levels: every 100 points (3000, 3100, 3200 …)
//
// Condition: during killzone, price touches the nearest round level
//   (wick into it) and CLOSES back in the opposite direction.
// Entry: at the round level. SL: beyond the wick. TPs: 1R / 2R / 3R.
// One signal per level touched per day.
// ═══════════════════════════════════════════════════════════════════════

var bool psych_done = false
if _newDay
    psych_done := false

if modPsych and barstate.isconfirmed and in_kz and adr_psych_ok and adr_hard_ok and not psych_done
    if not na(h1ATR) and h1ATR > 0
        // Nearest 50-point level and nearest 100-point level
        lvl50  = math.round(close / 50.0)  * 50.0
        lvl100 = math.round(close / 100.0) * 100.0
        // Pick whichever is closer to current close
        nearLevel = math.abs(close - lvl50) <= math.abs(close - lvl100) ? lvl50 : lvl100

        tol = atrVal * 0.25  // within 25% of ATR counts as a "touch"

        // Bullish bounce: wick tagged level from above, close is back above it
        bounceLong  = low  <= nearLevel + tol and low  <= nearLevel and close > nearLevel
        // Bearish rejection: wick tagged level from below, close is back below it
        bounceShort = high >= nearLevel - tol and high >= nearLevel and close < nearLevel

        dir = bounceLong and not bounceShort ? 1 : bounceShort and not bounceLong ? -1 : 0

        if dir != 0
            h1ok    = h1B == dir
            h4ok    = h4B == dir
            hdok    = hdB == dir
            aligned = h1ok or h4ok or hdok
            tier    = aligned ? "A" : "B"
            conf    = h1ok ? "h1" : h4ok ? "h4" : hdok ? "D" : "counter-bias"
            dirStr  = dir == 1 ? "LONG" : "SHORT"

            buf    = math.max(0.30 * atrVal, 0.10 * h1ATR)
            wick   = dir == 1 ? low : high
            entryP = nearLevel
            slP    = dir == 1 ? wick - buf : wick + buf
            slDist = math.abs(entryP - slP)
            slH1   = slDist / h1ATR

            if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
                tp1 = dir == 1 ? entryP + slDist * 1.0 : entryP - slDist * 1.0
                tp2 = dir == 1 ? entryP + slDist * 2.0 : entryP - slDist * 2.0
                tp3 = dir == 1 ? entryP + slDist * 3.0 : entryP - slDist * 3.0

                if (dir == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
                    psych_done := true
                    minsIn = in_london ? math.max(0, _minOfDay - 480) : math.max(0, _minOfDay - 780)
                    lvlStr = str.tostring(math.round(nearLevel))
                    fStr   = "PSYCH-" + lvlStr + (aligned ? " H1" : "") +
                             " ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"

                    alert(f_buildAlert("gold-specialist", dirStr, entryP, slP, tp1, tp2, tp3,
                                        nearLevel + tol, nearLevel - tol, "PSYCH",
                                        sess_label, tier, conf, fStr, minsIn),
                          alert.freq_once_per_bar)

                    label.new(bar_index, dir == 1 ? low : high,
                              lvlStr + " Psych " + (dir == 1 ? "Bounce" : "Reject"),
                              style=dir == 1 ? label.style_label_up : label.style_label_down,
                              color=color.new(color.purple, 10),
                              textcolor=color.white, size=size.tiny)

                    if showPosBox
                        f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL D2 — Psych Extended  (template: reaction-ext)
// ─────────────────────────────────────────────────────────────────────
// Same psych-level detection as Signal D but fires OUTSIDE London / NY
// kill zones — catches Asian-session and off-session setups that Signal D
// silently skips. Stricter gate: 2 of 3 HTF biases must align with the
// trade direction. Major 100-point levels only (safer in thinner windows).
// One signal per day, independent of psych_done.
// ═══════════════════════════════════════════════════════════════════════

var bool psych_ext_done = false
if _newDay
    psych_ext_done := false

if modPsychExt and barstate.isconfirmed and not in_kz and adr_psych_ok and adr_hard_ok and not psych_ext_done
    if not na(h1ATR) and h1ATR > 0
        // Major 100-point levels only — conservative choice for lower-liquidity windows
        nearLevel = math.round(close / 100.0) * 100.0
        tol = atrVal * 0.25

        bounceLong  = low  <= nearLevel + tol and low  <= nearLevel and close > nearLevel
        bounceShort = high >= nearLevel - tol and high >= nearLevel and close < nearLevel

        dir = bounceLong and not bounceShort ? 1 : bounceShort and not bounceLong ? -1 : 0

        if dir != 0
            h1ok       = h1B == dir
            h4ok       = h4B == dir
            hdok       = hdB == dir
            alignCount = (h1ok ? 1 : 0) + (h4ok ? 1 : 0) + (hdok ? 1 : 0)

            if alignCount >= 2
                conf   = (h1ok ? "h1" : "") + (h4ok ? (h1ok ? "+h4" : "h4") : "") + (hdok ? ((h1ok or h4ok) ? "+D" : "D") : "")
                dirStr = dir == 1 ? "LONG" : "SHORT"

                buf    = math.max(0.30 * atrVal, 0.10 * h1ATR)
                wick   = dir == 1 ? low : high
                entryP = nearLevel
                slP    = dir == 1 ? wick - buf : wick + buf
                slDist = math.abs(entryP - slP)
                slH1   = slDist / h1ATR

                if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
                    tp1 = dir == 1 ? entryP + slDist * 1.0 : entryP - slDist * 1.0
                    tp2 = dir == 1 ? entryP + slDist * 2.0 : entryP - slDist * 2.0
                    tp3 = dir == 1 ? entryP + slDist * 3.0 : entryP - slDist * 3.0

                    if (dir == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
                        psych_ext_done := true
                        lvlStr = str.tostring(math.round(nearLevel))
                        fStr   = "PSYCH-EXT-" + lvlStr + " " + str.tostring(alignCount) + "/3-HTF" +
                                 " ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%" +
                                 " OUT-KZ:" + sess_label

                        alert(f_buildAlert("gold-specialist", dirStr, entryP, slP, tp1, tp2, tp3,
                                            nearLevel + tol, nearLevel - tol, "PSYCH-EXT",
                                            sess_label, "A", conf, fStr, _minOfDay),
                              alert.freq_once_per_bar)

                        label.new(bar_index, dir == 1 ? low : high,
                                  "⚡ " + lvlStr + " Psych " + (dir == 1 ? "Bounce" : "Reject") + " [EXT]",
                                  style=dir == 1 ? label.style_label_up : label.style_label_down,
                                  color=color.new(color.orange, 10),
                                  textcolor=color.white, size=size.tiny)

                        if showPosBox
                            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL M — Frankfurt ORB  (template: frankfurt-orb)
// ─────────────────────────────────────────────────────────────────────
// Best config locked in: SHORT only, H1+H4 both bearish, entry must
// close below Asian session low (00:00-07:00 UTC). Wide SL at frb_hi.
// TP1 = frb_lo – 0.75 × orb_range  (confirmed PF 1.976, WR 63%)
// One signal per day.
// ═══════════════════════════════════════════════════════════════════════

if modFRB and barstate.isconfirmed and in_frb_trade and frb_locked and not frb_done and not na(frb_hi) and not na(frb_lo) and adr_hard_ok and _hm_tuesday
    orb_range_frb = frb_hi - frb_lo
    buf_frb       = math.max(atrVal * 0.10, 0.50)
    if orb_range_frb > 0.50
        if close < frb_lo and h1B == -1 and h4B == -1 and not na(ar_lo_prefrb) and close < ar_lo_prefrb
            entryP = close
            slP    = frb_hi + buf_frb
            slDist = slP - entryP
            tp1    = frb_lo - orb_range_frb * 0.75
            tp2    = frb_lo - orb_range_frb * 1.50
            tp3    = frb_lo - orb_range_frb * 2.25
            frb_done := true
            fStr   = "FRB✓ H1-H4-SHORT✓ ASIAN-LO✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("gold-specialist", "SHORT", entryP, slP, tp1, tp2, tp3,
                                frb_hi, frb_lo, "FRB",
                                sess_label, "A", "h1+h4", fStr,
                                math.max(0, _minOfDay - 450)),
                  alert.freq_once_per_bar)
            label.new(bar_index, high, "⚡ FRB SHORT",
                      style=label.style_label_down, color=color.new(color.red, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL H — NY ORB  (template: ny-orb)
// ─────────────────────────────────────────────────────────────────────
// Best config locked in: both directions, H1+H4 must align with trade.
// Wide SL at opposite ORB extreme. TP1 = 0.75 × orb_range from ORB edge.
// One signal per day.
// ═══════════════════════════════════════════════════════════════════════

if modNYORB and barstate.isconfirmed and nyorb_locked and not nyorb_done and not na(nyorb_hi) and not na(nyorb_lo) and adr_hard_ok and _hm_tuesday
    orb_range_ny = nyorb_hi - nyorb_lo
    buf_ny       = math.max(atrVal * 0.10, 0.50)
    if orb_range_ny > 0.50
        if close > nyorb_hi and h1B == 1 and h4B == 1
            entryP = close
            slP    = nyorb_lo - buf_ny
            slDist = entryP - slP
            tp1    = entryP + slDist * 0.75
            tp2    = entryP + slDist * 1.50
            tp3    = entryP + slDist * 2.25
            nyorb_done := true
            fStr   = "NYORB✓ H1-H4-LONG✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("gold-specialist", "LONG", entryP, slP, tp1, tp2, tp3,
                                nyorb_hi, nyorb_lo, "NYORB",
                                sess_label, "A", "h1+h4", fStr,
                                math.max(0, _minOfDay - 870)),
                  alert.freq_once_per_bar)
            label.new(bar_index, low, "⚡ NYORB LONG",
                      style=label.style_label_up, color=color.new(color.teal, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

        else if close < nyorb_lo and h1B == -1 and h4B == -1
            entryP = close
            slP    = nyorb_hi + buf_ny
            slDist = slP - entryP
            tp1    = entryP - slDist * 0.75
            tp2    = entryP - slDist * 1.50
            tp3    = entryP - slDist * 2.25
            nyorb_done := true
            fStr   = "NYORB✓ H1-H4-SHORT✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("gold-specialist", "SHORT", entryP, slP, tp1, tp2, tp3,
                                nyorb_hi, nyorb_lo, "NYORB",
                                sess_label, "A", "h1+h4", fStr,
                                math.max(0, _minOfDay - 870)),
                  alert.freq_once_per_bar)
            label.new(bar_index, high, "⚡ NYORB SHORT",
                      style=label.style_label_down, color=color.new(color.red, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

// Psychological level guide lines — persistent array prevents line count blowout
var array<line> _psych_lines = array.new<line>()
if barstate.islast
    for pln in _psych_lines
        line.delete(pln)
    array.clear(_psych_lines)
    for lvl = math.ceil(low / 50) * 50 to math.floor(high / 50) * 50 by 50
        isMajor = lvl % 100 == 0
        ln = line.new(bar_index - 60, lvl, bar_index + 20, lvl,
                      color=isMajor ? color.new(color.purple, 45) : color.new(color.purple, 75),
                      style=isMajor ? line.style_solid : line.style_dotted,
                      width=1)
        array.push(_psych_lines, ln)

// ─── STATUS TABLE ─────────────────────────────────────────────────────
var table stTbl = na

if showStatusTbl and barstate.islast
    if na(stTbl)
        stTbl := table.new(position.top_right, 2, 13,
                           bgcolor=color.new(color.black, 70),
                           border_color=color.new(color.gray, 60), border_width=1,
                           frame_color=color.new(color.gray, 60), frame_width=1)

    adrPct  = math.round(_adrConsumed * 100)
    adrCol  = _adrConsumed >= 2.50 ? color.red :
              _adrConsumed >= 1.50 ? color.orange :
              _adrConsumed >= 0.90 ? color.yellow :
              _adrConsumed >= 0.75 ? color.lime : color.aqua
    adrGates = (adr_fvg_ok ? "F" : "f") + (adr_judas_ok ? "J" : "j") + (adr_psych_ok ? "P" : "p")
    h1Str   = h1B == 1 ? "LONG" : h1B == -1 ? "SHORT" : "NEUT"
    h4Str   = h4B == 1 ? "LONG" : h4B == -1 ? "SHORT" : "NEUT"
    h1Col   = h1B == 1 ? color.lime : h1B == -1 ? color.red : color.gray
    h4Col   = h4B == 1 ? color.lime : h4B == -1 ? color.red : color.gray
    hdStr   = hdB == 1 ? "LONG" : hdB == -1 ? "SHORT" : "NEUT"
    hdCol   = hdB == 1 ? color.lime : hdB == -1 ? color.red : color.gray
    sCol    = in_kz ? color.lime : in_asian ? color.blue : color.gray
    arStr   = ar_locked and not na(ar_hi) ?
              str.tostring(ar_hi, format.mintick) + " / " + str.tostring(ar_lo, format.mintick) : "—"

    table.cell(stTbl, 0, 0, "QB GOLD",     text_color=color.new(#D4A017, 0),     text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_left)
    table.cell(stTbl, 1, 0, "XAUUSD · " + timeframe.period + "m", text_color=color.new(color.white,20), text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_right)

    table.cell(stTbl, 0, 1, "Session",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 1, sess_label,   text_color=color.new(sCol,0),        text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 2, "ADR",        text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 2, str.tostring(adrPct) + "% · " + _adrTierStr + " [" + adrGates + "]",
               text_color=color.new(adrCol,0), text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 3, "H1 bias",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 3, h1Str,        text_color=color.new(h1Col,0),       text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 4, "H4 bias",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 4, h4Str,        text_color=color.new(h4Col,0),       text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 5, "D bias",     text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 5, hdStr,        text_color=color.new(hdCol,0),       text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 6, "Asian R",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 6, arStr,        text_color=color.new(color.aqua,0),  text_size=size.tiny, text_halign=text.align_right)

    fvgCount = array.size(fU)
    table.cell(stTbl, 0, 7, "FVGs",       text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 7, str.tostring(fvgCount) + " live",
               text_color=color.new(color.white,20), text_size=size.tiny, text_halign=text.align_right)

    keyStr = _nearKeyTime == 1 ? "⚡ LBMA/COMEX" : "—"
    table.cell(stTbl, 0, 8, "Key time",   text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 8, keyStr,       text_color=color.new(_nearKeyTime==1 ? color.orange : color.gray, 0), text_size=size.tiny, text_halign=text.align_right)

    psychStr = psych_done ? "fired" : (adr_psych_ok and adr_hard_ok and in_kz ? "watching" : "off")
    psychCol = psych_done ? color.purple : (adr_psych_ok and adr_hard_ok and in_kz ? color.lime : color.gray)
    table.cell(stTbl, 0, 9, "Psych",      text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 9, psychStr,     text_color=color.new(psychCol, 0),   text_size=size.tiny, text_halign=text.align_right)

    psychExtStr = psych_ext_done ? "fired" : (adr_psych_ok and adr_hard_ok ? "armed" : "ADR-block")
    psychExtCol = psych_ext_done ? color.orange : (adr_psych_ok and adr_hard_ok ? color.yellow : color.gray)
    table.cell(stTbl, 0, 10, "Psych-Ext", text_color=color.new(color.gray,15),   text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 10, psychExtStr, text_color=color.new(psychExtCol, 0),   text_size=size.tiny, text_halign=text.align_right)

    frbStr = frb_done ? "fired" : (frb_locked and in_frb_trade and adr_hard_ok ? "watching" : in_frb_window ? "building" : "off")
    frbCol = frb_done ? color.red : (frb_locked and in_frb_trade and adr_hard_ok ? color.lime : color.gray)
    table.cell(stTbl, 0, 11, "FRB (M)",  text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 11, frbStr,     text_color=color.new(frbCol, 0),     text_size=size.tiny, text_halign=text.align_right)

    nyorbStr = nyorb_done ? "fired" : (nyorb_locked and adr_hard_ok ? "watching" : in_nyorb_window ? "building" : "off")
    nyorbCol = nyorb_done ? color.teal : (nyorb_locked and adr_hard_ok ? color.lime : color.gray)
    table.cell(stTbl, 0, 12, "NY ORB (H)", text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 12, nyorbStr,     text_color=color.new(nyorbCol, 0),    text_size=size.tiny, text_halign=text.align_right)

// ─── SESSION BACKGROUNDS ──────────────────────────────────────────────
bgcolor(in_asian   ? color.new(color.blue,   90) : na, title="Asian")
bgcolor(in_london  ? color.new(color.yellow, 90) : na, title="London KZ")
bgcolor(in_overlap ? color.new(color.orange, 88) : na, title="NY-Lon Overlap")
bgcolor(in_sb_win  ? color.new(color.lime,   75) : na, title="Silver Bullet")
