//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  QB NAS100 — STRATEGY BACKTEST  (identical logic to qb-nas100-specialist)
//  ─────────────────────────────────────────────────────────────────────────
//  HOW TO USE:
//    1. Load on NAS100 / CAPITALCOM:US100  ·  15m timeframe
//    2. Set date range to the same window you used before (e.g. 3yr)
//    3. Run with "Enable VIX gate" OFF  → note WR / PF / Trades
//    4. Run with "Enable VIX gate" ON   → compare same metrics
//    5. Both runs must use the same date range — results are directly comparable
//
//  Commission: 0.01% per trade (realistic NAS100 CFD spread ~3 pts at 30k)
//  Slippage  : 2 ticks (1 pip fill slippage on entry and exit)
// ═══════════════════════════════════════════════════════════════════════════
strategy("QB NAS100 · VIX Backtest", "QB NAS100 BT", overlay=true,
         default_qty_type  = strategy.fixed,
         default_qty_value = 1,
         commission_type   = strategy.commission.percent,
         commission_value  = 0.01,
         slippage          = 2,
         pyramiding        = 0,
         max_bars_back     = 500,
         calc_on_every_tick = false)

// ─── INPUT GROUPS ────────────────────────────────────────────────────────
G_CORE = "Core"
G_FILT = "Filters"
G_VIX  = "── VIX Regime Gate ──"

// ─── CORE INPUTS ─────────────────────────────────────────────────────────
modBoth   = input.bool(true,  "Trade both LONG + SHORT",             group=G_CORE)
tpMult    = input.float(2.0,  "TP multiplier (× R)",                 group=G_CORE, minval=0.5,  maxval=5.0,  step=0.5)
slBuf     = input.float(0.15, "SL buffer (× ATR)",                   group=G_CORE, minval=0.05, maxval=0.5,  step=0.05)
maxTrades = input.int(1,      "Max signals per day",                  group=G_CORE, minval=1, maxval=3)

// ─── FILTER INPUTS (same defaults as confirmed best) ─────────────────────
reqSweep  = input.bool(true,  "Require London→Asian sweep",          group=G_FILT,
            tooltip="ON = confirmed best. Only enter when London swept Asian H or L and closed back inside.")
reqBOS    = input.bool(true,  "Require ORB BOS before entry",        group=G_FILT,
            tooltip="ON = confirmed best. Wait for a bar to close beyond ORB in bias direction.")
useSMT    = input.bool(false, "SMT: require SP500 divergence",       group=G_FILT,
            tooltip="OFF = confirmed best.")
useH4     = input.bool(false, "H4 EMA200 gate",                      group=G_FILT,
            tooltip="OFF = confirmed best.")
fvgMinPts = input.float(20.0, "Min FVG size (index pts)",            group=G_FILT,
            minval=2.0, maxval=100.0, step=2.0,
            tooltip="20pts = confirmed best: 59.72% WR / PF 2.507 / 72 trades/yr")
atrLen    = input.int(14,     "ATR period",                          group=G_FILT, minval=5, maxval=50)
emaLen    = input.int(200,    "HTF EMA period",                      group=G_FILT, minval=20, maxval=500)

// ─── VIX GATE INPUTS ─────────────────────────────────────────────────────
useVIX = input.bool(false,  "Enable VIX regime gate",                group=G_VIX,
         tooltip="OFF = baseline run (no filter). ON = skip entry when prev-day VIX ≥ threshold. Compare both runs over the same date range.")
vixMax = input.float(20.0,  "Block if VIX ≥ (prev-day close)",       group=G_VIX,
         minval=10.0, maxval=50.0, step=1.0,
         tooltip="20 = standard (blocks top ~25% vol days). Try 18 and 22 to bracket the result.")

// ─── VIX DATA ────────────────────────────────────────────────────────────
// Previous daily VIX close — no lookahead bias.
// At 14:00 UTC (Silver Bullet entry window) the prior day's print is the
// only VIX level cleanly available. This is the correct reference.
vixPrev = request.security("TVC:VIX", "D", close[1], lookahead=barmerge.lookahead_off)
vixOK   = not useVIX or (not na(vixPrev) and vixPrev < vixMax)

// ─── HTF BIAS ────────────────────────────────────────────────────────────
f_ema200(int p) =>
    e = ta.ema(close, p)
    close[1] > e[1] ? 1 : close[1] < e[1] ? -1 : 0

h4B    = request.security(syminfo.tickerid, "240", f_ema200(emaLen), lookahead=barmerge.lookahead_off)
h1B    = request.security(syminfo.tickerid,  "60", f_ema200(emaLen), lookahead=barmerge.lookahead_off)
hdB    = request.security(syminfo.tickerid,   "D", f_ema200(emaLen), lookahead=barmerge.lookahead_off)
atrVal = ta.atr(atrLen)

// SP500 for SMT
s5Hi = request.security("CAPITALCOM:US500", timeframe.period, high, lookahead=barmerge.lookahead_off)
s5Lo = request.security("CAPITALCOM:US500", timeframe.period, low,  lookahead=barmerge.lookahead_off)

// ─── SESSION GATES (UTC minutes) ─────────────────────────────────────────
_mu     = hour(time, "UTC") * 60 + minute(time, "UTC")
_newDay = ta.change(time("D")) != 0

in_asian  = timeframe.isintraday and _mu >= 0   and _mu < 420
in_london = timeframe.isintraday and _mu >= 420 and _mu < 810
in_orb_w  = timeframe.isintraday and _mu >= 810 and _mu < 825
in_ny     = timeframe.isintraday and _mu >= 810 and _mu < 1170
in_sb_ext = timeframe.isintraday and _mu >= 840 and _mu < 960

// ─── DAY OF WEEK ─────────────────────────────────────────────────────────
_utcDow  = dayofweek(time, "UTC")
_dowTier = (_utcDow == 3 or _utcDow == 4 or _utcDow == 5) ? "A" : _utcDow == 2 ? "B" : "C"
_dowName = _utcDow == 4 ? "WED" : _utcDow == 3 ? "TUE" : _utcDow == 2 ? "MON" : _utcDow == 6 ? "FRI" : "THU"

// ─── DAILY DATA ──────────────────────────────────────────────────────────
_atr14d     = request.security(syminfo.tickerid, "D", ta.atr(14))
_priorDayHi = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
_priorDayLo = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
_priorClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
_todayOpen  = request.security(syminfo.tickerid, "D", open)
_todayHigh  = request.security(syminfo.tickerid, "D", high)
_todayLow   = request.security(syminfo.tickerid, "D", low)
_adrConsumed = _atr14d > 0 ? (_todayHigh - _todayLow) / _atr14d : 0.0

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1 · ASIAN RANGE  (00:00–07:00 UTC)
// ═══════════════════════════════════════════════════════════════════════════
var float asian_hi     = na
var float asian_lo     = na
var bool  asian_locked = false
var float sp5_asian_hi = na
var float sp5_asian_lo = na

if _newDay
    asian_hi     := na
    asian_lo     := na
    asian_locked := false
    sp5_asian_hi := na
    sp5_asian_lo := na

if in_asian
    asian_hi     := na(asian_hi)     ? high : math.max(asian_hi, high)
    asian_lo     := na(asian_lo)     ? low  : math.min(asian_lo, low)
    sp5_asian_hi := na(sp5_asian_hi) ? s5Hi : math.max(sp5_asian_hi, s5Hi)
    sp5_asian_lo := na(sp5_asian_lo) ? s5Lo : math.min(sp5_asian_lo, s5Lo)

if not in_asian and in_asian[1] and not na(asian_hi)
    asian_locked := true

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2 · LONDON SWEEP  (07:00–13:30 UTC)
// ═══════════════════════════════════════════════════════════════════════════
var float ldn_hi      = na
var float ldn_lo      = na
var bool  ldn_locked  = false
var bool  sw_lo       = false
var bool  sw_hi       = false
var float sp5_ldn_lo  = na
var float sp5_ldn_hi  = na
var int   day_bias    = 0
var bool  smt_bull_ok = false
var bool  smt_bear_ok = false
var bool  narr_set    = false

if _newDay
    ldn_hi      := na
    ldn_lo      := na
    ldn_locked  := false
    sw_lo       := false
    sw_hi       := false
    sp5_ldn_lo  := na
    sp5_ldn_hi  := na
    day_bias    := 0
    smt_bull_ok := false
    smt_bear_ok := false
    narr_set    := false

if in_london and asian_locked
    ldn_hi     := na(ldn_hi)     ? high : math.max(ldn_hi, high)
    ldn_lo     := na(ldn_lo)     ? low  : math.min(ldn_lo, low)
    sp5_ldn_lo := na(sp5_ldn_lo) ? s5Lo : math.min(sp5_ldn_lo, s5Lo)
    sp5_ldn_hi := na(sp5_ldn_hi) ? s5Hi : math.max(sp5_ldn_hi, s5Hi)
    if barstate.isconfirmed
        if not sw_lo and low < asian_lo and close > asian_lo
            sw_lo := true
        if not sw_hi and high > asian_hi and close < asian_hi
            sw_hi := true

if not in_london and in_london[1] and not na(ldn_hi)
    ldn_locked := true

if ldn_locked and not narr_set
    narr_set    := true
    smt_bull_ok := sw_lo and not na(sp5_asian_lo) and sp5_ldn_lo >= sp5_asian_lo
    smt_bear_ok := sw_hi and not na(sp5_asian_hi) and sp5_ldn_hi <= sp5_asian_hi
    raw          = sw_lo and not sw_hi ? 1 : sw_hi and not sw_lo ? -1 : sw_lo and sw_hi ? h4B : reqSweep ? 0 : h4B
    day_bias    := (not useH4 or raw == 0 or raw == h4B) ? raw : 0

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3a · ORB + BOS  (13:30–13:45 UTC)
// ═══════════════════════════════════════════════════════════════════════════
var float orb_hi     = na
var float orb_lo     = na
var bool  orb_locked = false
var bool  bos_long   = false
var bool  bos_short  = false

if _newDay
    orb_hi     := na
    orb_lo     := na
    orb_locked := false
    bos_long   := false
    bos_short  := false

if in_orb_w
    orb_hi := na(orb_hi) ? high : math.max(orb_hi, high)
    orb_lo := na(orb_lo) ? low  : math.min(orb_lo, low)

if not in_orb_w and in_orb_w[1] and not na(orb_hi)
    orb_locked := true

if orb_locked and barstate.isconfirmed and day_bias != 0
    if not bos_long  and day_bias ==  1 and close > orb_hi
        bos_long  := true
    if not bos_short and day_bias == -1 and close < orb_lo
        bos_short := true

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3b · FVG DETECTION  (from 13:30 UTC)
// ═══════════════════════════════════════════════════════════════════════════
var float fvg_hi      = na
var float fvg_lo      = na
var int   fvg_dir     = 0
var int   trades_today = 0
var bool  long_fired  = false
var bool  short_fired = false

if _newDay
    fvg_hi       := na
    fvg_lo       := na
    fvg_dir      := 0
    trades_today := 0
    long_fired   := false
    short_fired  := false

if barstate.isconfirmed and in_ny and day_bias != 0 and fvg_dir == 0
    bgap = low > high[2] ? low - high[2] : 0.0
    sgap = low[2] > high ? low[2] - high : 0.0
    if day_bias == 1 and bgap >= fvgMinPts
        fvg_lo  := high[2]
        fvg_hi  := low
        fvg_dir := 1
    else if modBoth and day_bias == -1 and sgap >= fvgMinPts
        fvg_lo  := high
        fvg_hi  := low[2]
        fvg_dir := -1

// ═══════════════════════════════════════════════════════════════════════════
// ENTRY + EXIT
// ═══════════════════════════════════════════════════════════════════════════
_bos_ready = not reqBOS or (day_bias == 1 ? bos_long : bos_short)

if barstate.isconfirmed and in_sb_ext and trades_today < maxTrades
   and day_bias != 0 and fvg_dir != 0 and _bos_ready and vixOK

    // ── LONG ────────────────────────────────────────────────────────────────
    _smt_l = not useSMT or smt_bull_ok
    if day_bias == 1 and fvg_dir == 1 and _smt_l and not long_fired
       and not na(fvg_lo) and not na(fvg_hi)
        if low <= fvg_hi and high >= fvg_lo
            ep   = close
            sl   = fvg_lo - atrVal * slBuf
            dist = ep - sl
            if dist > 0
                tp1 = ep + dist * tpMult
                if ep > sl and tp1 > ep
                    strategy.entry("Long", strategy.long, comment="AMD-FVG")
                    strategy.exit("Long X", "Long", limit=tp1, stop=sl)
                    long_fired   := true
                    trades_today += 1

    // ── SHORT ───────────────────────────────────────────────────────────────
    _smt_s = not useSMT or smt_bear_ok
    if modBoth and day_bias == -1 and fvg_dir == -1 and _smt_s and not short_fired
       and not na(fvg_lo) and not na(fvg_hi)
        if high >= fvg_lo and low <= fvg_hi
            ep   = close
            sl   = fvg_hi + atrVal * slBuf
            dist = sl - ep
            if dist > 0
                tp1 = ep - dist * tpMult
                if ep < sl and tp1 < ep
                    strategy.entry("Short", strategy.short, comment="AMD-FVG")
                    strategy.exit("Short X", "Short", limit=tp1, stop=sl)
                    short_fired  := true
                    trades_today += 1

// ═══════════════════════════════════════════════════════════════════════════
// VIX INFO LABEL  (top-right, updates on last bar)
// ═══════════════════════════════════════════════════════════════════════════
var label vixLbl = na
if barstate.islast
    label.delete(vixLbl)
    vixColor = not useVIX ? color.gray : vixOK ? color.new(color.teal, 20) : color.new(color.red, 20)
    vixText  = "VIX gate: " + (not useVIX ? "OFF (baseline)" : "ON  ≥" + str.tostring(vixMax, "0") + " → skip") +
               "\nPrev-day VIX: " + (na(vixPrev) ? "—" : str.tostring(vixPrev, "0.00")) +
               "\nToday OK: " + (not useVIX ? "—" : vixOK ? "✓ YES" : "✗ BLOCKED")
    vixLbl := label.new(bar_index, high, vixText,
                        style=label.style_label_lower_left,
                        color=vixColor, textcolor=color.white, size=size.small)
