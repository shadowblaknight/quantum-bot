//@version=6
indicator("Quantum Bot — Forex Specialist", "QB FOREX", overlay=true,
          max_bars_back=500, max_labels_count=200, max_lines_count=200, max_boxes_count=80)

// ═══════════════════════════════════════════════════════════════════════
//  QUANTUM BOT — FOREX SPECIALIST  (any forex pair, H1 chart)
//  ─────────────────────────────────────────────────────────────────────
//  Signal: H4 supply/demand zone retest + H1 CHoCH confirmation
//
//  Logic (derived from direct CSV analysis of 5-year GBPUSD data):
//    1. Daily EMA50 sets the primary trend bias (bull/bear)
//    2. H4 pivot high/low anchors a zone (width = H4 ATR × 0.40)
//    3. Price must be inside or within gate_atr of the zone edge
//    4. H1 close must break the most recent confirmed H1 swing pivot
//       in the trade direction  →  CHoCH confirmed
//    5. Session: London (08-12 UTC) or New York (13-18 UTC) only
//    6. Max 2 entries per zone per zone lifetime (dedup)
//       — from data: zones that failed 3+ times never recovered;
//         zones that won did so on entry 1 or 2.
//
//  Edge from data (64% of GBPUSD longs reached 1R, PF 1.80):
//    TP1 = 1R  ←  the natural exit
//    TP2 = 2R  (runner)
//    TP3 = 3R  (full swing)
//
//  Template: "forex-specialist"
// ═══════════════════════════════════════════════════════════════════════

// ─── WEBHOOK KEY ─────────────────────────────────────────────────────
WEBHOOK_KEY = "x5YFG4TDJKqi2fVEbBHO0r3vUPgmZACk"

// ─── INPUTS ──────────────────────────────────────────────────────────
G_STRAT = "Strategy"
emaLen    = input.int(50,     "Daily EMA period (trend bias)",  group=G_STRAT, minval=10, maxval=200)
h4ZoneW   = input.float(0.40, "H4 zone width (× H4 ATR)",      group=G_STRAT, minval=0.15, maxval=1.0,  step=0.05,
                               tooltip="Width of the demand/supply zone around each H4 pivot. 0.40 = 40% of H4 ATR.")
gateAtrD  = input.float(0.30, "Location gate (× D ATR)",       group=G_STRAT, minval=0.05, maxval=1.0,  step=0.05,
                               tooltip="How close price must be to the zone edge. 0.30 matched the profitable miner setting.")
slBuf     = input.float(0.20, "SL buffer beyond zone (× H4 ATR)", group=G_STRAT, minval=0.05, maxval=0.50, step=0.05)
maxEnt    = input.int(2,      "Max entries per zone",          group=G_STRAT, minval=1, maxval=4,
                               tooltip="Zones that failed 3+ entries never recovered in 5yr data. Cap at 2.")
rrMin     = input.float(1.5,  "Min RR to fire",                group=G_STRAT, minval=0.5, maxval=5.0,  step=0.5)
pivH1     = input.int(3,      "H1 CHoCH pivot bars",           group=G_STRAT, minval=2, maxval=8)
pivH4     = input.int(5,      "H4 zone pivot bars",            group=G_STRAT, minval=3, maxval=10)
maxZones  = input.int(4,      "Max active zones per side",     group=G_STRAT, minval=2, maxval=8)

G_SESSION = "Session"
lonS = input.int(8,  "London start UTC", group=G_SESSION, minval=0, maxval=23)
lonE = input.int(12, "London end UTC",   group=G_SESSION, minval=0, maxval=23)
nyS  = input.int(13, "NY start UTC",     group=G_SESSION, minval=0, maxval=23)
nyE  = input.int(18, "NY end UTC",       group=G_SESSION, minval=0, maxval=23)

G_VIS = "Visuals"
showZ   = input.bool(true,  "Show H4 zones",      group=G_VIS)
showLbl = input.bool(true,  "Show signal labels", group=G_VIS)
showTbl = input.bool(true,  "Status table",       group=G_VIS)
showEma = input.bool(false, "Show Daily EMA",     group=G_VIS)

// ─── SESSION ─────────────────────────────────────────────────────────
_utcH   = hour(time, "UTC")
_inLon  = _utcH >= lonS and _utcH < lonE
_inNY   = _utcH >= nyS  and _utcH < nyE
_inSess = _inLon or _inNY
_sessLbl = _inLon ? "LONDON" : _inNY ? "NEW_YORK" : "OFF"
_dow    = dayofweek(time, "UTC") - 1   // 0=Sun 1=Mon … 6=Sat

// ─── HTF DATA ─────────────────────────────────────────────────────────
f_dailyCtx(int emaL) =>
    [ta.ema(close, emaL), ta.atr(14)]

[d_ema_v, d_atr_v] = request.security(syminfo.tickerid, "D",
    f_dailyCtx(emaLen), lookahead=barmerge.lookahead_off)

f_h4Ctx(int pivL, int emaL) =>
    [ta.pivothigh(high, pivL, pivL), ta.pivotlow(low, pivL, pivL), ta.atr(14), ta.ema(close, emaL), close]

[h4_ph_r, h4_pl_r, h4_atr_r, h4_ema_r, h4_cls_r] = request.security(syminfo.tickerid, "240",
    f_h4Ctx(pivH4, emaLen), lookahead=barmerge.lookahead_off)

// ─── BIAS ─────────────────────────────────────────────────────────────
d_bull  = not na(d_ema_v) and close > d_ema_v
d_bear  = not na(d_ema_v) and close < d_ema_v
h4_bull = not na(h4_ema_r) and not na(h4_cls_r) and h4_cls_r > h4_ema_r
h4_bear = not na(h4_ema_r) and not na(h4_cls_r) and h4_cls_r < h4_ema_r

// ─── ZONE STORAGE ─────────────────────────────────────────────────────
var float[] d_lo  = array.new<float>(0)   // demand zone lower edge
var float[] d_hi  = array.new<float>(0)   // demand zone upper edge
var int[]   d_cnt = array.new<int>(0)     // entry count for this zone
var box[]   d_bx  = array.new<box>(0)     // visual box handle

var float[] s_lo  = array.new<float>(0)   // supply zone lower edge
var float[] s_hi  = array.new<float>(0)   // supply zone upper edge
var int[]   s_cnt = array.new<int>(0)
var box[]   s_bx  = array.new<box>(0)

// ─── ZONE BUILDER ─────────────────────────────────────────────────────
if barstate.isconfirmed and not na(h4_atr_r) and h4_atr_r > 0

    // New H4 demand zone from pivot low
    if not na(h4_pl_r)
        zlo = h4_pl_r
        zhi = h4_pl_r + h4_atr_r * h4ZoneW
        isDup = false
        for i = 0 to array.size(d_lo) - 1
            if math.abs(array.get(d_lo, i) - zlo) < h4_atr_r * 0.12
                isDup := true
                break
        if not isDup
            array.unshift(d_lo,  zlo)
            array.unshift(d_hi,  zhi)
            array.unshift(d_cnt, 0)
            bx = showZ ? box.new(bar_index, zhi, bar_index + 1, zlo,
                                 border_color=color.new(color.teal, 45), border_width=1,
                                 bgcolor=color.new(color.teal, 87), extend=extend.right) : na
            array.unshift(d_bx, bx)
            while array.size(d_lo) > maxZones
                ob = array.pop(d_bx)
                if not na(ob)
                    box.delete(ob)
                array.pop(d_lo)
                array.pop(d_hi)
                array.pop(d_cnt)

    // New H4 supply zone from pivot high
    if not na(h4_ph_r)
        zhi = h4_ph_r
        zlo = h4_ph_r - h4_atr_r * h4ZoneW
        isDup = false
        for i = 0 to array.size(s_hi) - 1
            if math.abs(array.get(s_hi, i) - zhi) < h4_atr_r * 0.12
                isDup := true
                break
        if not isDup
            array.unshift(s_lo,  zlo)
            array.unshift(s_hi,  zhi)
            array.unshift(s_cnt, 0)
            bx = showZ ? box.new(bar_index, zhi, bar_index + 1, zlo,
                                 border_color=color.new(color.red, 45), border_width=1,
                                 bgcolor=color.new(color.red, 87), extend=extend.right) : na
            array.unshift(s_bx, bx)
            while array.size(s_lo) > maxZones
                ob = array.pop(s_bx)
                if not na(ob)
                    box.delete(ob)
                array.pop(s_lo)
                array.pop(s_hi)
                array.pop(s_cnt)

    // Remove demand zones broken by bearish H4 close below zone lo
    for i = array.size(d_lo) - 1 to 0
        if close < array.get(d_lo, i) - h4_atr_r * 0.05
            ob = array.get(d_bx, i)
            if not na(ob)
                box.delete(ob)
            array.remove(d_lo, i)
            array.remove(d_hi, i)
            array.remove(d_cnt, i)
            array.remove(d_bx, i)

    // Remove supply zones broken by bullish H4 close above zone hi
    for i = array.size(s_lo) - 1 to 0
        if close > array.get(s_hi, i) + h4_atr_r * 0.05
            ob = array.get(s_bx, i)
            if not na(ob)
                box.delete(ob)
            array.remove(s_lo, i)
            array.remove(s_hi, i)
            array.remove(s_cnt, i)
            array.remove(s_bx, i)

// ─── H1 CHoCH PIVOT TRACKING ─────────────────────────────────────────
h1_ph_v = ta.pivothigh(high, pivH1, pivH1)
h1_pl_v = ta.pivotlow(low, pivH1, pivH1)

var float last_ph = na   // last confirmed H1 swing high
var float last_pl = na   // last confirmed H1 swing low
var int   last_ph_bar = na
var int   last_pl_bar = na

if not na(h1_ph_v)
    last_ph     := h1_ph_v
    last_ph_bar := bar_index

if not na(h1_pl_v)
    last_pl     := h1_pl_v
    last_pl_bar := bar_index

// ─── LOCATION: find nearest in-zone demand/supply ─────────────────────
gate_d   = not na(d_atr_v) and d_atr_v > 0 ? d_atr_v * gateAtrD : ta.atr(14) * gateAtrD * 4
h4_atr_n = not na(h4_atr_r) and h4_atr_r > 0 ? h4_atr_r : ta.atr(14) * 4

act_d_idx = -1
if array.size(d_lo) > 0
    best = 999999.0
    for i = 0 to array.size(d_lo) - 1
        if array.get(d_cnt, i) >= maxEnt
            continue
        zlo = array.get(d_lo, i)
        zhi = array.get(d_hi, i)
        if close >= zlo - gate_d and close <= zhi + gate_d
            dist = math.abs(close - (zlo + zhi) * 0.5)
            if dist < best
                best      := dist
                act_d_idx := i

act_s_idx = -1
if array.size(s_lo) > 0
    best = 999999.0
    for i = 0 to array.size(s_lo) - 1
        if array.get(s_cnt, i) >= maxEnt
            continue
        zlo = array.get(s_lo, i)
        zhi = array.get(s_hi, i)
        if close >= zlo - gate_d and close <= zhi + gate_d
            dist = math.abs(close - (zlo + zhi) * 0.5)
            if dist < best
                best      := dist
                act_s_idx := i

// ─── ALERT JSON BUILDER ──────────────────────────────────────────────
f_json(string dir, float entry, float sl, float tp1, float tp2, float tp3,
       float zlo, float zhi, string ztype, string filt, string tier) =>
    slD = math.abs(entry - sl)
    r1  = slD > 0 ? math.abs(tp1 - entry) / slD : 0.0
    r2  = slD > 0 ? math.abs(tp2 - entry) / slD : 0.0
    r3  = slD > 0 ? math.abs(tp3 - entry) / slD : 0.0
    "{\"version\":\"2.3\",\"action\":\"trade\",\"template\":\"forex-specialist\"" +
    ",\"direction\":\"" + dir + "\"" +
    ",\"symbol\":\"" + syminfo.tickerid + "\"" +
    ",\"timeframe\":\"60\"" +
    ",\"timestamp\":" + str.tostring(time) +
    ",\"entry\":\"" + str.tostring(entry, format.mintick) + "\"" +
    ",\"sl\":\""    + str.tostring(sl,    format.mintick) + "\"" +
    ",\"tp1\":\""   + str.tostring(tp1,   format.mintick) + "\"" +
    ",\"tp2\":\""   + str.tostring(tp2,   format.mintick) + "\"" +
    ",\"tp3\":\""   + str.tostring(tp3,   format.mintick) + "\"" +
    ",\"rr1\":"     + str.tostring(r1, "0.00") +
    ",\"rr2\":"     + str.tostring(r2, "0.00") +
    ",\"rr3\":"     + str.tostring(r3, "0.00") +
    ",\"zoneUpper\":\"" + str.tostring(zhi, format.mintick) + "\"" +
    ",\"zoneLower\":\"" + str.tostring(zlo, format.mintick) + "\"" +
    ",\"zoneType\":\"" + ztype + "\"" +
    ",\"activeSession\":\"" + _sessLbl + "\"" +
    ",\"htfTier\":\"" + tier + "\"" +
    ",\"htfBias\":\"" + (dir == "LONG" ? (h4_bull ? "1" : "0") : (h4_bear ? "-1" : "0")) + "/" +
                        (dir == "LONG" ? "1" : "-1") + "\"" +
    ",\"filters\":\"" + filt + "\"" +
    ",\"window\":\"" + _sessLbl + "\"" +
    ",\"hourUtc\":\"" + str.tostring(_utcH) + "\"" +
    ",\"dayOfWeek\":\"" + str.tostring(_dow) + "\"" +
    ",\"apiKey\":\"" + WEBHOOK_KEY + "\"}"

// ─── SIGNAL DETECTION ────────────────────────────────────────────────
if barstate.isconfirmed and _inSess

    // ── LONG: Daily bull bias + at H4 demand zone + H1 breaks last swing high ──
    if d_bull and act_d_idx >= 0 and not na(last_ph) and close > last_ph
        // Only fire if the pivot high that was broken is reasonably recent
        // (within 40 bars: ~40 H1 hours = 2 trading days)
        ph_age = not na(last_ph_bar) ? bar_index - last_ph_bar : 999
        if ph_age <= 40
            zlo  = array.get(d_lo, act_d_idx)
            zhi  = array.get(d_hi, act_d_idx)
            slP  = zlo - h4_atr_n * slBuf
            slD  = math.abs(close - slP)
            if slD > 0
                tp1 = close + slD * 1.0
                tp2 = close + slD * 2.0
                tp3 = close + slD * 3.0
                rr1 = slD > 0 ? (tp1 - close) / slD : 0.0
                if rr1 >= rrMin
                    array.set(d_cnt, act_d_idx, array.get(d_cnt, act_d_idx) + 1)
                    tier  = h4_bull ? "A" : "B"
                    fStr  = "ZONE✓ CHoCH-LONG✓ D" + (h4_bull ? "+H4" : "-only") + "-BULL"
                    alert(f_json("LONG", close, slP, tp1, tp2, tp3, zlo, zhi, "H4-DEMAND", fStr, tier),
                          alert.freq_once_per_bar)
                    if showLbl
                        label.new(bar_index, low,
                                  "⚡ LONG\n" + fStr + "\nZone " +
                                  str.tostring(zlo, format.mintick) + "–" + str.tostring(zhi, format.mintick),
                                  style=label.style_label_up,
                                  color=color.new(color.teal, 5),
                                  textcolor=color.white, size=size.tiny)

    // ── SHORT: Daily bear bias + at H4 supply zone + H1 breaks last swing low ──
    if d_bear and act_s_idx >= 0 and not na(last_pl) and close < last_pl
        pl_age = not na(last_pl_bar) ? bar_index - last_pl_bar : 999
        if pl_age <= 40
            zlo  = array.get(s_lo, act_s_idx)
            zhi  = array.get(s_hi, act_s_idx)
            slP  = zhi + h4_atr_n * slBuf
            slD  = math.abs(slP - close)
            if slD > 0
                tp1 = close - slD * 1.0
                tp2 = close - slD * 2.0
                tp3 = close - slD * 3.0
                rr1 = slD > 0 ? (close - tp1) / slD : 0.0
                if rr1 >= rrMin
                    array.set(s_cnt, act_s_idx, array.get(s_cnt, act_s_idx) + 1)
                    tier  = h4_bear ? "A" : "B"
                    fStr  = "ZONE✓ CHoCH-SHORT✓ D" + (h4_bear ? "+H4" : "-only") + "-BEAR"
                    alert(f_json("SHORT", close, slP, tp1, tp2, tp3, zlo, zhi, "H4-SUPPLY", fStr, tier),
                          alert.freq_once_per_bar)
                    if showLbl
                        label.new(bar_index, high,
                                  "⚡ SHORT\n" + fStr + "\nZone " +
                                  str.tostring(zlo, format.mintick) + "–" + str.tostring(zhi, format.mintick),
                                  style=label.style_label_down,
                                  color=color.new(color.red, 5),
                                  textcolor=color.white, size=size.tiny)

// ─── DAILY EMA LINE ───────────────────────────────────────────────────
plot(showEma ? d_ema_v : na, "D EMA50", color=color.new(color.orange, 35), linewidth=2)

// ─── SESSION BACKGROUNDS ──────────────────────────────────────────────
bgcolor(_inLon ? color.new(color.yellow, 93) : na, title="London")
bgcolor(_inNY  ? color.new(color.orange, 91) : na, title="New York")

// ─── STATUS TABLE ────────────────────────────────────────────────────
var table tbl = na
if showTbl and barstate.islast
    if na(tbl)
        tbl := table.new(position.top_right, 2, 10,
                         bgcolor=color.new(color.black, 70),
                         border_color=color.new(color.gray, 60), border_width=1,
                         frame_color=color.new(color.gray, 60), frame_width=1)

    dBStr = d_bull ? "BULL ▲" : d_bear ? "BEAR ▼" : "FLAT"
    dBCol = d_bull ? color.lime : d_bear ? color.red : color.gray
    h4BStr = h4_bull ? "BULL ▲" : h4_bear ? "BEAR ▼" : "FLAT"
    h4BCol = h4_bull ? color.lime : h4_bear ? color.red : color.gray
    sCol   = _inSess ? color.lime : color.gray
    nD     = array.size(d_lo)
    nS     = array.size(s_lo)
    adStr  = act_d_idx >= 0 ? "YES [" + str.tostring(array.get(d_cnt, act_d_idx)) + "/" + str.tostring(maxEnt) + "]" : "no"
    asStr  = act_s_idx >= 0 ? "YES [" + str.tostring(array.get(s_cnt, act_s_idx)) + "/" + str.tostring(maxEnt) + "]" : "no"

    table.cell(tbl, 0, 0, "QB FOREX",    text_color=color.new(color.aqua, 0), text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_left)
    table.cell(tbl, 1, 0, syminfo.ticker + " · H1", text_color=color.new(color.white,20), text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_right)
    table.cell(tbl, 0, 1, "Session",     text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 1, _sessLbl,      text_color=color.new(sCol, 0),       text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 2, "D Trend",     text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 2, dBStr,         text_color=color.new(dBCol, 0),      text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 3, "H4 Trend",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 3, h4BStr,        text_color=color.new(h4BCol, 0),     text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 4, "Demand zones",text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 4, str.tostring(nD) + " active", text_color=color.new(color.teal, 0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 5, "Supply zones",text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 5, str.tostring(nS) + " active", text_color=color.new(color.red, 0),  text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 6, "At demand",   text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 6, adStr,         text_color=color.new(act_d_idx >= 0 ? color.lime : color.gray, 0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 7, "At supply",   text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 7, asStr,         text_color=color.new(act_s_idx >= 0 ? color.lime : color.gray, 0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 8, "CHoCH level", text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    lastLvl = d_bull and act_d_idx >= 0 and not na(last_ph) ? str.tostring(last_ph, format.mintick) :
              d_bear and act_s_idx >= 0 and not na(last_pl) ? str.tostring(last_pl, format.mintick) : "—"
    table.cell(tbl, 1, 8, lastLvl,       text_color=color.new(color.white,20),text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 0, 9, "Template",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 9, "forex-specialist", text_color=color.new(color.white,20), text_size=size.tiny, text_halign=text.align_right)
