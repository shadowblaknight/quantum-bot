//@version=6
indicator("Quantum Bot — Silver Specialist", "QB SILVER", overlay=true,
          max_bars_back=500, max_labels_count=200, max_lines_count=100, max_boxes_count=100)

// ═══════════════════════════════════════════════════════════════════════
//  QUANTUM BOT — SILVER SPECIALIST  (XAGUSD, 15m recommended)
//  ─────────────────────────────────────────────────────────────────────
//  Ported from GS1 Gold Specialist architecture (97.54% WR confirmed).
//  Silver shares Gold's institutional session structure (Frankfurt +
//  NY ORB) and H1/H4 USD-macro bias, but with 1.5–2× wider ATR and
//  no LBMA/COMEX fix dependency. SL buffer and ORB minimums scaled
//  for Silver's typical $0.60–1.00 daily range.
//
//  Signals:
//    A) silver-fvg    — FVG retest London KZ / NY-Lon Overlap + BOS
//    B) judas-swing   — Asian-range sweep play (pure sweep, no FVG)
//    M) frankfurt-orb — Frankfurt 07:00-07:30 UTC C2 OCO retest
//    H) ny-orb        — NY 14:00-14:30 UTC C2 OCO retest
//
//  Engine: ADR gate, Asian range, FRB/NYORB trackers, FVG pool,
//  BOS tracker, HTF bias (H1/H4/D), CVD, status table.
// ═══════════════════════════════════════════════════════════════════════

WEBHOOK_KEY = "x5YFG4TDJKqi2fVEbBHO0r3vUPgmZACk"

// ─── INPUTS ──────────────────────────────────────────────────────────
G_CORE = "Core"
modFVG    = input.bool(true, "A) FVG Signal (silver-fvg)",             group=G_CORE)
modJudas  = input.bool(true, "B) Judas Sweep — pure sweep, no FVG",    group=G_CORE)
modFRB    = input.bool(true, "M) Frankfurt ORB — H1+H4 + Asian extreme required", group=G_CORE)
modNYORB  = input.bool(true, "H) NY ORB — H1+H4 required",             group=G_CORE)

G_C2 = "C2 — OCO (Signal M + H)"
c2SLBuf  = input.float(2.00, "SL beyond C2 level (price units)", group=G_C2, step=0.05,
             tooltip="Silver: $2.00 ≈ 3× typical daily ATR. Placed beyond ORB structural edge.")
c2TpMult = input.float(0.75, "TP = ORB range × (from C2 level)", group=G_C2, step=0.05)

G_FILT = "Filters"
adrFVGMax   = input.float(0.85, "FVG max ADR consumed",   group=G_FILT, minval=0.50, maxval=1.50, step=0.05)
adrJudasMax = input.float(0.90, "Judas max ADR consumed", group=G_FILT, minval=0.50, maxval=1.50, step=0.05)
atrLength   = input.int(14,    "ATR period",               group=G_FILT, minval=2, maxval=50)
emaLength   = input.int(20,    "HTF bias EMA period",      group=G_FILT, minval=5, maxval=100)
fvgMinGapATR  = input.float(0.10, "FVG min gap (× ATR)",             group=G_FILT, minval=0.03, step=0.03)
fvgMaxFillPct = input.float(0.50, "FVG max fill before entry fires",  group=G_FILT, minval=0.0, maxval=1.0, step=0.05)
fvgMaxAgeBars = input.int(20,    "FVG max age (bars)",                group=G_FILT, minval=4, maxval=100)
slMinH1ATR  = input.float(0.30, "SL min (× H1 ATR)", group=G_FILT, minval=0.1, step=0.05)
slMaxH1ATR  = input.float(3.00, "SL max (× H1 ATR)", group=G_FILT, minval=1.0, step=0.10)
orbMinRange = input.float(0.15, "Min ORB range (price units)", group=G_FILT, step=0.01,
              tooltip="Silver: $0.15 = ~8 pips minimum range to trade.")

G_VIS = "Visuals"
showPosBox    = input.bool(true, "Position box on fire",      group=G_VIS)
posBoxBars    = input.int(40,   "Position box width (bars)",  group=G_VIS, minval=5, maxval=200)
showStatusTbl = input.bool(true, "Corner status table",       group=G_VIS)
showFVGZones  = input.bool(true, "FVG zones on chart",        group=G_VIS)

// ─── HTF BIAS ─────────────────────────────────────────────────────────
f_htfBias(int emaLen, int atrLen) =>
    e = ta.ema(close, emaLen)
    b = close[1] > e[1] ? 1 : close[1] < e[1] ? -1 : 0
    a = ta.atr(atrLen)
    [b, a]

[h1B, h1ATR] = request.security(syminfo.tickerid, "60",  f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[h4B, h4ATR] = request.security(syminfo.tickerid, "240", f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[hdB, hdATR] = request.security(syminfo.tickerid, "D",   f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)

atrVal = ta.atr(atrLength)

// ─── SESSION CONTEXT ──────────────────────────────────────────────────
_hourUtc   = hour(time, "UTC")
_minOfDay  = _hourUtc * 60 + minute(time, "UTC")
_dayOfWeek = dayofweek(time, "UTC") - 1

_atr14d     = request.security(syminfo.tickerid, "D", ta.atr(14))
_todayOpen  = request.security(syminfo.tickerid, "D", open)
_todayHigh  = request.security(syminfo.tickerid, "D", high)
_todayLow   = request.security(syminfo.tickerid, "D", low)
_priorClose = request.security(syminfo.tickerid, "D", close[1])
_priorDayHi = request.security(syminfo.tickerid, "D", high[1])
_priorDayLo = request.security(syminfo.tickerid, "D", low[1])

_adrConsumed = _atr14d > 0 ? (_todayHigh - _todayLow) / _atr14d : 0.0
_gapRaw      = _todayOpen - _priorClose
_gapAtr      = _atr14d > 0 ? math.abs(_gapRaw) / _atr14d : 0.0
_gapSign     = _gapRaw > 0 ? 1 : _gapRaw < 0 ? -1 : 0
_gapDirLong  = _gapSign
_gapDirShort = _gapSign * -1
_priorDayPos = _todayOpen > _priorDayHi ? 1 : _todayOpen < _priorDayLo ? -1 : 0

_adrTierStr = _adrConsumed >= 2.50 ? "OUTLIER" :
              _adrConsumed >= 1.50 ? "NEWS-EXT" :
              _adrConsumed >= 0.90 ? "EXHAUST"  :
              _adrConsumed >= 0.75 ? "HIGH-PROB" : "BUILDING"
_adrQuiet       = _adrConsumed < 0.75
_adrRemainTo75  = math.max(0.0, _atr14d * 0.75 - (_todayHigh - _todayLow))

// ─── CVD ──────────────────────────────────────────────────────────────
_signedVol  = close > open ? volume : close < open ? -volume : 0.0
_newDay     = ta.change(time("D")) != 0

var float _cvdRunning = 0.0
_cvdRunning := _cvdRunning + _signedVol
var float _cvdBase = 0.0
if _newDay
    _cvdBase := _cvdRunning - _signedVol
cvd      = _cvdRunning - _cvdBase
cvdMa    = ta.ema(cvd, 14)
cvdSlope = cvd > cvd[1] and cvd > cvdMa ? "rising" : cvd < cvd[1] and cvd < cvdMa ? "falling" : "flat"

// ─── SESSION GATES (UTC) ──────────────────────────────────────────────
in_asian        = timeframe.isintraday and (_minOfDay >= 0    and _minOfDay < 480)
in_london       = timeframe.isintraday and (_minOfDay >= 480  and _minOfDay < 660)
in_overlap      = timeframe.isintraday and (_minOfDay >= 780  and _minOfDay < 1020)
in_kz           = in_london or in_overlap
in_frb_window   = timeframe.isintraday and (_minOfDay >= 420  and _minOfDay < 450)
in_frb_trade    = timeframe.isintraday and (_minOfDay >= 450  and _minOfDay < 660)
in_nyorb_window = timeframe.isintraday and (_minOfDay >= 840  and _minOfDay < 870)

string sess_label = in_overlap ? "NY_AM" : in_london ? "LONDON" : in_asian ? "ASIAN" : "OFF"

adr_fvg_ok   = _adrConsumed[1] < adrFVGMax
adr_judas_ok = _adrConsumed[1] < adrJudasMax
adr_hard_ok  = _adrConsumed    < 2.50

// ─── ASIAN RANGE ──────────────────────────────────────────────────────
var float ar_hi     = na
var float ar_lo     = na
var bool  ar_locked = false

if _newDay
    ar_hi     := na
    ar_lo     := na
    ar_locked := false

if in_asian
    ar_hi := na(ar_hi) ? high : math.max(ar_hi, high)
    ar_lo := na(ar_lo) ? low  : math.min(ar_lo, low)

if not in_asian and in_asian[1] and not na(ar_hi)
    ar_locked := true

// ─── FRANKFURT ORB + NY ORB ───────────────────────────────────────────
var float ar_lo_prefrb = na
var float ar_hi_prefrb = na
var float frb_hi       = na
var float frb_lo       = na
var bool  frb_locked   = false
var bool  frb_done     = false
var float nyorb_hi     = na
var float nyorb_lo     = na
var bool  nyorb_locked = false
var bool  nyorb_done   = false

if _newDay
    ar_lo_prefrb := na
    ar_hi_prefrb := na
    frb_hi       := na
    frb_lo       := na
    frb_locked   := false
    frb_done     := false
    nyorb_hi     := na
    nyorb_lo     := na
    nyorb_locked := false
    nyorb_done   := false

if _minOfDay >= 0 and _minOfDay < 420
    ar_lo_prefrb := na(ar_lo_prefrb) ? low  : math.min(ar_lo_prefrb, low)
    ar_hi_prefrb := na(ar_hi_prefrb) ? high : math.max(ar_hi_prefrb, high)

if in_frb_window
    frb_hi := na(frb_hi) ? high : math.max(frb_hi, high)
    frb_lo := na(frb_lo) ? low  : math.min(frb_lo, low)

if not in_frb_window and in_frb_window[1] and not na(frb_hi)
    frb_locked := true

if in_nyorb_window
    nyorb_hi := na(nyorb_hi) ? high : math.max(nyorb_hi, high)
    nyorb_lo := na(nyorb_lo) ? low  : math.min(nyorb_lo, low)

if not in_nyorb_window and in_nyorb_window[1] and not na(nyorb_hi)
    nyorb_locked := true

// ─── BOS TRACKING ─────────────────────────────────────────────────────
SWG = 3
var float _prev_sh   = na
var float _prev_sl   = na
var int   bos_bull_b = na
var int   bos_bear_b = na

_sh_now = ta.pivothigh(high, SWG, SWG)
_sl_now = ta.pivotlow(low,   SWG, SWG)

if not na(_sh_now)
    if not na(_prev_sh) and _sh_now > _prev_sh
        bos_bull_b := bar_index[SWG]
    _prev_sh := _sh_now

if not na(_sl_now)
    if not na(_prev_sl) and _sl_now < _prev_sl
        bos_bear_b := bar_index[SWG]
    _prev_sl := _sl_now

bos_bull_ok = not na(bos_bull_b) and (bar_index - bos_bull_b) <= 30
bos_bear_ok = not na(bos_bear_b) and (bar_index - bos_bear_b) <= 30

// ─── FVG POOL ─────────────────────────────────────────────────────────
var array<float> fU     = array.new<float>(0)
var array<float> fL     = array.new<float>(0)
var array<int>   fDir   = array.new<int>(0)
var array<int>   fBar   = array.new<int>(0)
var array<float> fFill  = array.new<float>(0)
var array<bool>  fFired = array.new<bool>(0)
var array<box>   fBoxes = array.new<box>(0)

if barstate.isconfirmed and atrVal > 0
    bull_fvg = low > high[2]
    bear_fvg = high < low[2]
    bull_gap = bull_fvg ? (low - high[2]) : 0.0
    bear_gap = bear_fvg ? (low[2] - high) : 0.0

    if bull_fvg and bull_gap >= atrVal * fvgMinGapATR
        array.push(fU, low)
        array.push(fL, high[2])
        array.push(fDir, 1)
        array.push(fBar, bar_index - 1)
        array.push(fFill, 0.0)
        array.push(fFired, false)
        bx = showFVGZones ?
             box.new(bar_index - 2, low, bar_index + fvgMaxAgeBars, high[2],
                     border_color=color.new(color.green, 40), border_width=1,
                     bgcolor=color.new(color.green, 86)) : na
        array.push(fBoxes, bx)

    if bear_fvg and bear_gap >= atrVal * fvgMinGapATR
        array.push(fU, low[2])
        array.push(fL, high)
        array.push(fDir, -1)
        array.push(fBar, bar_index - 1)
        array.push(fFill, 0.0)
        array.push(fFired, false)
        bx = showFVGZones ?
             box.new(bar_index - 2, low[2], bar_index + fvgMaxAgeBars, high,
                     border_color=color.new(color.red, 40), border_width=1,
                     bgcolor=color.new(color.red, 86)) : na
        array.push(fBoxes, bx)

    while array.size(fU) > 25
        old = array.shift(fBoxes)
        if not na(old)
            box.delete(old)
        array.shift(fU)
        array.shift(fL)
        array.shift(fDir)
        array.shift(fBar)
        array.shift(fFill)
        array.shift(fFired)

if barstate.isconfirmed and array.size(fU) > 0
    for idx = array.size(fU) - 1 to 0
        u   = array.get(fU,   idx)
        l   = array.get(fL,   idx)
        d   = array.get(fDir, idx)
        gsz = u - l
        if gsz <= 0
            continue
        if d == 1 and low < u
            array.set(fFill, idx, math.min(1.0, math.max(0.0, u - math.max(l, low)) / gsz))
        if d == -1 and high > l
            array.set(fFill, idx, math.min(1.0, math.max(0.0, math.min(u, high) - l) / gsz))

// ─── ALERT BUILDER ────────────────────────────────────────────────────
f_buildAlert(string tmpl, string dir, float entry, float slP,
             float tp1, float tp2, float tp3,
             float zU, float zL, string zType,
             string sess, string tier, string conf,
             string filters, int minsIntoWin) =>
    slRisk  = math.abs(entry - slP)
    rr1     = slRisk > 0 ? math.abs(tp1 - entry) / slRisk : 0.0
    rr2     = slRisk > 0 ? math.abs(tp2 - entry) / slRisk : 0.0
    rr3     = slRisk > 0 ? math.abs(tp3 - entry) / slRisk : 0.0
    scGapDir = dir == "LONG" ? _gapDirLong : _gapDirShort
    cvdOk    = dir == "LONG" ? cvdSlope == "rising" : cvdSlope == "falling"
    dEmoji   = dir == "LONG" ? "🟢" : "🔴"
    readable = dEmoji + " " + syminfo.ticker + " · " + (dir == "LONG" ? "BUY" : "SELL") +
               " · " + str.upper(tmpl) + " · " + timeframe.period + "m · Tier " + tier +
               "\nZone: " + str.tostring(zL, format.mintick) + " – " + str.tostring(zU, format.mintick) +
               "\nFilters: " + filters + "\n---\n"
    head   = "{\"version\":\"2.3\",\"action\":\"trade\",\"template\":\"" + tmpl +
              "\",\"direction\":\"" + dir +
              "\",\"symbol\":\"" + syminfo.tickerid +
              "\",\"timeframe\":\"" + timeframe.period +
              "\",\"timestamp\":" + str.tostring(time)
    prices = ",\"entry\":\""  + str.tostring(entry, format.mintick) +
              "\",\"sl\":\""  + str.tostring(slP,   format.mintick) +
              "\",\"tp1\":\"" + str.tostring(tp1,   format.mintick) +
              "\",\"tp2\":\"" + str.tostring(tp2,   format.mintick) +
              "\",\"tp3\":\"" + str.tostring(tp3,   format.mintick) +
              "\",\"rr1\":"   + str.tostring(rr1,   "0.00") +
              ",\"rr2\":"     + str.tostring(rr2,   "0.00") +
              ",\"rr3\":"     + str.tostring(rr3,   "0.00")
    zone   = ",\"zoneUpper\":\"" + str.tostring(zU, format.mintick) +
              "\",\"zoneLower\":\"" + str.tostring(zL, format.mintick) +
              "\",\"zoneType\":\"" + zType + "\""
    htf    = ",\"activeSession\":\"" + sess +
              "\",\"htfTier\":\"" + tier +
              "\",\"htfBias\":\"" + str.tostring(h1B) + "/" + str.tostring(h4B) + "/" + str.tostring(hdB) +
              "\",\"htfBiasAlign\":" + str.tostring(tier == "A" ? 1 : 0) +
              ",\"htfConfluence\":\"" + conf + "\""
    ctx    = ",\"window\":\"" + sess +
              "\",\"swept\":\"\",\"impulseATR\":\"0.00\"" +
              ",\"filters\":\"" + filters + "\"" +
              ",\"cvdSlope\":\"" + cvdSlope + "\"" +
              ",\"cvdConfirms\":" + str.tostring(cvdOk) +
              ",\"cvdDivergence\":\"none\",\"cvdLowTrust\":false" +
              ",\"barOpen\":\""  + str.tostring(open,  format.mintick) + "\"" +
              ",\"barHigh\":\""  + str.tostring(high,  format.mintick) + "\"" +
              ",\"barLow\":\""   + str.tostring(low,   format.mintick) + "\"" +
              ",\"barClose\":\"" + str.tostring(close, format.mintick) + "\"" +
              ",\"adrConsumed\":\"" + str.tostring(_adrConsumed,  "#.####") + "\"" +
              ",\"adrTier\":\""    + _adrTierStr                              + "\"" +
              ",\"gapAtr\":\""      + str.tostring(_gapAtr,        "#.####") + "\"" +
              ",\"gapDir\":\""      + str.tostring(scGapDir)                 + "\"" +
              ",\"priorDayPos\":\"" + str.tostring(_priorDayPos)             + "\"" +
              ",\"hourUtc\":\""     + str.tostring(_hourUtc)                 + "\"" +
              ",\"dayOfWeek\":\""   + str.tostring(_dayOfWeek)               + "\"" +
              ",\"minsIntoWindow\":" + str.tostring(minsIntoWin) +
              ",\"apiKey\":\"" + WEBHOOK_KEY + "\"}"
    readable + head + prices + zone + htf + ctx

f_drawPosBox(float e, float slP, float tp3) =>
    r = bar_index + posBoxBars
    box.new(bar_index, math.max(e, tp3), r, math.min(e, tp3),
            border_color=color.new(color.teal, 50), bgcolor=color.new(color.teal, 88))
    box.new(bar_index, math.max(e, slP), r, math.min(e, slP),
            border_color=color.new(color.red,  55), bgcolor=color.new(color.red,  90))
    line.new(bar_index, e, r, e, color=color.new(color.gray, 10), style=line.style_dashed, width=1)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL A — Silver FVG  (template: silver-specialist)
// ═══════════════════════════════════════════════════════════════════════
if modFVG and barstate.isconfirmed and in_kz and adr_fvg_ok and adr_hard_ok and not na(h1ATR) and h1ATR > 0 and array.size(fU) > 0
    firedA = false
    for idx = array.size(fU) - 1 to 0
        if firedA or array.get(fFired, idx)
            continue
        u       = array.get(fU,    idx)
        l       = array.get(fL,    idx)
        d       = array.get(fDir,  idx)
        birth   = array.get(fBar,  idx)
        fillPct = array.get(fFill, idx)

        if (bar_index - birth) > fvgMaxAgeBars or fillPct > fvgMaxFillPct
            continue

        touch = d == 1 ? (low <= u and high >= l) : (high >= l and low <= u)
        if not touch
            continue

        if not ((d == 1 and bos_bull_ok) or (d == -1 and bos_bear_ok))
            continue

        dirStr  = d == 1 ? "LONG" : "SHORT"
        h1ok    = h1B == d
        h4ok    = h4B == d
        hdok    = hdB == d
        aligned = h1ok or h4ok or hdok
        tier    = aligned ? "A" : "B"
        conf    = (h1ok ? "h1" : "") + (h4ok ? (h1ok ? "+h4" : "h4") : "") + (hdok ? ((h1ok or h4ok) ? "+D" : "D") : "")
        if str.length(conf) == 0
            conf := "counter-bias"

        buf     = math.max(0.20 * atrVal, 0.08 * h1ATR)
        entryP  = d == 1 ? l : u
        slP     = d == 1 ? l - buf : u + buf
        slDist  = math.abs(entryP - slP)
        slH1    = slDist / h1ATR

        if slDist <= 0 or slH1 < slMinH1ATR or slH1 > slMaxH1ATR
            continue

        tp1Mult = (_adrQuiet and _adrRemainTo75 > 0 and _adrRemainTo75 < slDist * 1.5) ? 0.75 : 1.0
        tp1 = d == 1 ? entryP + slDist * tp1Mult : entryP - slDist * tp1Mult
        tp2 = d == 1 ? entryP + slDist * 2.0 : entryP - slDist * 2.0
        tp3 = d == 1 ? entryP + slDist * 3.0 : entryP - slDist * 3.0

        if not (d == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
            continue

        array.set(fFired, idx, true)
        firedA := true

        minsIn = in_london ? math.max(0, _minOfDay - 480) : math.max(0, _minOfDay - 780)
        fStr   = "FVG✓ BOS✓" + (aligned ? " H1✓" : " H1✗") +
                 " ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"

        alert(f_buildAlert("silver-specialist", dirStr, entryP, slP, tp1, tp2, tp3,
                            u, l, "FVG", sess_label, tier, conf, fStr, minsIn),
              alert.freq_once_per_bar)

        if showPosBox
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL B — Judas Sweep
// ═══════════════════════════════════════════════════════════════════════
var bool judas_hi_done = false
var bool judas_lo_done = false

if _newDay
    judas_hi_done := false
    judas_lo_done := false

if modJudas and barstate.isconfirmed and in_london and ar_locked and adr_judas_ok and adr_hard_ok
    if not na(ar_hi) and not na(ar_lo) and not na(h1ATR) and h1ATR > 0
        aRef = nz(atrVal, h1ATR)

        if not judas_hi_done and high > ar_hi and close < ar_hi
            sweepSz = high - ar_hi
            if sweepSz >= aRef * 0.15
                entryP = ar_hi
                buf    = aRef * 0.20
                slP    = high + buf
                slDist = math.abs(entryP - slP)
                slH1   = slDist / h1ATR
                if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
                    tp1 = entryP - slDist * 1.0
                    tp2 = entryP - slDist * 2.0
                    tp3 = entryP - slDist * 3.0
                    judas_hi_done := true
                    tier = (h1B == -1 or h4B == -1 or hdB == -1) ? "A" : "B"
                    fStr = "SWEEP✓ CLOSE-INSIDE✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
                    alert(f_buildAlert("silver-specialist", "SHORT", entryP, slP, tp1, tp2, tp3,
                                        ar_hi + 0.01, ar_hi - 0.01, "Asian-H",
                                        "LONDON", tier, "judas-hi-sweep", fStr,
                                        math.max(0, _minOfDay - 480)),
                          alert.freq_once_per_bar)
                    label.new(bar_index, high, "⚡ Judas SHORT",
                              style=label.style_label_down, color=color.new(color.red, 5),
                              textcolor=color.white, size=size.small)
                    if showPosBox
                        f_drawPosBox(entryP, slP, tp3)

        if not judas_lo_done and low < ar_lo and close > ar_lo
            sweepSz = ar_lo - low
            if sweepSz >= aRef * 0.15
                entryP = ar_lo
                buf    = aRef * 0.20
                slP    = low - buf
                slDist = math.abs(entryP - slP)
                slH1   = slDist / h1ATR
                if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
                    tp1 = entryP + slDist * 1.0
                    tp2 = entryP + slDist * 2.0
                    tp3 = entryP + slDist * 3.0
                    judas_lo_done := true
                    tier = (h1B == 1 or h4B == 1 or hdB == 1) ? "A" : "B"
                    fStr = "SWEEP✓ CLOSE-INSIDE✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
                    alert(f_buildAlert("silver-specialist", "LONG", entryP, slP, tp1, tp2, tp3,
                                        ar_lo + 0.01, ar_lo - 0.01, "Asian-L",
                                        "LONDON", tier, "judas-lo-sweep", fStr,
                                        math.max(0, _minOfDay - 480)),
                          alert.freq_once_per_bar)
                    label.new(bar_index, low, "⚡ Judas LONG",
                              style=label.style_label_up, color=color.new(color.teal, 5),
                              textcolor=color.white, size=size.small)
                    if showPosBox
                        f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL M — Frankfurt ORB C2 OCO
// ═══════════════════════════════════════════════════════════════════════
if modFRB and barstate.isconfirmed and in_frb_trade and frb_locked and not frb_done and not na(frb_hi) and not na(frb_lo) and adr_hard_ok and _adrConsumed[1] < 0.90
    orb_range_frb = frb_hi - frb_lo
    if orb_range_frb >= orbMinRange
        if close < frb_lo and h1B == -1 and h4B == -1 and not na(ar_lo_prefrb) and close < ar_lo_prefrb
            entryP   = frb_lo
            slP      = frb_lo + c2SLBuf
            tp1      = frb_lo - orb_range_frb * c2TpMult
            tp2      = frb_lo - orb_range_frb * c2TpMult * 2.0
            tp3      = frb_lo - orb_range_frb * c2TpMult * 3.0
            frb_done := true
            fStr     = "FRB-C2✓ H1-H4-SHORT✓ ASIAN-LO✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("silver-specialist", "SHORT", entryP, slP, tp1, tp2, tp3,
                                frb_hi, frb_lo, "FRB", sess_label, "A", "h1+h4", fStr,
                                math.max(0, _minOfDay - 450)),
                  alert.freq_once_per_bar)
            label.new(bar_index, high, "⚡ FRB C2 SHORT",
                      style=label.style_label_down, color=color.new(color.red, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

        else if close > frb_hi and h1B == 1 and h4B == 1 and not na(ar_hi_prefrb) and close > ar_hi_prefrb
            entryP   = frb_hi
            slP      = frb_hi - c2SLBuf
            tp1      = frb_hi + orb_range_frb * c2TpMult
            tp2      = frb_hi + orb_range_frb * c2TpMult * 2.0
            tp3      = frb_hi + orb_range_frb * c2TpMult * 3.0
            frb_done := true
            fStr     = "FRB-C2✓ H1-H4-LONG✓ ASIAN-HI✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("silver-specialist", "LONG", entryP, slP, tp1, tp2, tp3,
                                frb_hi, frb_lo, "FRB", sess_label, "A", "h1+h4", fStr,
                                math.max(0, _minOfDay - 450)),
                  alert.freq_once_per_bar)
            label.new(bar_index, low, "⚡ FRB C2 LONG",
                      style=label.style_label_up, color=color.new(color.teal, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL H — NY ORB C2 OCO
// ═══════════════════════════════════════════════════════════════════════
if modNYORB and barstate.isconfirmed and nyorb_locked and not nyorb_done and not na(nyorb_hi) and not na(nyorb_lo) and adr_hard_ok and _adrConsumed[1] < 0.90
    orb_range_ny = nyorb_hi - nyorb_lo
    if orb_range_ny >= orbMinRange
        if close > nyorb_hi and h1B == 1 and h4B == 1
            entryP      = nyorb_hi
            slP         = nyorb_hi - c2SLBuf
            tp1         = nyorb_hi + orb_range_ny * c2TpMult
            tp2         = nyorb_hi + orb_range_ny * c2TpMult * 2.0
            tp3         = nyorb_hi + orb_range_ny * c2TpMult * 3.0
            nyorb_done := true
            fStr        = "NYORB-C2✓ H1-H4-LONG✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("silver-specialist", "LONG", entryP, slP, tp1, tp2, tp3,
                                nyorb_hi, nyorb_lo, "NYORB", sess_label, "A", "h1+h4", fStr,
                                math.max(0, _minOfDay - 870)),
                  alert.freq_once_per_bar)
            label.new(bar_index, low, "⚡ NYORB C2 LONG",
                      style=label.style_label_up, color=color.new(color.teal, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

        else if close < nyorb_lo and h1B == -1 and h4B == -1
            entryP      = nyorb_lo
            slP         = nyorb_lo + c2SLBuf
            tp1         = nyorb_lo - orb_range_ny * c2TpMult
            tp2         = nyorb_lo - orb_range_ny * c2TpMult * 2.0
            tp3         = nyorb_lo - orb_range_ny * c2TpMult * 3.0
            nyorb_done := true
            fStr        = "NYORB-C2✓ H1-H4-SHORT✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("silver-specialist", "SHORT", entryP, slP, tp1, tp2, tp3,
                                nyorb_hi, nyorb_lo, "NYORB", sess_label, "A", "h1+h4", fStr,
                                math.max(0, _minOfDay - 870)),
                  alert.freq_once_per_bar)
            label.new(bar_index, high, "⚡ NYORB C2 SHORT",
                      style=label.style_label_down, color=color.new(color.red, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

// ─── STATUS TABLE ─────────────────────────────────────────────────────
var table stTbl = na

if showStatusTbl and barstate.islast
    if na(stTbl)
        stTbl := table.new(position.top_right, 2, 11,
                           bgcolor=color.new(color.black, 70),
                           border_color=color.new(color.gray, 60), border_width=1,
                           frame_color=color.new(color.gray, 60), frame_width=1)

    adrPct = math.round(_adrConsumed * 100)
    adrCol = _adrConsumed >= 2.50 ? color.red :
             _adrConsumed >= 1.50 ? color.orange :
             _adrConsumed >= 0.90 ? color.yellow :
             _adrConsumed >= 0.75 ? color.lime : color.aqua
    h1Str  = h1B == 1 ? "LONG" : h1B == -1 ? "SHORT" : "NEUT"
    h4Str  = h4B == 1 ? "LONG" : h4B == -1 ? "SHORT" : "NEUT"
    hdStr  = hdB == 1 ? "LONG" : hdB == -1 ? "SHORT" : "NEUT"
    h1Col  = h1B == 1 ? color.lime : h1B == -1 ? color.red : color.gray
    h4Col  = h4B == 1 ? color.lime : h4B == -1 ? color.red : color.gray
    hdCol  = hdB == 1 ? color.lime : hdB == -1 ? color.red : color.gray
    sCol   = in_kz ? color.lime : in_asian ? color.blue : color.gray
    arStr  = ar_locked and not na(ar_hi) ?
             str.tostring(ar_hi, format.mintick) + " / " + str.tostring(ar_lo, format.mintick) : "—"

    table.cell(stTbl, 0, 0, "QB SILVER",  text_color=color.new(color.silver, 0), text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_left)
    table.cell(stTbl, 1, 0, "XAGUSD · " + timeframe.period + "m", text_color=color.new(color.white,20), text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_right)
    table.cell(stTbl, 0, 1, "Session",   text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 1, sess_label,  text_color=color.new(sCol,0),        text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 2, "ADR",       text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 2, str.tostring(adrPct) + "% · " + _adrTierStr, text_color=color.new(adrCol,0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 3, "H1 bias",   text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 3, h1Str,       text_color=color.new(h1Col,0),       text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 4, "H4 bias",   text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 4, h4Str,       text_color=color.new(h4Col,0),       text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 5, "D bias",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 5, hdStr,       text_color=color.new(hdCol,0),       text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 6, "Asian R",   text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 6, arStr,       text_color=color.new(color.aqua,0),  text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 7, "FVGs",      text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 7, str.tostring(array.size(fU)) + " live", text_color=color.new(color.white,20), text_size=size.tiny, text_halign=text.align_right)

    frbStr = frb_done ? "fired" : (frb_locked and in_frb_trade and adr_hard_ok ? "watching" : in_frb_window ? "building" : "off")
    frbCol = frb_done ? color.red : (frb_locked and in_frb_trade and adr_hard_ok ? color.lime : color.gray)
    table.cell(stTbl, 0, 8, "FRB (M)",   text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 8, frbStr,      text_color=color.new(frbCol, 0),     text_size=size.tiny, text_halign=text.align_right)

    nyStr  = nyorb_done ? "fired" : (nyorb_locked and adr_hard_ok ? "watching" : in_nyorb_window ? "building" : "off")
    nyCol  = nyorb_done ? color.teal : (nyorb_locked and adr_hard_ok ? color.lime : color.gray)
    table.cell(stTbl, 0, 9, "NY ORB (H)", text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 9, nyStr,        text_color=color.new(nyCol, 0),      text_size=size.tiny, text_halign=text.align_right)

    judStr = (judas_hi_done or judas_lo_done) ? "fired" : (in_london and ar_locked and adr_judas_ok ? "watching" : "off")
    judCol = (judas_hi_done or judas_lo_done) ? color.orange : (in_london and ar_locked and adr_judas_ok ? color.lime : color.gray)
    table.cell(stTbl, 0, 10, "Judas (B)", text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 10, judStr,      text_color=color.new(judCol, 0),     text_size=size.tiny, text_halign=text.align_right)

bgcolor(in_asian   ? color.new(color.blue,   90) : na, title="Asian")
bgcolor(in_london  ? color.new(color.yellow, 90) : na, title="London KZ")
bgcolor(in_overlap ? color.new(color.orange, 88) : na, title="NY-Lon Overlap")
