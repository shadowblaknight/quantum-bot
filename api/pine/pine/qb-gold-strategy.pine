//@version=6
strategy("QB Gold Specialist — Strategy", "QB GOLD · STRAT", overlay=true,
         max_bars_back=500, max_labels_count=500, max_lines_count=500, max_boxes_count=300,
         default_qty_type=strategy.percent_of_equity, default_qty_value=1,
         commission_type=strategy.commission.percent, commission_value=0.0,
         slippage=2, pyramiding=2, calc_on_every_tick=false,
         close_entries_rule="ANY")

// ═══════════════════════════════════════════════════════════════════════
//  QB GOLD SPECIALIST — STRATEGY VERSION  (XAUUSD 15m)
//  ─────────────────────────────────────────────────────────────────────
//  Identical detection logic as the indicator.  alert() → strategy.entry()
//  / strategy.exit() so TradingView Strategy Tester computes the full
//  historical win rate instantly across up to ~1 year of 15m bars.
//
//  Exit is determined by WHICH LEVEL PRICE HITS FIRST after entry:
//    slP         → LOSS   (same stop as drawn on the indicator box)
//    tp1/tp2/tp3 → WIN    (select in "Strategy" input group)
//
//  One trade at a time (pyramiding=0).  A new signal is skipped while a
//  previous trade is still running — same behaviour as the live bot.
//
//  How to read results:
//    Open TradingView → Pine Editor → paste → Add to chart
//    Open the "Strategy Tester" tab at the bottom
//    Switch "Exit target" input to compare TP1 / TP2 / TP3 scenarios
// ═══════════════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────────────
G_WIN = "0 · Test window"
// Added 2026-09-21 after a batch of six runs came back on 3 Nov 2023 - 21 Sep 2026
// while the recorded baseline was measured on 16 Sep 2023 - 16 Sep 2026. TradingView
// serves however much deep history it feels like on a 15m chart, so the start date
// MOVES between loads. Two runs compared across that drift are two different
// populations and part of the trade-count difference is just data supply.
useTestWin = input.bool(false, "Pin the backtest window (turn ON for any A/B)", group=G_WIN,
             tooltip="OFF = use every bar TradingView supplies, which is what every run before 2026-09-21 did. The loaded start date drifts between chart loads, so two runs taken on different days are NOT directly comparable - trade counts differ partly because the data supply differed.\n\nON = only bars inside the fixed window below can open a trade. Turn this ON before comparing anything to anything, and leave the dates alone for the whole comparison. Every run in the set then covers identical bars, so a trade-count difference is caused by the change you made and nothing else.\n\nDefaults sit inside the range TradingView reliably serves, so the window stays fully populated even on a short load.")
twStart    = input.time(timestamp("01 Jan 2024 00:00 +0000"), "  Window start", group=G_WIN)
twEnd      = input.time(timestamp("01 Sep 2026 00:00 +0000"), "  Window end",   group=G_WIN)
_testWinOk = not useTestWin or (time >= twStart and time <= twEnd)

G_CORE = "Core"
modORB        = input.bool(false, "G) London ORB — 08:00-08:30 UTC (verified)",     group=G_CORE)
modNYORB      = input.bool(true,  "H) NY ORB EARLY — break lands inside 14:30-16:00 UTC",  group=G_CORE,
              tooltip="H and H' are now INDEPENDENT SIGNALS on the same 14:00-14:30 opening range, split by WHEN the breakout bar closes. H takes the break only if it lands inside 14:30-16:00 UTC. H' takes it only if it lands after 16:00. The two windows are disjoint and nyorb_done is shared, so at most ONE NY ORB trade still exists per day. This SPLITS the population, it does not duplicate it.\n\nMAPPING FROM THE OLD SEMANTICS (H' used to be a restriction ON H, not a signal):\n  old H ON / H' OFF  (every break - the 3y-validated baseline)   ==  new H ON + H' ON\n  old H ON / H' ON   (early breaks only - the current LIVE set)  ==  new H ON + H' OFF\n* RESET THESE BY HAND. TradingView keeps the saved value of modNYORBP on an existing chart and that value now means something different.\n\nWHY SPLIT IT. The 2026-09-18 test could only compare 'H windowed' against 'H unwindowed' and had to infer the late trades by subtraction: OFF 218 trades +4148 USD, ON 141 trades +2342 USD, so the ~77 trades the window removed were worth ~23.45 each against 16.61 for the ones it kept. That inference said LATE BREAKS ARE THE BETTER TRADES but could never be measured directly, because blocking H frees the position slot and reshuffles the whole book. Running H' ALONE finally prices the late breaks on their own.")
modNYORBP     = input.bool(true,  "H') NY ORB LATE — break lands after 16:00 UTC",        group=G_CORE,
              tooltip="The second half of the NY ORB split - see the H tooltip for the full mapping. ON = a 14:00-14:30 range whose first close outside it lands AFTER 16:00 UTC is traded, with the entry comment 'ny-orb-L' so the Strategy Tester list separates it from the early ones ('ny-orb-E').\n\nSET H OFF AND H' ON to price the late breaks on their own. That is the run the old windowed test could not do.\n\nORDER LIFE. The old H' also cancelled the NYORB limit at 16:00. That cancel is GONE: a LATE break arms after 16:00, so a 16:00 cancel would kill it on arrival. Use 'H) NY limit life' in the Order life group instead - nyOrderMins = 90 reproduces the old 14:30+90min = 16:00 expiry exactly, and it bounds only the resting LIMIT, never the signal.")
nySplitMin    = input.int(960, "H) EARLY window ENDS (mins UTC)", group=G_CORE, minval=870, maxval=1260, step=15,
              tooltip="H's UPPER edge: a break is H's only if it closes BEFORE this minute.\n\n★ HIS TESTER, 2026-11-07: best 1035 (17:15 UTC) for H run ALONE, against 960 (16:00) for H-prime run alone. Those two cannot both be set with one line, because H's upper edge used to BE H-prime's lower edge. Hence the separate input below.\n\nREAD TOGETHER his two numbers are not two lines, they are a BAND. H wants 14:30-17:15, H-prime wants 16:00 onward, so BOTH optima contain 16:00-17:15 and what they disagree about is the tails: H throws away everything past 17:15, H-prime everything before 16:00. Same two-sided shape as the U prior-day band, where both ends lost.\n\nMEASURED 2026-11-07, 4.4yr broker 15m, live geometry, late-only, NY ADR guard OFF -- the whole stretch 15:00-16:00 is flat to four decimals on the book (+0.0230 / +0.0231 / +0.0223 / +0.0222 / +0.0224). 14:30 is clearly worse (+0.0155), so SOME line exists; where it sits inside the plateau is not resolvable on 4.4 years.\n\nWARNING: with BOTH H and H-prime on and overlapping windows, their union is 14:30 to the roll -- every NY break -- so the pair behaves like no line at all and only the TAG changes. The edges only bite when one of the two signals is OFF.\n\nWARNING: H and H-prime are not two signals. 171 NY trades on 171 DISTINCT DAYS over 4.4 years and zero days carrying two: one opening range, one done-flag, one position slot, 99.2% direction agreement. These edges choose WHEN the same break is taken.")
nyLateStart   = input.int(960, "H') LATE window BEGINS (mins UTC)", group=G_CORE, minval=870, maxval=1260, step=15,
              tooltip="H-prime's LOWER edge: a break is H-prime's only if it closes AT or AFTER this minute. Default 960 (16:00 UTC) = the historical behaviour, where it was the same number as the H edge above.\n\n★ WHY THIS EXISTS. His Tester found 1035 best for H and 960 best for H-prime. With one line that is unsettable. Set this to 960 and the H edge to 1035 to run both at their own optimum -- the two windows then OVERLAP on 16:00-17:15, which is allowed.\n\nELIGIBILITY, because overlapping windows needed a rule. Each signal tests its OWN window and the break is taken if EITHER claims it. H keeps priority for the ny-orb-E / ny-orb-L tag only. The old ternary routed a break to whichever side of one line it fell on, which with overlapping edges would have SILENTLY REFUSED a break that sat in H-prime window while H was switched off.\n\nINERT at 960 while the H edge is also 960: the two expressions are then identical and every recorded run reproduces.")
nyOneSignal   = input.bool(false, "H) ONE NY signal - merge H and H'", group=G_CORE,
              tooltip="ON = H and H-prime collapse into ONE NY signal taking the window [H' LATE window BEGINS .. NY window ENDS). The modNYORB and modNYORBP toggles are then IGNORED and every NY trade is tagged ny-orb. OFF = the historical H / H-prime pair, unchanged.\n\n★ WHY THIS IS THE RIGHT SHAPE, measured 2026-11-07/08 on 4.4yr of broker 15m:\n  · 171 NY trades on 171 DISTINCT DAYS and ZERO days carrying two. One opening range, one done-flag, one position slot.\n  · H and H-prime agree on DIRECTION 99.2% of the time -- one disagreement in 4.4 years.\n  · running BOTH came back IDENTICAL to running no line at all (775 book / 171 NY / +0.0235 R per trade either way). The pair only ever changed the TAG, never the trade list.\n\nSo they were never two signals. They were one signal and a timing choice, and the pair has already cost a recorded result once when a semantic change left H' switched off.\n\n★ THE MEASURED CELL, live geometry, NY ADR guard OFF:\n  lower edge 14:30 (no cut)  171 NY   book R/tr +0.0235  R +18.2  R/DD 2.17\n  lower edge 15:00           161      +0.0325            +24.9  3.89   <- best\n  lower edge 15:30           146      +0.0320            +24.3  3.80\n  lower edge 16:00           123      +0.0283            +21.2  2.81\n  lower edge 17:00            93      +0.0242            +18.2  2.11\nagainst live today (16:00 with the ADR guard ON): 736 book, R +16.5, maxDD 7.3, R/DD 2.27.\n\nWARNING, and it is the reason 15:00 is not a new default: ERA SIGNS prefer 16:00. 15:00 and 15:30 are negative in the first two quarters of the sample (--++) while 16:00 and 16:30 are positive in three (-+++). The P&L peak is more back-loaded than the 16:00 cell. The difference is about 3.7R over 4.4 years.\n\nWARNING: the UPPER edge is worth nothing and bounding it COSTS money. 15:30-18:00 gives +0.0305 against 15:30-to-roll +0.0320; only 9 NY trades in 4.4 years live past 18:00 and they are worth about zero. Leave nyWinEnd at 1440 unless you are testing it.\n\nWARNING: pair this with the H ADR guard OFF. That guard HALVES the NY sample (123 trades to 55) and its own null says it is thinning rather than selecting -- 65% of random picks of the same size beat the trades it keeps. It is the single biggest change to NY's numbers in this file.")
nyWinStart    = input.int(870, "H) NY window BEGINS (mins UTC, merged only)", group=G_CORE, minval=870, maxval=1260, step=15,
              tooltip="Lower edge of the MERGED NY window, minute-of-day UTC. Only used when 'ONE NY signal' is ticked.\n\n870 = 14:30 UTC = the moment the 14:00-14:30 opening range locks, so the default is the FULL NY SESSION, start to end: every break of the range is one signal tagged ny-orb. That is the 'as before' behaviour, with no early/late split anywhere.\n\nMEASURED 2026-11-07/08, 4.4yr broker 15m, live geometry (absolute 40, brkStr 0.26), NY ADR guard OFF, one signal:\n  start 14:30 (full session)  171 NY trades  book R/tr +0.0235  R +18.2\n  start 15:00                 161            +0.0325            +24.9\n  start 15:30                 146            +0.0320            +24.3\n  start 16:00                 123            +0.0283            +21.2\n  start 17:00                  93            +0.0242            +18.2\n\nSo on THAT geometry the full session is the weakest start and 15:00 is the best, worth about +6.7R over 4.4 years. But the full session is the most TRADES by a wide margin, and at a different stop and target the ranking can move -- the whole filter stack reverses between a 19-point stop and a 40-point one. Sweep it at YOUR geometry.\n\nWARNING: the era signs disagree with the P&L. 15:00 and 15:30 are negative in the first two quarters of the sample (--++) while 16:00 and 16:30 are positive in three (-+++). A later start is more evenly distributed; an earlier one earns more and earns it later.")
nyWinEnd      = input.int(1440, "H) NY window ENDS (mins UTC, 1440 = none)", group=G_CORE, minval=960, maxval=1440, step=15,
              tooltip="Upper edge of the merged NY window, minute-of-day UTC. 1440 = no bound, which is the historical behaviour and the measured best.\n\nMEASURED and it does NOTHING. Lower edge 15:30 paired with an upper edge of 18:00 gives book R/trade +0.0305 against +0.0320 for no upper edge at all; at a 16:00 lower edge it is +0.0280 against +0.0283. Only 9 NY trades in 4.4 years close past 18:00 and they are worth about zero, so there is nothing up there to cut.\n\nIt exists because the window has two edges and the second one should be visible rather than hidden at infinity. If you sweep it, expect flat-to-slightly-negative.")
modFRB        = input.bool(true,  "M) Frankfurt ORB — 07:00-07:30 UTC (pre-London)", group=G_CORE)
modSYD        = input.bool(true,  "U) Sydney ORB — session open, same C2 architecture as M/H  [UNTESTED]", group=G_CORE)
orbMaxTries = input.int(1, "RE-ENTRY) Entry attempts per session, per signal", group=G_CORE, minval=1, maxval=4,
              tooltip="How many ENTRY ATTEMPTS each signal may make inside its own session. 1 = the historical behaviour: the first break of the session is the only trade, and a stop-out ends the day for that signal. 2+ lets a signal take a LATER break of the SAME opening range after the earlier attempt is finished. WHY: the ORB V2 study measured that 91.7% of FIRST breaks fail back inside the range within about 45 minutes, so the second break is a different population that has never been traded. The entry still requires a flat book (strategy.position_size == 0), so attempts are strictly sequential, never stacked. The per-session limit cancels still fire at the session edge, so no attempt can outlive its own range.")
maxSlots = input.int(1, "SLOTS) Positions open at once", group=G_CORE, minval=1, maxval=3,
              tooltip="How many trades may be open at the same time. 1 = the historical behaviour, exactly.\n\n★ WHY: his 2026 funnel measured M losing 29.8% of its signals and G losing 30.0% to a busy slot, while H lost 0% and U 4.4%. M runs 07:30-11:00 and G 08:30-11:00, so the two sit on top of each other. That is ~29 trades a year on the two signals he rates highest.\n\n⚠⚠ SAME DIRECTION ONLY, AND THIS IS A PINE LIMIT, NOT A CHOICE. A Pine strategy holds one NET position: an opposite-direction entry REVERSES it rather than opening a second trade. So a second slot is granted only when the new trade agrees with the one already open. M and G agree on direction 85.2% of the time, so this measures about 85% of the opportunity and is a LOWER BOUND. The live account can hedge; the backtest cannot.\n\n⚠ CLAMPED TO 1 under 'Ratchet (no TP)' and 'Live final-tp (BE cascade)'. Both run ONE shared trailing-stop state machine that assumes a single open position, so a second slot would corrupt it without any error. Use a fixed TP rung to test slots.")

G_ASIA = "U/V — Asian session ORBs"
sydOpenHr   = input.int(22, "U) Sydney open (UTC hour)", group=G_ASIA, minval=18, maxval=23,
              tooltip="Sydney is UTC+10 (AEST) / UTC+11 (AEDT), so 07:00 local lands on 21:00 or 22:00 UTC depending on DST.\n\nMEASURED 2026-11-06 AND THIS IS BACKWARDS: 22:00 UTC *IS* the rollover hour in WINTER (the halt is 17:00-18:00 ET = 21:00-22:00 UTC in summer, 22:00-23:00 UTC in winter), so U's range sits inside the halt every winter and U has ZERO winter trades. Tick 'Anchor Sydney to 18:00 ET' to fix it — if the range were built BEFORE the rollover, the daily reset would wipe it mid-trade-window.\n\nSweep 21 vs 22 and compare.")
sydOrbMins  = input.int(30, "U) Sydney ORB length (mins)", group=G_ASIA, minval=15, maxval=120, step=15)
sydTradeMins= input.int(90, "U) Sydney trade window after ORB (mins)", group=G_ASIA, minval=30, maxval=300, step=30)
c2MinRangeASIA = input.float(5.0, "U/V) Min ORB range to trade (pts)", group=G_ASIA, step=1.0,
              tooltip="Asian sessions are thin — ranges are typically much smaller than Frankfurt or NY. If this filter blocks nearly every signal, that is the finding: the setup does not exist on gold in Asian hours.")

// ─── U CONTEXT FILTERS  (added 2026-10-10) ───────────────────────────
// WHY U AND NOT THE OTHERS: an audit of the whole file found U is the only
// ORB signal with no context test at all. Its gate is break strength, the
// liquidity check and HTF bias - nothing that asks whether the break cleared
// anything. M has orbBreakAsianHi/Lo (ON, live), G has lonBreakAsianHi/Lo,
// H has orbNYLonHiFilter/LoFilter plus asianBiasFilter, W has three. U has
// none, and the two signals that DO carry this family are the two it is
// measured to help - lonBreakAsian took G from PF 4.176 to 7.096.
//
// This is NOT a port of the Shanghai work. W was retired on 2026-10-10 when
// the blend test showed it cut the book's return-per-drawdown by 64%. What
// survived W is the previous-DAY test, which nothing else in the file had.
//
// All default OFF. Test each ALONE and inside the blend - the live book runs
// 99.59% on 242 trades with ONE loss, so a filter cannot be validated against
// the loss count; judge it on P&L per unit of drawdown instead.
sydBreakNyHi = input.bool(false, "U LONG)  Require close above the NY session HIGH", group=G_ASIA,
               tooltip="U opens at 22:00, one hour after NY closes at 21:00, so NY is the session immediately behind it and its high is the nearest pool of resting sell orders. Exactly the demand M makes of the Asian extreme and H makes of the London extreme. Uses ny_hi_presyd, the 14:00-to-Sydney-open pool, which self-adjusts if you change the Sydney open hour.")
sydBreakNyLo = input.bool(false, "U SHORT) Require close below the NY session LOW", group=G_ASIA,
               tooltip="Symmetric to the LONG filter above.")
sydNyCascade = input.bool(false, "U) NY cascade - trade only in the NY close direction", group=G_ASIA,
               tooltip="Blocks a U trade opposing the direction NY closed, measured close versus open over 14:00-21:00 UTC. The T-1 theorem measured this cascade as significant on every session tested (Asian to NY was z=+3.68); asianBiasFilter is the same idea pointed the other way. CAVEAT: the NY bias is latched at 21:00, so this is only 'today's NY' while the Sydney open hour is 21 or later. At the 18-20 settings the ORB runs INSIDE the NY session and the latch still holds YESTERDAY's - the filter silently changes meaning.")
sydBreakPdHi = input.bool(false, "U LONG)  Require close above the PREVIOUS DAY high", group=G_ASIA,
               tooltip="The one mechanism that came out of the Shanghai research and outlived it. Osler's NY Fed order-book work found protective stops cluster just past prior-period extremes and round numbers, and that clearing a real stop cluster ACCELERATES price while merely leaving a range into the take-profit cluster reverts. An INFERENCE, not a cited result - no order-level study of this exists for gold. Note the broker day rolls at 21:00/22:00, so at 22:30 the 'previous day' is the session that closed less than two hours ago, and which one depends on DST by an hour.")
sydBreakPdLo = input.bool(false, "U SHORT) Require close below the PREVIOUS DAY low", group=G_ASIA,
               tooltip="Symmetric to the LONG filter above. Test it apart from the NY-extreme filter: the two overlap (the day high is often set in London or NY) but they are different claims and a null on one says nothing about the other.")


// ─── LIQUIDITY TARGETS — aim at a LEVEL, not at a multiple of the range ──
// Every target in this file is range x orbTPMult x n. That number describes the
// OPENING RANGE. It says nothing about where price is actually trying to go.
// Price travels to LIQUIDITY - prior-day and prior-session extremes - because
// that is where resting stops and limit orders sit.
//
// So the first rung becomes ADAPTIVE: find the nearest untouched pool ahead of
// the entry and aim just short of it. tp2/tp3 keep the ladder shape at 2x/3x
// that distance. If no pool qualifies, the normal range multiple is used, so
// the signal never loses a target.
//
// ★ MEASURED 1yr (2025-10-10 -> 2026-10-09), book M+G+H+U, one slot, 1m path,
// SL 50, c2RetestDepth 0.25 (the LIVE depth):
//     range x 0.75 (today)      169 tr  WR 90.5  PF 1.479  netR  +7.68  DD 2.80  netR/DD 2.75  avgWin  7.8
//     nearest PD + session      154 tr  WR 77.9  PF 1.627  netR +16.55  DD 3.60  netR/DD 4.60  avgWin 17.9
//     ...only if >= 30pt away   158 tr  WR 83.5  PF 1.823  netR +17.52  DD 2.17  netR/DD 8.05  avgWin 14.7
//
// The minimum-distance rule is what makes it work: a big void ahead means let
// it run, a pool close by means take the quick target. 2.3x the netR, 2.9x the
// risk-adjusted return, nearly DOUBLE the average win, on LOWER drawdown.
//
// ⚠ ONE YEAR, IN-SAMPLE, and measured in the offline harness, not the Tester.
// Also note the win rate FALLS (90.5 -> 83.5) - this trades some of the win
// rate for much bigger wins, which is the whole point, but it changes how the
// equity curve feels. Default OFF.
// ─── CONTEXT FILTERS — intermarket + higher timeframe ────────────────
// Added 2026-10-17 from the deep run. These are the only two entry filters in
// this file that were validated on a FIXED LIST (every candidate taken, nothing
// displaced), which is the one test that cannot be faked by the position slot
// reshuffling the population. Seven earlier filters died because they were only
// ever read in the blend.
//
// ★ WHY SILVER AND NOT THE DOLLAR. Gold/DXY correlates -0.466 over 24h on this
// window - real, textbook, and NOT TRADEABLE: on the fixed list DXY-opposing
// scores +0.1092 against the +0.0951 of what it rejects. Gold/silver correlates
// +0.844 and silver-leading scores +0.2094 against -0.0128. It is the only
// filter in the project whose rejected half goes NEGATIVE, on a near-even split
// (417 of 804), which is real selection rather than skimming a pile that was
// already positive.
//
// ⚠ SILVER NEEDS A BIG TARGET. At the live range x 0.75 geometry it makes things
// WORSE (+0.0186 vs the +0.0288 baseline). It predicts DIRECTION, not magnitude
// - the MFE distribution of silver-leading candidates is the same as everything
// else (median 46.6 vs 41.9 pts). It is useless if you are aiming 10 points.
//
// ⚠ DO NOT STACK A THIRD. silver+align is 11.98 netR/DD; adding DXY takes it to
// 6.37, adding the room filter to 2.90. Two is the ceiling, measured.


G_STRAT = "Strategy"
exitMode  = input.string("TP1 · 1R", "Exit target",
            options=["TP1 · 1R", "TP2 · 2R", "TP3 · 3R", "Split TP1+TP2", "Trail after TP1", "Scale 30/75/150", "Ratchet (no TP)", "Live final-tp (BE cascade)", "One-shot (arm + lock)"],
            tooltip="TP1/TP2/TP3: fixed single-target exits. Split: 50% at TP1 + 50% at TP2. Trail: trail stop after TP1. Scale 30/75/150 (H/M only): 25% at 0.30×range, 50% at 0.75×range, 25% runner at 1.50×range — BE stop on remaining after TP1 hit. Python v4: WR 82.8%, PF 2.030.\n\nLIVE FINAL-TP (BE CASCADE) - added 2026-09-29. The mode the ACCOUNT is actually running (dashboard exitMode=final-tp), which had never been backtested. It is NOT the same as 'TP3 - 3R': the full position rides to TP3, but the stop CASCADES underneath it exactly as manage-trades.js does - TP1 touched moves the stop to breakeven, TP2 touched moves it to TP1. So most trades that reach TP1 and then fail are scratches, not full losses, which is precisely what the fixed-stop TP3 run cannot show.\n\nCompare against 'TP1 - 1R' (the 390-trade / 9-loss / PF 4.176 baseline) and against 'Ratchet (no TP)'.",
            group=G_STRAT)
showBoxes      = input.bool(true, "Show position boxes", group=G_STRAT)
trailArm  = input.float(0.75, "Ratchet: arm trail after (x ORB range)", group=G_STRAT, minval=0.05, maxval=10.0, step=0.05,
            tooltip="How far price must travel past the ORB level before the trail takes over from the original stop. 0.75 = the old TP1 distance.")
trailKeep = input.float(0.75, "Ratchet: fraction of reach locked", group=G_STRAT, minval=0.10, maxval=0.95, step=0.05,
            tooltip="Stop sits at this fraction of the furthest excursion, so it locks PROFIT rather than returning to entry. reach 0.75 -> locks 0.56 · reach 1.00 -> locks 0.75 · reach 2.00 -> locks 1.50 · reach 10.0 -> locks 7.50. Giveback is (1 - this). Capped at 0.95 because a stop sitting exactly on the extreme is taken out by the first tick of noise.")
osArm = input.float(3.0, "One-shot: ARM at (x session sigma)", group=G_STRAT, minval=0.5, maxval=12.0, step=0.25,
        tooltip="How far the best CLOSE must travel past the entry, in session-sigma units, before the stop moves ONCE. sigma = the mean of THIS signal's own last osigLook opening ranges, so it is hour-matched: a rolling ATR read at 07:00 UTC is fed by 04:00-06:00, the deadest hours of the day.\n\nOnly read when 'Exit target' is 'One-shot (arm + lock)'.\n\n3.0 is DELIBERATELY NOT AN OPTIMUM. It is the same distance as the 'x session sigma' target at k=3, chosen so the two engines are comparable. The walk-forward below holds it FIXED on purpose.\n\n* DO NOT SWEEP THIS. Letting a walk-forward choose arm and give per fold scored +0.0074 R/trade out of sample - BELOW the +0.0081 placebo floor - and picked a different pair every fold. Holding them fixed scored +0.026 to +0.032. The tuning is what breaks it.")
osGive = input.float(2.0, "One-shot: GIVE BACK (x session sigma)", group=G_STRAT, minval=0.0, maxval=11.0, step=0.25,
        tooltip="How far below the arm point the stop is parked, in session-sigma units. The stop lands at entry + (ARM - GIVE) x sigma, so with arm 3.0 and give 2.0 it sits a full sigma IN PROFIT and the trade can no longer lose.\n\nSet GIVE equal to ARM to lock breakeven instead. Setting GIVE above ARM is allowed and parks the stop below entry - a partial-loss cap rather than a profit lock.\n\nNOT THE BE CASCADE, which is already measured destructive here: that armed at TP1 (0.75 x ORB range, ~18 pts) and moved to BREAKEVEN. This arms at ~29 pts and moves to a sigma in profit. Different arm, different destination - the null on the first says nothing about the second.")
osS1Arm = input.float(1.0, "One-shot STAGE 1: cut the loss at (x session sigma, 0 = off)", group=G_STRAT, minval=0.0, maxval=6.0, step=0.25,
        tooltip="THE DOWNWARD TRIGGER. The one-shot above only reacts to SUCCESS, so a trade that moves a little and then dies keeps its FULL stop. This fires at a SHORT distance and pulls the stop from a full loss to a partial one. Stage 2 (the profit lock) is unchanged and fires later.\n\n  +1 sigma (~10 pts) -> stop from -50 to -12.5\n  +3 sigma (~30 pts) -> stop to +1 sigma, trade cannot lose\n\nMEASURED 2026-11-11, 4.4yr, M+G+H-prime, SL 50, cap 480, against the plain one-shot:\n                      totR   avgLoss  avgWin  full%   R/DD   worst\n  plain one-shot      +65.0   -31.8p  +30.0p  51.4%  14.83  -1.00R\n  s1 1.0 keep 0.50    +67.5   -27.3p  +30.4p  26.5%  14.16  -1.63R\n  s1 1.0 keep 0.25    +66.4   -20.0p  +29.5p  20.2%  17.84  -1.25R\nThe average loss falls 37% IN POINTS, full stops go 51% -> 20%, the average WIN is UNCHANGED, and total R and R/DD both improve. Not a trade-off, because stage 1 only fires on a trade that has already proved something - so it is not clipping winners to buy the saving.\n\n** THE FLOOR IS 1 SIGMA. At 0.5 sigma the loss falls further (-14.2p) and it COSTS 24R of the 65: totR +41.1, R/DD 4.72. Below 1 sigma it eats winners, which is the ratchet's own failure mode. Do not lower it.\n\n0 = off = the plain one-shot.")
osS1Keep = input.float(0.25, "One-shot STAGE 1: fraction of the risk KEPT", group=G_STRAT, minval=0.0, maxval=1.0, step=0.05,
        tooltip="Where stage 1 parks the stop, as a fraction of the ORIGINAL risk. 0.25 with a 50-pt stop puts it at -12.5. 0.50 puts it at -25. 0.0 is breakeven.\n\nMEASURED: 0.25 gives the best R/DD (17.84) and the smallest average loss (-20.0p); 0.50 gives slightly more total R (+67.5 vs +66.4) with a bigger average loss (-27.3p). Both are 4/4 eras. 0.25 is the default because the daily-loss rule is what binds this account, not the return.\n\n⚠ 0.0 (breakeven) is NOT the same as the live BE cascade and is still worse than 0.25 here - it takes R/DD to 7.36 and only 2 of 4 eras positive. A stop exactly at entry gets taken out by noise on trades that would have recovered.")
osPartPct = input.float(0.33, "One-shot PARTIAL: bank this fraction at the TP1 below (0 = off)", group=G_STRAT, minval=0.0, maxval=0.9, step=0.01,
        tooltip="THE MEDIAN between the three exits this file has measured. Banks this fraction of the position at the ORIGINAL Pine TP1 (0.75 x ORB range) and leaves the remainder to stage 1 + the frozen lock + the hold cap.\n\nIt keeps one thing from each base: the Pine 0.75 x range target, the ratchet's rule that a winner must not become a full loss, and the one-shot's tail.\n\nMEASURED 2026-11-11, 4.4yr, M+G+H-prime, SL 50, cap 480:\n  bank  totR   R/DD  avgLoss  biggest  worstDay  fullStop%\n    0  +66.4  17.84   -20.0p   +577p    -1.25R     20.2%\n   25  +52.4  18.89   -15.4p   +435p    -1.16R      7.6%\n   33  +47.9  19.40   -14.1p   +390p    -1.13R      7.7%\n   50  +38.4  18.27   -11.4p   +293p    -1.07R      8.1%\n(Pine TP1 alone +20.9 / 4.27. The ratchet +11.2 / 1.59.)\n\nBanking more ALWAYS returns less - monotone on the backtest AND on his 27 real MT5 fills. What it buys is the drawdown: R/DD peaks at 33% and FULL STOPS FALL FROM 20.2% OF LOSSES TO 7.7%. 0.33 takes that trade; 0 gives the pure one-shot.\n\n* THE WIN RATE DOES NOT COME BACK: 57.1% at bank 0, 58.1% at bank 33. Banking a third does not make a trade a winner if the runner loses. Only 75% reaches 68.5% and it costs two thirds of the return. The 88-99% WR era is not compatible with the tail.\n\n** VERIFY IN THE TESTER. Two live exit orders now sit on one position (-XP on the limit, -X on the stop). A banking trade should show TWO closes in the trade list. If it shows one, qty_percent is not behaving as assumed.")
osPartMult = input.float(0.75, "One-shot PARTIAL: TP1 = k x ORB range", group=G_STRAT, minval=0.1, maxval=4.0, step=0.05,
        tooltip="Where the banked leg takes profit, in ORB-range units from the broken level - i.e. the ORIGINAL Pine TP1 geometry, which is why 0.75 is the default.\n\nMEASURED at a 50% bank: 0.50 -> R/DD 23.30 (the best cell in the whole sweep) but totR +38.4; 0.75 -> 18.27; 1.00 -> 18.19; 1.50 -> 13.99. Nearer is better for drawdown, further is better for the win rate (58.1% at 0.50 against 66.5% at 1.50) and barely moves total R.\n\nKept separate from orbTPMult so the partial does not move when the 'x ORB range' target mode is swept.")
beRung = input.string("TP1 (live)", "Final-TP: arm the breakeven stop at", options=["TP1 (live)", "TP2", "Off"], group=G_STRAT,
         tooltip="Only used by exit mode 'Live final-tp (BE cascade)'. It decides how far a trade must travel BEFORE the stop starts cascading.\n\nTP1 (live) - what the account runs: tagging TP1 moves the stop to breakeven, tagging TP2 moves it to TP1.\n\nTP2 - the cascade only engages once TP2 is tagged, so a trade that merely TOUCHES TP1 and pulls back keeps its original stop and is not scratched out of a move that was going to continue.\n\nOff - the stop never moves; the position rides to TP3 on its original stop. That is identical to 'TP3 - 3R'.\n\nThe exit-comparison table measures TP1 and TP2 side by side regardless of this setting - it is here so the WINNER can be run through the Strategy Tester for a drawdown figure, which the table cannot produce.")
_beArm = beRung == "TP2" ? 2 : beRung == "Off" ? 99 : 1
orbSLMode      = input.string("Wide SL", "H/M) SL mode",
                 options=["Wide SL", "Tight SL + entry TPs", "Tight SL + OR-edge TPs"],
                 tooltip="Wide SL: SL at opposite OR extreme, TPs at OR multiples (baseline). Tight SL + entry TPs: SL at breakout level, TPs scale from entry (1:1 system). Tight SL + OR-edge TPs: tiny SL, original large TPs (asymmetric R:R).",
                 group=G_STRAT)
orbBiasFilter  = input.bool(true,  "M/H/U) HTF bias MASTER — skip trades against trend", group=G_STRAT,
                 tooltip="The MASTER switch. Off = the bias filter is off for M, H and U together, which is what this toggle always did. On = each signal then obeys its OWN switch below.\n\n⚠ THE LABEL USED TO SAY H/M AND THAT WAS WRONG - it has been wired into U since U was built, so M, H and U could never be tested apart. Split 2026-10-22.")
orbBiasTF      = input.string("H1+H4", "H/M) Bias timeframe",
                 options=["H1", "H4", "Daily", "H1+H4", "H1+H4+D", "M15", "M15+H1", "M15+H1+H4"],
                 tooltip="H1+H4 = the 218-trade baseline. H4 alone = older baseline (PF 1.409). H1+H4+D = all three align (strictest).\n\nM15 options added 2026-09-18. The premise: the ORB is a 15m structure, so gating it on H4 may be asking a 4-hour trend to approve a 15-minute decision. M15+H1 keeps the confirmation on timeframes that actually move inside the trade window.\n\nThe 15m bias reads close[1] vs EMA[1], deliberately NOT the signal bar — a bar that closes past the ORB level has almost certainly closed past its own 15m EMA, so scoring the current bar would grade the breakout against itself and produce a filter that looks predictive while measuring nothing.",
                 group=G_STRAT)
// ─── PER-SIGNAL HTF BIAS (split 2026-10-22) ──────────────────────────
// orbBiasFilter above says "H/M" but was wired into U as well, so M, H and U
// could never be tested apart. Split the same way the ADR guard already was,
// and for the same reason. orbBiasFilter stays the MASTER: with it off all
// three are off, exactly as before. Every default below reproduces the
// current baseline, so toggling nothing changes nothing.
// ⚠ The LIVE indicator has no switch at all here - it HARDCODES
// h1B/h4B alignment on M (:904/:927), H (:1027/:1049) and U (:1090/:1109).
// Anything proven here needs porting there PRESENT AND OFF, never absent.
frbBiasFilter  = input.bool(false, "M) HTF bias filter", group=G_STRAT,
                 tooltip="Frankfurt ORB. Reads M's own bias timeframe below, not the shared one.\n\n★ MEASURED OFF 2026-10-22. His Tester runs: the HTF bias alignment carries H and only H. M and U are better without it. This is the same shape as the ADR guard, which is GOOD for H and BAD for M off identical logic — a shared switch had to be wrong for somebody, and it was.")
frbBiasTF      = input.string("H1+H4", "M) Bias timeframe", group=G_STRAT,
                 options=["H1", "H4", "Daily", "H1+H4", "H1+H4+D", "M15", "M15+H1", "M15+H1+H4"],
                 tooltip="M's own bias timeframe, independent of H. Default H1+H4 reproduces the current behaviour exactly.\n\nWHY M GETS ITS OWN. The four signals read the day's HTF bias at very different stages of its formation: U at 22:30 reads a bias that is still yesterday's, M at 07:30 reads one a few hours old, H at 14:30 reads one that has had most of a session to form. Same filter, different information content, in that order. If U turns out to want a shorter timeframe, M is the next most likely to.")
nyBiasFilter   = input.bool(true, "H) HTF bias filter", group=G_STRAT,
                 tooltip="NY ORB. M and U now carry their own bias timeframe, so orbBiasTF above governs H, G and BBX only. H is the signal that needs its own least - at 14:30 it reads a bias that has had most of a session to form.")
sydBiasFilter  = input.bool(false, "U) HTF bias filter", group=G_STRAT,
                 tooltip="Sydney ORB. U is the FIRST signal of the trading day, so the H1/H4 bias it reads is still yesterday's - the day's own bias only begins forming during U. That makes this the one place where the H/M architecture may not transfer, in either direction. Test it against the U-only book, not the blend.\n\n★ MEASURED OFF 2026-10-22. His Tester runs: the HTF bias alignment carries H and only H. M and U are better without it. This is the same shape as the ADR guard, which is GOOD for H and BAD for M off identical logic — a shared switch had to be wrong for somebody, and it was.")
sydBiasTF      = input.string("H1+H4", "U) Bias timeframe", group=G_STRAT,
                 options=["H1", "H4", "Daily", "H1+H4", "H1+H4+D", "M15", "M15+H1", "M15+H1+H4"],
                 tooltip="U's own bias timeframe, independent of H and M. Default H1+H4 reproduces the current behaviour exactly. If U is reading a bias that has not formed yet, the shorter options (M15, M15+H1) are the ones that can see the session U is actually trading.")

nyorbDirFilter = input.string("Both", "H) Direction filter",  options=["Both", "Long only", "Short only"],
                 tooltip="London Bias study (54yr): the PM fix window (14:00 UTC) has a structural short tailwind. Test 'Short only' to isolate whether H shorts carry the PF.",
                 group=G_STRAT)
frbDirFilter   = input.string("Both", "M) Direction filter",  options=["Both", "Long only", "Short only"], group=G_STRAT)
orbTPMult      = input.float(0.75, "H/M) TP1 multiplier",    minval=0.25, maxval=8.0, step=0.25,
                 tooltip="1.0 = standard 1R (baseline PF 1.145). 0.75 = ¾R — raises WR at cost of smaller wins. Find the WR/PF sweet spot between 0.75 and 1.0.\n\n★ MAXVAL RAISED 2.0 -> 8.0 on 2026-10-17. Nothing about the default changed; the cap simply made the only geometry that can pass a one-month challenge impossible to enter.\n\nMEASURED 1yr, SL 50, depth 0.25, one slot, rolling 30-day windows against the real FTMO rules (+10% target, -5%/day, -10% total):\n  x0.75 at SL 76 (LIVE)   0% pass at EVERY risk, and 0% even with an UNLIMITED horizon - it makes ~+4.9%/yr at 2% risk, so it cannot reach +10% in 300 days\n  x0.75 at SL 50          2% pass at 4% risk\n  x3                     35% pass / 38% breach at 4%\n  x4                     37% / 24%\n  ★ x5                   51% / 21%  <- best one-slot cell found\n  x8                     51% / 24%\n\nWin rate FALLS 90.5% -> 53.6%. That is the mechanism, not a side effect: a 0.13R win cannot compound to 10% in ~14 trades, so every high-WR setting scores ZERO. The target has to be worth ~2R.\n\n⚠ THE EXIT MODEL BEHIND THESE FIGURES WAS WRONG - see the CLK group. The target fired on only 10.6% of trades; 58.7% exited on an arbitrary 24h clock that carried more than the whole net, and 24h was the PEAK of its own sweep. Treat the pass rates above as the shape of the finding (a big target is required) and NOT as the numbers. The fixed clock exit replaces them.",
                 group=G_STRAT)
orbTPMode      = input.string("x ORB range", "TP1 unit", options=["x ORB range", "x ATR", "Absolute points", "x session sigma", "No target"], group=G_STRAT,
                 tooltip="WHICH UNIT THE TARGET IS MEASURED IN. 'x ORB range' is the historical behaviour, exactly: rng x orbTPMult.\n\n★ WHY THIS EXISTS (engine f58c-f58f, broker 15m 4.4yr, four eras): sweeping the target against a FIXED 50-point stop produced NOT ONE rule of 28 positive in all four eras. The reason is mechanical - gold's daily ATR ran 25.5 -> 28.0 -> 45.6 -> 112.3 across the four eras, so a fixed stop is 2.0x ADR in era 1 and 0.45x in era 4. The R denominator does not mean the same thing twice, and a target sweep on a fixed stop reads the volatility regime instead of the target.\n\n★★ PUTTING THE STOP AND THE TARGET IN THE SAME UNIT fixed it: with c2SLMode 'x ATR' AND this set to 'x ATR', 8 of 48 cells came out positive in ALL FOUR eras. Best practical cell SL 8xATR / TP 12xATR: R/tr +0.0940, R/DD 2.64, WR 50.7%, avg stop 42.8 pts - against the live geometry's R/tr +0.0085 and R/DD 0.72 at 2/4 eras.\n\n⚠ SET c2SLMode TO 'x ATR' TOO. An ATR target on a fixed stop is the half-measure that failed; the result is in the PAIR, not in either half.\n\n⚠ THE WIN RATE FALLS TO ~51% AND THE LONGEST LOSING RUN GOES 3 -> 9. That is the trade, not a bug: the payoff inverts. Size for the drawdown, not the win rate.\n\n⚠ IN-SAMPLE over 48 cells and non-monotone in the stop (2x and 8x pass four eras, 4x and 6x fail era 3). Walk it forward before it goes anywhere near the account.")
orbTPAtrMult   = input.float(12.0, "TP1 = k x ATR  (when TP1 unit = x ATR)", group=G_STRAT, minval=0.5, maxval=40.0, step=0.5,
                 tooltip="Only read when 'TP1 unit' is 'x ATR'. Measured FROM THE ENTRY, so tp1 = entry + k x ATR(atrLength) - the same quantity the Python engine calls tpAtrMult.\n\nEngine, paired with SL 8 x ATR, all four eras positive:\n  k 6   R/tr +0.0401  R/DD 1.28  WR 56.4%\n  k 8   R/tr +0.0592  R/DD 1.86  WR 53.2%\n  ★ k 12  R/tr +0.0940  R/DD 2.64  WR 50.7%\n  k 16  R/tr +0.0785  R/DD 1.56  WR 49.3%\n  k 24  R/tr +0.0740  R/DD 1.49  WR 48.8%\nA PLATEAU, not a spike - which is the one thing that makes it worth testing.")
orbTPAbs       = input.float(40.0, "TP1 = fixed points  (when TP1 unit = Absolute)", group=G_STRAT, minval=1.0, maxval=400.0, step=1.0,
                 tooltip="Only read when 'TP1 unit' is 'Absolute points'. Measured FROM THE ENTRY.\n\n⚠ A FIXED POINT TARGET WAS THE WORST OF THE FOUR UNITS TESTED: the available move has a coefficient of variation of 1.39 in raw points against 0.89 in ATR15 units, and at MATCHED average distance a fixed target lost to both ATR scalings by 2-5x in R/trade. It is here for completeness and to be the control, not because it won anything.")
orbTPOsig      = input.float(3.0, "TP1 = k x session sigma  (when TP1 unit = x session sigma)", group=G_STRAT, minval=0.25, maxval=12.0, step=0.25,
                 tooltip="sigma = the mean of THIS signal's own last N opening ranges, so it is matched to the signal's hour. Measured FROM THE ENTRY.\n\nWHY HOUR-MATCHED: a rolling ATR read at 07:00 UTC is fed by 04:00-06:00 UTC, the deadest hours of the day, so it is systematically too tight for the expansion it is meant to size. Research 2026-11-11; the same unit is tpOsigMult in the Python engine.\n\nEngine f61, broker 15m 4.4yr, SL 50, against the live TP1's R/tr +0.0085 / R/DD 0.72:\n  k 1.0   R/tr +0.0234  R/DD 2.76  3/4 eras\n  k 2.5   R/tr +0.0533  R/DD 3.22  3/4\n  k 3.0   R/tr +0.0772  R/DD 4.46  3/4   <- this default, best R/DD\n  k 4.0   R/tr +0.0716  R/DD 2.57  2/4\n  k 5.0   R/tr +0.0812  R/DD 2.98  3/4\nR/tr rises monotonically with k while R/DD peaks at 3.0 - so k is a drawdown choice, not a return choice.\n\nBEST DAY 7.5% of total profit against the live TP1's 61.1%. The FTMO Consistency rule caps the best day at 50%, and being a RATIO it is scale-invariant, so position sizing cannot fix it - the exit has to.\n\n* IN-SAMPLE over ~14 cells. era2 is -0.00005, i.e. flat not positive. Judge on the era row and R/DD, never on WR.")
osigLook       = input.int(14, "session sigma lookback (sessions)", group=G_STRAT, minval=2, maxval=60,
                 tooltip="How many of this signal's own prior opening ranges the sigma averages. 14 matches the Python engine's osigLook and the 14-day realised-move window used by the one published system that scales a threshold by time of day.")
orbNFPFilter   = input.bool(false, "H/M) Skip first-Friday of month (NFP days)", group=G_STRAT)
orbADRGuard    = input.bool(true,  "U/V) Skip when >90% ADR already consumed",   group=G_STRAT,
                 tooltip="Now applies to U and V ONLY. M and H have their own switches below — see why.")
// SPLIT 2026-09-21. This was ONE toggle gating M, H, U and V through _orbGateOk.
// Measured: the ADR guard HURTS M and HELPS H. A shared switch therefore had to
// be wrong for one of them no matter how it was set, and it was set ON — which
// means every baseline run so far carried a filter that costs Frankfurt money.
// Both default TRUE so the existing baseline still reproduces; set frbADRGuard
// OFF to take the measured improvement.
frbADRGuard    = input.bool(true,  "M) Skip when >90% ADR already consumed",     group=G_STRAT,
                 tooltip="MEASURED BAD FOR M (2026-09-21). Frankfurt fires at 07:30-11:00, early in the session, when little of the day's range is normally spent — so a >90% ADR reading at that hour is not an exhausted market, it is an unusually violent overnight. Those are exactly the days Frankfurt continuation works. Turn OFF.")
nyADRGuard     = input.bool(true,  "H) Skip when >90% ADR already consumed",     group=G_STRAT,
                 tooltip="MEASURED GOOD FOR H (2026-09-21). NY fires at 14:30+, by which point 90% of the average range genuinely is spent, so the guard is reading real exhaustion rather than an early-session anomaly. Keep ON.")
orbSeasonFilt  = input.bool(false, "H/M) Seasonal bias (Sep=Short only · Jan=Long only)",
                 tooltip="September is 90% bearish over 10yr (gold seasonal). January is 80% bullish. Blocks counter-seasonal trades in these two months only.",
                 group=G_STRAT)
orbBreakAsianLo = input.bool(true,  "M) Require entry closes below Asian low (WR 84.6%)",
                 tooltip="Frankfurt ORB SHORT only fires when entry bar closes below the Asian session low (00:00-07:00 UTC range). Sweeps overnight stop-losses = maximum bearish conviction. Python analysis: WR 84.6%, PF 1.655 (N=26/5.5yr ~ 5 trades/year vs 40/yr unfiltered).",
                 group=G_STRAT)
orbBreakAsianHi = input.bool(true,  "M) Require entry closes above Asian high (LONG, symmetric filter)",
                 tooltip="Frankfurt ORB LONG only fires when entry bar closes above the Asian session high (00:00-07:00 UTC range). Symmetric to the SHORT Asian-lo filter — tests whether breaking above overnight liquidity gives the same edge on the long side.",
                 group=G_STRAT)
orbNYFRBCtxS   = input.bool(false, "H SHORT) Require Frankfurt SHORT today + H1 bear (WR 75%)",
                 tooltip="H SHORT only fires when Frankfurt ORB also broke SHORT today AND H1 is bearish at NY time. Python: WR 75.0%, PF 1.935 (N=64, ~12/yr). Continuation setup: Frankfurt+H1 both bear, NY confirms down.",
                 group=G_STRAT)
orbNYFRBCtxL   = input.bool(false, "H LONG) Require Frankfurt SHORT today + H1 bull (WR 73.6%)",
                 tooltip="H LONG only fires when Frankfurt ORB broke SHORT earlier today AND H1 has since flipped bullish. Python: WR 73.6%, PF 1.542 (N=91, ~17/yr). Reversal setup: Frankfurt exhausted sellers, NY sees fresh buyers.",
                 group=G_STRAT)
orbNYLonHiFilter = input.bool(false, "H LONG)  Require close above London session HIGH (theorem filter)",
                 tooltip="NY ORB LONG only fires when the breakout bar also closes above the London session high (08:00-14:00 UTC). Mirrors the FRB Asian-extreme gate — theorem predicts WR ≈ 97-98%.",
                 group=G_STRAT)
orbNYLonLoFilter = input.bool(false, "H SHORT) Require close below London session LOW (theorem filter)",
                 tooltip="NY ORB SHORT only fires when the breakout bar also closes below the London session low (08:00-14:00 UTC). Mirrors the FRB Asian-extreme gate — theorem predicts WR ≈ 97-98%.",
                 group=G_STRAT)
orbNYPdHiFilter  = input.bool(false, "H LONG)  Require close above the PREVIOUS DAY high",
                 tooltip="The level-quality test, one step up from the London filter above: not the session behind H but the whole day behind it. Osler's NY Fed order-book work found protective stops cluster just past prior-period extremes, and that clearing a real stop cluster accelerates price while leaving a range into the take-profit cluster reverts. EXPECT THIS TO BE WEAK FOR H SPECIFICALLY: by 14:00 London has already run six hours, so on a trending day the previous day's high is usually long gone and the filter passes trivially. That is the opposite of its position on U, where it fires 90 minutes after the day rolled. A null here is informative, not a bug.",
                 group=G_STRAT)
orbNYPdLoFilter  = input.bool(false, "H SHORT) Require close below the PREVIOUS DAY low",
                 tooltip="Symmetric to the LONG filter above.",
                 group=G_STRAT)

// ─── H FVG-MARGIN FILTER (sweep survivor, 2026-10-22) ────────────────
// ~1,100 level/mode/threshold combinations were scored on 4.4 years and this
// was the only one positive in ALL FOUR eras, across an ADR range of 20 to
// 103 points: +10.8 / +26.2 / +11.9 / +23.4 pp on the scale-free race, 185
// kept vs 162 blocked, out-of-sample +16.3pp and in-sample +16.3pp.
//
// It asks whether the break got CLOSE TO the gap structure standing beyond
// the opening range, rather than stalling a long way short of it. Note the
// sign: this is NOT a headroom gate. Headroom - 'is there an obstacle in
// front' - was measured dead against a matched placebo on the same data.
//
// ⚠ The threshold is a FRACTION OF ADR, deliberately. The absolute-points
// version of this idea was measured on 2025-26 only and turned out to be a
// volatility detector: gold's 14-day ADR ran 20 -> 103 pts over this window,
// so any fixed point threshold is partly a date filter.
// ⚠ Measured on H EARLY only (break lands 14:30-16:00), so the gate is inert
// for H' by construction - H' was never tested with it.
// ⚠ Measured on the RAW break list with only break-strength 0.26 applied. On
// the fully filtered book a filter can change sign, so this needs the A/B.
hFvgOn   = input.bool(false, "H) FVG margin — block breaks that stall short of the gap above/below",
                 tooltip="NY ORB only, and only the EARLY window (14:30-16:00). Finds the nearest FVG-derived level beyond the ORB extreme on the break side, then blocks the trade if the breakout bar closed further short of it than the budget below. Clear air passes. Sweep survivor: the only one of ~1,100 combinations positive in all four eras.",
                 group=G_STRAT)
hFvgADR  = input.float(0.35, "H) FVG margin budget (x 14-day ADR)", group=G_STRAT,
                 step=0.05, minval=0.05, maxval=1.50,
                 tooltip="How far short of the gap level the break is allowed to close, as a fraction of the 14-day ADR. 0.35 is the measured value. Worth sweeping 0.20-0.60 — the plateau was wide and ATR(14) here is not exactly the mean daily range the study used, so the optimum may sit a little either side.")
hFvgMinW = input.float(1.0,  "H) Minimum gap width to count (pts)", group=G_STRAT,
                 step=0.5, minval=0.0,
                 tooltip="Gaps narrower than this are ignored. The study used 1.0 pt. Raising it makes the level set sparser and the gate rarer.")
asianBiasFilter  = input.bool(false, "H/M) Asian cascade — only trade in Asian close direction (T-1: z=+3.68, all sessions significant)",
                 tooltip="T-1 Theorem: Asian session direction (close vs open, 00:00-07:00 UTC) cascades to Frankfurt (65.7%, z=3.03★), London (61.7%, z=3.63★) and NY (64.6%, z=3.68★). When ON, blocks ORB trades that oppose the Asian session close direction. Default OFF — turn ON to test the cascade filter independently.",
                 group=G_STRAT)
i_hm_useDow  = input.bool(false, "H/M) Day of Week filter",  group=G_STRAT)
i_hm_dow_mon = input.bool(false, "H/M   Mon",                group=G_STRAT)
i_hm_dow_tue = input.bool(true,  "H/M   Tue",                group=G_STRAT)
i_hm_dow_wed = input.bool(false, "H/M   Wed",                group=G_STRAT)
i_hm_dow_thu = input.bool(false, "H/M   Thu",                group=G_STRAT)
i_hm_dow_fri = input.bool(false, "H/M   Fri",                group=G_STRAT)

G_SMC = "SMC - session roles, structure, liquidity, FVG"
// --- HIS SIX REQUESTED FILTER FAMILIES -------------------------------
// Requested 2026-11-08. Families 2-5 are GLOBAL (one toggle, all signals)
// because the engine measurement found no per-signal structure in any of
// them. Family 1 is PER-SIGNAL because that is the one place it did.
// Engine results on his config (base n 606, R/tr +0.0472, R +28.6,
// maxDD 4.7, R/DD 6.03), all costed with the real broker spread:
//   bosMode agree  -0.0099 | oppose -0.0061 | with an age cap, far worse
//   retracement    every band negative, -0.0096 to -0.0545
//   liquidity any  +0.0195 R/tr BUT first half -0.0073, total R +27.2
//   FVG filled     +0.0041 (near-inert: 99.8% of M/G bars pass)
//   FVG inside     +0.0201 R/tr but total R +14.6 of +28.6 -- thinning
//   manipulation   present / opposite / same, all negative
//   accumulation   see the accMin/accMax pair below -- the one survivor
// NONE clears the placebo floor (+0.0066 p95) on a walk-forward, so every
// default here is OFF. These exist for HIS Tester, not as a verdict.
smcPivLb = input.int(5, "SMC) Pivot lookback for structure", minval=2, maxval=30, group=G_SMC,
           tooltip="Fractal pivot width for the break-of-structure test. A pivot at bar j needs bars j-lb to j+lb, so it is only CONFIRMED lb bars later, and a BOS therefore appears lb bars after the pivot it broke. That lag is deliberate - it is what a live chart shows. Engine default 5.")
smcBosMode = input.string("off", "SMC) Break of structure", options=["off", "agree", "oppose"], group=G_SMC,
           tooltip="agree = only trade in the direction of the most recent break of structure. oppose = only trade against it.\n\nMEASURED: agree -0.0099 R/trade, oppose -0.0061. Both are WORSE than taking every break. Adding an age cap made it much worse again (-0.0774 at 4 bars). Present so the result can be reproduced rather than trusted.")
smcBosAge = input.int(0, "SMC) ... BOS max age in bars (0 = no limit)", minval=0, maxval=500, group=G_SMC,
           tooltip="Require the break of structure to be RECENT. MEASURED STRONGLY NEGATIVE at every setting - 4 bars -0.0774, 8 -0.0602, 16 -0.0510, 32 -0.0284, 64 -0.0304. The slope points at NO CAP.")
smcRetrOn = input.bool(false, "SMC) Retracement - require position inside the current leg", group=G_SMC,
           tooltip="Position of price within the leg that began at the last break of structure. 0 = back at the leg origin (deep retracement), 1 = at the leg extreme.\n\nMEASURED: every band negative. 0.0-0.5 (deep) -0.0217, 0.0-0.7 -0.0131, 0.3-0.8 -0.0545, 0.5-1.0 -0.0105, 0.7-1.0 (breakout) -0.0096.")
smcRetrLo = input.float(0.0, "SMC) ... leg position LOW", minval=0.0, maxval=1.5, step=0.05, group=G_SMC)
smcRetrHi = input.float(1.0, "SMC) ... leg position HIGH", minval=0.0, maxval=1.5, step=0.05, group=G_SMC)
smcLiqMode = input.string("off", "SMC) Daily liquidity fill", options=["off", "any", "opposite", "same"], group=G_SMC,
           tooltip="Require the prior day high or low to have been taken out TODAY before entry. any = either side. opposite = the side AGAINST the trade was swept (sweep the low, then go long), the classic read. same = the side the trade is heading toward was already taken.\n\nMEASURED: any +0.0195 R/trade, which looks like the best cell in the set until it is split - FIRST HALF -0.0073 against a base of +0.0026, so it is a second-half-only filter. opposite -0.0144. same +0.0188 but maxDD 4.7 to 7.1. Per signal it is only +0.0009 to +0.0058; the +0.0195 appears only when stacked on all four.")
smcFvgMode = input.string("off", "SMC) FVG", options=["off", "filled today", "directional fill", "inside unfilled"], group=G_SMC,
           tooltip="Three-bar fair value gap. filled today = some FVG was fully filled earlier today. directional fill = one in the trade direction was. inside unfilled = price is currently INSIDE an unfilled FVG pointing the trade way.\n\nMEASURED: the first two are NEARLY INERT - 99.8% of M and G bars pass, because over a 15m day something is almost always filled, so they cannot select. Only inside-unfilled discriminates (23% long, 6% short), and it is the thinning trap: R/trade +0.0201 but total R falls +28.6 to +14.6.")
smcAmdMode = input.string("off", "SMC) Manipulation before distribution", options=["off", "present", "opposite", "same"], group=G_SMC,
           tooltip="Has the Asian range (00:00-07:00) been swept by now, and on which side. present = either side. opposite = the side against the trade was swept, which is the PO3 / AMD read - London sweeps the Asian low, New York distributes UP. same = the trade own side was swept.\n\nMEASURED: present -0.0095, opposite -0.0124, same -0.0017. The textbook read is the WORST of the three. It was the only cell with all four eras positive, at n 226 - but total R only +7.9 of +28.6.")
// --- FAMILY 1: ACCUMULATION QUALITY, BOTH DIRECTIONS -----------------
// accQ = Asian(00:00-07:00) range / 14-day ADR, carried across the broker
// day. Median 0.41.
// ** HIS PREMISE IS INVERTED. The AMD model wants a TIGHT accumulation.
// Measured, a MAXIMUM is negative and MONOTONE TOWARD NO CAP:
//   0.25 -0.1096 | 0.30 -0.0457 | 0.35 -0.0686 | 0.40 -0.0415
//   0.50 -0.0274 | 0.60 -0.0177 | 0.80 -0.0116 | none 0.0000
// while the MINIMUM form is positive over a three-cell plateau:
//   0.200 +0.0038 | 0.225 +0.0089 | 0.250 +0.0100 | 0.275 +0.0025
// At 0.25 all four eras turn positive, total R goes +28.6 to +32.5 and
// R/DD 6.03 to 6.50. Per signal: M +0.0081 (R +33.1, R/DD 6.99, ++++),
// H +0.0030, U -0.0005, G -0.0039.
// IT DOES NOT SURVIVE A WALK-FORWARD: +0.0015, above the floor mean but
// far below p95, and forward it LOSES total R (+23.7 vs +27.4) and
// worsens maxDD (6.8 vs 4.7). Same shape as the inverted ADR gate.
smcAccMinM = input.float(0.0, "M) Require Asian range / ADR >= (0 = off)", minval=0.0, maxval=3.0, step=0.025, group=G_SMC,
           tooltip="The strongest single cell in the whole SMC set: at 0.25 on M alone, R/trade +0.0554, total R +33.1 against +28.6, maxDD UNCHANGED at 4.7, R/DD 6.99 against 6.03, all four eras positive - and it removes only 8 trades of 606. That last fact is also the warning: 8 trades is not a sample.")
smcAccMinG = input.float(0.0, "G) Require Asian range / ADR >= (0 = off)", minval=0.0, maxval=3.0, step=0.025, group=G_SMC,
           tooltip="Measured -0.0039 at 0.25, the one signal where the minimum does not help. G opens at 08:30, by which time Frankfurt has already traded the 07:00-08:00 hour, so the Asian range is no longer the live context it is for M.")
smcAccMinH = input.float(0.0, "H) Require Asian range / ADR >= (0 = off)", minval=0.0, maxval=3.0, step=0.025, group=G_SMC,
           tooltip="Measured +0.0030 at 0.25 (total R +30.1, R/DD 6.02). Mildly positive, inside the noise floor.")
smcAccMinU = input.float(0.0, "U) Require Asian range / ADR >= (0 = off)", minval=0.0, maxval=3.0, step=0.025, group=G_SMC,
           tooltip="Measured -0.0005 at 0.25, i.e. nothing. U fires at 22:30, fifteen hours after the Asian range closed, so there is no mechanism for it to matter - and the measurement agrees.")
smcAccMax = input.float(0.0, "SMC) Require Asian range / ADR <= (0 = off, ALL signals)", minval=0.0, maxval=3.0, step=0.025, group=G_SMC,
           tooltip="HIS ORIGINAL DIRECTION - a tight Asian accumulation. MEASURED NEGATIVE AT EVERY SETTING and monotone toward no cap: 0.25 -0.1096, 0.30 -0.0457, 0.40 -0.0415, 0.60 -0.0177, 0.80 -0.0116. Left in so the inversion can be seen rather than taken on trust - set this and the minimum above to the same number and compare.")

// --- WHICH SIGNALS EACH FAMILY APPLIES TO ---------------------------
// HIS 3-DAY TESTER CAMPAIGN, 2026-11-09/10. Tuned one signal at a time
// he found these families pay PER SIGNAL and not at all globally:
//   BOS oppose          -> U ALONE   (U 110 trades, 98.18%, PF 2.69)
//   daily liq opposite  -> H ALONE   (H 115 trades, 91.30%)
//   nothing             -> M and G
// Applied to all four at once I measured BOS oppose at -0.0061 R/trade
// and liq opposite at -0.0144, which is not a contradiction: those were
// the coarse all-signal cells, these are the fine per-signal ones.
// Type the letters of the signals a family should gate: M G H U.
// "MGHU" (the default) = every signal = exactly the old behaviour.
// An empty box or a letter soup with none of MGHU switches it OFF.
smcBosSig  = input.string("MGHU", "SMC) ... BOS applies to", group=G_SMC,
           tooltip="Letters of the signals the break-of-structure setting gates. HIS RESULT: U. Default MGHU = all four = unchanged.")
smcRetrSig = input.string("MGHU", "SMC) ... retracement applies to", group=G_SMC)
smcLiqSig  = input.string("MGHU", "SMC) ... liquidity fill applies to", group=G_SMC,
           tooltip="HIS RESULT: H. Default MGHU = all four = unchanged.")
smcFvgSig  = input.string("MGHU", "SMC) ... FVG applies to", group=G_SMC)
smcAmdSig  = input.string("MGHU", "SMC) ... manipulation applies to", group=G_SMC)
_sgBos  = str.upper(smcBosSig)
_sgRetr = str.upper(smcRetrSig)
_sgLiq  = str.upper(smcLiqSig)
_sgFvg  = str.upper(smcFvgSig)
_sgAmd  = str.upper(smcAmdSig)
// --- HIS H REQUEST: close beyond the ASIAN extreme -------------------
hBreakAsianHi = input.bool(false, "H LONG) Require close above Asian high", group=G_SMC,
           tooltip="His request, 2026-11-08. The direct analogue of the M orbBreakAsianHi and the G lonBreakAsianHi, measured against the FULL Asian session (00:00-08:00) as G does, since both open after it closes.\n\nMEASURED: +0.0015 R/trade, total R +29.2 against +28.6, maxDD UNCHANGED at 4.7, R/DD 6.15 against 6.03. It keeps 56.4% of H break bars, so it is genuinely selective rather than inert, and it is the only cell in the entire set better on R/trade AND total R AND maxDD at once. It is also far too small to call a result.")
hBreakAsianLo = input.bool(false, "H SHORT) Require close below Asian low", group=G_SMC,
           tooltip="Symmetric to the LONG filter, and it does NOT behave symmetrically: -0.0063 R/trade, total R +24.4 against +28.6, maxDD 4.7 to 5.4. Both sides on together give -0.0051.\n\nThat asymmetry fits the rest of the record - gold drifted UP in 4 of 5 eras, so demanding that a SHORT also close below the Asian low cuts good shorts, while demanding a LONG close above the Asian high is mild confirmation of the prevailing drift.")
G_LON = "G — London ORB"
lonUseC2 = input.bool(true, "G) Use C2 retest architecture (same as M/H)", group=G_LON,
           tooltip="OFF = the legacy Signal G: MARKET entry at the signal bar's close, SL at the OPPOSITE OR extreme, TPs at 1/2/3x the OR width from the broken level.\n\nON = the architecture M and H actually use: a LIMIT resting back at the broken ORB level (shifted by c2RetestDepth), SL = level +/- the C2 stop, TPs = range x orbTPMult x {1,2,3}.\n\nThat is the single biggest difference between G and the two signals that produce the 99% baseline. G has never been given it — this is the A/B.")
c2MinRangeLON = input.float(5.0, "G) Min London ORB range to trade (pts)", group=G_LON, step=1.0,
           tooltip="Only applies in C2 mode. Legacy mode keeps its original 0.50 floor. Matches the 5.0 floor M and H use — with a 150-pt stop a 2-pt opening range is not a tradeable structure.")
lonDirFilter = input.string("Both", "G) Direction filter", options=["Both", "Long only", "Short only"], group=G_LON)
lonBiasFilter = input.bool(false, "G) Require HTF bias alignment", group=G_LON,
           tooltip="Uses the same bias timeframe selected for H/M above, so G can be compared against them on equal terms.")
lonADRGuard = input.bool(false, "G) Skip when >90% ADR already consumed", group=G_LON,
           tooltip="The M/H ADR guard, given its own switch for G. Reads _adrConsumed[1] so the trigger bar's own wick cannot self-block.")
lonBreakAsianHi = input.bool(false, "G LONG) Require close above Asian high", group=G_LON,
           tooltip="The direct analogue of M's orbBreakAsianHi, but measured against the FULL Asian session (00:00-08:00) rather than M's 00:00-07:00 window — because each session's filter should use the Asian range up to ITS OWN open, and London opens an hour after Frankfurt.\n\nNote what this means at 08:30: Frankfurt has already traded 07:00-08:00, so the Asian extreme may have been swept before London even opened. That is a real difference from M and part of what the test measures.")
lonBreakAsianLo = input.bool(false, "G SHORT) Require close below Asian low", group=G_LON,
           tooltip="Symmetric to the LONG filter above.")
lonAsianCascade = input.bool(false, "G) Asian cascade — only trade in the Asian close direction", group=G_LON,
           tooltip="Blocks G trades opposing the Asian session's own direction (close vs open, 00:00-07:00 UTC). T-1 theorem measured London at 61.7%, z=3.63. Independent of the H/M asianBiasFilter so the two can be tested separately.\n\nCORRECTION 2026-09-21: this tooltip previously said 00:00-08:00. It is wrong — _asianBias is accumulated in the `_minOfDay < 420` block, i.e. 00:00-07:00, the same window M uses. The 377-trade baseline was measured with 07:00. Port that, not 08:00.")

G_LIFE = "Order life (limit expiry)"
// Added 2026-09-21. These windows were HARDCODED, which meant the one number that
// decides "how long does an unfilled limit stay alive" could not be measured.
//
// WHAT AN EXPIRY CAN AND CANNOT DO. It cancels an order that NEVER FILLED. It
// cannot touch a filled position — once you are in, SL/TP own the trade. So a
// shorter expiry can never cut a winner short mid-trade. What it CAN do is
// cancel a limit that would have filled later and won. That is the real cost,
// and these inputs exist to price it: shorten one, re-run, read the trade count
// and WR.
//
// PATH-DEPENDENCE WARNING: cancelling early also FREES the position slot early,
// so a shorter expiry can ADD trades from other signals. The trade list
// reshuffles. Judge on net P&L and WR together, never on count alone.
frbTradeMins = input.int(210, "M) Frankfurt limit life (mins from 07:30)", group=G_LIFE, minval=15, maxval=600, step=15,
               tooltip="210 = expires 11:00 UTC, the value used in the 377-trade / 99.47% baseline. Shorten to measure what late Frankfurt fills are worth.")
lonTradeMins = input.int(150, "G) London limit life (mins from 08:30)",    group=G_LIFE, minval=15, maxval=600, step=15,
               tooltip="150 = expires 11:00 UTC, the baseline value. G overlaps M's window (M runs 07:30-11:00), so these two compete for the single position slot — shortening one hands trades to the other.")
nyOrderMins  = input.int(0,   "H) NY limit life (mins from 14:30, 0 = none)", group=G_LIFE, minval=0, maxval=600, step=15,
               tooltip="0 = the BASELINE behaviour: the NY limit is cancelled only at the daily roll (21:00/22:00 UTC), so it can rest ~7 hours against a level that stopped being the opening range long before. H is the only signal with an effectively unbounded order.\n\nThat unbounded life is part of what produced 99.47%, which is the uncomfortable part — the H' test already showed late NY breaks are the BETTER trades, so a tight expiry here may cost real money. Set a value and measure before assuming shorter is safer.")

G_C2 = "C2 — OCO (Signal M + H)"
c2SLBuf   = input.float(76.0,  "SL beyond C2 structural level (pts)", group=G_C2, step=0.5,
            tooltip="Stop distance in points beyond the C2 retest LEVEL (not from the signal bar close). Only used when SL mode = Absolute points. TP targets still use orbTPMult x ORB range measured from the same level.\n\n**** THIS IS THE STOP SWEEP, AND IT IS THE ONE RUN STILL OUTSTANDING.\nWalk-forwarding THIS NUMBER ALONE is the only result in the whole project that has ever passed t=2.\n\nMEASURED 2026-11-06, 4.4yr of broker 15m, LIVE config (one slot, brkStr 0.26, floors 0, H off / H-prime on), nothing changing but this input:\n  pts   n     WR%     R/trade   totR   maxDD   R/DD   eras   @2026 spread\n   30   807   80.79   +0.0409   +33.0   6.7    4.95   3/4    +0.0269\n   40   736   83.29   +0.0224   +16.5   7.3    2.27   2/4    +0.0119   <- LIVE\n   50   695   86.76   +0.0329   +22.8   6.7    3.42   3/4    +0.0245\n   60   651   88.33   +0.0255   +16.6   4.4    3.78   3/4    +0.0185\n   76   575   90.43   +0.0264   +15.2   4.6    3.31   4/4    +0.0209   <- this default\n   90   550   91.82   +0.0227   +12.5   4.1    3.04   4/4    +0.0180\n  110   523   93.12   +0.0178    +9.3   4.4    2.13   4/4    +0.0140\n\n*** THE LIVE 40 IS THE WORST CELL IN THE SWEEP BAR 110. It is the only value under 3.0 R/DD other than that, and BOTH tighter (30) and wider (50-90) beat it. Era consistency rises monotonically with the stop: 2 of 4 at 40, all 4 at 76-110.\n\n*** WALK FORWARD, the stop chosen on the training span only and run forward against a fixed 40: pooled +0.0583 against +0.0338, so it ADDS +0.0244 R/trade at t=+2.07. Measured 2026-11-07 against a placebo floor (a search over a feature built from a hash of the bar timestamp, which buys +0.0012 on average and +0.0066 at p95), this is one of only two results on the record that CLEAR that floor -- the other is the U prior-day band.\n\nWARNING, AND IT IS WHY THE DEFAULT HAS NOT MOVED: the parameter is UNSTABLE. The three folds chose 76, 90 and 30 -- a different stop every time -- it beat the live 40 in only 2 of 3, and the pooled figure is dominated by fold 3. The honest claim is 40 IS WRONG, not X IS RIGHT. Which is why this is a sweep for your Tester and not a new default.\n\nWARNING: WR and R/trade move in OPPOSITE directions here. 110 pts gives the best win rate in the file (93.12%) and nearly the worst risk-adjusted return. Judge this on R/trade and R/DD, never on WR.\n\nWARNING: the MAE stop-sweep table in the SL research group looks like it answers this and DOES NOT. It re-prices the trades this run actually took against other stop sizes, and this harness is path-dependent: one slot, every entry gated on a flat book, so a different stop closes trades at different times and a completely different set of later signals gets taken. Read that table as a shortlist. The only answer is to set this number and re-run.\n\nHOW TO RUN IT: pin the test window first (Test window group) so every run covers identical bars, then take 30 / 50 / 60 / 76 / 90 and record trade count, net and max drawdown for each. Reconcile the trade COUNT first and the win rate second -- if the count moves far from the table above, the window differs and the runs are not comparable.")
c2SLMode  = input.string("Absolute points", "SL mode", options=["Absolute points", "x ORB range", "x ATR"], group=G_C2,
            tooltip="How the C2 stop distance is derived. Applies to M, H, U and V.\n\nABSOLUTE POINTS — the historical behaviour: a flat c2SLBuf regardless of instrument or volatility. The problem: 150 pts is 3.43% of gold's price but 1.97% of SP500's, and 6.25x gold's ORB range vs 9.04x SP500's. It is one number pretending to be one strategy across instruments that differ 3-10x.\n\nx ORB RANGE — stop = k x that day's own opening range. Self-scales across instruments AND across volatility regimes (gold's ranges doubled as it ran 1,900 -> 4,370 while the flat 150 stayed put).\n\nx ATR — stop = k x entry-TF ATR. Similar self-scaling, but keyed to general volatility rather than the specific range being traded.\n\nDefault is Absolute points so the existing baseline reproduces unchanged.")
c2SLRangeMult = input.float(2.0, "SL = k x ORB range", group=G_C2, minval=0.25, maxval=15.0, step=0.25,
            tooltip="Only used when SL mode = 'x ORB range'.\n\nReference points (using 1y average ranges - gold 24 pts, SP500 16.6 pts):\n  k=6.25 -> gold 150, SP500 104  (reproduces gold's current stop)\n  k=3.00 -> gold 72,  SP500 50\n  k=2.00 -> gold 48,  SP500 33   <- 3R becomes reachable\n  k=1.50 -> gold 36,  SP500 25\n\nWhy it matters: TP1 is 0.75 x range, so at k=6.25 TP1 is only 0.12R and a 3R target sits ~450 pts away - several daily ranges. Lower k shrinks R until 3R is a normal day's move, which is what makes an R-based ladder fire at all.")
c2SLAtrMult = input.float(3.0, "SL = k x ATR", group=G_C2, minval=0.25, maxval=20.0, step=0.25,
            tooltip="Only used when SL mode = 'x ATR'. Stop = k x the entry-timeframe ATR(atrLength).")
c2MinRangeFRB  = input.float(5.0,  "M) Min Frankfurt ORB range to trade (pts)", group=G_C2, step=1.0,
               tooltip="Skip FRB (Signal M) if the 07:00-07:30 UTC ORB range is below this. Frankfurt ranges tend to be tighter than NY — tune separately. Breakeven at SL=8pt, TP mult=0.75: range > 10.67pt.")
c2MinRangeNY   = input.float(5.0,  "H) Min NY ORB range to trade (pts)",         group=G_C2, step=1.0,
               tooltip="Skip NYORB (Signal H) if the 14:00-14:30 UTC ORB range is below this. NY ranges expand with US session volatility — tune separately. Breakeven at SL=8pt, TP mult=0.75: range > 10.67pt.")
c2MinBreakStr = input.float(0.0, "C2 min break strength (x ORB range)", group=G_C2, minval=0.0, maxval=1.00, step=0.05,
               tooltip="Requires the signal bar to close at least this far BEYOND the ORB level, in range units. LEAVE AT 0.00 — TESTED AND REJECTED 2026-09-18. Keep the input only so the negative result stays attached to the code.\n\nMEASURED 3y (16 Sep 2023 - 16 Sep 2026):\n  0.00   218 trades   99.08% WR   PF 6.335   +4148 USD\n  0.10   200 trades   98.50% WR   PF 3.849   +2832 USD\n  0.15   189 trades   97.88% WR   PF 2.585   +2143 USD\nMonotonically worse on every metric. Losses went 2 -> 3 -> 4 and max drawdown rose 710 -> 714 -> 722.\n\nTHE HYPOTHESIS WAS SOUND AND STILL FAILED. The observation was real: among trades actually taken, breaks weaker than 0.10 range stayed under 20 pts of heat only 50.0% of the time vs 83.8% for the rest (z = -3.43, p ~ 0.0006, n=96). Filtering on it made the system worse anyway.\n\nWHY IT DID NOT TRANSFER — two reasons, both structural:\n\n1. THE TRADE LIST IS PATH-DEPENDENT. pyramiding=0 and every entry gated on strategy.position_size == 0, so blocking a signal FREES THE SLOT for a later signal that would otherwise have been skipped. The filtered run is not the baseline minus 18 trades — it is a different, reshuffled population. That is why losses can go UP while trades go DOWN, which is arithmetically impossible under a nested subset. Any MAE study that re-prices the taken list silently assumes the list is fixed. It is not.\n\n2. WEAK BREAKS ARE THE FREE FILLS. At c2RetestDepth 0.25 the long limit rests at level + 0.25 x range. A break of strength 0.05 closes BELOW that limit, so it fills instantly at a favourable price. A break of strength 0.50 closes above it and needs a genuine pullback that may never arrive. So this filter preferentially deletes the cheapest, most certain fills and keeps the ones contingent on a retest.\n\nHEAT IS NOT LOSS. Weak breaks carried more adverse excursion and still won, at 99% WR. Optimising away excursion optimised away profit.")
c2LiqGrab = input.string("Off", "C2) Liquidity grab required before break", options=["Off", "Sweep own ORB opposite", "Sweep prior session pool", "Either sweep"], group=G_C2,
               tooltip="Only take the breakout if a pool of resting stops on the OPPOSITE side was run first. A long break wants the downside swept; a short break wants the upside swept.\n\nApplies to M (Frankfurt), H (NY) and U (Sydney). V (Tokyo) is deliberately left alone so it stays identical in both arms of the comparison.\n\nSWEEP OWN ORB OPPOSITE — price traded beyond the far side of this session's own opening range before breaking the near side. The classic ORB fakeout: the first break fails, traps traders, and the second one runs.\n\nSWEEP PRIOR SESSION POOL — price traded beyond the previous session's extreme. M sweeps the ASIAN range (00:00-07:00), H sweeps the LONDON range (08:00-14:00), U sweeps the NY range (14:00 to the Sydney open).\n\nEITHER SWEEP — passes if either pool was run. Keeps the most trades.\n\nTracking starts at each session's ORB window open and resets on the rising edge of that same window, never on the daily roll, because the broker day turns over at 21:00/22:00 UTC — directly on top of the Sydney open and the NY pool window.\n\nThis is distinct from the orbBreakAsianHi/Lo filters above, which demand the break CLOSE BEYOND the prior extreme. That is expansion. This is a sweep and reclaim, which is the opposite shape.")
c2RetestDepth = input.float(0.0, "C2 partial retest depth (x ORB range)", group=G_C2, minval=0.0, maxval=0.70, step=0.05,
               tooltip="How far the limit sits from the ORB level, TOWARD current price. Only meaningful in Retest (limit) mode.\n\n0.00 = limit exactly at the ORB level (the backtested baseline). Needs a FULL retest, so runaway breakouts are never taken.\n0.25 = limit a quarter-range closer to price — fills on a shallow bounce.\n0.50 = half a range closer. Fills far more often, entry price worse.\n\nSL and TP stay anchored to the ORB level, so trade geometry is unchanged — only fill probability and entry price move. This is the middle ground between a full-retest limit and chasing at market.\n\nWhy it exists: the breakouts a full-retest limit misses are the ones that travel furthest (they never come back). Sweep 0 / 0.25 / 0.50 and look for the knee.\n\nAuto-clamped below the TP multiplier so the entry can never sit past its own target.")
c2EntryMode = input.string("Retest (limit)", "C2 entry type", options=["Retest (limit)", "Immediate (market)"], group=G_C2,
               tooltip="A/B test for signals M + H.\n\nRETEST (limit) — the backtested baseline. Order rests AT the ORB level; fills only if price returns to it. Breakouts that run away are never taken.\n\nIMMEDIATE (market) — fills at the signal bar close, which is ALREADY past the level. Takes every signal, including runaways, but entry is worse: SL and TP stay anchored to the ORB level, so each win banks less and each loss costs more.\n\nBreakeven WR rises from ~90.9% to ~92.7% at 1:10 R:R. Baseline runs 97.5% — verify the blended WR stays above ~95% before switching live.")


G_REV = "Reverse (research)"
// Added 2026-09-29. Takes the OPPOSITE side of a signal, to test whether the
// edge is inverted. Per-signal so they can be isolated.
//
// WHAT REVERSE DOES: the TRIGGER is untouched. An upward break of the ORB high
// still fires; it simply opens a SHORT instead of a LONG. Stop and target keep
// the SAME DISTANCES as the original trade, mirrored around the fill, so R:R is
// identical and direction is the only variable.
//
// WHY THE ENTRY BECOMES A MARKET FILL. The C2 entry is a LIMIT resting for a
// pullback: on an upward break the buy limit sits at level + depth x range,
// BELOW current price. Flip the trade to a sell and that same price is still
// below the market, which makes it a STOP order, not a limit. The retest
// mechanic cannot survive inversion, so a reversed trade fills at the signal
// bar close. c2EntryMode is ignored for reversed signals.
//
// READ RESULTS WITH THAT IN MIND: the reversed arm pays a worse entry than the
// original's retest, so a small edge either way is inside that difference.
// Only a large, consistent gap means anything.
//
// ENTRY IDS STAY TIED TO THE TRIGGER. With revM on, "FRB-L" is a SHORT. Signal
// attribution in the contribution and loss tables stays correct; the DIR column
// shows the TRIGGER direction, not the trade.
revM = input.bool(false, "M) Reverse Frankfurt ORB", group=G_REV)
revG = input.bool(false, "G) Reverse London ORB",    group=G_REV)
revH = input.bool(false, "H) Reverse NY ORB (H' too)", group=G_REV)
revU = input.bool(false, "U) Reverse Sydney ORB",    group=G_REV)

G_FILT = "Filters"
atrLength     = input.int(14,     "ATR period",                    group=G_FILT, minval=2,    maxval=50)
emaLength     = input.int(20,     "HTF bias EMA period",           group=G_FILT, minval=5,    maxval=100)

// ═══════════════════════════════════════════════════════════════════════
// FTMO RULES AS BACKTEST CONSTRAINTS  (strategy.risk.*)
// ═══════════════════════════════════════════════════════════════════════
// Until now the daily-loss exposure was computed AFTER a run, by hand, from
// a loss rate — "at 4% risk, two stops in one day is 8% and breaches the 5%
// cap". That is an estimate about a sequence the backtest never actually
// enforced.
//
// Pine enforces it natively. These two calls make the account rules a rule
// of the RUN: the strategy stops trading for the day when the intraday loss
// trips, and stops entirely when total drawdown trips. So the cost of a
// circuit breaker can be measured BEFORE one is written into manage-trades,
// which is the open item the sizing notes have carried since 22 Sep.
//
// DEFAULT OFF, and off means 100% — a threshold no run reaches — so every
// recorded baseline reproduces byte-for-byte until the switch is thrown.
// They are called unconditionally rather than inside `if` because these are
// declarations, not actions: they register a rule with the engine once.
//
// READ IT AS: net WITH the guards is what the funded account would actually
// have made. Net without them is what the strategy would make if nobody
// enforced the rules. The gap is what the rules cost you.
// ═══════════════════════════════════════════════════════════════════════
// PINE LOGS  (log.info / log.warning / log.error)
// ═══════════════════════════════════════════════════════════════════════
// This file has spent weeks reimplementing a log panel out of table cells.
// Pine has had one since v6. A log line is timestamped, scrollable, wraps to
// any length and can be COPIED - none of which a table cell does. So tables
// keep the things you scan at a glance, and anything you would want to read
// in full or paste into a conversation goes here instead.
//
// Deliberately bounded: one summary block at the end of the run, plus one
// line per LOSING trade. Logging every signal would flood the panel, and
// Pine caps how many lines it keeps.
G_LOG   = "Pine Logs"
showLog = input.bool(false, "Write the run summary to Pine Logs", group=G_LOG,
          tooltip="Opens under the Pine Editor's 'Pine Logs' tab. Writes the exit-mode comparison, the shadow accounting, the intrabar verdict and one line per losing trade.\n\nOFF by default because logs cost time on a three-year run and you rarely want them while sweeping a parameter.")

G_FTMO     = "FTMO rules (backtest enforcement)"
ftmoGuards = input.bool(false, "Enforce the account rules during the backtest", group=G_FTMO,
             tooltip="OFF = the run ignores account rules entirely, which is how every recorded baseline was measured.\n\nON = the strategy stops for the DAY when the intraday loss hits the daily cap, and stops for GOOD when equity drawdown hits the total cap. That is what the funded account does to you, so it is what the backtest should do to the strategy.\n\nExpect NET TO FALL. That fall is not a worse strategy - it is the part of the old number the rules would never have let you keep.")
ftmoDaily  = input.float(5.0,  "  Daily loss cap (% of equity)", group=G_FTMO, minval=0.5, maxval=100.0, step=0.5,
             tooltip="FTMO measures this from each day's STARTING equity, resets daily, and counts floating P&L. At riskPct 4% one full stop is 4% of the account, so two stops in one day is 8% and breaches - this is the rule that actually binds, not the 10% total.")
ftmoTotal  = input.float(10.0, "  Total drawdown cap (% of equity)", group=G_FTMO, minval=1.0, maxval=100.0, step=0.5,
             tooltip="FTMO's total loss floor is STATIC - fixed in dollars on day one and it never trails your equity up - so every dollar of profit is permanent buffer. Pine's max_drawdown is measured from peak equity instead, which is STRICTER than FTMO. Treat a trip here as a warning, not a literal breach.")

// 100 = a cap no run ever reaches, so OFF is genuinely inert.
strategy.risk.max_intraday_loss(ftmoGuards ? ftmoDaily : 100.0, strategy.percent_of_equity)
strategy.risk.max_drawdown(ftmoGuards ? ftmoTotal : 100.0, strategy.percent_of_equity)


// ═══════════════════════════════════════════════════════════════════════
// NFP DAY — heuristic vs the real release calendar  (request.economic)
// ═══════════════════════════════════════════════════════════════════════
// `_isNFP` has always been "Friday, and day-of-month <= 7". That is a decent
// approximation and it is wrong several times a year: BLS moves the release
// for holidays, and a month starting on a Saturday puts the first Friday on
// the 7th while the release is the 6th of the NEXT week.
//
// request.economic pulls the actual series. It does not hand you a "release
// today" flag, so the release bar is detected as the bar the VALUE CHANGES.
//
// WHY THIS IS A SWITCH AND NOT A REPLACEMENT: the field code is not something
// this file can prove. `ignore_invalid_symbol = true` makes a wrong code
// return na rather than throwing, so a bad guess degrades to "never NFP"
// silently. The comparison table therefore reports how many days each source
// flagged and how often they AGREED. If the economic count is 0, the field
// code is wrong - not the calendar.
G_ECON = "NFP source"
nfpSrc = input.string("Heuristic (first Friday)", "How to detect an NFP day", options=["Heuristic (first Friday)", "request.economic (US NFP)"], group=G_ECON,
         tooltip="Only matters when orbNFPFilter is ON - which it is not, because NFP was measured DEAD as a filter on 2026-09-27. This exists so the loss autopsy's NFP column is honest, and so the two sources can be checked against each other.\n\nIf the economic row in the comparison table reports 0 days, the field code is wrong and this option is doing nothing.")

// ─── HTF BIAS (H1 / H4 / D) ──────────────────────────────────────────
f_htfBias(int emaLen, int atrLen) =>
    e = ta.ema(close, emaLen)
    b = close[1] > e[1] ? 1 : close[1] < e[1] ? -1 : 0
    a = ta.atr(atrLen)
    [b, a]

[h1B, h1ATR] = request.security(syminfo.tickerid, "60",  f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[h4B, h4ATR] = request.security(syminfo.tickerid, "240", f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[hdB, hdATR] = request.security(syminfo.tickerid, "D",   f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)

atrVal = ta.atr(atrLength)


// ─── CLOCK EXIT ──────────────────────────────────────────────────────
// Replaces the fitted 24-hour hold the deep run was accidentally measuring.
// The hold was the PEAK of its own sweep (12h 7.82 / 18h 9.33 / 24h 11.98 /
// 30h 6.21); a fixed clock is implementable AND flat: 17:00 9.38, 17:30 9.99,
// 18:00 11.06, 18:30 9.02, 19:00 9.69, 19:30 10.25, 20:00 10.58, 20:30 9.50,
// with ZERO challenge breaches across 17:00-20:00 at both 2% and 3% risk.
//
// ⚠ AND THE HONEST PART: on the BARE entry set the same exit scores 1.34. The
// exit carries none of the edge - the context filters do. Its only job is to
// stop the edge being given back.
G_CLK = "Clock exit (deep run 2026-10-17)"
clkExitOn  = input.bool(false, "CLK) Close every position at a fixed UTC time", group=G_CLK,
             tooltip="Flattens whatever is open when this minute arrives and cancels any limit still resting. Pine fills it at the NEXT bar's open, so expect a small difference from the offline figures, which priced it inside the 20:00 bar.\n\nMEASURED with SL 50 + silver + align: a target or a trail on top of this is worth about 0.5 netR/DD, which is inside the noise - the clock alone scores 10.58 against 11.13 with a 200pt target. The simplest version is the right one.\n\n⚠ NEEDS SL 50. The same exit at c2SLBuf 76 scores 6.71 and passes 23% of challenge months instead of 52%.")
orbHoldBars = input.int(0, "CLK)   hold cap in BARS from entry (0 = off)", group=G_CLK, minval=0, maxval=1000,
             tooltip="Flatten N BARS AFTER THE FILL, regardless of clock time. 0 = off. On 15m, 96 = 24h, 192 = 48h.\n\nWHY THIS EXISTS, and why it is not the same thing as the UTC flatten above: a wall clock hands every signal a DIFFERENT hold. From a 20:00 UTC wall, H (14:00) gets 6h, M (07:00) 13h, U (22:30) 21.5h into the next day. Measured mean realised hold under clkExitMin 20:00 is 1.6-3.9 HOURS against 6.9-22.3 for a 96-bar cap. The wall clock is a truncation, not an exit.\n\nMEASURED 2026-11-11, broker 15m 4.4yr, R/tr by cap:\n  bars      4      16      32      48      96     192     288\n  hours   1.0     4.0     8.0    12.0    24.0    48.0    72.0\n  TP1  -0.0025 -0.0021 +0.0088 +0.0040 +0.0085 +0.0162 +0.0210\n  sig3 -0.0038 +0.0028 +0.0382 +0.0452 +0.0772 +0.0745 +0.1009\nMonotone rising. session sigma x3 holds R/DD 3.4-5.25 and 3/4-4/4 eras from 32 bars to 288 - a plateau over a 9x range, which is what makes the hold a mechanism and not a fitted number.\n\nCONSISTENT WITH TWO INDEPENDENT PUBLISHED FINDINGS: micro-gold's 60-min mean-reversion half-life is ~8 HOURS, longer than one session; and on MNQ the only change that moved an opening-range break from -0.82 to +2.82 net points was lengthening the hold 5 -> 75 min.\n\n⚠ THIS IS A FREE PARAMETER. Every documented professional system uses an EXOGENOUS boundary (a cash close) because it cannot be fitted, and gold has no cash close. R/tr is STILL RISING at 72h, so the data says 'hold longer', not 'hold exactly N'. Past ~24h the trade spans days and FTMO judges breaches on EQUITY INCLUDING OPEN P/L, so an open position carries its adverse excursion into the daily limit. Choose the cap from that constraint, not from the best cell.\n\n⚠ SET THE TWO EXITS INDEPENDENTLY. Leaving clkExitOn on while this is set applies BOTH, and whichever fires first wins - which reintroduces the truncation this input exists to remove.")
clkExitMin = input.int(1200, "CLK)   UTC minute to flatten", group=G_CLK, minval=0, maxval=1439, step=15,
             tooltip="1200 = 20:00 UTC, the best pass rate (52% of rolling 30-day windows, zero breaches). 1080 = 18:00 UTC gives the lowest drawdown (2.82R vs 3.17R) but a lower pass rate. Anything from 17:00 to 20:30 sits on the plateau.\n\nNote Signal U fires at 22:30, AFTER this time, so a Sydney trade is flattened at the NEXT day's clock - about 21 hours later. That is what was measured; it is not a bug.")



// 15m bias — the ORB's OWN timeframe. Computed natively (no request.security);
// the chart is 15m, so this is just EMA(emaLength) on this series.
//
// CRITICAL: it reads close[1] vs ema[1], NOT the current bar. On the signal bar
// the break condition is `close > frb_hi`, and a bar that closes above the ORB
// high has almost certainly closed above its own 15m EMA too. Scoring the bias
// on the current bar would therefore be scoring the breakout against itself —
// the filter would look predictive while measuring nothing. Reading [1] asks
// the real question: was the 15m already trending up BEFORE this bar broke?
_m15ema = ta.ema(close, emaLength)
m15B    = close[1] > _m15ema[1] ? 1 : close[1] < _m15ema[1] ? -1 : 0

// Partial-retest depth, clamped so the limit can never sit at or past its own
// TP (which would make the trade nonsensical). At depth >= orbTPMult the entry
// would be beyond tp1; 0.9x keeps a margin.
_c2Depth = math.min(c2RetestDepth, orbTPMult * 0.9)

// C2 stop distance. A flat point value is NOT comparable across instruments —
// 150 pts is 6.25x gold's ORB range but 9.04x SP500's, so the same number is
// two different strategies. Range/ATR modes derive the stop from the
// instrument's own volatility instead.
// Floored at one tick so a degenerate range can never produce SL == entry.
// A+ TIER hooks in HERE, at the single point every signal already asks for its
// stop — M, H, U, V and G all call this, so the tier reaches all of them with
// no per-signal edits and no chance of one drifting out of sync.
f_c2SL(float rng) =>
    base = c2SLMode == "x ORB range" ? rng * c2SLRangeMult : c2SLMode == "x ATR" ? atrVal * c2SLAtrMult : c2SLBuf
    math.max(base, syminfo.mintick)



// Bias check helpers for H/M filter (resolved once per bar)
_orbBiasLong  = orbBiasTF == "H1" ? h1B >= 0 : orbBiasTF == "Daily" ? hdB >= 0 : orbBiasTF == "H1+H4" ? (h1B == 1 and h4B == 1) : orbBiasTF == "H1+H4+D" ? (h1B == 1 and h4B == 1 and hdB == 1) : orbBiasTF == "M15" ? m15B == 1 : orbBiasTF == "M15+H1" ? (m15B == 1 and h1B == 1) : orbBiasTF == "M15+H1+H4" ? (m15B == 1 and h1B == 1 and h4B == 1) : h4B >= 0
_orbBiasShort = orbBiasTF == "H1" ? h1B <= 0 : orbBiasTF == "Daily" ? hdB <= 0 : orbBiasTF == "H1+H4" ? (h1B == -1 and h4B == -1) : orbBiasTF == "H1+H4+D" ? (h1B == -1 and h4B == -1 and hdB == -1) : orbBiasTF == "M15" ? m15B == -1 : orbBiasTF == "M15+H1" ? (m15B == -1 and h1B == -1) : orbBiasTF == "M15+H1+H4" ? (m15B == -1 and h1B == -1 and h4B == -1) : h4B <= 0

// U reads its OWN bias timeframe. His 2026-10-22 observation: U fires at
// 22:30, FIRST in the trading day, so the H1/H4 bias it reads is still
// yesterday's picture - the day's bias only starts forming during U itself.
// H and M at 07:30/14:30 read a bias that has had hours to form. Same filter,
// completely different information content. sydBiasTF defaults to H1+H4 so
// nothing moves until it is deliberately changed.
_frbBiasLong  = frbBiasTF == "H1" ? h1B >= 0 : frbBiasTF == "H4" ? h4B >= 0 : frbBiasTF == "Daily" ? hdB >= 0 : frbBiasTF == "H1+H4" ? (h1B == 1 and h4B == 1) : frbBiasTF == "H1+H4+D" ? (h1B == 1 and h4B == 1 and hdB == 1) : frbBiasTF == "M15" ? m15B == 1 : frbBiasTF == "M15+H1" ? (m15B == 1 and h1B == 1) : (m15B == 1 and h1B == 1 and h4B == 1)
_frbBiasShort = frbBiasTF == "H1" ? h1B <= 0 : frbBiasTF == "H4" ? h4B <= 0 : frbBiasTF == "Daily" ? hdB <= 0 : frbBiasTF == "H1+H4" ? (h1B == -1 and h4B == -1) : frbBiasTF == "H1+H4+D" ? (h1B == -1 and h4B == -1 and hdB == -1) : frbBiasTF == "M15" ? m15B == -1 : frbBiasTF == "M15+H1" ? (m15B == -1 and h1B == -1) : (m15B == -1 and h1B == -1 and h4B == -1)
_sydBiasLong  = sydBiasTF == "H1" ? h1B >= 0 : sydBiasTF == "H4" ? h4B >= 0 : sydBiasTF == "Daily" ? hdB >= 0 : sydBiasTF == "H1+H4" ? (h1B == 1 and h4B == 1) : sydBiasTF == "H1+H4+D" ? (h1B == 1 and h4B == 1 and hdB == 1) : sydBiasTF == "M15" ? m15B == 1 : sydBiasTF == "M15+H1" ? (m15B == 1 and h1B == 1) : (m15B == 1 and h1B == 1 and h4B == 1)
_sydBiasShort = sydBiasTF == "H1" ? h1B <= 0 : sydBiasTF == "H4" ? h4B <= 0 : sydBiasTF == "Daily" ? hdB <= 0 : sydBiasTF == "H1+H4" ? (h1B == -1 and h4B == -1) : sydBiasTF == "H1+H4+D" ? (h1B == -1 and h4B == -1 and hdB == -1) : sydBiasTF == "M15" ? m15B == -1 : sydBiasTF == "M15+H1" ? (m15B == -1 and h1B == -1) : (m15B == -1 and h1B == -1 and h4B == -1)

// ─── SESSION CONTEXT ──────────────────────────────────────────────────
_hourUtc  = hour(time, "UTC")
_minOfDay = _hourUtc * 60 + minute(time, "UTC")
_newDay   = ta.change(time("D")) != 0

_atr14d     = request.security(syminfo.tickerid, "D", ta.atr(14))
_todayHigh  = request.security(syminfo.tickerid, "D", high)
_todayLow   = request.security(syminfo.tickerid, "D", low)
// Previous completed day's extremes, feeding W's level-quality filter. The [1]
// is what makes this safe: it reads the FINISHED daily bar, so there is no
// lookahead even though the day series is still forming. Same pattern as
// _priorClose directly above. Note the broker day rolls at 21:00/22:00, so at
// 01:00 UTC "previous day" means the session that ended ~3h before W fires.
_pdHigh     = request.security(syminfo.tickerid, "D", high[1])
_pdLow      = request.security(syminfo.tickerid, "D", low[1])
// Previous WEEK extremes, for the liquidity-target pool set. Same [1] safety
// as the daily pair above: it reads the COMPLETED weekly bar.


// Session VWAP, for Signal X's optional VWAP-side filter. Computed at TOP
// LEVEL and unconditionally on purpose: ta.vwap carries internal cumulative
// state, so calling it inside `if modX` would feed it a gappy history and
// return a different number than an always-on call would. Costs nothing when
// X is off. Note ta.vwap anchors to the CHART session while the offline
// harness anchored to the broker day - another reason the Tester and the
// Python numbers will not line up trade-for-trade on this filter.


_adrConsumed   = _atr14d > 0 ? (_todayHigh - _todayLow) / _atr14d : 0.0

// H/M research gate helpers (placed here — needs _adrConsumed defined first)
// NFP day. Two sources, switchable, because the heuristic is an approximation
// the file has never been able to check. _isNFPapx is the original rule;
// _isNFPeco marks the bar the official series CHANGES, which is the release.
// A wrong field code returns na and simply never fires - the comparison table
// counts both so a silent zero is visible rather than assumed correct.
_nfpEco     = request.economic("US", "NFP", ignore_invalid_symbol = true)
_isNFPapx   = dayofweek == dayofweek.friday and dayofmonth <= 7
// ta.change is STATEFUL - it compares against its own previous call - so
// putting it behind a short-circuiting `and` means it is skipped on every
// bar where _nfpEco is na, and its history is then wrong for every bar
// after. Hoisted so it runs unconditionally; nz() keeps the na case false,
// which is the same answer the old expression gave when the field code is
// invalid. (TradingView warning at 871.)
_nfpEcoChg  = ta.change(_nfpEco)
_isNFPeco   = not na(_nfpEco) and nz(_nfpEcoChg) != 0
_isNFP      = nfpSrc == "request.economic (US NFP)" ? _isNFPeco : _isNFPapx
_mnth       = month(time)
_orbSeasonL = not orbSeasonFilt or _mnth != 9   // Sep blocks longs (90% bearish)
_orbSeasonS = not orbSeasonFilt or _mnth != 1   // Jan blocks shorts (80% bullish)
_nfpOk      = (not orbNFPFilter or not _isNFP) and _testWinOk
// ---------------------------------------------------------------------
// ADR GATE AS A BAND. The 0.90 was hardcoded at six sites and had never
// been swept -- the switches only turned the guard on and off AT 0.90.
//
// MEASURED 2026-11-05 on 4.4yr of broker 15m (bt/f08_adr_map.py):
//   the >=0.90 band the guard DELETES is the BEST band in the sample,
//   +0.047 R/trade against +0.003 for everything. Inverting the gate
//   (trade ONLY when >=0.50 ADR is spent) walked forward at +0.0509
//   R/trade over 3 folds against the live gate's -0.0017 on the same
//   span. Per signal the inversion helps G most (4/4 eras) and M
//   second; H is indifferent; U is removed entirely, which helps
//   because U is negative anyway.
//
// WHY ONE NUMBER COULD NEVER WORK: the share of each signal's trades
// that 0.90 cuts is H 54.4%, G 9.7%, M 8.9%, U 0.3%. Median ADR at the
// signal bar is H 0.942, G 0.573, M 0.481, U 0.090. A threshold cannot
// mean the same thing at the Sydney open and in the New York afternoon.
//
// Defaults 0.00/0.90 reproduce the existing behaviour exactly.
adrLoFRB = input.float(0.00, "M) ADR band LOW  (trade only above)",  minval=0.0, maxval=5.0, step=0.05, group=G_STRAT, tooltip="Set to 0.50 for the measured inverted gate. M: live -0.0085 R/tr -> inverted +0.0377.")
adrHiFRB = input.float(0.90, "M) ADR band HIGH (trade only below)",  minval=0.0, maxval=9.9, step=0.05, group=G_STRAT, tooltip="Set to 9.9 to remove the upper cut, which is what the inverted gate needs.")
adrLoNY  = input.float(0.00, "H) ADR band LOW",  minval=0.0, maxval=5.0, step=0.05, group=G_STRAT, tooltip="H is the one signal indifferent to the inversion: live +0.0186 vs inverted +0.0116. Its median ADR is 0.942, so 0.90 cuts 54% of its trades.")
adrHiNY  = input.float(0.90, "H) ADR band HIGH", minval=0.0, maxval=9.9, step=0.05, group=G_STRAT, tooltip="hi 0.70 measured +0.0696 R/tr on 64 trades for H -- the best H cell, but thin.")
adrLoORB = input.float(0.00, "U) ADR band LOW",  minval=0.0, maxval=5.0, step=0.05, group=G_STRAT, tooltip="U fires at the Sydney open with a median ADR of 0.090, so any upper threshold is inert for it and any lower one deletes it entirely.")
adrHiORB = input.float(0.90, "U) ADR band HIGH", minval=0.0, maxval=9.9, step=0.05, group=G_STRAT)
// --- U) PRIOR-DAY POSITION BAND ------------------------------------
// Where the Sydney-open close sits inside the PREVIOUS day's range.
// Two-sided: U loses at BOTH extremes, worst above yesterday's high.
// _pdHigh/_pdLow are read off the COMPLETED daily bar via [1], so there
// is no lookahead. Default OFF, so the file is inert until it is ticked.
// --- H') ACCELERATION GATE ------------------------------------------
// Second derivative of price, signed by the trade direction. Bypassed
// on the EARLY NY break (H), where the same construct measured NEGATIVE.
hpAccelOn  = input.bool(false, "H') Require acceleration in the trade direction", group=G_STRAT, tooltip="MEASURED 2026-11-05 on 4.4yr of broker 15m, run INSIDE the engine.\n\naccel2 = is the last 30 min faster than the 30 before it, in the trade's\nown direction, in ATR units. It is the SECOND derivative - not net\ndisplacement. Net displacement (mom16) was tested and is DEAD: it\nreversed sign in-engine and sat at null p=0.2875.\n\nH' threshold sweep, H' run alone:\n  no gate   232 trades   R/tr +0.0206\n  >= -0.50  222          +0.0350\n  >=  0.00  207          +0.0619\n  >=  0.25  195          +0.0686   <- peak\n  >=  0.50  173          +0.0316\n  >=  1.00  118          -0.0687\nA hump, not a spike.\n\nRANDOM-DELETION NULL: p = 0.0175 on 1200 draws.\nWALK-FORWARD, construct fixed, threshold chosen on the past: H' ADDS\n+0.0273 R/trade out of sample.\n\n★ H' ONLY. The same construct COSTS H -0.0781 out of sample, M -0.0272,\nG -0.0100. It is bypassed automatically on the early break, so ticking\nthis cannot affect H.\n\nPAIRED WITH THE U PRIOR-DAY BAND (orbPdBandOn), the whole-book\nwalk-forward is +0.0427 R/trade against +0.0106 for live, all 3 folds\nchose to gate and all 3 beat live. t=+1.72 on 905 trades - better than\nanything else measured here and still NOT significant at 5%.\n\nWARNING: ~280 cells were searched to find this. Verify in the Tester.")
hpAccelThr = input.float(0.00, "H') min signed acceleration (xATR)", minval=-2.0, maxval=3.0, step=0.05, group=G_STRAT, tooltip="Minimum signed acceleration, in ATR units. 0.00 and 0.25 both measured\nwell (+0.0619 and +0.0686); above 0.75 it goes negative.\nThe walk-forward chose 0.00 in two folds and 0.25 in one.")
_acc2Raw   = na(atrVal) or atrVal <= 0 ? 0.0 : ((close - close[2]) - (close[2] - close[4])) / atrVal

// --- SESSION ANCHORS AND THE 06:45 PRIOR ----------------------------
// US DST detected by comparing clocks, not by hardcoding dates:
// (UTC hour - New York hour) mod 24 is 4 in EDT and 5 in EST.
_usOff      = (_hourUtc - hour(time, "America/New_York") + 24) % 24
_isUsDst    = _usOff == 4
nyETAnchor  = input.bool(false, "H/H') Anchor NY to 09:00 ET (MEASURED NEGATIVE)", group=G_STRAT, tooltip="MEASURED 2026-11-06 AND REJECTED. Default OFF. Present so it can be\nre-swept at a different geometry, not because it works.\n\nThe NY equity open is 09:30 ET = 13:30 UTC in summer, 14:30 in winter,\nso the fixed 14:00-14:30 UTC range is a DIFFERENT setup each half of the\nyear. Measured volatility confirms it:\n  WINTER  range forms in LOW vol (11.67, 9.71 bp) and breaks into RISING\n          vol (14:30 = 14.75, 15:00 = 14.90). The textbook ORB shape.\n  SUMMER  range forms in HIGH vol (15.81, 13.15) AFTER the 13:30 open\n          and breaks into FALLING vol (12.72, 10.69, 9.47, 8.10).\n\nThis anchors the window to 09:00-09:30 ET all year, i.e. the winter\nshape everywhere. It FAILED:\n  H' summer +0.1002 -> -0.0984\n  whole book +3.2 R -> -25.5 R, maxDD 24.5 -> 39.7\n  walk-forward chose the plain UTC anchor in 3 of 3 folds\n\nAND THE HYPOTHESIS FAILED ITS OWN PREDICTION: winter has the good ORB\nshape and winter is the LOSING half (H' summer +0.1002 at 4/4 eras vs\nwinter -0.1366 at 1/4). So volatility geometry does not explain the\nseasonal split, whatever does.\n\nThe winter identity check passed (winter trades bit-identical under both\nanchors), so the above is a real result and not a wiring bug.")
sydETAnchor = input.bool(false, "U) Anchor Sydney to 18:00 ET (fixes the winter halt)", group=G_ASIA, tooltip="MEASURED 2026-11-06 on 4.4yr of broker candles. Bars present per\ncalendar date, by US daylight time:\n\n  UTC hour      summer/day    winter/day\n  21:00            0.00          3.06      <- SHUT in summer\n  22:00            3.17          0.00      <- SHUT in WINTER\n  23:00            3.18          3.23\n\nThe broker halts 17:00-18:00 ET all year. That is 21:00-22:00 UTC in\nsummer and 22:00-23:00 UTC in winter. So U's fixed 22:00 UTC range is\nthe first half hour AFTER the reopen in summer and sits INSIDE THE HALT\nin winter. U has 437 summer trades and ZERO winter ones - it has been a\nsummer-only signal for its whole history.\n\nThis anchors the window to 18:00-18:30 ET instead: 22:00 UTC in summer\n(unchanged, bit-identical) and 23:00 UTC in winter (new).\n\nThe 222 winter trades it adds are the PROFITABLE half:\n  summer  437 trades  WR 74.60%  R/tr -0.0040\n  WINTER  222 trades  WR 76.58%  R/tr +0.0620   3/4 eras\nWhole book +3.2R -> +13.9R and maxDD FALLS 24.5 -> 20.1.\n\nChosen by the walk-forward in 3 of 3 folds.\n\nWARNING: if you also tick the prior-day band, note the band HURTS these\nnew winter trades (+0.0620 -> +0.0085) while helping summer\n(-0.0040 -> +0.0473). The band was fitted on summer-only U and winter is\nthe only fresh data it has ever seen.")
preOn0645   = input.bool(false, "M/G) Require agreement with the 06:45 UTC bar", group=G_STRAT, tooltip="MEASURED 2026-11-06 on 4.4yr of broker 15m, run INSIDE the engine.\n\nThe 06:45 UTC bar is the strongest single bucket in the Asian half of\nthe day: +0.923 bp mean drift at t=+3.00. This requires the breakout to\nagree with that bar's own direction. It closes at 07:00, before M's\nrange opens, so there is no lookahead.\n\n  M   675 -> 392 trades   -0.0068 -> +0.0557   eras 2/4 -> 4/4\n  G   563 -> 340 trades   +0.0071 -> +0.0549   eras 2/4 -> 3/4\nRandom-deletion null: M p=0.0060, G p=0.0393. Both SELECT.\n\nMORNING SIGNALS ONLY. On H (p=0.82), H' (p=0.95) and U (p=0.63) it is\ninside the null AND negative, so it is deliberately not wired to them.\nA prior from 06:45 helping 07:30 and 08:30 but not 14:30 is the\nphysically sensible shape.\n\nCOMPLEMENTARY to the Asian bias (G cascade), not a duplicate:\n  G cascade alone  +0.0281\n  06:45 prior alone +0.0549\n  both together     +0.0830   on 208 trades, 4/4 eras\n\nChosen by the walk-forward in 3 of 3 folds (as 'pre').")

orbPdBandOn = input.bool(false, "U) Require prior-day position in band", group=G_STRAT, tooltip="MEASURED 2026-11-05 on 4.4yr of broker 15m, run INSIDE the engine, not\nfiltered out of a finished trade list.\n\nU's trades bucketed by where the 22:00 close sits in YESTERDAY's range:\n  0.00-0.15   n=34   WR 73.5%   R/tr -0.0283\n  0.15-0.35   n=66   WR 74.2%   R/tr -0.0323\n  0.35-0.65   n=97   WR 74.2%   R/tr +0.0084\n  0.65-0.85   n=64   WR 81.3%   R/tr +0.0759\n  0.85-1.00   n=50   WR 68.0%   R/tr -0.1135\n  above yesterday's high   n=15   WR 46.7%   R/tr -0.2632\n\nBOTH blocked ends lose (low -0.1201 on 20 trades, high -0.1341 on 49),\nso this is genuinely two-sided and cfPdPos, which is monotone, could\nnever have found it.\n\nU at 0.15-0.85: 333 -> 235 trades, R/tr -0.0289 -> +0.0259, eras 1/4 ->\n3/4. WHOLE BOOK +3.2R -> +22.6R, maxDD 24.5 -> 22.3. It also beats\nswitching U off entirely, which gives +15.0R.\n\nWARNING - U ONLY. The same band costs the book -9.0R on M, -8.8R on G\nand -1.7R on H. Do not apply it to the other three.\n\nWARNING - walk-forward ADDS +0.0156 R/tr out of sample but t=+1.08,\nwhich is NOT significant, and this is the single survivor of roughly\n240 cells searched. A candidate for the Tester, not a finding.")
orbPdBandLo = input.float(0.15, "U) prior-day position LOW",  minval=0.0, maxval=1.0, step=0.05, group=G_STRAT, tooltip="Lower edge. 0.15 measured best for the book.\n0.00 keeps everything down to yesterday's low; the sub-0.15 bucket\nruns -0.0283 R/trade.")
orbPdBandHi = input.float(0.85, "U) prior-day position HIGH", minval=0.0, maxval=1.0, step=0.05, group=G_STRAT, tooltip="Upper edge. 0.85 measured best.\nThe 0.85-1.00 bucket runs -0.1135 and above yesterday's high runs\n-0.2632 at a 46.7% win rate - that tail is most of what this is for.")
_pdRangeU    = (not na(_pdHigh) and not na(_pdLow)) ? _pdHigh - _pdLow : 0.0
_pdPosU      = _pdRangeU > 0 ? (close - _pdLow) / _pdRangeU : -1.0
_orbPdBandOk = not orbPdBandOn or (_pdPosU >= orbPdBandLo and _pdPosU <= orbPdBandHi)

adrLoLON = input.float(0.00, "G) ADR band LOW",  minval=0.0, maxval=5.0, step=0.05, group=G_LON, tooltip="G gains most from the inversion and most consistently: +0.0469 -> +0.1165 R/tr, positive in 4 of 4 eras. Set 0.50 with the HIGH at 9.9.")
adrHiLON = input.float(0.90, "G) ADR band HIGH", minval=0.0, maxval=9.9, step=0.05, group=G_LON)

_orbGateOk  = (not orbADRGuard or (_adrConsumed[1] >= adrLoORB and _adrConsumed[1] < adrHiORB)) and _nfpOk and _orbPdBandOk   // U / V  (prior-day band appended 2026-11-05, inert while orbPdBandOn is false)
_orbGateFRB = (not frbADRGuard or (_adrConsumed[1] >= adrLoFRB and _adrConsumed[1] < adrHiFRB)) and _nfpOk   // M — ADR measured HARMFUL here
_orbGateNY  = (not nyADRGuard  or (_adrConsumed[1] >= adrLoNY  and _adrConsumed[1] < adrHiNY)) and _nfpOk   // H — ADR measured HELPFUL here
_hm_dow     = dayofweek(time, "UTC")
_hm_dow_ok  = not i_hm_useDow or (_hm_dow == dayofweek.monday and i_hm_dow_mon) or (_hm_dow == dayofweek.tuesday and i_hm_dow_tue) or (_hm_dow == dayofweek.wednesday and i_hm_dow_wed) or (_hm_dow == dayofweek.thursday and i_hm_dow_thu) or (_hm_dow == dayofweek.friday and i_hm_dow_fri)

// ─── SESSION GATES (UTC) ──────────────────────────────────────────────
in_asian   = timeframe.isintraday and (_minOfDay >= 0   and _minOfDay < 480)
in_london  = timeframe.isintraday and (_minOfDay >= 480 and _minOfDay < 660)
in_overlap = timeframe.isintraday and (_minOfDay >= 780 and _minOfDay < 1020)

// ─── ASIAN RANGE ──────────────────────────────────────────────────────
var float ar_hi    = na
var float ar_lo    = na

if _newDay
    ar_hi    := na
    ar_lo    := na

if in_asian
    ar_hi := na(ar_hi) ? high : math.max(ar_hi, high)
    ar_lo := na(ar_lo) ? low  : math.min(ar_lo, low)

// ─── POSITION BOX (same visual as indicator) ──────────────────────────
f_drawPosBox(float e, float slP, float tp3) =>
    if showBoxes
        r = bar_index + 40
        box.new(bar_index, math.max(e, tp3), r, math.min(e, tp3),
                border_color=color.new(color.teal, 50), bgcolor=color.new(color.teal, 88))
        box.new(bar_index, math.max(e, slP), r, math.min(e, slP),
                border_color=color.new(color.red, 55), bgcolor=color.new(color.red, 90))
        line.new(bar_index, e, r, e,
                 color=color.new(color.gray, 10), style=line.style_dashed, width=1)

// ─── EXIT LIMIT HELPER ────────────────────────────────────────────────
// BUG FIX: "Ratchet (no TP)" used to fall through this ternary's final `: tp2`,
// so every signal that is NOT M/H/U/V silently had its target DOUBLED from 1R
// to 2R the moment ratchet mode was selected. That is not a ratchet — it is a
// wider TP — and it drags the blended win rate down for no reason. Signals A-T
// have R-based targets, not ORB-range ones, so the ratchet cannot apply to
// them: hold them at their proven TP1 instead.
f_exitLim(float tp1, float tp2, float tp3) =>
    exitMode == "TP1 · 1R" ? tp1 : exitMode == "TP3 · 3R" ? tp3 : exitMode == "Live final-tp (BE cascade)" ? tp3 : exitMode == "Ratchet (no TP)" ? tp1 : tp2

// Shared C2 exit router — used by G, U and V. "Scale 30/75/150" needs the _mtp
// state machine wired per-signal, so those signals fall through to the
// single-target exit for it. Defined here (rather than beside U/V, where it
// used to live) because Signal G sits earlier in the file and Pine requires a
// function to be defined before every use.
f_c2Exit(string id, float slP, float tp1, float tp2, float tp3, float rng) =>
    if exitMode == "Trail after TP1"
        strategy.exit(id + "-X", from_entry=id, stop=slP, trail_price=tp1, trail_offset=math.round(rng / syminfo.mintick))
    else if exitMode == "Split TP1+TP2"
        strategy.exit(id + "-X1", from_entry=id, qty_percent=50, stop=slP, limit=tp1)
        strategy.exit(id + "-X2", from_entry=id, stop=slP, limit=tp2)
    else if exitMode == "Ratchet (no TP)"
        strategy.exit(id + "-X", from_entry=id, stop=slP)
    else
        strategy.exit(id + "-X", from_entry=id, stop=slP, limit=f_exitLim(tp1, tp2, tp3))

// ─── OPENING RANGE TRACKERS ───────────────────────────────────────────
// Frankfurt ORB: 07:00–07:30 UTC (pre-London institutional open)
in_frb_window  = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 450)
in_frb_trade   = timeframe.isintraday and (_minOfDay >= 450 and _minOfDay < 450 + frbTradeMins)
var float frb_op   = na   // ORB-window OPEN, for the counter-probe veto
var float lorb_op  = na
var float nyorb_op = na
var float syd_op   = na
var float frb_hi = na
var float frb_lo = na
var bool  frb_locked = false
var bool  frb_done   = false
var int   frb_tries    = 0
var bool  frb_short_today = false  // true if Frankfurt ORB fired SHORT today (used by Signal H)

// Pre-Frankfurt Asian range (00:00-07:00 UTC, before FRB window opens)
var float ar_lo_prefrb = na
var float ar_hi_prefrb = na

// Asian session direction (open vs close) for T-1 cascade filter
var float _asian_sess_open  = na
var float _asian_sess_close = na

// London ORB: 08:00–08:30 UTC (first 2 bars of London on 15M)
in_lorb_window = in_london and _minOfDay < 510
// G trade window: 08:30–11:00 UTC. Previously G was gated on `in_london` alone,
// which is the whole 08:00–11:00 session; lorb_locked made it behave as 08:30+
// anyway, but naming it explicitly lets the C2 limit expire at the window edge
// the way M's does, instead of resting against a dead level all day.
in_lorb_trade  = timeframe.isintraday and (_minOfDay >= 510 and _minOfDay < 510 + lonTradeMins)
var float lorb_hi = na
var float lorb_lo = na
var bool  lorb_locked = false
var bool  lorb_done   = false
var int   lorb_tries   = 0

// NY ORB: 14:00–14:30 UTC (first 2 bars of NY on 15M)
// nyETAnchor shifts the NY window one hour earlier in summer so it tracks
// 09:00-09:30 ET all year. MEASURED NEGATIVE - see the input tooltip.
_nyShift        = nyETAnchor and _isUsDst ? 60 : 0
in_nyorb_window = timeframe.isintraday and (_minOfDay + _nyShift >= 840 and _minOfDay + _nyShift < 870)
// EARLY/LATE split line: 14:30–16:00 UTC. A break landing inside this window
// belongs to H, a break landing after it belongs to H'. Disjoint by
// construction, so the two are independent signals over ONE shared opening
// range, never a filter on each other.
in_nyorb_trade  = timeframe.isintraday and (_minOfDay + _nyShift >= 870 and _minOfDay + _nyShift < nySplitMin)
// H-prime window. SEPARATE from H now, so the two may overlap.
in_nyorb_late   = timeframe.isintraday and (_minOfDay + _nyShift >= nyLateStart)
// MERGED NY WINDOW. nyOneSignal collapses H and H-prime into one
// signal over [nyLateStart, nyWinEnd); the pair toggles are then
// ignored. Off = the historical behaviour, bit for bit.
// The merged window is its OWN span, independent of H-prime's edge,
// so 'ONE NY signal' means the FULL session by default (870).
_nyOneOk   = timeframe.isintraday and (_minOfDay + _nyShift >= nyWinStart) and (_minOfDay + _nyShift < nyWinEnd)
_nyEligE   = nyOneSignal ? false : (in_nyorb_trade and modNYORB)
_nyEligL   = nyOneSignal ? _nyOneOk : (in_nyorb_late  and modNYORBP)
_hpAccOkL  = not hpAccelOn or in_nyorb_trade or (_acc2Raw >= hpAccelThr)
_hpAccOkS  = not hpAccelOn or in_nyorb_trade or (-_acc2Raw >= hpAccelThr)
// Optional NY limit expiry, independent of H'. When nyOrderMins is 0 this stays
// permanently TRUE, so the falling-edge cancel below can never fire and the
// baseline (cancel at the daily roll only) is reproduced exactly.
in_ny_orderlife = nyOrderMins <= 0 or (_minOfDay >= 870 and _minOfDay < 870 + nyOrderMins)

// ─── U/V: ASIAN SESSION ORBs (Sydney + Tokyo) ────────────────────────
// Same C2 architecture as M (Frankfurt) and H (NY): build a 30-min opening
// range at the session open, then take the first close outside it as a
// breakout and rest a limit back at the level.
//
// Window maths uses a wrap-safe helper because both sessions can straddle
// 00:00 UTC, where _minOfDay resets to 0 while the BROKER day (which drives
// the var resets below) rolls at 21:00/22:00 UTC instead.
// sydETAnchor shifts the window +60 min in winter so it tracks 18:00 ET and
// stops landing inside the broker's 17:00-18:00 ET halt. See the input tooltip.
_sydShift    = sydETAnchor ? (_usOff - 4) * 60 : 0
_sydOrbStart = sydOpenHr * 60 + _sydShift
_sydOrbEnd   = _sydOrbStart + sydOrbMins

f_inWin(int startMin, int endMin) =>
    s = startMin % 1440
    e = endMin % 1440
    timeframe.isintraday and (e > s ? (_minOfDay >= s and _minOfDay < e) : (_minOfDay >= s or _minOfDay < e))

// W - Shanghai. 01:00 sits AFTER the broker roll (21:00/22:00), so unlike U this
// window never straddles the day boundary and plain minute maths is safe here.
// The PRIOR session for a 01:00 open is Sydney: its open through to the SGE open.
// Wrap-safe, because it crosses midnight.

// --- the 06:45 UTC bar's own direction, held for the rest of the day ---
// 405 = 6*60+45. Captured on the CONFIRMED bar and read by M and G, whose
// ranges open at 07:00 and 08:00, so the value is always already closed.
var float _pre0645 = na
if _newDay
    _pre0645 := na
if _minOfDay == 405 and barstate.isconfirmed
    _pre0645 := close - close[1]
_preOkL = not preOn0645 or (not na(_pre0645) and _pre0645 > 0)
_preOkS = not preOn0645 or (not na(_pre0645) and _pre0645 < 0)

in_syd_window = f_inWin(_sydOrbStart, _sydOrbEnd)
in_syd_trade  = f_inWin(_sydOrbEnd,   _sydOrbEnd + sydTradeMins)

// Sydney extreme and direction feeding W. Reset on the rising edge of the POOL
// window, never on _newDay - the broker day turns over at 21:00/22:00, directly
// on top of where this starts accumulating.

var float syd_hi = na
var float syd_lo = na
var bool  syd_locked = false
var bool  syd_done   = false
var int   syd_tries    = 0
var float nyorb_hi = na
var float nyorb_lo = na
var bool  nyorb_locked = false
var bool  nyorb_done   = false
var int   nyorb_tries  = 0

// London extreme before NY ORB (08:00-14:00 UTC) — theorem London filter for Signal H
var float lon_hi_preny = na
var float lon_lo_preny = na

if _newDay
    frb_hi         := na
    frb_lo         := na
    frb_locked     := false
    frb_done       := false
    frb_tries    := 0
    frb_short_today := false
    ar_lo_prefrb   := na
    ar_hi_prefrb   := na
    _asian_sess_open  := na
    _asian_sess_close := na
    lorb_hi     := na
    lorb_lo     := na
    lorb_locked := false
    lorb_done   := false
    lorb_tries   := 0
    nyorb_hi     := na
    nyorb_lo     := na
    nyorb_locked := false
    nyorb_done   := false
    nyorb_tries  := 0
    lon_hi_preny := na
    lon_lo_preny := na
    syd_hi       := na
    syd_lo       := na
    syd_locked   := false
    syd_done     := false
    syd_tries    := 0

// Track Asian range BEFORE Frankfurt ORB window (strictly 00:00-07:00 UTC)
// Also capture first/last close for T-1 cascade direction
if _minOfDay >= 0 and _minOfDay < 420
    ar_lo_prefrb := na(ar_lo_prefrb) ? low  : math.min(ar_lo_prefrb, low)
    ar_hi_prefrb := na(ar_hi_prefrb) ? high : math.max(ar_hi_prefrb, high)
    if na(_asian_sess_open)
        _asian_sess_open := open
    _asian_sess_close := close

_asianBias = na(_asian_sess_open) or na(_asian_sess_close) ? 0 : _asian_sess_close > _asian_sess_open ? 1 : _asian_sess_close < _asian_sess_open ? -1 : 0

// --- SMC CONTEXT: structure, liquidity, FVG, AMD ---------------------
// All six families are computed here once, then read by the per-signal
// gates through f_smcOk(). Nothing here depends on an input being ON, so
// leaving every toggle off leaves the book byte-identical.

// 2. STRUCTURE: fractal pivots -> break of structure.
// ta.pivothigh(lb, lb) publishes a pivot lb bars AFTER it forms, so a BOS
// necessarily lags the pivot it broke. That is the live behaviour.
_smcPh = ta.pivothigh(smcPivLb, smcPivLb)
_smcPl = ta.pivotlow(smcPivLb, smcPivLb)
var float _smcLastPh = na
var float _smcLastPl = na
if not na(_smcPh)
    _smcLastPh := _smcPh
if not na(_smcPl)
    _smcLastPl := _smcPl
var int   _smcBos    = 0
var int   _smcBosBar = na
var float _smcLegLo  = na
var float _smcLegHi  = na
if not na(_smcLastPh) and close > _smcLastPh and _smcBos != 1
    _smcBos    := 1
    _smcBosBar := bar_index
    _smcLegLo  := na(_smcLastPl) ? low : _smcLastPl
    _smcLegHi  := high
else if not na(_smcLastPl) and close < _smcLastPl and _smcBos != -1
    _smcBos    := -1
    _smcBosBar := bar_index
    _smcLegHi  := na(_smcLastPh) ? high : _smcLastPh
    _smcLegLo  := low
else
    if _smcBos == 1 and (na(_smcLegHi) or high > _smcLegHi)
        _smcLegHi := high
    else if _smcBos == -1 and (na(_smcLegLo) or low < _smcLegLo)
        _smcLegLo := low
_smcBosAgeNow = na(_smcBosBar) ? 9999 : bar_index - _smcBosBar
_smcLegPos = (not na(_smcLegHi) and not na(_smcLegLo) and _smcLegHi > _smcLegLo) ? (close - _smcLegLo) / (_smcLegHi - _smcLegLo) : 0.5

// 3. DAILY LIQUIDITY: prior-day high / low taken today.
// _pdHigh and _pdLow come off the COMPLETED daily bar, so this is a
// same-day running flag with no lookahead. The _Was copies are what the
// gate reads, so the trigger bar own wick cannot self-satisfy the filter.
var bool _smcPdhT = false
var bool _smcPdlT = false
if _newDay
    _smcPdhT := false
    _smcPdlT := false
_smcPdhWas = _smcPdhT
_smcPdlWas = _smcPdlT
if not na(_pdHigh) and high >= _pdHigh
    _smcPdhT := true
if not na(_pdLow) and low <= _pdLow
    _smcPdlT := true

// 4. FVG: the most recent unfilled gap each way.
// A bullish FVG is the window between the high of bar [2] and the low of
// bar [0] when they do not overlap; bearish is the mirror. Only the most
// recent unfilled gap per direction is tracked, which covers all three
// modes and costs far less than an array of every gap.
var float _smcFvgUlo = na
var float _smcFvgUhi = na
var float _smcFvgDlo = na
var float _smcFvgDhi = na
var bool  _smcFvgFu  = false
var bool  _smcFvgFd  = false
if _newDay
    _smcFvgFu := false
    _smcFvgFd := false
_smcFvgInNow = 0
if not na(_smcFvgUlo) and low <= _smcFvgUhi and high >= _smcFvgUlo
    _smcFvgInNow := 1
if not na(_smcFvgDlo) and high >= _smcFvgDlo and low <= _smcFvgDhi
    _smcFvgInNow := -1
if not na(_smcFvgUlo) and low <= _smcFvgUlo
    _smcFvgFu  := true
    _smcFvgUlo := na
    _smcFvgUhi := na
if not na(_smcFvgDhi) and high >= _smcFvgDhi
    _smcFvgFd  := true
    _smcFvgDlo := na
    _smcFvgDhi := na
if low > high[2]
    _smcFvgUlo := high[2]
    _smcFvgUhi := low
else if high < low[2]
    _smcFvgDhi := low[2]
    _smcFvgDlo := high

// 1 + 5. AMD: accumulation quality and manipulation side.
// ** The BROKER DAY rolls at 22:00-23:00 UTC, so the U bars at 22:30 sit
// in a new day whose Asian window has not happened, and about 20% of H
// days start the same way. Without this carry-forward an accumulation or
// manipulation filter would BLOCK 100% of U and 20% of H whatever the
// setting. The carried range is strictly in the past, so still causal.
var float _smcAcH   = na
var float _smcAcL   = na
var int   _smcAcDay = na
var int   _smcManip = 0
var int   _smcDayN  = 0
if _newDay
    _smcDayN := _smcDayN + 1
if not na(ar_hi_prefrb) and not na(ar_lo_prefrb) and _minOfDay >= 420 and _smcAcDay != _smcDayN
    _smcAcH   := ar_hi_prefrb
    _smcAcL   := ar_lo_prefrb
    _smcAcDay := _smcDayN
    _smcManip := 0
_smcAccQ = (not na(_smcAcH) and not na(_smcAcL) and _atr14d > 0) ? (_smcAcH - _smcAcL) / _atr14d : 9.9
_smcManipWas = _smcManip
if not na(_smcAcH) and not na(_smcAcL)
    if high > _smcAcH
        _smcManip := (_smcManip == -1 or _smcManip == 2) ? 2 : 1
    if low < _smcAcL
        _smcManip := (_smcManip == 1 or _smcManip == 2) ? 2 : -1

// --- the single gate every signal calls -----------------------------
// _d is +1 long / -1 short. _accMin is that signal own minimum, 0 = off.
// --- SPLIT 2026-11-10, FOR THE TOKEN CEILING -----------------------
// f_smcOk was called at EIGHT sites and inlined whole at each. But the
// five family VERDICTS depend only on the DIRECTION; what varies per
// signal is merely WHETHER a family applies (str.contains on the
// per-signal letters) and that signal's own accMin.
//
// So the verdicts are computed once per direction here and the body below
// collapses to five applicability tests plus the two accumulation
// thresholds. Identical answer, a fraction of the tokens.
//
// EVERY VALUE READ HERE IS ALREADY FINAL for the bar: _smcBos,
// _smcLegPos, _smcBosAgeNow, _smcFvgInNow, _smcAccQ and the _Was copies
// are all assigned above this line, and the _Was copies exist precisely
// so the trigger bar cannot self-satisfy its own filter.
f_smcFam(int _d) =>
    bool _b = true
    if smcBosMode != "off"
        if _smcBos == 0
            _b := false
        else if smcBosMode == "agree" and _smcBos != _d
            _b := false
        else if smcBosMode == "oppose" and _smcBos == _d
            _b := false
        if _b and smcBosAge > 0 and _smcBosAgeNow > smcBosAge
            _b := false
    bool _r = true
    if smcRetrOn
        float _lp = _d > 0 ? _smcLegPos : 1.0 - _smcLegPos
        _r := _lp >= smcRetrLo and _lp <= smcRetrHi
    bool _l = true
    if smcLiqMode == "any"
        _l := _smcPdhWas or _smcPdlWas
    else if smcLiqMode == "opposite"
        _l := _d > 0 ? _smcPdlWas : _smcPdhWas
    else if smcLiqMode == "same"
        _l := _d > 0 ? _smcPdhWas : _smcPdlWas
    bool _f = true
    if smcFvgMode == "filled today"
        _f := _smcFvgFu or _smcFvgFd
    else if smcFvgMode == "directional fill"
        _f := _d > 0 ? _smcFvgFu : _smcFvgFd
    else if smcFvgMode == "inside unfilled"
        _f := _smcFvgInNow == _d
    bool _a = true
    if smcAmdMode == "present"
        _a := _smcManipWas != 0
    else if smcAmdMode == "opposite"
        _a := _d > 0 ? (_smcManipWas == -1 or _smcManipWas == 2) : (_smcManipWas == 1 or _smcManipWas == 2)
    else if smcAmdMode == "same"
        _a := _d > 0 ? (_smcManipWas == 1 or _smcManipWas == 2) : (_smcManipWas == -1 or _smcManipWas == 2)
    [_b, _r, _l, _f, _a]

[_smBosL, _smRetL, _smLiqL, _smFvgL, _smAmdL] = f_smcFam(1)
[_smBosS, _smRetS, _smLiqS, _smFvgS, _smAmdS] = f_smcFam(-1)

f_smcOk(int _d, float _accMin, string _sid) =>
    bool _ok = true
    if smcBosMode != "off" and str.contains(_sgBos, _sid)
        _ok := _d > 0 ? _smBosL : _smBosS
    if _ok and smcRetrOn and str.contains(_sgRetr, _sid)
        _ok := _d > 0 ? _smRetL : _smRetS
    if _ok and smcLiqMode != "off" and str.contains(_sgLiq, _sid)
        _ok := _d > 0 ? _smLiqL : _smLiqS
    if _ok and smcFvgMode != "off" and str.contains(_sgFvg, _sid)
        _ok := _d > 0 ? _smFvgL : _smFvgS
    if _ok and smcAmdMode != "off" and str.contains(_sgAmd, _sid)
        _ok := _d > 0 ? _smAmdL : _smAmdS
    if _ok and _accMin > 0.0 and not (_smcAccQ >= _accMin and _smcAccQ < 9.0)
        _ok := false
    if _ok and smcAccMax > 0.0 and _smcAccQ > smcAccMax
        _ok := false
    _ok
// --- end SMC CONTEXT ---


if in_frb_window
    frb_hi := na(frb_hi) ? high : math.max(frb_hi, high)
    frb_lo := na(frb_lo) ? low  : math.min(frb_lo, low)

frb_op := in_frb_window and not in_frb_window[1] ? open : frb_op

if not in_frb_window and in_frb_window[1] and not na(frb_hi)
    frb_locked := true

if in_lorb_window
    lorb_hi := na(lorb_hi) ? high : math.max(lorb_hi, high)
    lorb_lo := na(lorb_lo) ? low  : math.min(lorb_lo, low)

lorb_op := in_lorb_window and not in_lorb_window[1] ? open : lorb_op

if not in_lorb_window and in_lorb_window[1] and not na(lorb_hi)
    lorb_locked := true

if in_nyorb_window
    nyorb_hi := na(nyorb_hi) ? high : math.max(nyorb_hi, high)
    nyorb_lo := na(nyorb_lo) ? low  : math.min(nyorb_lo, low)

nyorb_op := in_nyorb_window and not in_nyorb_window[1] ? open : nyorb_op

if not in_nyorb_window and in_nyorb_window[1] and not na(nyorb_hi)
    nyorb_locked := true

// London + Overlap extreme accumulated BEFORE the NYORB window (08:00-14:00 UTC)
if _minOfDay >= 480 and _minOfDay < 840
    lon_hi_preny := na(lon_hi_preny) ? high : math.max(lon_hi_preny, high)
    lon_lo_preny := na(lon_lo_preny) ? low  : math.min(lon_lo_preny, low)

// U/V range building + lock, mirroring the FRB/NYORB trackers
if in_syd_window
    syd_hi := na(syd_hi) ? high : math.max(syd_hi, high)
    syd_lo := na(syd_lo) ? low  : math.min(syd_lo, low)
syd_op := in_syd_window and not in_syd_window[1] ? open : syd_op

if not in_syd_window and in_syd_window[1] and not na(syd_hi)
    syd_locked := true

// ═══════════════════════════════════════════════════════════════════════
// LIQUIDITY-GRAB TRACKING  (Signals M / H / U)
// ─────────────────────────────────────────────────────────────────────
// Gold's most-cited intraday behaviour is the stop run: price pushes through
// a pool of resting orders, fails to hold, and reverses hard the other way.
// A breakout that fires AFTER the opposite side has been swept is a different
// animal from one that fires cold — the fuel (trapped traders on the wrong
// side, plus the liquidity their stops just provided) is already in place.
//
// Two pools tracked per session, from that session's ORB window open onward:
//
//   OWN ORB OPPOSITE — price traded beyond the far side of this session's own
//     opening range before breaking the near side. The classic ORB fakeout.
//
//   PRIOR SESSION POOL — price traded beyond the previous session's extreme:
//     M (Frankfurt) sweeps the ASIAN range   00:00-07:00
//     H (NY)        sweeps the LONDON range  08:00-14:00
//     U (Sydney)    sweeps the NY range      14:00 -> Sydney open
//
// A LONG break wants the DOWNSIDE pool swept first, and vice versa.
//
// NOT applied to V (Tokyo): the request was NY / Frankfurt / Sydney, and
// leaving V untouched keeps it identical in both arms. That matters here —
// this harness is path-dependent (see c2MinBreakStr), so anything that is not
// held fixed between runs contaminates the comparison.
//
// Distinct from orbBreakAsianHi/Lo, which require the break to CLOSE BEYOND
// the prior extreme. That is expansion. This is sweep-and-reclaim — the
// opposite shape, and never tested before.
//
// Every reset rides the rising edge of the session's OWN window, never
// _newDay: the broker day rolls at 21:00/22:00 UTC, directly on top of both
// the Sydney open and the NY pool window.
// ═══════════════════════════════════════════════════════════════════════

// ─── PREVIOUS LONDON / NY SESSIONS, LATCHED  (feeds Signal W) ────────
// Why this cannot reuse lon_hi_preny: that one is wiped on _newDay, and the
// broker day rolls at 21:00/22:00 UTC - AFTER London and NY have both finished
// but BEFORE W fires at 01:00. By the time W looks, the old values are na.
//
// So each session accumulates into a _Cur pair, and on the FALLING EDGE of the
// session the finished values are latched into a _Prev pair that nothing ever
// resets. At 01:00 those hold yesterday's completed sessions, which is exactly
// what W needs. The same latch carries the session's DIRECTION for the cascades.
in_ny_sess  = timeframe.isintraday and (_minOfDay >= 840 and _minOfDay < 1260)

var float _nyHiCur = na
var float _nyLoCur = na
var float _nyOpCur = na
var float _nyClCur = na
var int   _nyBiasPrev = 0
if in_ny_sess and not in_ny_sess[1]
    _nyHiCur := na
    _nyLoCur := na
    _nyOpCur := na
    _nyClCur := na
if in_ny_sess
    _nyHiCur := na(_nyHiCur) ? high : math.max(_nyHiCur, high)
    _nyLoCur := na(_nyLoCur) ? low  : math.min(_nyLoCur, low)
    if na(_nyOpCur)
        _nyOpCur := open
    _nyClCur := close
if not in_ny_sess and in_ny_sess[1] and not na(_nyHiCur)
    _nyBiasPrev := _nyClCur > _nyOpCur ? 1 : _nyClCur < _nyOpCur ? -1 : 0

// NY session extreme feeding Signal U. Ends where the Sydney ORB begins.
in_ny_pool = f_inWin(840, _sydOrbStart)
var float ny_hi_presyd = na
var float ny_lo_presyd = na
if in_ny_pool and not in_ny_pool[1]
    ny_hi_presyd := na
    ny_lo_presyd := na
if in_ny_pool
    ny_hi_presyd := na(ny_hi_presyd) ? high : math.max(ny_hi_presyd, high)
    ny_lo_presyd := na(ny_lo_presyd) ? low  : math.min(ny_lo_presyd, low)

var bool frb_sw_lo   = false
var bool frb_sw_hi   = false
var bool frb_pool_lo = false
var bool frb_pool_hi = false
var bool nyo_sw_lo   = false
var bool nyo_sw_hi   = false
var bool nyo_pool_lo = false
var bool nyo_pool_hi = false
var bool syd_sw_lo   = false
var bool syd_sw_hi   = false
var bool syd_pool_lo = false
var bool syd_pool_hi = false

// M — Frankfurt. Own range can only be pierced after it locks at 07:30; the
// Asian pool can be pierced from 07:00 onward, so both start at the window open.
if in_frb_window and not in_frb_window[1]
    frb_sw_lo   := false
    frb_sw_hi   := false
    frb_pool_lo := false
    frb_pool_hi := false
if in_frb_window or in_frb_trade
    if frb_locked and not na(frb_lo) and low < frb_lo
        frb_sw_lo := true
    if frb_locked and not na(frb_hi) and high > frb_hi
        frb_sw_hi := true
    if not na(ar_lo_prefrb) and low < ar_lo_prefrb
        frb_pool_lo := true
    if not na(ar_hi_prefrb) and high > ar_hi_prefrb
        frb_pool_hi := true

// H — NY. Signal H carries no explicit trade-window gate (it may fire any time
// after the 14:30 lock), so track from 14:00 to the end of the session day.
if in_nyorb_window and not in_nyorb_window[1]
    nyo_sw_lo   := false
    nyo_sw_hi   := false
    nyo_pool_lo := false
    nyo_pool_hi := false
if timeframe.isintraday and _minOfDay >= 840
    if nyorb_locked and not na(nyorb_lo) and low < nyorb_lo
        nyo_sw_lo := true
    if nyorb_locked and not na(nyorb_hi) and high > nyorb_hi
        nyo_sw_hi := true
    if not na(lon_lo_preny) and low < lon_lo_preny
        nyo_pool_lo := true
    if not na(lon_hi_preny) and high > lon_hi_preny
        nyo_pool_hi := true

// U — Sydney.
if in_syd_window and not in_syd_window[1]
    syd_sw_lo   := false
    syd_sw_hi   := false
    syd_pool_lo := false
    syd_pool_hi := false
if in_syd_window or in_syd_trade
    if syd_locked and not na(syd_lo) and low < syd_lo
        syd_sw_lo := true
    if syd_locked and not na(syd_hi) and high > syd_hi
        syd_sw_hi := true
    if not na(ny_lo_presyd) and low < ny_lo_presyd
        syd_pool_lo := true
    if not na(ny_hi_presyd) and high > ny_hi_presyd
        syd_pool_hi := true

// V — Tokyo. Tracked for CLASSIFICATION ONLY: the A+ table has to be able to
// label every ORB trade in the baseline, and V is part of that baseline. The
// f_liqOk gates below are deliberately NOT extended to V, so turning the
// filter on still changes exactly the same three signals the two test runs
// used. Pool = the Sydney session, i.e. Sydney open -> Tokyo open.

// ═══════════════════════════════════════════════════════════════════════
// ZONE MAP — the levels price has actually DEFENDED, scored
// ═══════════════════════════════════════════════════════════════════════
// A zone is a price the market has turned at more than once. The map keeps
// one entry per zone with a touch COUNT, so a level defended 33 times
// outranks one wicked through on a Tuesday. Capped and pruned, because an
// unbounded array over three years hits Pine's object ceiling.
//
// Sources are the ones this file already tracks, plus swing pivots and the
// round-$10 grid. Nothing new is requested from the server.
//
// ★ FIVE ZONE IDEAS ARE ALREADY DEAD, and they all asked the same question.
// FVG as the entry location (1.03 against a 4.73 control), FVG as the stop
// (WR 5.2% — the median gap is 2.39 pts), the opposing-FVG exit (converges
// to doing nothing), the AOI exit (1.67), AOI as a quality filter (flat).
// Every one of them asked WHERE AM I.
//
// ★★ THE QUESTION NOBODY ASKED IS WHAT IS IN MY WAY. On 21 Oct 2026 the
// London ORB broke down at 4114.86 with its target at 4101.30 — and
// 4112-4116 had been defended 33 times in the previous 48 hours. The path
// was blocked. Every filter in this file looks BEHIND the break (did it
// clear the level it came from); none looks AHEAD.




// ─── LIQUIDITY TARGET RESOLVER ───────────────────────────
// Returns the FIRST-RUNG DISTANCE in points, measured from the structural
// level. Every caller then builds tp_n = level + dir * dist * n, so the ladder
// keeps its shape and nothing else in the file has to change.
//
// Returns the plain range multiple whenever the feature is off or no pool
// qualifies, so a signal can never be left without a target.
//
// NO LOOKAHEAD: _pdHigh/_pdLow read the COMPLETED daily bar via [1], and every
// session extreme used here is a latched PREVIOUS session.
// ---- HOUR-MATCHED SESSION SIGMA -----------------------------------------
// sigma for a signal = the mean of its OWN last osigLook opening ranges.
// Each signal fires at exactly one clock hour, so this is hour-matched by
// construction. That is the point: a rolling ATR read at 07:00 UTC is fed by
// 04:00-06:00 UTC, the deadest hours of the day, so it is systematically too
// tight for the expansion it is meant to size.
//
// DECLARED HERE, ABOVE f_tpDist, because Pine needs the declaration before
// the use and f_tpDist reads these. The pushes sit in the same block: every
// flag and locked extreme they need exists by line ~889, and a push only
// fires on the window-END bar, when no new signal can be placed - so a
// session can never target its own trade off its own range.
var float[] _osM = array.new_float()
var float[] _osG = array.new_float()
var float[] _osH = array.new_float()
var float[] _osU = array.new_float()

f_osPush(float[] a, float v) =>
    if not na(v) and v > 0
        array.push(a, v)
        if array.size(a) > osigLook
            array.shift(a)

f_osAvg(float[] a, float fb) =>
    array.size(a) > 0 ? array.avg(a) : fb

if not in_frb_trade and in_frb_trade[1]
    f_osPush(_osM, frb_hi - frb_lo)
if not in_lorb_trade and in_lorb_trade[1]
    f_osPush(_osG, lorb_hi - lorb_lo)
if not in_nyorb_trade and in_nyorb_trade[1]
    f_osPush(_osH, nyorb_hi - nyorb_lo)
if not in_syd_trade and in_syd_trade[1]
    f_osPush(_osU, syd_hi - syd_lo)

// HOISTED ON PURPOSE. f_tpDist is called at EIGHT sites and Pine inlines a
// function at every call site, so resolving these four means INSIDE it would
// pay for f_osAvg 32 times. Computed once per bar here, f_tpDist only selects
// between four plain variables. na until a signal has banked one session.
_osvM = f_osAvg(_osM, na)
_osvG = f_osAvg(_osG, na)
_osvH = f_osAvg(_osH, na)
_osvU = f_osAvg(_osU, na)

f_tpDist(int d, float lvl, float px, float rng, string sg) =>
    // TP1 UNIT. "x ORB range" is the original expression, untouched.
    // The other two measure FROM THE ENTRY, so the rng * c2RetestDepth term
    // converts to the distance-from-LEVEL that every caller expects when it
    // builds tp_n = lvl + d * dist * n.
    //
    // THE LIQUIDITY-POOL HALF IS GONE (2026-11-10). It was re-tested on
    // 2026-11-04 and came back NEGATIVE on every pool set, and it was being
    // inlined at all EIGHT call sites. d, lvl and px are unused; sg
    // SELECTS THE SIGNAL'S SIGMA as of 2026-11-11, so it is live again.
    _osig = nz(sg == "M" ? _osvM : sg == "G" ? _osvG : sg == "H" ? _osvH : _osvU, rng)
    // "No target" returns a distance nothing can reach, so the trade leaves
    // only on the stop or the clock. The order stays in place rather than
    // being removed, so the eight call sites and the rung arithmetic are
    // untouched. ** SET orbHoldBars (preferred) OR clkExitOn, or the
    // position has no way out but the stop.
    orbTPMode == "No target" ? 100000.0
      : orbTPMode == "x session sigma" ? rng * c2RetestDepth + orbTPOsig * _osig
      : orbTPMode == "x ATR" ? rng * c2RetestDepth + orbTPAtrMult * atrVal
      : orbTPMode == "Absolute points" ? rng * c2RetestDepth + orbTPAbs
      : rng * orbTPMult

// Pure resolver — reads the mode, assigns nothing, so it is safe as a function.
f_liqOk(bool ownSw, bool poolSw) =>
    c2LiqGrab == "Off" ? true : c2LiqGrab == "Sweep own ORB opposite" ? ownSw : c2LiqGrab == "Sweep prior session pool" ? poolSw : (ownSw or poolSw)

// ─── RATCHET (NO TP) — unlimited runner, stop-only exit ──────────────
// No take-profit order at all. The position closes ONLY when the ratcheting
// stop is hit, so a trade that keeps going keeps going — 10R, 20R, no cap.
//
// Rungs are spaced in ORB-RANGE units, NOT R. R here is the 150-pt stop while
// the ORB range is ~24 pts, so an R-spaced ladder would put its first rung
// ~112 pts away — 1.5-3 daily ranges — and would essentially never arm. Range
// units put rung 1 at ~18 pts, where price actually trades.
//
//   reach r (>= trailArm) -> stop to (r * trailKeep) x step beyond the level
//   giveback is always (1 - trailKeep) of the furthest excursion, so the stop
//   locks PROFIT and never returns to entry. Unbounded above.
//
// step = orb_range * orbTPMult, i.e. the same spacing as tp1/tp2/tp3.
//
// TIMING CAVEAT — this is why the ratchet cannot hold the TP1 win rate.
// Under "TP1 · 1R" the exit is a LIMIT order, which TradingView fills the
// instant the bar's high touches it, INTRABAR. The trail below recalculates
// only at bar close and the new stop is live from the NEXT bar. So a 15m bar
// that spikes past the arm level and closes back below is a WIN under TP1 and
// can still be a full LOSS here. With step ~18 pts, a single gold 15m bar
// routinely covers the whole distance. That gap is real trading behaviour,
// not a modelling artifact — it is the price of removing the take-profit.

// ─── C2 PENDING-ORDER EXPIRY ─────────────────────────────────────────
// A strategy.entry limit stays live until it fills or is cancelled, and none
// of the C2 limits were ever cancelled. An FRB-S limit armed on Monday could
// therefore still fill on Thursday against Monday's ORB level. In Ratchet mode
// that is worse than a stale entry: _rt_lvl would be days old, so `reach`
// comes out enormous and the trail slams the stop far past current price.
// Bound every C2 limit to its own session.
if not in_frb_trade and in_frb_trade[1]
    strategy.cancel("FRB-L")
    strategy.cancel("FRB-S")
// G in C2 mode rests a limit, so it needs the same expiry M has — otherwise an
// ORB-L armed at 10:55 still fills at 19:00 against a level that stopped being
// the London opening range hours earlier.
if not in_lorb_trade and in_lorb_trade[1]
    strategy.cancel("ORB-L")
    strategy.cancel("ORB-S")
if not in_syd_trade and in_syd_trade[1]
    strategy.cancel("SYD-L")
    strategy.cancel("SYD-S")
if _newDay
    strategy.cancel("NYORB-L")
    strategy.cancel("NYORB-S")
// The old H'-only 16:00 cancel is GONE. H' is now the LATE signal and arms
// AFTER 16:00, so cancelling there would kill it the moment it exists. Set
// nyOrderMins = 90 (14:30 + 90 = 16:00) to reproduce the old expiry exactly.
//
// NY limit expiry (nyOrderMins > 0). Bounds how long an already-armed LIMIT may
// rest; it never blocks a SIGNAL. Kept separate from the H/H' split so the
// resting-order question and the early/late question stay testable apart.
if not in_ny_orderlife and in_ny_orderlife[1]
    strategy.cancel("NYORB-L")
    strategy.cancel("NYORB-S")

// Clock exit: flatten and clear the book at the configured UTC minute. Placed
// with the other time-bounding logic, before the ratchet state machine, so a
// flattened trade frees its slot on the same pass the cancels run.
if clkExitOn and timeframe.isintraday and _minOfDay >= clkExitMin and _minOfDay < clkExitMin + 15
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment="clock exit " + str.tostring(clkExitMin))

// HOLD CAP FROM ENTRY. Measured in bars since the fill, so every signal gets
// the SAME hold - which the wall clock above does not do. Reads opentrades
// rather than a tracked var, so a stop or a manual close cannot leave the
// counter armed against a position that no longer exists.
if orbHoldBars > 0 and strategy.opentrades > 0
    if bar_index - strategy.opentrades.entry_bar_index(0) >= orbHoldBars
        strategy.cancel_all()
        strategy.close_all(comment="hold cap " + str.tostring(orbHoldBars))

var float  _rt_lvl   = na     // ORB structural level the rungs measure from
var float  _rt_entry = na     // actual fill reference (level +/- _c2Depth)
var float  _rt_rng   = na     // ORB range captured at signal time
var int    _rt_dir   = 0      // +1 long, -1 short, 0 idle
var string _rt_id    = na     // entry order id
var float  _rt_sl    = na     // current stop
var float  _rt_sl0   = na     // INITIAL stop, kept for the stop-buffer calc
var float  _rt_reach = 0.0    // furthest excursion reached, in step units
var float  _os_best = na     // best CLOSE since entry (one-shot arm test)
var bool   _os_fired = false // the latch - the stop moves ONCE and never again
var bool   _os_s1 = false    // stage-1 latch, separate from stage 2
var float  _os_q0 = na      // position size at the fill, for the partial
var bool   _os_pdone = false // true once the banked leg has filled

// TWO MODES SHARE THIS STATE MACHINE. Both need the same facts captured at
// entry (level, range, direction, id, initial stop) and both move the stop
// from the favourable high-water mark; they differ ONLY in where the stop
// goes and whether a take-profit is parked. Sharing the registration means
// the ten entry sites stay identical between them, so an A/B between the
// two cannot be contaminated by a difference in how the trade was recorded.
_rtMode     = exitMode == "Ratchet (no TP)"
_fcMode     = exitMode == "Live final-tp (BE cascade)"
// ONE-SHOT joins the SHARED registration deliberately: all ten entry sites
// already set _rt_lvl/_rt_entry/_rt_rng/_rt_dir/_rt_id/_rt_sl whenever
// _useRtState is true, so this reaches every signal with NO entry-site edits
// and no chance of one drifting out of sync. Token ceiling: this file has
// hit 100,256 once already, so a new mode must not cost ten edits.
_osMode     = exitMode == "One-shot (arm + lock)"
_useRtState = _rtMode or _fcMode or _osMode

if _useRtState and _rt_dir != 0 and not na(_rt_lvl) and strategy.position_size != 0
    step = _rt_rng * orbTPMult
    if step > 0
        // Excursion beyond the ORB level, in step units (1.0 = one TP step).
        reach = _rt_dir == 1 ? (high - _rt_lvl) / step : (_rt_lvl - low) / step
        if reach > _rt_reach
            _rt_reach := reach
        // CANDIDATE STOP - the ONLY place the two modes diverge.
        float cand = na
        // ---- ONE-SHOT. Arms on the best CLOSE, not the high: a stop moved
        // on an intrabar extreme would need the Tester to guess whether the
        // high or the low came first, which is the whole reason this mode
        // exists instead of a trail. Fires once, then _os_fired blocks it
        // forever, so the stop is static for the rest of the hold.
        //
        // ** NEEDS A TIME EXIT. With no target and a frozen stop a runaway
        // winner has no way out - measured, under 60 of ~450 trades ever
        // closed without one. Set orbHoldBars (480 = 5 days) or clkExitOn.
        if _osMode
            _osv = nz(str.contains(_rt_id, "NYORB") ? _osvH : str.contains(_rt_id, "FRB") ? _osvM : str.contains(_rt_id, "SYD") ? _osvU : _osvG, _rt_rng)
            _os_best := na(_os_best) ? close : (_rt_dir == 1 ? math.max(_os_best, close) : math.min(_os_best, close))
            _osExc = (_os_best - _rt_entry) * _rt_dir
            // STAGE 1 - the DOWNWARD move. Fires first and at a shorter
            // distance, so a trade that performed a little and then died
            // costs a PARTIAL loss instead of the full stop. Measured: the
            // average loss falls 37% in points with the average WIN
            // unchanged, because this only ever fires on a trade that has
            // already proved something.
            if osS1Arm > 0 and not _os_s1 and _osv > 0 and _osExc >= osS1Arm * _osv
                _os_s1 := true
                cand := _rt_entry - _rt_dir * osS1Keep * math.abs(_rt_entry - _rt_sl0)
            // STAGE 2 - the profit lock. Assigned AFTER stage 1 so that if
            // both clear on the same bar the profit lock wins, which is the
            // better of the two stops by construction.
            if not _os_fired and _osv > 0 and _osExc >= osArm * _osv
                _os_fired := true
                cand := _rt_entry + _rt_dir * (osArm - osGive) * _osv
        if _rtMode and _rt_reach >= trailArm
            // Stop sits at a FRACTION of the furthest excursion, so it locks
            // PROFIT rather than returning to entry: reach 0.75 with keep 0.75
            // locks 0.5625. Never gives back more than (1 - trailKeep).
            cand := _rt_lvl + _rt_dir * (_rt_reach * trailKeep) * step
        if _fcMode
            // LIVE BE CASCADE - the mirror of the specialist branch in
            // manage-trades.js:
            //     TP1 touched (reach >= 1) -> stop to the ENTRY (breakeven)
            //     TP2 touched (reach >= 2) -> stop to TP1
            // Read off _rt_reach, the favourable HIGH-WATER mark, because live
            // detects a TP touch from the extreme since open and never from the
            // last price: a spike that tags TP1 and retraces still locks BE.
            // Generalised cascade: clearing the ARM rung moves the stop to
            // the entry, and each rung above it moves the stop one rung
            // further down the ladder. _beArm 99 = never, i.e. BE off.
            _bRg = math.min(math.floor(_rt_reach), 3)
            cand := _bRg > _beArm ? _rt_lvl + _rt_dir * step * (_bRg - _beArm) : _bRg >= _beArm ? _rt_entry : na
        if not na(cand)
            // FIDELITY FIX 2026-09-23. manage-trades.js applies TWO tests, not
            // one: the stop must improve AND it must still sit a buffer away
            // from current price -
            //   valid = isLong ? slTarget <= price - buf : slTarget >= price + buf
            // Pine only had the improve test, so it would happily place a stop
            // the bar has ALREADY passed. That fills instantly, which made the
            // backtested ratchet exit EARLIER than the live one and would have
            // biased this whole sweep against the ratchet.
            //
            // buf there is min(max(R x 0.25, pipSize x 2), pipSize x 8). Gold's
            // pipSize is 0.1, so the x8 cap binds at 0.8 points for any real
            // stop. Computed the same way here rather than hardcoded, so the
            // formula stays honest if the stop ever gets small.
            _rtR   = math.abs(_rt_entry - _rt_sl0)
            _rtBuf = math.min(math.max(_rtR * 0.25, 0.2), 0.8)
            valid  = _rt_dir == 1 ? cand <= close - _rtBuf : cand >= close + _rtBuf
            better = _rt_dir == 1 ? cand > _rt_sl : cand < _rt_sl
            if valid and better
                _rt_sl := cand
        if _rtMode or _osMode
            // THE PARTIAL. "-XP" banks osPartPct at the original Pine TP1
            // while "-X" carries the remainder on the ratcheting stop. The
            // latch stops -XP being re-armed once it has filled: without it,
            // re-issuing qty_percent every bar would bank a fraction of the
            // already-reduced position over and over.
            if _osMode and osPartPct > 0
                if na(_os_q0) and strategy.position_size != 0
                    _os_q0 := math.abs(strategy.position_size)
                if not _os_pdone and not na(_os_q0) and math.abs(strategy.position_size) < _os_q0 * 0.95
                    _os_pdone := true
                if not _os_pdone
                    strategy.exit(_rt_id + "-XP", from_entry=_rt_id, qty_percent=math.round(osPartPct * 100), stop=_rt_sl, limit=_rt_lvl + _rt_dir * _rt_rng * osPartMult)
            // stop only — no limit arg means no take-profit on the remainder
            strategy.exit(_rt_id + "-X", from_entry=_rt_id, stop=_rt_sl)
        else
            // The FULL position rides to TP3 — where the live broker TP is
            // parked in final-tp mode — with the cascaded stop underneath it.
            //
            // TP3 is DERIVED, not stored: lvl + dir x step x 3 reproduces each
            // entry site's own tp3 exactly while _c2Depth is 0, which it is in
            // every config run so far. If partial-retest depth is ever raised
            // AND a reverse toggle is on, store tp3 at registration instead.
            strategy.exit(_rt_id + "-X", from_entry=_rt_id, stop=_rt_sl, limit=_rt_lvl + _rt_dir * step * 3.0)

// Clear ratchet state only on an ACTUAL close (was in a position, now flat).
// Testing position_size == 0 alone would wipe the state of a C2 limit that is
// armed but not yet filled — every retest entry sits flat before it fills.
var float _rt_prevSize = 0.0
if strategy.position_size == 0 and _rt_prevSize != 0
    _rt_dir  := 0
    _rt_reach := 0.0
    _os_best := na
    _os_fired := false
    _os_s1 := false
    _os_q0 := na
    _os_pdone := false
    _rt_lvl  := na
    _rt_sl   := na
    _rt_sl0  := na
_rt_prevSize := strategy.position_size

// ─── SCALE 30/75/150 — BE STOP MANAGEMENT ────────────────────────────
// Tracks open multi-TP positions (H/M only). When TP1 fires (position
// shrinks by ≥15%), cancels original X2/X3 and re-issues them with
// stop=entry (breakeven), preventing a TP1 winner from turning into a loss.
var float  _mtp_px   = na      // entry price stored at trade open
var float  _mtp_tp2  = na      // TP2 level stored at trade open
var float  _mtp_run  = na      // runner level stored at trade open
var string _mtp_id   = na      // entry order ID ("FRB-S", "NYORB-L", etc.)
var bool   _mtp_be   = false   // true once BE stop has been re-issued
var float  _mtp_prev = 0.0     // position size at end of previous bar

_mtp_cur = strategy.position_size
if not na(_mtp_id) and _mtp_cur != 0 and not _mtp_be
    if math.abs(_mtp_cur) < math.abs(_mtp_prev) * 0.85  // TP1 fired
        _mtp_be := true
        strategy.cancel(_mtp_id + "-X2")
        strategy.cancel(_mtp_id + "-X3")
        if _mtp_cur < 0  // remaining short: re-issue X2/X3 with BE stop
            strategy.exit(_mtp_id + "-X2b", from_entry=_mtp_id, qty_percent=67, stop=_mtp_px, limit=_mtp_tp2)
            strategy.exit(_mtp_id + "-X3b", from_entry=_mtp_id, stop=_mtp_px, limit=_mtp_run)
        else             // remaining long
            strategy.exit(_mtp_id + "-X2b", from_entry=_mtp_id, qty_percent=67, stop=_mtp_px, limit=_mtp_tp2)
            strategy.exit(_mtp_id + "-X3b", from_entry=_mtp_id, stop=_mtp_px, limit=_mtp_run)
if _mtp_cur == 0
    _mtp_id := na
    _mtp_be := false
_mtp_prev := _mtp_cur

// ─── H / U CONTEXT GATES, HOISTED ────────────────────────────────────
// Each of these gate lines exists TWICE - the real entry block and the shadow
// signal-funnel copy that has to agree with it. Hoisting is what keeps the two
// in step; inlining the conditions twice is how the funnel drifts and starts
// counting signals the entry never took. Defined here, above every signal
// block, because H fires at 14:30 and U at 22:30 and one definition serves
// both plus their funnel copies.
// Context gates, hoisted for the same reason as _hOkL/_uOkL below: each one
// is needed at BOTH the real entry and its shadow-funnel copy, and hoisting
// is what keeps the two in step.
// ─── UNMITIGATED FVG LEVELS ───────────────────────────────────────────
// A 3-bar gap, tracked until price returns to its near edge. _fgLvl holds the
// FAR edge, which is the level the study measured against; _fgMit holds the
// near edge, which is what retires the gap. Maintained at top level and
// unconditionally - building it inside an `if` gives it gappy history, which
// is the bug that bit the zone map's pivots.
var array<float> _fgLvl = array.new<float>()
var array<float> _fgMit = array.new<float>()
var array<int>   _fgBar = array.new<int>()

if barstate.isconfirmed
    // Retire first, then detect, so a gap formed on THIS bar is not instantly
    // mitigated by the very bar that created it.
    if array.size(_fgLvl) > 0
        for _k = array.size(_fgLvl) - 1 to 0
            _mit = array.get(_fgMit, _k)
            _lv  = array.get(_fgLvl, _k)
            _up  = _lv > _mit                       // resistance above
            if (_up ? high >= _mit : low <= _mit) or (bar_index - array.get(_fgBar, _k)) > 960
                array.remove(_fgLvl, _k)
                array.remove(_fgMit, _k)
                array.remove(_fgBar, _k)
    // bearish gap -> resistance ABOVE: far edge low[2], near edge high[0]
    if low[2] > high and (low[2] - high) >= hFvgMinW
        array.push(_fgLvl, low[2])
        array.push(_fgMit, high)
        array.push(_fgBar, bar_index)
    // bullish gap -> support BELOW: far edge high[2], near edge low[0]
    if high[2] < low and (low - high[2]) >= hFvgMinW
        array.push(_fgLvl, high[2])
        array.push(_fgMit, low)
        array.push(_fgBar, bar_index)

// ═══════════════════════════════════════════════════════════════════════
//  Z · ORB CONFIRMATION MODULE          added 2026-10-31
//  ─────────────────────────────────────────────────────────────────────
//  Every ORB confirmation measured in the confirmation study, wired as a
//  single gate on all four signals. ALL DEFAULT OFF, so the file behaves
//  exactly as before until you switch something on.
//
//  ⚠⚠ READ THIS BEFORE YOU TUNE. The study searched 1.99 BILLION
//  combinations of these features. It came out NULL: a label-permuted
//  book beat the real best (4.801 vs 4.798, p=0.500), and of the top 2000
//  train picks only 0.23% reached z>2 out of sample against 2.28%
//  expected BY CHANCE — the search's own picks were ANTI-predictive.
//
//  ⚠⚠ AND THE DEEPER PROBLEM IS NOT DIRECTION. Over 22 years and FOUR
//  session opens, ALWAYS-LONG beat the breakout entry every single time
//  (entry value -0.052 to -0.062 R/trade). A 9pp gain in direction moved
//  R/trade by 0.0013. The ORB is GEOMETRY-limited, not direction-limited.
//  So if something in here looks good, suspect the long side first.
//
//  ★ THE DIAGNOSTIC THAT MATTERS, and it is already in this file:
//  run each signal's direction filter as "Long only", then "Short only".
//  If the longs carry everything and the shorts sit near zero, you are
//  measuring gold's drift, not a confirmation. That was true of EVERY
//  ORB variant I tested, filtered or not.
// ═══════════════════════════════════════════════════════════════════════
G_CONF = "Z) ORB confirmation — 2026-10-31 study (all OFF by default)"

cfProbeVeto = input.bool(false, "Z) VETO a break preceded by a counter-probe", group=G_CONF,
   tooltip="★ THE 'LAST-SECOND REVERSE', with the sign INVERTED. Dalton calls it open-rejection-reverse: price probes the WRONG way inside the ORB window, then breaks the other way. The hypothesis was that the failed probe CONFIRMS the break. It does the opposite.\n\nMeasured, 15m, 4.4yr, non-overlapping, symmetric-barrier test:\n  counter-probe PRESENT   n=478   41.42% favourable\n  counter-probe ABSENT    n=1559  50.67%\n  base                    n=2037  48.50%\n-9.25pp, z=-3.54.\n\n⚠ TWO CAVEATS. It DECAYS: -14.41pp in the first half of the sample, only -4.31pp in the second. And it moves R/trade by +0.0013 — the direction gain does not reach the P&L, because the ORB's problem is geometry.\n\nMeasured as: how far the ORB window's OPEN sat on the wrong side of the eventual break, as a fraction of the ORB range.")
cfProbeMax  = input.float(0.33, "Z)   counter-probe tolerated <=", minval=0.0, maxval=1.0, step=0.01, group=G_CONF)
cfProbeReq  = input.bool(false, "Z) INVERT: require the counter-probe instead", group=G_CONF,
   tooltip="Takes ONLY the breaks the veto above would reject — i.e. your original hypothesis as stated. On my data this is the losing side (41.42%). Here so you can price it yourself rather than take my word.")

cfTvOn      = input.bool(false, "Z) Require break-bar volume expansion", group=G_CONF,
   tooltip="★ THE CLEANEST MONOTONE FEATURE IN THE WHOLE ORB STUDY. Break-bar tick volume against its 96-bar median, by quintile:\n  45.3% / 47.9% / 46.2% / 50.9% / 52.2%   rank correlation +0.89\nAt >=1.53x it gives 53.14% (z=+2.09). The best hand-built stack — counter-probe veto PLUS volume >=1.5x — reached 53.85% (z=+1.69, n=677).\n\n⚠ It never cleared the Bonferroni bar of 3.87 for the 465 predicates tested, and it still moved R/trade by only +0.001. A prop-firm study of 15,799 stock breakouts also found relative-volume filters 'did not help'.")
cfTvMin     = input.float(1.50, "Z)   volume / median(96) >=", minval=0.0, maxval=10.0, step=0.05, group=G_CONF)

cfClPosOn   = input.bool(false, "Z) Break bar must close near its extreme", group=G_CONF,
   tooltip="Did the bar hold its high (for a long)? The single-bar order-flow confirmation. Measured flat on the ORB; it is the 3-bar delta below that carried on COMPASS.")
cfClPosMin  = input.float(0.70, "Z)   close position in bar >=", minval=0.0, maxval=1.0, step=0.05, group=G_CONF)

cfDeltaOn   = input.bool(false, "Z) Require delta agreement (3-bar proxy)", group=G_CONF,
   tooltip="★ THE ONE CONFIRMATION THAT SURVIVED EVERYTHING — on COMPASS, not here. Sums volume x (2*closePosition - 1) over 3 bars, normalises by volume, signs by direction: recent volume-weighted closes must AGREE with the trade. Exactly what the order-flow literature prescribes, so it was predicted by mechanism rather than found by a sweep.\n\nOn COMPASS 4h, 22yr sequential: R/trade +0.1087 -> +0.1202, maxDD 44.9% -> 30.1%, FTMO breach 13% -> 8%, and it STRENGTHENS the short side (+0.063 -> +0.119).\n\nIt is offered here untested on the 15m ORB. If it works anywhere on this file it is the first place I would look.")
cfDeltaMin  = input.float(0.20, "Z)   signed 3-bar delta >=", minval=-1.0, maxval=1.0, step=0.05, group=G_CONF)

cfAbsorbOn  = input.bool(false, "Z) VETO absorption (volume without progress)", group=G_CONF,
   tooltip="Absorption is the order-flow name for heavy volume that FAILS to move price — passive limits soaking up aggressive orders, i.e. the breakout being faded. Computed as (volume/medianVolume) / (range/medianRange). It appeared in the single best combination the 1.99-billion-cell search found, which a permuted-label null then beat.")
cfAbsorbMax = input.float(2.00, "Z)   (vol/medVol)/(rng/medRng) <=", minval=0.1, maxval=20.0, step=0.1, group=G_CONF)

cfBarRngOn  = input.bool(false, "Z) Require a big break bar", group=G_CONF,
   tooltip="Break-bar range against its 96-bar median. A small break bar measured WORSE: <=1.10x gave 45.52% against a 48.50% base (z=-1.70).")
cfBarRngMin = input.float(1.10, "Z)   break bar range / median(96) >=", minval=0.0, maxval=10.0, step=0.05, group=G_CONF)

cfRngAdrOn  = input.bool(false, "Z) Require ORB range vs ADR", group=G_CONF,
   tooltip="ORB range divided by the 14-day ATR. Wider opening ranges followed through better (>=0.19 ADR gave 52.94%), which agrees with your own floor-scales-with-stop result and CONTRADICTS the vendor claim that narrow initial balances extend more often.\n\n⚠ THE ADR TRAP: a ratio was SUPPOSED to be immune to it. MEASURED 2026-11-10 AND IT IS NOT - at 0.0855 the share of days kept runs 97 / 84 / 81 / 81 / 69 % from 2022 to 2026, because opening ranges have shrunk against the daily range. Partly a date filter after all.\n\nWHY IT IS M+G ONLY: median range/ADR is H 0.206, G 0.126, M 0.125, U 0.064. At 0.0855 the veto keeps 97.4% of H days (inert), 81% of M and G (cuts the bottom fifth) and only 34.4% of U (guts it). His per-signal assignment is what these distributions dictate.")
cfRngAdrMin = input.float(0.10, "Z)   ORB range / ADR(14d) >=", minval=0.0, maxval=2.0, step=0.01, group=G_CONF)
cfRngAdrSig = input.string("MGHU", "Z)   ... this veto applies to", group=G_CONF,
   tooltip="Letters of the signals this ORB/ADR veto gates: M G H U. HIS 3-DAY RESULT: MG -- M and G want 0.0855, H and U want no veto at all. Default MGHU = all four = unchanged.")
_sgRngAdr = str.upper(cfRngAdrSig)

cfAtrRatOn  = input.bool(false, "Z) Require ATR expansion", group=G_CONF,
   tooltip="ATR(14) against ATR(96) on 15m — Crabel's contraction-expansion idea. ⚠ Crabel's own NR7 has decayed badly: 67% on 1980s S&P futures vs 49.8% on SPY 2000-2026.")
cfAtrRatMin = input.float(1.00, "Z)   ATR(14)/ATR(96) >=", minval=0.2, maxval=5.0, step=0.05, group=G_CONF)

cfRvOn      = input.bool(false, "Z) Volatility-state band", group=G_CONF,
   tooltip="★ THE ONLY WELL-EVIDENCED ORB CONDITIONAL IN THE PUBLISHED LITERATURE. Lundstrom measured an average difference of ~200 basis points PER DAY for crude oil and ~150bp for the S&P 500 between the HIGHEST and the LOWEST volatility state, framing the breakout as a time-varying inefficiency. He also reports the peer-reviewed precursor's significant returns appeared ONLY in 2001-2011, a window containing the subprime crisis — so not robust to time.\n\nOn gold I measured it FLAT on both books. This is the one place the literature and my measurement disagree, which makes it the most interesting switch in this group.")
cfRvMin     = input.float(0.0,  "Z)   realised-vol percentile >=", minval=0.0, maxval=1.0, step=0.05, group=G_CONF)
cfRvMax     = input.float(1.0,  "Z)   realised-vol percentile <=", minval=0.0, maxval=1.0, step=0.05, group=G_CONF)
cfRvLook    = input.int(300,    "Z)   percentile lookback (bars)", minval=100, maxval=400, group=G_CONF,
   tooltip="Capped at 400 because this script runs max_bars_back=500 and the measure also needs a 30-bar average on top.")

cfCh4hVeto  = input.bool(false, "Z) VETO breaks at the 4h channel extreme", group=G_CONF,
   tooltip="★★ THE STRONGEST SINGLE PREDICATE IN THE ENTIRE 15m BOOK. When the 4h 50-bar channel position is >= 0.95 — price pinned at the very top of its 4h range — breaks FAIL: 39.86% favourable against a 48.50% base, z=-3.40, n=281.\n\n★ Note the sign. pos-channel BUYS at >=0.80 on 4h and it works there. The same location KILLS a 15m breakout. Same price, opposite conclusion, different holding period — which is the cleanest evidence in this project that a filter is only valid for the geometry it was measured on.\n\nStill under the Bonferroni bar of 3.87, and it is the one ORB finding I would re-examine first.")
cfCh4hMax   = input.float(0.95, "Z)   veto when 4h position >=", minval=0.5, maxval=1.0, step=0.01, group=G_CONF)
cfCh4hOn    = input.bool(false, "Z) Require 4h channel position to agree", group=G_CONF,
   tooltip="The pos-channel signal used as a direction gate on the ORB. ⚠ MEASURED: it does NOT rescue the ORB. With the gate at >=0.60 the hybrid made +0.2071 R/trade while ALWAYS-LONG at the same bars made +0.2524; at >=0.80, +0.1389 against +0.2501. The gate just selects more longs.")
cfCh4hMin   = input.float(0.60, "Z)   4h position (direction-signed) >=", minval=0.0, maxval=1.0, step=0.05, group=G_CONF)

cfPdPosOn   = input.bool(false, "Z) Require position in the previous day's range", group=G_CONF,
   tooltip="Where the break sits inside yesterday's range, direction-signed. 53.19% at >=0.89 with a monotone quintile gradient (+0.65). Under the bar, but one of the few that trended the right way.")
cfPdPosMin  = input.float(0.60, "Z)   previous-day position >=", minval=0.0, maxval=1.0, step=0.05, group=G_CONF)

cfChaseOn   = input.bool(false, "Z) VETO chasing a break that already ran", group=G_CONF,
   tooltip="How far past the ORB level the bar closed, as a fraction of the ORB range. Chasing measured clearly worse: >=0.44 gave 45.05% against a 48.50% base (z=-2.74). This is the positional form of the live chase guard.\n\n⚠ NOTE IT FIGHTS c2MinBreakStr, which is a MINIMUM on the same quantity. Setting a max below the min silently produces zero trades.")
cfChaseMax  = input.float(0.44, "Z)   (close - ORB level)/range <=", minval=0.0, maxval=5.0, step=0.01, group=G_CONF)

cfPrevBarVeto = input.bool(false, "Z) VETO when the previous bar agreed", group=G_CONF,
   tooltip="Counter-intuitive and measured: when the bar BEFORE the break already moved the trade's way, the break did worse — 46.83% against a 48.50% base, z=-2.90, n=2097. Consistent with the chase finding: by the time two bars have pushed, the move is spent.")

// ─── top-level calcs (ta.* must be unconditional) ───────────────────
_cfVolMed = ta.median(volume, 96)
_cfRngMed = ta.median(high - low, 96)
_cfAtrS   = ta.atr(14)
_cfAtrL   = ta.atr(96)
_cfClPos  = (high - low) > 0 ? (close - low) / (high - low) : 0.5
_cfSgnVol = volume * (2 * _cfClPos - 1)
_cfVol3   = math.sum(volume, 3)
// math.sum keeps a RUNNING WINDOW, so calling it in one branch of a ternary
// skips the bars the branch is not taken and the window is wrong afterwards.
// Hoisted. This feeds cfDeltaOn, the one confirmation that survived on
// COMPASS, so a silently corrupted value here would matter. (Warning 2138.)
_cfSgnSum = math.sum(_cfSgnVol, 3)
_cfDelta3 = _cfVol3 > 0 ? _cfSgnSum / _cfVol3 : 0.0
_cfRv     = ta.sma(math.abs(close - close[1]), 30)
_cfRvPct  = ta.percentrank(_cfRv, cfRvLook) / 100.0

// 4h channel position and the previous day's range. BOTH use [1] inside the
// request so they read the LAST CLOSED higher-timeframe bar — the same
// discipline that the COMPASS daily-gate bug taught us. Do not remove the [1].
_cf4hH = request.security(syminfo.tickerid, "240", ta.highest(high, 50)[1], lookahead=barmerge.lookahead_off)
_cf4hL = request.security(syminfo.tickerid, "240", ta.lowest(low,  50)[1], lookahead=barmerge.lookahead_off)
_cf4hC = request.security(syminfo.tickerid, "240", close[1],                lookahead=barmerge.lookahead_off)
_cf4hP = na(_cf4hH) or na(_cf4hL) or _cf4hH <= _cf4hL ? 0.5 : (_cf4hC - _cf4hL) / (_cf4hH - _cf4hL)
_cfPdH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
_cfPdL = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)
_cfPdP = na(_cfPdH) or na(_cfPdL) or _cfPdH <= _cfPdL ? 0.5 : (close - _cfPdL) / (_cfPdH - _cfPdL)

// ─── THE GATE ───────────────────────────────────────────────────────
// d = +1 long, -1 short.  oOp is the ORB window's OPEN.
// Returns TRUE when nothing is switched on, so the file is unchanged by default.
// --- SPLIT 2026-11-10, FOR THE TOKEN CEILING -----------------------
// f_confOk was called at EIGHT sites (4 signals x 2 directions) carrying
// 14 locals and 16 checks, so Pine inlined the whole thing eight times.
// ELEVEN of those checks read only the DIRECTION - volume, close position,
// delta, absorption, bar range, ATR ratio, the volatility state, the 4h
// channel either way, the previous-day position and the previous bar - so
// they were computed eight times to produce TWO answers.
//
// Hoisted here. Only the three checks that genuinely need the opening
// range stay per-signal: the counter-probe, the ORB/ADR veto (which also
// needs _sid) and the chase.
f_confDir(int d) =>
    bool _ok = true
    float _sg   = d == 1 ? 1.0 : -1.0
    float _clp  = d == 1 ? _cfClPos : 1.0 - _cfClPos
    float _dlt  = _cfDelta3 * _sg
    float _tvr  = _cfVolMed > 0 ? volume / _cfVolMed : 1.0
    float _brr  = _cfRngMed > 0 ? (high - low) / _cfRngMed : 1.0
    float _abs  = _brr > 0 ? _tvr / _brr : 1.0
    float _atrR = _cfAtrL > 0 ? _cfAtrS / _cfAtrL : 1.0
    float _p4   = d == 1 ? _cf4hP : 1.0 - _cf4hP
    float _ppd  = d == 1 ? _cfPdP : 1.0 - _cfPdP
    float _prev = (close[1] - close[2]) * _sg
    if cfTvOn and _tvr < cfTvMin
        _ok := false
    if cfClPosOn and _clp < cfClPosMin
        _ok := false
    if cfDeltaOn and _dlt < cfDeltaMin
        _ok := false
    if cfAbsorbOn and _abs > cfAbsorbMax
        _ok := false
    if cfBarRngOn and _brr < cfBarRngMin
        _ok := false
    if cfAtrRatOn and _atrR < cfAtrRatMin
        _ok := false
    if cfRvOn and (na(_cfRvPct) or _cfRvPct < cfRvMin or _cfRvPct > cfRvMax)
        _ok := false
    if cfCh4hVeto and _p4 >= cfCh4hMax
        _ok := false
    if cfCh4hOn and _p4 < cfCh4hMin
        _ok := false
    if cfPdPosOn and _ppd < cfPdPosMin
        _ok := false
    if cfPrevBarVeto and _prev > 0
        _ok := false
    _ok

_cfDirL = f_confDir(1)
_cfDirS = f_confDir(-1)

f_confOk(int d, float oHi, float oLo, float oRng, float oOp, string _sid) =>
    bool _ok = d == 1 ? _cfDirL : _cfDirS
    if _ok and (cfProbeVeto or cfProbeReq)
        float _probe = (na(oOp) or na(oRng) or oRng <= 0) ? 0.0 : (d == 1 ? (oOp - oLo) : (oHi - oOp)) / oRng
        if cfProbeVeto and _probe > cfProbeMax
            _ok := false
        if cfProbeReq and _probe <= cfProbeMax
            _ok := false
    if _ok and cfRngAdrOn and str.contains(_sgRngAdr, _sid)
        float _rgAdr = (_atr14d > 0 and not na(oRng)) ? oRng / _atr14d : 1.0
        if _rgAdr < cfRngAdrMin
            _ok := false
    if _ok and cfChaseOn
        float _lvl   = d == 1 ? oHi : oLo
        float _chase = (na(oRng) or oRng <= 0) ? 0.0 : (close - _lvl) * (d == 1 ? 1.0 : -1.0) / oRng
        if _chase > cfChaseMax
            _ok := false
    _ok

// TRUE unless the break closed further short of the nearest gap level beyond
// the ORB extreme than the ADR budget allows. Clear air passes.
f_hFvgOk(int d, float orbLvl) =>
    bool _ok = true
    if hFvgOn and in_nyorb_trade and array.size(_fgLvl) > 0 and not na(orbLvl) and _atr14d > 0
        float _best = na
        for _k = 0 to array.size(_fgLvl) - 1
            _p = array.get(_fgLvl, _k)
            if (d == 1 ? _p > orbLvl : _p < orbLvl) and (na(_best) or (d == 1 ? _p < _best : _p > _best))
                _best := _p
        if not na(_best)
            _ok := (d == 1 ? close - _best : _best - close) >= -hFvgADR * _atr14d
    _ok

// CONTEXT FILTERS REMOVED 2026-11-10: silver-leading and HTF-align were
// both measured to HURT. Names kept as constants so the entry sites are
// untouched.
_ctxL = true
_ctxS = true

_hOkL = (not orbNYPdHiFilter or (not na(_pdHigh) and close > _pdHigh))
_hOkS = (not orbNYPdLoFilter or (not na(_pdLow)  and close < _pdLow))

_uOkL = (not sydBreakNyHi or (not na(ny_hi_presyd) and close > ny_hi_presyd)) and (not sydNyCascade or _nyBiasPrev >= 0) and (not sydBreakPdHi or (not na(_pdHigh) and close > _pdHigh))
_uOkS = (not sydBreakNyLo or (not na(ny_lo_presyd) and close < ny_lo_presyd)) and (not sydNyCascade or _nyBiasPrev <= 0) and (not sydBreakPdLo or (not na(_pdLow)  and close < _pdLow))

// --- GATES HOISTED OUT OF THE ENTRY SITES  (2026-11-10) -------------
// PINE INLINES A FUNCTION AT EVERY CALL SITE. f_zoneOk at 16 sites,
// f_zoneConf at 16, f_smcOk at 16 and f_hFvgOk at 4 compiled to 52
// copies of four gate bodies - two of which contain loops - and that is
// what put the file over the 100,256-token ceiling.
//
// Each distinct (gate, signal, direction) is evaluated ONCE here and
// read twice: at the real entry and at its shadow-funnel copy. All four
// are PURE - no ta.*, no var state, no assignment outside themselves -
// so running them on every bar rather than only on gate bars cannot
// change a value. Same pattern, same reason, as _ctxL / _hOkL / _uOkL
// directly above.
//
// ⚠ IF YOU ADD A GATE, HOIST IT. Inlining one more loop across 16 sites
// is how this ceiling gets hit again.
// ZONE MAP REMOVED 2026-11-10 for the token ceiling. Headroom was
// measured DEAD against a matched placebo, and the only surviving idea
// about it says the gate may have the sign BACKWARDS. The ten names are
// kept as constants so all 16 entry sites and the shadow funnel read
// exactly as before - that is what made this a safe cut instead of a
// surgical one. Re-adding it means restoring the engine, not the names.
_zOkL = true
_zOkS = true
_zcML = true
_zcMS = true
_zcGL = true
_zcGS = true
_zcHL = true
_zcHS = true
_zcUL = true
_zcUS = true
_hfL  = f_hFvgOk(1, nyorb_hi)
_hfS  = f_hFvgOk(-1, nyorb_lo)
_smML = f_smcOk(1, smcAccMinM, "M")
_smMS = f_smcOk(-1, smcAccMinM, "M")
_smGL = f_smcOk(1, smcAccMinG, "G")
_smGS = f_smcOk(-1, smcAccMinG, "G")
_smHL = f_smcOk(1, smcAccMinH, "H")
_smHS = f_smcOk(-1, smcAccMinH, "H")
_smUL = f_smcOk(1, smcAccMinU, "U")
_smUS = f_smcOk(-1, smcAccMinU, "U")

// --- SLOT TEST, hoisted ---------------------------------------------
// Replaces `strategy.position_size == 0` in the four entry blocks. It is
// DIRECTIONAL because Pine nets positions: a second entry the other way
// would reverse the first rather than open a second trade, which is a
// different strategy pretending to be this one.
//   flat                      -> any direction may enter
//   open and room left        -> only the SAME direction may enter
//   open and no room          -> blocked, exactly as before
// Clamped to one slot whenever a shared trailing state machine is live.
_slotsN = _useRtState ? 1 : maxSlots
_slotL  = strategy.opentrades == 0 or (strategy.opentrades < _slotsN and strategy.position_size > 0)
_slotS  = strategy.opentrades == 0 or (strategy.opentrades < _slotsN and strategy.position_size < 0)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL M — Frankfurt ORB (Opening Range Breakout 07:00-07:30 UTC)
// Frankfurt/ECB open — European banks begin gold programs.  Same ORB
// logic as G and H but fires 1 hour before London, in a completely
// separate time window so it never conflicts with G or H.
// ═══════════════════════════════════════════════════════════════════════
if modFRB and barstate.isconfirmed and _testWinOk and in_frb_trade and frb_locked and not frb_done and not na(frb_hi) and not na(frb_lo) and _orbGateFRB and _hm_dow_ok
    orb_range = frb_hi - frb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range >= c2MinRangeFRB
        if close > frb_hi and (close - frb_hi) >= orb_range * c2MinBreakStr and f_liqOk(frb_sw_lo, frb_pool_lo) and (not (orbBiasFilter and frbBiasFilter) or _frbBiasLong) and frbDirFilter != "Short only" and _orbSeasonL and (not orbBreakAsianHi or (not na(ar_hi_prefrb) and close > ar_hi_prefrb)) and (not asianBiasFilter or _asianBias >= 0) and _ctxL and _zOkL and _zcML and f_confOk(1, frb_hi, frb_lo, orb_range, frb_op, "M") and _preOkL and _smML and _slotL
            // C2 retest: BUY LIMIT at frb_hi (broken ORB high retests as support).
            // Depth > 0 lifts the limit toward price so a shallow bounce fills it;
            // SL/TP stay on the ORB level, so only entry price and fill odds move.
            _mlE = frb_hi + orb_range * _c2Depth
            _mlS = frb_hi - f_c2SL(orb_range)
            _dml = f_tpDist(1, frb_hi, _mlE, orb_range, "M")
            _mlA = frb_hi + _dml
            _mlB = frb_hi + _dml * 2.0
            _mlC = frb_hi + _dml * 3.0
            // REVERSE: opposite side at the bar close, ORIGINAL distances mirrored.
            entryP = revM ? close : _mlE
            slP    = revM ? close + math.abs(_mlE - _mlS) : _mlS
            slDist = math.abs(entryP - slP)
            tp1    = revM ? close - math.abs(_mlE - _mlA) : _mlA
            tp2    = revM ? close - math.abs(_mlE - _mlB) : _mlB
            tp3    = revM ? close - math.abs(_mlE - _mlC) : _mlC
            frb_tries += 1
            frb_done := frb_tries >= orbMaxTries
            // limit=na → market fill at this bar's close. SL/TP stay anchored to
            // the ORB level either way, so only the entry price differs.
            c2LimFL = (not revM and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("FRB-L", revM ? strategy.short : strategy.long, limit=c2LimFL, comment="frankfurt-orb · C2 LONG")
            if _useRtState
                _rt_lvl   := revM ? entryP : frb_hi
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := revM ? -1 : 1
                _rt_id    := "FRB-L"
                _rt_sl    := slP
                _rt_sl0   := slP
                _rt_reach := 0.0
            if exitMode == "Trail after TP1"
                strategy.exit("FRB-L-X", from_entry="FRB-L", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("FRB-L-X1", from_entry="FRB-L", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("FRB-L-X2", from_entry="FRB-L", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = frb_hi + orb_range * 0.30
                sc2 = frb_hi + orb_range * 0.75
                sc3 = frb_hi + orb_range * 1.50
                strategy.exit("FRB-L-X1", from_entry="FRB-L", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("FRB-L-X2", from_entry="FRB-L", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("FRB-L-X3", from_entry="FRB-L", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "FRB-L"
                _mtp_be  := false
            else if exitMode == "Ratchet (no TP)"
                strategy.exit("FRB-L-X", from_entry="FRB-L", stop=slP)
            else
                strategy.exit("FRB-L-X", from_entry="FRB-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

        else if close < frb_lo and (frb_lo - close) >= orb_range * c2MinBreakStr and f_liqOk(frb_sw_hi, frb_pool_hi) and (not (orbBiasFilter and frbBiasFilter) or _frbBiasShort) and frbDirFilter != "Long only" and _orbSeasonS and (not orbBreakAsianLo or (not na(ar_lo_prefrb) and close < ar_lo_prefrb)) and (not asianBiasFilter or _asianBias <= 0) and _ctxS and _zOkS and _zcMS and f_confOk(-1, frb_hi, frb_lo, orb_range, frb_op, "M") and _preOkS and _smMS and _slotS
            // C2 retest: SELL LIMIT at frb_lo (broken ORB low retests as resistance).
            // Depth > 0 drops the limit toward price so a shallow bounce fills it.
            _msE = frb_lo - orb_range * _c2Depth
            _msS = frb_lo + f_c2SL(orb_range)
            _dms = f_tpDist(-1, frb_lo, _msE, orb_range, "M")
            _msA = frb_lo - _dms
            _msB = frb_lo - _dms * 2.0
            _msC = frb_lo - _dms * 3.0
            // REVERSE: opposite side at the bar close, ORIGINAL distances mirrored.
            entryP = revM ? close : _msE
            slP    = revM ? close - math.abs(_msE - _msS) : _msS
            slDist = math.abs(slP - entryP)
            tp1    = revM ? close + math.abs(_msE - _msA) : _msA
            tp2    = revM ? close + math.abs(_msE - _msB) : _msB
            tp3    = revM ? close + math.abs(_msE - _msC) : _msC
            frb_tries += 1
            frb_done := frb_tries >= orbMaxTries
            frb_short_today := true
            c2LimFS = (not revM and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("FRB-S", revM ? strategy.long : strategy.short, limit=c2LimFS, comment="frankfurt-orb · C2 SHORT")
            if _useRtState
                _rt_lvl   := revM ? entryP : frb_lo
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := revM ? 1 : -1
                _rt_id    := "FRB-S"
                _rt_sl    := slP
                _rt_sl0   := slP
                _rt_reach := 0.0
            if exitMode == "Trail after TP1"
                strategy.exit("FRB-S-X", from_entry="FRB-S", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("FRB-S-X1", from_entry="FRB-S", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("FRB-S-X2", from_entry="FRB-S", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = frb_lo - orb_range * 0.30
                sc2 = frb_lo - orb_range * 0.75
                sc3 = frb_lo - orb_range * 1.50
                strategy.exit("FRB-S-X1", from_entry="FRB-S", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("FRB-S-X2", from_entry="FRB-S", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("FRB-S-X3", from_entry="FRB-S", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "FRB-S"
                _mtp_be  := false
            else if exitMode == "Ratchet (no TP)"
                strategy.exit("FRB-S-X", from_entry="FRB-S", stop=slP)
            else
                strategy.exit("FRB-S-X", from_entry="FRB-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL G — London ORB (Opening Range Breakout 08:00-08:30 UTC)
// The most documented professional gold setup.  OR = first 30 min.
// After 08:30: trade first bar that closes outside the OR.
// SL at opposite OR extreme; TP targets are multiples of OR width.
// ═══════════════════════════════════════════════════════════════════════
// REWORKED 2026-09-21. G was the last ORB still running the ORIGINAL
// architecture — market entry at the close, SL at the opposite OR extreme, no
// bias gate, no ADR gate, no min-range floor, no Asian filters. M and H have all
// of those and produce the 99% baseline; G had none and was left OFF.
//
// Now switchable to the identical C2 geometry, with each requested filter on its
// own toggle so they can be isolated one at a time rather than all at once.
// Every filter defaults OFF, so turning modORB on alone reproduces C2-G bare.
if modORB and barstate.isconfirmed and in_lorb_trade and lorb_locked and not lorb_done and not na(lorb_hi) and not na(lorb_lo) and (not lonADRGuard or (_adrConsumed[1] >= adrLoLON and _adrConsumed[1] < adrHiLON)) and _testWinOk and _hm_dow_ok
    orb_range = lorb_hi - lorb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range >= (lonUseC2 ? c2MinRangeLON : 0.50)
        if close > lorb_hi and lonDirFilter != "Short only" and (not lonBiasFilter or _orbBiasLong) and (not lonBreakAsianHi or (not na(ar_hi) and close > ar_hi)) and (not lonAsianCascade or _asianBias >= 0) and _ctxL and _zOkL and _zcGL and f_confOk(1, lorb_hi, lorb_lo, orb_range, lorb_op, "G") and _preOkL and _smGL and _slotL
            // C2: BUY LIMIT back at lorb_hi (broken ORB high retests as support).
            // Legacy: market fill at this bar's close, SL at the opposite extreme.
            _glE = lonUseC2 ? lorb_hi + orb_range * _c2Depth : close
            _glS = lonUseC2 ? lorb_hi - f_c2SL(orb_range)    : lorb_lo - buf
            _dgl = f_tpDist(1, lorb_hi, _glE, orb_range, "G")
            _glA = lonUseC2 ? lorb_hi + _dgl       : lorb_hi + orb_range
            _glB = lonUseC2 ? lorb_hi + _dgl * 2.0 : lorb_hi + orb_range * 2.0
            _glC = lonUseC2 ? lorb_hi + _dgl * 3.0 : lorb_hi + orb_range * 3.0
            // REVERSE: opposite side at the bar close, ORIGINAL distances mirrored.
            entryP = revG ? close : _glE
            slP    = revG ? close + math.abs(_glE - _glS) : _glS
            tp1    = revG ? close - math.abs(_glE - _glA) : _glA
            tp2    = revG ? close - math.abs(_glE - _glB) : _glB
            tp3    = revG ? close - math.abs(_glE - _glC) : _glC
            lorb_tries += 1
            lorb_done := lorb_tries >= orbMaxTries
            c2LimGL = (not revG and lonUseC2 and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("ORB-L", revG ? strategy.short : strategy.long, limit=c2LimGL, comment="london-orb · LONG")
            // Ratchet state — without this, f_c2Exit's ratchet branch places a
            // naked stop with no TP and no trail: a guaranteed full loss. Same
            // bug U and V carried until it was found.
            if _useRtState
                _rt_lvl   := revG ? entryP : lorb_hi
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := revG ? -1 : 1
                _rt_id    := "ORB-L"
                _rt_sl    := slP
                _rt_sl0   := slP
                _rt_reach := 0.0
            f_c2Exit("ORB-L", slP, tp1, tp2, tp3, orb_range)
            f_drawPosBox(entryP, slP, tp3)

        else if close < lorb_lo and lonDirFilter != "Long only" and (not lonBiasFilter or _orbBiasShort) and (not lonBreakAsianLo or (not na(ar_lo) and close < ar_lo)) and (not lonAsianCascade or _asianBias <= 0) and _ctxS and _zOkS and _zcGS and f_confOk(-1, lorb_hi, lorb_lo, orb_range, lorb_op, "G") and _preOkS and _smGS and _slotS
            _gsE = lonUseC2 ? lorb_lo - orb_range * _c2Depth : close
            _gsS = lonUseC2 ? lorb_lo + f_c2SL(orb_range)    : lorb_hi + buf
            _dgs = f_tpDist(-1, lorb_lo, _gsE, orb_range, "G")
            _gsA = lonUseC2 ? lorb_lo - _dgs       : lorb_lo - orb_range
            _gsB = lonUseC2 ? lorb_lo - _dgs * 2.0 : lorb_lo - orb_range * 2.0
            _gsC = lonUseC2 ? lorb_lo - _dgs * 3.0 : lorb_lo - orb_range * 3.0
            // REVERSE: opposite side at the bar close, ORIGINAL distances mirrored.
            entryP = revG ? close : _gsE
            slP    = revG ? close - math.abs(_gsE - _gsS) : _gsS
            tp1    = revG ? close + math.abs(_gsE - _gsA) : _gsA
            tp2    = revG ? close + math.abs(_gsE - _gsB) : _gsB
            tp3    = revG ? close + math.abs(_gsE - _gsC) : _gsC
            lorb_tries += 1
            lorb_done := lorb_tries >= orbMaxTries
            c2LimGS = (not revG and lonUseC2 and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("ORB-S", revG ? strategy.long : strategy.short, limit=c2LimGS, comment="london-orb · SHORT")
            if _useRtState
                _rt_lvl   := revG ? entryP : lorb_lo
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := revG ? 1 : -1
                _rt_id    := "ORB-S"
                _rt_sl    := slP
                _rt_sl0   := slP
                _rt_reach := 0.0
            f_c2Exit("ORB-S", slP, tp1, tp2, tp3, orb_range)
            f_drawPosBox(entryP, slP, tp3)



// ═══════════════════════════════════════════════════════════════════════
// SIGNAL H — NY ORB (Opening Range Breakout 14:00-14:30 UTC)
// Same concept for the NY open — second major institutional opportunity.
// ═══════════════════════════════════════════════════════════════════════
if (_nyEligE or _nyEligL) and barstate.isconfirmed and _testWinOk and nyorb_locked and not nyorb_done and not na(nyorb_hi) and not na(nyorb_lo) and _orbGateNY and _hm_dow_ok
    orb_range = nyorb_hi - nyorb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    // Tags the Strategy Tester trade list so the two halves are separable there
    // as well as by the toggles.
    _nyTag    = nyOneSignal ? "ny-orb" : _nyEligE ? "ny-orb-E" : "ny-orb-L"
    if orb_range >= c2MinRangeNY
        if close > nyorb_hi and (close - nyorb_hi) >= orb_range * c2MinBreakStr and f_liqOk(nyo_sw_lo, nyo_pool_lo) and (not (orbBiasFilter and nyBiasFilter) or _orbBiasLong) and nyorbDirFilter != "Short only" and _orbSeasonL and (not orbNYFRBCtxL or (frb_short_today and h1B == 1)) and (not orbNYLonHiFilter or (not na(lon_hi_preny) and close > lon_hi_preny)) and (not asianBiasFilter or _asianBias >= 0) and _hOkL and _ctxL and _zOkL and _zcHL and _hfL and f_confOk(1, nyorb_hi, nyorb_lo, orb_range, nyorb_op, "H") and _hpAccOkL and _smHL and (not hBreakAsianHi or (not na(ar_hi) and close > ar_hi)) and _slotL
            // C2 retest: BUY LIMIT at nyorb_hi (broken ORB high retests as support).
            // Depth > 0 lifts the limit toward price so a shallow bounce fills it.
            _hlE = nyorb_hi + orb_range * _c2Depth
            _hlS = nyorb_hi - f_c2SL(orb_range)
            _dhl = f_tpDist(1, nyorb_hi, _hlE, orb_range, "H")
            _hlA = nyorb_hi + _dhl
            _hlB = nyorb_hi + _dhl * 2.0
            _hlC = nyorb_hi + _dhl * 3.0
            // REVERSE: opposite side at the bar close, ORIGINAL distances mirrored.
            entryP = revH ? close : _hlE
            slP    = revH ? close + math.abs(_hlE - _hlS) : _hlS
            slDist = math.abs(entryP - slP)
            tp1    = revH ? close - math.abs(_hlE - _hlA) : _hlA
            tp2    = revH ? close - math.abs(_hlE - _hlB) : _hlB
            tp3    = revH ? close - math.abs(_hlE - _hlC) : _hlC
            nyorb_tries += 1
            nyorb_done := nyorb_tries >= orbMaxTries
            c2LimNL = (not revH and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("NYORB-L", revH ? strategy.short : strategy.long, limit=c2LimNL, comment=_nyTag + " · C2 LONG")
            if _useRtState
                _rt_lvl   := revH ? entryP : nyorb_hi
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := revH ? -1 : 1
                _rt_id    := "NYORB-L"
                _rt_sl    := slP
                _rt_sl0   := slP
                _rt_reach := 0.0
            if exitMode == "Trail after TP1"
                strategy.exit("NYORB-L-X", from_entry="NYORB-L", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("NYORB-L-X1", from_entry="NYORB-L", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("NYORB-L-X2", from_entry="NYORB-L", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = nyorb_hi + orb_range * 0.30
                sc2 = nyorb_hi + orb_range * 0.75
                sc3 = nyorb_hi + orb_range * 1.50
                strategy.exit("NYORB-L-X1", from_entry="NYORB-L", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("NYORB-L-X2", from_entry="NYORB-L", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("NYORB-L-X3", from_entry="NYORB-L", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "NYORB-L"
                _mtp_be  := false
            else if exitMode == "Ratchet (no TP)"
                strategy.exit("NYORB-L-X", from_entry="NYORB-L", stop=slP)
            else
                strategy.exit("NYORB-L-X", from_entry="NYORB-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

        else if close < nyorb_lo and (nyorb_lo - close) >= orb_range * c2MinBreakStr and f_liqOk(nyo_sw_hi, nyo_pool_hi) and (not (orbBiasFilter and nyBiasFilter) or _orbBiasShort) and nyorbDirFilter != "Long only" and _orbSeasonS and (not orbNYFRBCtxS or (frb_short_today and h1B == -1)) and (not orbNYLonLoFilter or (not na(lon_lo_preny) and close < lon_lo_preny)) and (not asianBiasFilter or _asianBias <= 0) and _hOkS and _ctxS and _zOkS and _zcHS and _hfS and f_confOk(-1, nyorb_hi, nyorb_lo, orb_range, nyorb_op, "H") and _hpAccOkS and _smHS and (not hBreakAsianLo or (not na(ar_lo) and close < ar_lo)) and _slotS
            // C2 retest: SELL LIMIT at nyorb_lo (broken ORB low retests as resistance).
            // Depth > 0 drops the limit toward price so a shallow bounce fills it.
            _hsE = nyorb_lo - orb_range * _c2Depth
            _hsS = nyorb_lo + f_c2SL(orb_range)
            _dhs = f_tpDist(-1, nyorb_lo, _hsE, orb_range, "H")
            _hsA = nyorb_lo - _dhs
            _hsB = nyorb_lo - _dhs * 2.0
            _hsC = nyorb_lo - _dhs * 3.0
            // REVERSE: opposite side at the bar close, ORIGINAL distances mirrored.
            entryP = revH ? close : _hsE
            slP    = revH ? close - math.abs(_hsE - _hsS) : _hsS
            slDist = math.abs(slP - entryP)
            tp1    = revH ? close + math.abs(_hsE - _hsA) : _hsA
            tp2    = revH ? close + math.abs(_hsE - _hsB) : _hsB
            tp3    = revH ? close + math.abs(_hsE - _hsC) : _hsC
            nyorb_tries += 1
            nyorb_done := nyorb_tries >= orbMaxTries
            c2LimNS = (not revH and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("NYORB-S", revH ? strategy.long : strategy.short, limit=c2LimNS, comment=_nyTag + " · C2 SHORT")
            if _useRtState
                _rt_lvl   := revH ? entryP : nyorb_lo
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := revH ? 1 : -1
                _rt_id    := "NYORB-S"
                _rt_sl    := slP
                _rt_sl0   := slP
                _rt_reach := 0.0
            if exitMode == "Trail after TP1"
                strategy.exit("NYORB-S-X", from_entry="NYORB-S", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("NYORB-S-X1", from_entry="NYORB-S", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("NYORB-S-X2", from_entry="NYORB-S", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = nyorb_lo - orb_range * 0.30
                sc2 = nyorb_lo - orb_range * 0.75
                sc3 = nyorb_lo - orb_range * 1.50
                strategy.exit("NYORB-S-X1", from_entry="NYORB-S", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("NYORB-S-X2", from_entry="NYORB-S", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("NYORB-S-X3", from_entry="NYORB-S", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "NYORB-S"
                _mtp_be  := false
            else if exitMode == "Ratchet (no TP)"
                strategy.exit("NYORB-S-X", from_entry="NYORB-S", stop=slP)
            else
                strategy.exit("NYORB-S-X", from_entry="NYORB-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNALS U + V — Asian session ORBs  (Sydney / Tokyo)
// ─────────────────────────────────────────────────────────────────────
// M and H are really just "session-open ORB" applied to Frankfurt and NY.
// U and V apply the identical C2 architecture to the two Asian opens:
//   U) Sydney — 22:00 UTC default (UTC+10/+11, DST-dependent)
//   V) Tokyo  — 00:00 UTC (UTC+9, no DST, so this one is exact)
//
// Identical to M/H in every respect: 30-min opening range, first close
// outside it is the breakout, limit rests back at the level (shifted by
// _c2Depth), SL = level ± f_c2SL(range), TPs = range × orbTPMult × {1,2,3},
// H1+H4 bias must align, min-range floor, ADR gate, one shot per day.
//
// UNTESTED. Asian sessions carry a fraction of Frankfurt/NY liquidity, so
// the honest prior is that ranges rarely clear the 5pt floor and that any
// breakout mean-reverts rather than extends. The min-range filter blocking
// most signals IS a result — it would mean the setup does not exist here.
// ═══════════════════════════════════════════════════════════════════════

// f_c2Exit moved UP to just after f_exitLim — Signal G now uses it too, and G
// sits earlier in the file than this block did. Pine requires a function to be
// defined before every use.

// ─── SIGNAL U — Sydney ORB ───────────────────────────────────────────
if modSYD and barstate.isconfirmed and _testWinOk and in_syd_trade and syd_locked and not syd_done and not na(syd_hi) and not na(syd_lo) and _orbGateOk and _hm_dow_ok
    rngU = syd_hi - syd_lo
    if rngU >= c2MinRangeASIA
        if close > syd_hi and (close - syd_hi) >= rngU * c2MinBreakStr and f_liqOk(syd_sw_lo, syd_pool_lo) and (not (orbBiasFilter and sydBiasFilter) or _sydBiasLong) and _uOkL and _ctxL and _zOkL and _zcUL and f_confOk(1, syd_hi, syd_lo, rngU, syd_op, "U") and _smUL and _slotL
            _ulE = syd_hi + rngU * _c2Depth
            _ulS = syd_hi - f_c2SL(rngU)
            _dul = f_tpDist(1, syd_hi, _ulE, rngU, "U")
            _ulA = syd_hi + _dul
            _ulB = syd_hi + _dul * 2.0
            _ulC = syd_hi + _dul * 3.0
            // REVERSE: opposite side at the bar close, ORIGINAL distances mirrored.
            entryP = revU ? close : _ulE
            slP    = revU ? close + math.abs(_ulE - _ulS) : _ulS
            tp1    = revU ? close - math.abs(_ulE - _ulA) : _ulA
            tp2    = revU ? close - math.abs(_ulE - _ulB) : _ulB
            tp3    = revU ? close - math.abs(_ulE - _ulC) : _ulC
            syd_tries += 1
            syd_done := syd_tries >= orbMaxTries
            c2LimUL = (not revU and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("SYD-L", revU ? strategy.short : strategy.long, limit=c2LimUL, comment="sydney-orb · C2 LONG")
            // BUG FIX: U/V never registered ratchet state, so f_c2Exit's ratchet
            // branch placed a NAKED stop with no TP and no trail. Every filled
            // Sydney/Tokyo trade could then only ever exit at its original stop —
            // a guaranteed full loss, 100% of the time.
            if _useRtState
                _rt_lvl   := revU ? entryP : syd_hi
                _rt_entry := entryP
                _rt_rng   := rngU
                _rt_dir   := revU ? -1 : 1
                _rt_id    := "SYD-L"
                _rt_sl    := slP
                _rt_sl0   := slP
                _rt_reach := 0.0
            f_c2Exit("SYD-L", slP, tp1, tp2, tp3, rngU)
            label.new(bar_index, low, "U↑", style=label.style_label_up,
                      color=color.new(color.blue, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

        else if close < syd_lo and (syd_lo - close) >= rngU * c2MinBreakStr and f_liqOk(syd_sw_hi, syd_pool_hi) and (not (orbBiasFilter and sydBiasFilter) or _sydBiasShort) and _uOkS and _ctxS and _zOkS and _zcUS and f_confOk(-1, syd_hi, syd_lo, rngU, syd_op, "U") and _smUS and _slotS
            _usE = syd_lo - rngU * _c2Depth
            _usS = syd_lo + f_c2SL(rngU)
            _dus = f_tpDist(-1, syd_lo, _usE, rngU, "U")
            _usA = syd_lo - _dus
            _usB = syd_lo - _dus * 2.0
            _usC = syd_lo - _dus * 3.0
            // REVERSE: opposite side at the bar close, ORIGINAL distances mirrored.
            entryP = revU ? close : _usE
            slP    = revU ? close - math.abs(_usE - _usS) : _usS
            tp1    = revU ? close + math.abs(_usE - _usA) : _usA
            tp2    = revU ? close + math.abs(_usE - _usB) : _usB
            tp3    = revU ? close + math.abs(_usE - _usC) : _usC
            syd_tries += 1
            syd_done := syd_tries >= orbMaxTries
            c2LimUS = (not revU and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("SYD-S", revU ? strategy.long : strategy.short, limit=c2LimUS, comment="sydney-orb · C2 SHORT")
            if _useRtState
                _rt_lvl   := revU ? entryP : syd_lo
                _rt_entry := entryP
                _rt_rng   := rngU
                _rt_dir   := revU ? 1 : -1
                _rt_id    := "SYD-S"
                _rt_sl    := slP
                _rt_sl0   := slP
                _rt_reach := 0.0
            f_c2Exit("SYD-S", slP, tp1, tp2, tp3, rngU)
            label.new(bar_index, high, "U↓", style=label.style_label_down,
                      color=color.new(color.blue, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)
















// SIGNAL COUNTER - setups that FIRED vs setups that were TAKEN
// -------------------------------------------------------------------
// Added 2026-09-23 on a fair objection: the entry conditions are identical
// between exit modes, so the SETUP count cannot change. Only the TAKEN count
// can. That was asserted rather than measured; this measures it.
//
// Every entry block is gated on `strategy.position_size == 0`. The ratchet
// holds a position far longer than a fixed TP does, so a signal that fires
// while a trade is still open is simply not taken - the setup existed, the
// slot did not.
//
// THIS BLOCK PLACES NO ORDER. It re-evaluates each signal's conditions with
// the position gate removed and counts them, so both numbers can be read
// side by side.
//
// THE CONDITIONS BELOW ARE A DELIBERATE COPY of each entry gate, minus
// `strategy.position_size == 0` and minus the real `_done` flag (each shadow
// carries its own). They are NOT hoisted out of the entry blocks on purpose:
// rewriting those blocks could change which trades fire, and a wrong counter
// costs an analysis while a broken entry costs money. Keep them in sync by
// hand if an entry filter ever changes.
// BAR-RANGE DIAGNOSTIC 2026-09-23. strategy.closedtrades came back 174 while
// the Tester reported 390 - the same 42-45% gap recorded as the open
// 417-vs-176 puzzle. If the script is only RUNNING on part of the range the
// Tester evaluates (Deep Backtest / PROFOND computes server-side over more
// history than the chart holds), every table in this file is reading a subset
// and none of their percentages describe the headline result.
//
// This records the first and last bar the SCRIPT saw. Compare against the
// Tester's date range: if they differ, that is the whole answer.
var int _firstBarT = na
if na(_firstBarT)
    _firstBarT := time

var int  sigM   = 0
var int  sigH   = 0
var int  sigG   = 0
var int  sigW   = 0
var int  sigU   = 0
var int  sigV   = 0
var int  trdM   = 0
var int  trdH   = 0
var int  trdG   = 0
var int  trdW   = 0
var int  trdU   = 0
var int  trdV   = 0
var bool smDone = false
var bool shDone = false
var bool sgDone = false
var bool swDone = false
var bool suDone = false
var bool svDone = false

// Shadow done-flags reset exactly where the real ones do.
if _newDay
    smDone := false
    shDone := false
    sgDone := false
if in_syd_window and not in_syd_window[1]
    suDone := false

if modFRB and barstate.isconfirmed and _testWinOk and in_frb_trade and frb_locked and not smDone and not na(frb_hi) and not na(frb_lo) and _orbGateFRB and _hm_dow_ok
    rM = frb_hi - frb_lo
    if rM >= c2MinRangeFRB
        okML = close > frb_hi and (close - frb_hi) >= rM * c2MinBreakStr and f_liqOk(frb_sw_lo, frb_pool_lo) and (not (orbBiasFilter and frbBiasFilter) or _frbBiasLong) and frbDirFilter != "Short only" and _orbSeasonL and (not orbBreakAsianHi or (not na(ar_hi_prefrb) and close > ar_hi_prefrb)) and (not asianBiasFilter or _asianBias >= 0) and _ctxL and _zOkL and _zcML and _preOkL and _smML
        okMS = close < frb_lo and (frb_lo - close) >= rM * c2MinBreakStr and f_liqOk(frb_sw_hi, frb_pool_hi) and (not (orbBiasFilter and frbBiasFilter) or _frbBiasShort) and frbDirFilter != "Long only" and _orbSeasonS and (not orbBreakAsianLo or (not na(ar_lo_prefrb) and close < ar_lo_prefrb)) and (not asianBiasFilter or _asianBias <= 0) and _ctxS and _zOkS and _zcMS and _preOkS and _smMS
        if okML or okMS
            sigM   := sigM + 1
            smDone := true

if (_nyEligE or _nyEligL) and barstate.isconfirmed and _testWinOk and nyorb_locked and not shDone and not na(nyorb_hi) and not na(nyorb_lo) and _orbGateNY and _hm_dow_ok
    rH = nyorb_hi - nyorb_lo
    if rH >= c2MinRangeNY
        okHL = close > nyorb_hi and (close - nyorb_hi) >= rH * c2MinBreakStr and f_liqOk(nyo_sw_lo, nyo_pool_lo) and (not (orbBiasFilter and nyBiasFilter) or _orbBiasLong) and nyorbDirFilter != "Short only" and _orbSeasonL and (not orbNYFRBCtxL or (frb_short_today and h1B == 1)) and (not orbNYLonHiFilter or (not na(lon_hi_preny) and close > lon_hi_preny)) and (not asianBiasFilter or _asianBias >= 0) and _hOkL and _ctxL and _zOkL and _zcHL and _hfL and _smHL and (not hBreakAsianHi or (not na(ar_hi) and close > ar_hi))
        okHS = close < nyorb_lo and (nyorb_lo - close) >= rH * c2MinBreakStr and f_liqOk(nyo_sw_hi, nyo_pool_hi) and (not (orbBiasFilter and nyBiasFilter) or _orbBiasShort) and nyorbDirFilter != "Long only" and _orbSeasonS and (not orbNYFRBCtxS or (frb_short_today and h1B == -1)) and (not orbNYLonLoFilter or (not na(lon_lo_preny) and close < lon_lo_preny)) and (not asianBiasFilter or _asianBias <= 0) and _hOkS and _ctxS and _zOkS and _zcHS and _hfS and _smHS and (not hBreakAsianLo or (not na(ar_lo) and close < ar_lo))
        if okHL or okHS
            sigH   := sigH + 1
            shDone := true

if modORB and barstate.isconfirmed and in_lorb_trade and lorb_locked and not sgDone and not na(lorb_hi) and not na(lorb_lo) and (not lonADRGuard or (_adrConsumed[1] >= adrLoLON and _adrConsumed[1] < adrHiLON)) and _testWinOk and _hm_dow_ok
    rG = lorb_hi - lorb_lo
    if rG >= (lonUseC2 ? c2MinRangeLON : 0.50)
        okGL = close > lorb_hi and lonDirFilter != "Short only" and (not lonBiasFilter or _orbBiasLong) and (not lonBreakAsianHi or (not na(ar_hi) and close > ar_hi)) and (not lonAsianCascade or _asianBias >= 0) and _ctxL and _zOkL and _zcGL and _preOkL and _smGL
        okGS = close < lorb_lo and lonDirFilter != "Long only" and (not lonBiasFilter or _orbBiasShort) and (not lonBreakAsianLo or (not na(ar_lo) and close < ar_lo)) and (not lonAsianCascade or _asianBias <= 0) and _ctxS and _zOkS and _zcGS and _preOkS and _smGS
        if okGL or okGS
            sigG   := sigG + 1
            sgDone := true


if modSYD and barstate.isconfirmed and _testWinOk and in_syd_trade and syd_locked and not suDone and not na(syd_hi) and not na(syd_lo) and _orbGateOk and _hm_dow_ok
    rU2 = syd_hi - syd_lo
    if rU2 >= c2MinRangeASIA
        okUL = close > syd_hi and (close - syd_hi) >= rU2 * c2MinBreakStr and f_liqOk(syd_sw_lo, syd_pool_lo) and (not (orbBiasFilter and sydBiasFilter) or _sydBiasLong) and _uOkL and _ctxL and _zOkL and _zcUL and _smUL
        okUS = close < syd_lo and (syd_lo - close) >= rU2 * c2MinBreakStr and f_liqOk(syd_sw_hi, syd_pool_hi) and (not (orbBiasFilter and sydBiasFilter) or _sydBiasShort) and _uOkS and _ctxS and _zOkS and _zcUS and _smUS
        if okUL or okUS
            sigU   := sigU + 1
            suDone := true

// TAKEN counters - the rising edge of each real done-flag IS the moment an
// order was placed, so these need no copied conditions and cannot drift.
if frb_done   and not frb_done[1]
    trdM := trdM + 1
if nyorb_done and not nyorb_done[1]
    trdH := trdH + 1
if lorb_done  and not lorb_done[1]
    trdG := trdG + 1
if syd_done   and not syd_done[1]
    trdU := trdU + 1

// FOOTPRINT REMOVED 2026-11-10 (it needs a Premium/Ultimate plan and returns
// na without one). The four context captures below still PUSH this value, so
// it stays as a permanent na: the condition study's two delta buckets then
// simply never populate, which is exactly what they did on a plan without
// tick data. Nothing else in the file reads it.
float fpDelta = na

// ═══════════════════════════════════════════════════════════════════════
// A+ CONTEXT CAPTURE — recorded at SIGNAL time, not fill time
// ─────────────────────────────────────────────────────────────────────
// WHY THIS CHANGED. The previous version captured on the bar a position
// OPENED, which is blind to any trade that opens and closes inside one bar.
// That lost 24 of 96 trades, and NOT at random: every one of them had MAE
// <= 20. The context analysis was running on the harder three quarters of
// the list, biasing every percentage in it downward.
//
// Capturing on the SIGNAL bar fixes the coverage (a signal always precedes
// or equals its fill) AND unlocks the feature the break-and-retest research
// points at hardest: RETEST LATENCY, the gap in bars between the break and
// the limit filling. The literature is consistent that a fast, shallow
// pullback holding the level is healthy continuation, while a slow drift
// back into the range is a breakout that already died. Latency is that idea
// as a number, and it is known by the time the trade fills.
//
// Two more features that cost nothing to record:
//   BREAK STRENGTH — how far beyond the level the signal bar closed, in
//     range units. A marginal break is a weak break.
//   DAILY AGREEMENT — the H/M gate requires H1+H4 to align but says nothing
//     about the Daily, so hdB varies trade to trade and has never been tested.
//
// NOT captured: relative volume. The 2026 ORB study found volume does not
// predict follow-through in either direction, so the "high volume = conviction"
// heuristic is not worth a column here.
//
// Detection rides the rising edge of each signal's own `done` flag, so the
// eight entry blocks need no edits and cannot drift out of sync with this.
var array<int>   _ctxBar = array.new<int>(0)   // signal bar index
var array<float> _ctxRng = array.new<float>(0) // ORB range, points
var array<float> _ctxStr = array.new<float>(0) // break strength, in range units
var array<float> _ctxAdr = array.new<float>(0) // ADR consumed at signal
var array<int>   _ctxAgr = array.new<int>(0)   // 1 = Daily bias agrees with the break
var array<int>   _ctxSig = array.new<int>(0)   // 0=FRB 1=NYORB 2=SYD 3=TOK
var array<int>   _ctxPool= array.new<int>(0)   // 1 = prior-session pool swept on the break's far side
var array<int>   _ctxM15 = array.new<int>(0)   // 1 = 15m bias agrees with the break
var array<float> _ctxAtr = array.new<float>(0) // entry-TF ATR at signal — the third stop normalizer
// Added 2026-09-27 for the LOSS AUTOPSY table. Signal-bar time, and the NFP
// flag read AT SIGNAL TIME so the column matches exactly what orbNFPFilter
// would have gated on. Deriving NFP from entry_time instead would mislabel
// Signal U, whose 22:00 UTC window can carry the fill into the next day.
var array<int>   _ctxTime = array.new<int>(0)   // signal bar time (ms)
var array<int>   _ctxNFP  = array.new<int>(0)   // 1 = first-Friday NFP day
// Volume delta on the signal bar. na = no footprint data for that bar, which
// must stay distinct from a genuine zero - "nobody traded either way" and "we
// could not see" are different facts.
var array<float> _ctxDelta = array.new<float>(0)
// ZONE: what was in the PATH at signal time. na headroom = clear air.
// Recorded whether or not the gate is armed, so the map can be graded
// before it is ever allowed to block a trade.
var array<float> _ctxHead  = array.new<float>(0)
var array<int>   _ctxHeadN = array.new<int>(0)

// ─── TARGET ANATOMY: exit-independent forward excursion ──────────────
// THE TRAP THIS EXISTS TO AVOID: strategy.closedtrades.max_runup() is
// CENSORED BY THE EXIT. With exitMode "TP1 · 1R" every winner closes at
// 0.75 × ORB range, so its run-up IS 0.75 × ORB range - a table built on
// it would report that the available target equals the target already set,
// for every signal, in every run. Circular, and it looks like a finding.
//
// So these record the forward excursion from the SIGNAL BAR CLOSE over the
// next tgtHorizon bars, for EVERY signal, taken or not, whatever the exit
// mode is doing. Realized P&L is read later only as the second number -
// what was actually captured - so the pair gives a capture ratio.
//
// Reference = the signal bar CLOSE because live gold enters at MARKET after
// C2 (GOLD_MARKET_ENTRY, webhook.js), so that close is within a tick of the
// real fill. On the retest limit it is ~0.25 × range optimistic.
G_TGT = "Target anatomy (2026-11-10)"
showTgt    = input.bool(true, "Show target anatomy table", group=G_TGT,
             tooltip="What distance is actually available per signal, and in WHICH UNIT a take-profit belongs. Costs nothing: no input in this group is read by any entry or exit gate, so the trade list is identical with it on or off.")
tgtHorizon = input.int(24, "Forward horizon, bars", minval=4, maxval=96, group=G_TGT,
             tooltip="How far past each signal to follow price when measuring the available move. 24 bars = 6 hours on 15m.\n\nCounted in BARS, not clock time, so the daily halt costs nothing - no bars print through it, which matters for U (22:00) whose range sits next to the 22:00-23:00 winter halt.\n\n★ This is a horizon, not a hold: it bounds the MEASUREMENT only. It cannot change a trade.")
var array<float> _ctxRef  = array.new<float>(0) // signal bar close = entry ref
var array<int>   _ctxDir  = array.new<int>(0)   // +1 long, -1 short
var array<float> _ctxMfe  = array.new<float>(0) // fwd FAVOURABLE excursion, pts
var array<float> _ctxMadv = array.new<float>(0) // fwd ADVERSE excursion, pts
var array<float> _ctxAtrD = array.new<float>(0) // daily ATR(14) at signal

// Inlined per signal rather than wrapped in a helper: Pine functions may not
// assign to globals, and mutating a global array from inside one is a rule I
// would rather not lean on in code that decides real stops.
if frb_done and not frb_done[1] and not na(frb_hi) and not na(frb_lo) and frb_hi > frb_lo
    dirF = close > frb_hi ? 1 : -1
    lvlF = dirF == 1 ? frb_hi : frb_lo
    rngF = frb_hi - frb_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngF)
    array.push(_ctxStr, math.abs(close - lvlF) / rngF)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirF ? 1 : 0)
    array.push(_ctxSig, 0)
    array.push(_ctxRef,  close)
    array.push(_ctxDir,  dirF)
    array.push(_ctxMfe,  0.0)
    array.push(_ctxMadv, 0.0)
    array.push(_ctxAtrD, _atr14d)
    array.push(_ctxHead,  float(na))
    array.push(_ctxHeadN, 0)
    array.push(_ctxPool, (dirF == 1 ? frb_pool_lo : frb_pool_hi) ? 1 : 0)
    array.push(_ctxM15, m15B == dirF ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    array.push(_ctxTime, time)
    array.push(_ctxNFP, _isNFP ? 1 : 0)
    array.push(_ctxDelta, fpDelta)

if nyorb_done and not nyorb_done[1] and not na(nyorb_hi) and not na(nyorb_lo) and nyorb_hi > nyorb_lo
    dirN = close > nyorb_hi ? 1 : -1
    lvlN = dirN == 1 ? nyorb_hi : nyorb_lo
    rngN = nyorb_hi - nyorb_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngN)
    array.push(_ctxStr, math.abs(close - lvlN) / rngN)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirN ? 1 : 0)
    array.push(_ctxSig, 1)
    array.push(_ctxRef,  close)
    array.push(_ctxDir,  dirN)
    array.push(_ctxMfe,  0.0)
    array.push(_ctxMadv, 0.0)
    array.push(_ctxAtrD, _atr14d)
    array.push(_ctxHead,  float(na))
    array.push(_ctxHeadN, 0)
    array.push(_ctxPool, (dirN == 1 ? nyo_pool_lo : nyo_pool_hi) ? 1 : 0)
    array.push(_ctxM15, m15B == dirN ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    array.push(_ctxTime, time)
    array.push(_ctxNFP, _isNFP ? 1 : 0)
    array.push(_ctxDelta, fpDelta)

if syd_done and not syd_done[1] and not na(syd_hi) and not na(syd_lo) and syd_hi > syd_lo
    dirS = close > syd_hi ? 1 : -1
    lvlS = dirS == 1 ? syd_hi : syd_lo
    rngS = syd_hi - syd_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngS)
    array.push(_ctxStr, math.abs(close - lvlS) / rngS)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirS ? 1 : 0)
    array.push(_ctxSig, 2)
    array.push(_ctxRef,  close)
    array.push(_ctxDir,  dirS)
    array.push(_ctxMfe,  0.0)
    array.push(_ctxMadv, 0.0)
    array.push(_ctxAtrD, _atr14d)
    array.push(_ctxHead,  float(na))
    array.push(_ctxHeadN, 0)
    array.push(_ctxPool, (dirS == 1 ? syd_pool_lo : syd_pool_hi) ? 1 : 0)
    array.push(_ctxM15, m15B == dirS ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    array.push(_ctxTime, time)
    array.push(_ctxNFP, _isNFP ? 1 : 0)
    array.push(_ctxDelta, fpDelta)

// SIGNAL G — was missing entirely. Without this block every London ORB trade is
// invisible to the A+ table: ctxSig has no code for it, so the matcher below
// finds nothing and G is silently dropped from every split. Since G is now the
// biggest contributor to the baseline, that gap would have hidden exactly the
// signal this study most needs to see.
if lorb_done and not lorb_done[1] and not na(lorb_hi) and not na(lorb_lo) and lorb_hi > lorb_lo
    dirG = close > lorb_hi ? 1 : -1
    lvlG = dirG == 1 ? lorb_hi : lorb_lo
    rngG = lorb_hi - lorb_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngG)
    array.push(_ctxStr, math.abs(close - lvlG) / rngG)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirG ? 1 : 0)
    array.push(_ctxSig, 4)
    array.push(_ctxRef,  close)
    array.push(_ctxDir,  dirG)
    array.push(_ctxMfe,  0.0)
    array.push(_ctxMadv, 0.0)
    array.push(_ctxAtrD, _atr14d)
    array.push(_ctxHead,  float(na))
    array.push(_ctxHeadN, 0)
    // G has no pool tracking of its own — the liquidity-grab filter was never
    // extended to it. Recorded as 0 rather than left out, so the array lengths
    // stay locked together; read the POOL rows as M/H/U only.
    array.push(_ctxPool, 0)
    array.push(_ctxM15, m15B == dirG ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    array.push(_ctxTime, time)
    array.push(_ctxNFP, _isNFP ? 1 : 0)
    array.push(_ctxDelta, fpDelta)

// ═══════════════════════════════════════════════════════════════════════
// ─── FORWARD EXCURSION TRACKER ───────────────────────────────────────
// Walks the open measurement windows BACKWARDS and stops at the first
// record older than the horizon. _ctxBar is ascending by construction, so
// that break is correct and bounds the loop to the few live windows (M at
// 07:00 and G at 08:00 are 4 bars apart, so they DO overlap - which is
// exactly why this is per-record and not a single tracker).
//
// _ageT > 0 skips the signal bar itself: the signal is only known at that
// bar's CLOSE, so counting that bar's own range would be lookahead.
//
// ⚠ PINE: `for q = n - 1 to 0` runs DESCENDING, which is what we want, but
// with n == 0 it would run -1 to 0 ASCENDING and read index -1. Guarded.
//
// First and last signal time, for the SCRIPT SAW footer. The on-chart
// tables describe only the stretch THIS SCRIPT ran on, which is not the
// stretch PROFOND computes over - reading a 1yr table as a 3yr result has
// already produced one wrong conclusion here.
_ctxTimeFirst = array.size(_ctxTime) > 0 ? array.get(_ctxTime, 0) : time
_ctxTimeLast  = array.size(_ctxTime) > 0 ? array.get(_ctxTime, array.size(_ctxTime) - 1) : time
_nCtxT = array.size(_ctxBar)
if _nCtxT > 0 and barstate.isconfirmed
    for q = _nCtxT - 1 to 0
        _ageT = bar_index - array.get(_ctxBar, q)
        if _ageT > tgtHorizon
            break
        if _ageT > 0
            _dT = array.get(_ctxDir, q)
            _rT = array.get(_ctxRef, q)
            _fT = _dT == 1 ? high - _rT : _rT - low
            _aT = _dT == 1 ? _rT - low  : high - _rT
            if _fT > array.get(_ctxMfe, q)
                array.set(_ctxMfe, q, _fT)
            if _aT > array.get(_ctxMadv, q)
                array.set(_ctxMadv, q, _aT)

// SL RESEARCH — MAE-driven stop sweep  (answers "how small can c2SLBuf go?")
// ─────────────────────────────────────────────────────────────────────
// The 150-pt stop is ~6-19x the ORB range, so a win banks ~0.06R while a loss
// costs 1R. Live sizing is risk-based, so a smaller stop buys a bigger position
// for the same dollars: halve the stop and each ~12-pt win pays roughly double.
// The only thing stopping you is how many winners a tighter stop would kill.
//
// This table answers that directly from MAXIMUM ADVERSE EXCURSION — how far
// each trade went against you before it resolved. For each candidate stop S:
//   - a winner whose MAE <= S still wins, and banks its actual points
//   - a winner whose MAE >  S is CONVERTED to a loss of S
//   - a trade that already lost simply loses S instead of the old stop
// Net R = net points / S, which is the unit that matters under risk-based
// sizing (TradingView's dollar P&L is NOT comparable across stop widths).
//
// READ IT AS: the smallest S where "Net R" is still climbing is your floor.
// Below that, converted winners eat the gain from the larger R multiple.
//
// IMPORTANT — S is measured from the ENTRY, while c2SLBuf is measured from the
// ORB LEVEL, and the entry sits c2RetestDepth x range past the level. So set
//     c2SLBuf  =  S  -  (c2RetestDepth x ORB range)      [~0.25 x range]
// Then re-run with that c2SLBuf to confirm the real number.
//
// CAVEAT: this re-prices the SAME trade list. It cannot show trades a tighter
// stop would have let you re-enter, and it assumes a converted winner stops at
// exactly S. Treat it as the shortlist, not the final answer — confirm the
// winner by actually setting c2SLBuf and re-running.
// ═══════════════════════════════════════════════════════════════════════
G_SLR   = "SL research"
showSLR = input.bool(true, "Show MAE stop-sweep table", group=G_SLR,
          tooltip="Re-prices every closed trade in this run against a range of candidate stop sizes, using each trade's own maximum adverse excursion. Turn off once you have settled on a stop.")

// Thresholds concentrated in the WR-PRESERVING zone. The first sweep ran
// 10-40 pts, which trades win rate for R — rejected. What matters is the band
// just above the worst winner's excursion, where nothing is killed at all.
var array<float> _slrTh = array.from(10.0, 15.0, 20.0, 25.0, 30.0, 40.0, 50.0, 70.0, 100.0, 150.0)
var table slrTbl = na

// The table is built whenever showSLR is on, even with zero usable trades, and
// the bottom row always reports trade count + point value. A table that renders
// nothing at all is indistinguishable from a script that failed to load, which
// is exactly the debugging hole this avoids.
// Hoisted into a function 2026-09-22: TradingView rejected the script
// with "main body of the script is too long". Pine compiles function
// bodies separately from the main body, so moving the render here buys
// back the headroom. The table object is PASSED IN because a Pine
// function may not assign to a global - creation stays at the call site.
f_drawSlrTable(table t) =>
    // syminfo.pointvalue is na or 0 on some feeds. Previously that emptied the
    // array and the whole table silently disappeared; fall back to 1.0 instead,
    // which is correct for XAUUSD (1 contract x 1.00 price move = 1 currency).
    pv = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

    // Pass 1 — pull each closed trade's MAE and P&L into POINTS per contract.
    // max_drawdown() and profit() are both in currency, so divide by the trade's
    // own size: percent_of_equity means size differs from trade to trade.
    mae  = array.new<float>(0)
    pnl  = array.new<float>(0)
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            sz = math.abs(strategy.closedtrades.size(i))
            if sz > 0
                unit = sz * pv
                array.push(mae, strategy.closedtrades.max_drawdown(i) / unit)
                array.push(pnl, strategy.closedtrades.profit(i) / unit)

    table.cell(t, 0, 15, "closed trades: " + str.tostring(strategy.closedtrades) + "  ·  usable: " + str.tostring(array.size(mae)) + "  ·  pointvalue: " + str.tostring(pv, "#.####"),
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)

    // ─── WINNER-ONLY MAE — the WR-preserving answer ──────────────────
    // A stop only costs win rate when it sits INSIDE a winner's adverse
    // excursion. So the smallest stop that changes the win rate by exactly
    // nothing is (worst winner's MAE + a tick of margin). Everything above
    // that line is free: same trades, same wins, smaller R denominator.
    // p99/p95/p90 are there for the next decision — how much WR you would
    // trade away to shrink the stop further, priced one winner at a time.
    if array.size(mae) > 0
        wmae = array.new<float>(0)
        for j = 0 to array.size(mae) - 1
            if array.get(pnl, j) > 0
                array.push(wmae, array.get(mae, j))
        if array.size(wmae) > 0
            // percentile_linear_interpolation REQUIRES the array to be sorted
            // first. Passing an unsorted array returns a meaningless number
            // with no error and no warning — sort before reading percentiles.
            array.sort(wmae, order.ascending)
            wMax  = array.max(wmae)
            w99   = array.percentile_linear_interpolation(wmae, 99)
            w95   = array.percentile_linear_interpolation(wmae, 95)
            w90   = array.percentile_linear_interpolation(wmae, 90)
            zeroS = math.ceil(wMax) + 2
            wCol  = color.new(color.aqua, 0)
            table.cell(t, 0, 12, "WINNER MAE (n=" + str.tostring(array.size(wmae)) + ")", text_color=wCol, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 12, "max " + str.tostring(wMax, "#.#"), text_color=color.new(color.white, 15), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, 12, "p99 " + str.tostring(w99,  "#.#"), text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, 12, "p95 " + str.tostring(w95,  "#.#"), text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, 12, "p90 " + str.tostring(w90,  "#.#"), text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)

            table.cell(t, 0, 13, "ZERO-WR-COST STOP", text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 13, str.tostring(zeroS, "#") + " pts", text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, 13, "WR unchanged", text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, 13, "c2SLBuf ~", text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, 13, str.tostring(zeroS - 6, "#"), text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_right)

            // Cost of going tighter, priced in winners lost rather than percent.
            table.cell(t, 0, 14, "tighter costs:", text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 14, "p99 loses ~1 win", text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, 14, "p95 ~5%", text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, 14, "p90 ~10%", text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, 14, "of wins", text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)

    if array.size(mae) > 0
        hCol = color.new(#D4A017, 0)
        table.cell(t, 0, 0, "Stop (from entry)", text_color=hCol, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, 0, "Wins killed",       text_color=hCol, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, 0, "WR %",              text_color=hCol, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, 0, "Net pts",           text_color=hCol, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, 0, "Net R",             text_color=hCol, text_size=size.tiny, text_halign=text.align_right)

        // Pass 2 — re-price the whole trade list against each candidate stop.
        bestR   = -1e12
        bestS   = 0.0
        for ti = 0 to array.size(_slrTh) - 1
            S       = array.get(_slrTh, ti)
            netPts  = 0.0
            wins    = 0
            losses  = 0
            killed  = 0
            for j = 0 to array.size(mae) - 1
                m = array.get(mae, j)
                p = array.get(pnl, j)
                if p > 0
                    if m > S
                        killed := killed + 1
                        losses := losses + 1
                        netPts := netPts - S
                    else
                        wins   := wins + 1
                        netPts := netPts + p
                else
                    losses := losses + 1
                    netPts := netPts - S
            tot  = wins + losses
            wr   = tot > 0 ? wins * 100.0 / tot : 0.0
            netR = S > 0 ? netPts / S : 0.0
            if netR > bestR
                bestR := netR
                bestS := S
            rCol = netR > 0 ? color.lime : color.red
            table.cell(t, 0, ti + 1, str.tostring(S, "#") + " pts",      text_color=color.new(color.white, 15), text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, ti + 1, str.tostring(killed),                text_color=color.new(killed > 0 ? color.orange : color.gray, 0), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, ti + 1, str.tostring(wr, "#.##"),            text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, ti + 1, str.tostring(netPts, "#"),           text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, ti + 1, str.tostring(netR, "#.#"),           text_color=color.new(rCol, 0),         text_size=size.tiny, text_halign=text.align_right)

        table.cell(t, 0, 11, "BEST: " + str.tostring(bestS, "#") + " pts", text_color=color.new(color.aqua, 0), text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, 11, "n=" + str.tostring(array.size(mae)),         text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, 11, "",                                            text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, 11, "max R",                                       text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, 11, str.tostring(bestR, "#.#"),                    text_color=color.new(color.aqua, 0),  text_size=size.tiny, text_halign=text.align_right)

// ═══════════════════════════════════════════════════════════════════════

if barstate.islast and showSLR
    if na(slrTbl)
        slrTbl := table.new(position.middle_right, 5, 16,
                   bgcolor=color.new(color.black, 60),
                   border_color=color.new(color.gray, 60), border_width=1,
                   frame_color=color.new(color.gray, 60), frame_width=1)

    f_drawSlrTable(slrTbl)

// CONDITION STUDY — grade the baseline, do not try to beat it
// ─────────────────────────────────────────────────────────────────────
// Added 2026-09-22 on the user's reframe, which is the right one: THE
// BASELINE IS THE A+ SETUP. Six attempts to beat it have failed (break
// strength, liquidity grab, range-scaled stops, H-prime, Tokyo, and the
// tight-stop A+ tier). Stop trying to beat it. Grade it instead.
//
// This table breaks ONE signal at a time into its condition buckets, because
// the signals do not share conditions — already proven: the ADR guard HELPS H
// and HURTS M. A study that pools them averages that away and finds nothing.
//
// WHAT IT IS FOR: a RISK LADDER. Rank the buckets by win rate and heat, then
// set risk percent per grade. The LOT follows from risk / stopDist, so the same
// ladder produces 0.5 lots on a 100k account and 2.0 on a 400k one with no
// change to the rule.
//
// WHY GRADING IS SAFE WHERE FILTERING IS NOT: changing the SIZE of a trade does
// not change WHICH trades fire, so the trade list is identical and the buckets
// are an honest split. Blocking a signal frees the position slot and reshuffles
// everything downstream - which is exactly why every filter above failed.
//
// READ IT AS: a bucket earns a higher rung only if BOTH its win rate holds AND
// its heat stays low. A bucket with a great win rate and high heat is a bucket
// that survived by luck on a wide stop, and it will not survive being sized up.
// ═══════════════════════════════════════════════════════════════════════
G_COND = "Condition study (per signal)"
condSig = input.string("ALL", "Signal to break down", options=["ALL", "M  Frankfurt", "H  NY", "G  London", "U  Sydney"], group=G_COND,
          tooltip="Study ONE signal at a time. Conditions are not shared between signals - the ADR guard is measured GOOD for H and BAD for M - so pooling them averages the real effects away.\n\nRun this four times, once per signal, and write down the buckets that hold both a high win rate AND low heat. Those are the rungs of the risk ladder.")
showCond = input.bool(true, "Show condition study", group=G_COND)

var array<string> _cdLbl = array.from("ORB rng  < 10", "ORB rng  10-15", "ORB rng  15-20", "ORB rng  20-30", "ORB rng  30 +", "ADR  < 50%", "ADR  50-75%", "ADR  75-90%", "ADR  90% +", "dir  LONG", "dir  SHORT", "Daily bias AGREES", "Daily bias opposes", "M15 bias AGREES", "M15 bias opposes", "pool SWEPT", "pool not swept", "break .26-.40", "break .40-.60", "break > .60  (thin at mkt)", "delta AGREES break", "delta OPPOSES break", "ZONE headroom < 5", "ZONE headroom 5-15", "ZONE headroom 15-30", "ZONE headroom 30+ / clear", "ZONE obstacle 2-4 touch", "ZONE obstacle 5+ touch")
var table cdTbl = na

f_drawCondTable(table t) =>
    pv4 = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue
    // 20 buckets, five families. Parallel arrays keep it flat and readable.
    cN   = array.new<int>(28, 0)
    cWin = array.new<int>(28, 0)
    cLow = array.new<int>(28, 0)
    cMae = array.new<float>(28, 0.0)
    cPts = array.new<float>(28, 0.0)
    seen = 0
    // Pre-allocated ONCE. Building this with array.from() inside the trade loop
    // would allocate a fresh array per trade and can hit Pine's object ceiling
    // on a long backtest; reusing seven slots costs nothing.
    bIdx = array.new<int>(10, 0)

    // Which _ctxSig this run is studying. -1 = pool everything.
    want = condSig == "M  Frankfurt" ? 0 : condSig == "H  NY" ? 1 : condSig == "U  Sydney" ? 2 : condSig == "G  London" ? 4 : -1

    for i = 0 to strategy.closedtrades - 1
        sz4 = math.abs(strategy.closedtrades.size(i))
        if sz4 > 0
            u4  = sz4 * pv4
            m4  = strategy.closedtrades.max_drawdown(i) / u4
            p4  = strategy.closedtrades.profit(i)       / u4
            id4 = strategy.closedtrades.entry_id(i)
            s4  = id4 == "FRB-L" ? 0 : id4 == "FRB-S" ? 1 : id4 == "NYORB-L" ? 2 : id4 == "NYORB-S" ? 3 : (id4 == "SYD-L" or id4 == "SYD-S") ? 4 : (id4 == "TOK-L" or id4 == "TOK-S") ? 5 : (id4 == "ORB-L" or id4 == "ORB-S") ? 6 : -1
            g4  = s4 < 0 ? -1 : s4 <= 1 ? 0 : s4 <= 3 ? 1 : s4 == 4 ? 2 : s4 == 5 ? 3 : 4
            if g4 >= 0 and (want < 0 or g4 == want)
                eb4 = strategy.closedtrades.entry_bar_index(i)
                k4 = -1
                for q = array.size(_ctxBar) - 1 to 0
                    if array.get(_ctxBar, q) <= eb4 and array.get(_ctxSig, q) == g4
                        k4 := q
                        break
                if k4 >= 0
                    seen := seen + 1
                    rg = array.get(_ctxRng, k4)
                    ad = array.get(_ctxAdr, k4)
                    st = array.get(_ctxStr, k4)
                    // Direction comes from the entry id, not the context - the
                    // id is the literal this script passed to strategy.entry.
                    isLong4 = id4 == "FRB-L" or id4 == "NYORB-L" or id4 == "SYD-L" or id4 == "TOK-L" or id4 == "ORB-L"
                    // Bucket ids, one per family. -1 never happens; the ranges
                    // are exhaustive by construction.
                    bRng = rg < 10.0 ? 0 : rg < 15.0 ? 1 : rg < 20.0 ? 2 : rg < 30.0 ? 3 : 4
                    bAdr = ad < 0.50 ? 5 : ad < 0.75 ? 6 : ad < 0.90 ? 7 : 8
                    bDir = isLong4 ? 9 : 10
                    bAgr = array.get(_ctxAgr, k4) == 1 ? 11 : 12
                    bM15 = array.get(_ctxM15, k4) == 1 ? 13 : 14
                    bPul = array.get(_ctxPool, k4) == 1 ? 15 : 16
                    bStr = st < 0.40 ? 17 : st < 0.60 ? 18 : 19
                    // -1 = no footprint reading for this signal, so it joins
                    // neither delta bucket rather than silently padding one.
                    dl   = array.get(_ctxDelta, k4)
                    bDlt = na(dl) ? -1 : ((isLong4 ? dl > 0 : dl < 0) ? 20 : 21)
                    // ZONE. na headroom = nothing in the path, which is the
                    // GOOD case and gets its own bucket rather than a skip.
                    hd   = array.get(_ctxHead,  k4)
                    hn   = array.get(_ctxHeadN, k4)
                    bHd  = na(hd) ? 25 : hd < 5.0 ? 22 : hd < 15.0 ? 23 : hd < 30.0 ? 24 : 25
                    bHn  = na(hd) ? -1 : (hn >= 5 ? 27 : 26)
                    // Each trade lands in exactly one bucket per family, so it
                    // is counted seven times across seven independent splits.
                    array.set(bIdx, 0, bRng)
                    array.set(bIdx, 1, bAdr)
                    array.set(bIdx, 2, bDir)
                    array.set(bIdx, 3, bAgr)
                    array.set(bIdx, 4, bM15)
                    array.set(bIdx, 5, bPul)
                    array.set(bIdx, 6, bStr)
                    array.set(bIdx, 7, bDlt)
                    array.set(bIdx, 8, bHd)
                    array.set(bIdx, 9, bHn)
                    for bi7 = 0 to 9
                        b = array.get(bIdx, bi7)
                        if b < 0
                            continue
                        array.set(cN,   b, array.get(cN,   b) + 1)
                        array.set(cWin, b, array.get(cWin, b) + (p4 > 0 ? 1 : 0))
                        array.set(cMae, b, array.get(cMae, b) + m4)
                        array.set(cPts, b, array.get(cPts, b) + p4)
                        if m4 <= 20.0
                            array.set(cLow, b, array.get(cLow, b) + 1)

    hD = color.new(#D4A017, 0)
    gD = color.new(color.gray, 10)
    wD = color.new(color.white, 20)
    table.cell(t, 0, 0, "CONDITION  ·  " + condSig, text_color=hD, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 0, "N",       text_color=hD, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 0, "WR %",    text_color=hD, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 0, "avgMAE",  text_color=hD, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 0, "<=20 %",  text_color=hD, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 0, "avg pts", text_color=hD, text_size=size.tiny, text_halign=text.align_right)

    for b = 0 to 27
        n5 = array.get(cN, b)
        wr5  = n5 > 0 ? 100.0 * array.get(cWin, b) / n5 : 0.0
        mae5 = n5 > 0 ? array.get(cMae, b) / n5 : 0.0
        low5 = n5 > 0 ? 100.0 * array.get(cLow, b) / n5 : 0.0
        pts5 = n5 > 0 ? array.get(cPts, b) / n5 : 0.0
        // A bucket earns a higher rung only if the win rate holds AND heat is
        // low. High WR with high heat means it survived on stop width, not on
        // quality, and it will not survive being sized up.
        good = n5 >= 10 and wr5 >= 97.0 and low5 >= 80.0
        thin = n5 < 10
        rowD = thin ? gD : good ? color.new(color.aqua, 0) : wD
        table.cell(t, 0, b + 1, array.get(_cdLbl, b),      text_color=rowD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, b + 1, str.tostring(n5),           text_color=thin ? color.new(color.orange, 0) : wD, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, b + 1, str.tostring(wr5,  "#.##"), text_color=rowD, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, b + 1, str.tostring(mae5, "#.#"),  text_color=rowD, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, b + 1, str.tostring(low5, "#.#"),  text_color=rowD, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 5, b + 1, str.tostring(pts5, "#.#"),  text_color=wD,   text_size=size.tiny, text_halign=text.align_right)

    table.cell(t, 0, 29, "n=" + str.tostring(seen) + " trades in this signal   ·   AQUA = n>=10, WR>=97%, heat<=20 on 80%+   ·   ORANGE n = too thin to read",
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)

if barstate.islast and showCond and strategy.closedtrades > 0
    if na(cdTbl)
        cdTbl := table.new(position.bottom_left, 6, 30,
                  bgcolor=color.new(color.black, 60),
                  border_color=color.new(color.gray, 60), border_width=1,
                  frame_color=color.new(color.gray, 60), frame_width=1)

    f_drawCondTable(cdTbl)

// ═══════════════════════════════════════════════════════════════════════
// TARGET ANATOMY TABLE — his question, 2026-11-10:
//   "identify each taken trade from each signal, their average point, min
//    and maximum, test if TPs are related to ATR, and how we can aim to a
//    long or a short distance take profit instead of counting Rs and ORB
//    ranges."
//
// THREE BLOCKS, answering three different questions:
//
// A  WHAT WAS AVAILABLE vs WHAT WAS TAKEN, per signal. avgMOVE is the
//    exit-independent forward excursion (_ctxMfe); avgGOT is what the
//    strategy actually banked. CAP% is the ratio - the share of the move
//    the current exit converts. A low CAP% is money on the table, not a
//    bad signal.
//
// B  THE UNIT TEST — the part that answers "are TPs related to ATR". The
//    SAME excursion is expressed four ways and each gets a coefficient of
//    variation (sd/mean). The unit with the LOWEST CV is the one the move
//    is closest to CONSTANT in, and therefore the unit a target belongs
//    in. If "raw POINTS" wins, a FIXED-DISTANCE take-profit is right and
//    both R-counting and ORB-range scaling are adding noise. If "÷ ATRd"
//    wins, the target should be an ATR multiple. Falsifiable, not opinion.
//
// C  TARGET FEASIBILITY — for each candidate distance T, the share of
//    taken trades whose forward excursion REACHED T.
//
//    ⚠⚠ READ C AS A CEILING, NOT AN EXPECTANCY. "Reached T" is not
//    "would have banked T": the ORDER of the favourable and adverse
//    excursions inside the path is unknown, so a trade that reached T may
//    have hit its stop first. This is the re-priced-list hazard that has
//    already killed two studies in this file (the MAE stop sweep and the
//    break-strength study). The honest use of C is to RANK candidate
//    distances and kill the impossible ones, then confirm the survivor by
//    actually setting the target and re-running.
//
// WHY NOT max_runup: it is censored by the exit. Under "TP1 · 1R" every
// winner closes at 0.75 × ORB range, so its run-up IS 0.75 × ORB range -
// the table would report that the available target equals the target
// already set, for every signal, in every run.
// ═══════════════════════════════════════════════════════════════════════
var array<float>  _tgTh  = array.from(5.0, 10.0, 15.0, 20.0, 25.0, 30.0, 40.0, 50.0, 75.0, 100.0)
var array<string> _tgSg  = array.from("M  Frankfurt", "G  London", "H  NY", "U  Sydney", "ALL  pooled")
var array<string> _tgUn  = array.from("raw POINTS", "÷ ORB range", "÷ ATR(14) 15m", "÷ ATR(14) daily")
var table tgTbl = na

// Global, not nested: PINE FORBIDS DECLARING A FUNCTION INSIDE A FUNCTION.
// The table is a parameter because a Pine function may not assign to a
// global, which is the same reason f_drawSlrTable takes one.
f_tc(table t, int cx, int ry, string tx, color cc) =>
    table.cell(t, cx, ry, tx, text_color=cc, text_size=size.tiny,
               text_halign=cx == 0 ? text.align_left : text.align_right)

f_drawTgtTable(table t) =>
    pv9 = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue
    // slots 0..4 = M, G, H, U, ALL
    aN   = array.new<int>(5, 0)
    aSum = array.new<float>(5, 0.0)
    aMin = array.new<float>(5, 1.0e9)
    aMax = array.new<float>(5, -1.0e9)
    aGot = array.new<float>(5, 0.0)
    aRng = array.new<float>(5, 0.0)
    aAtD = array.new<float>(5, 0.0)
    // unit test: 0 raw, 1 /rng, 2 /atr15, 3 /atrD
    uS   = array.new<float>(4, 0.0)
    uSS  = array.new<float>(4, 0.0)
    uN   = array.new<int>(4, 0)
    // feasibility, target-major: idx = ti * 5 + slot
    fHit = array.new<int>(50, 0)
    nCtx = array.size(_ctxBar)

    if strategy.closedtrades > 0 and nCtx > 0
        for i = 0 to strategy.closedtrades - 1
            sz9 = math.abs(strategy.closedtrades.size(i))
            if sz9 > 0
                u9  = sz9 * pv9
                id9 = strategy.closedtrades.entry_id(i)
                s9  = id9 == "FRB-L" ? 0 : id9 == "FRB-S" ? 1 : id9 == "NYORB-L" ? 2 : id9 == "NYORB-S" ? 3 : (id9 == "SYD-L" or id9 == "SYD-S") ? 4 : (id9 == "TOK-L" or id9 == "TOK-S") ? 5 : (id9 == "ORB-L" or id9 == "ORB-S") ? 6 : -1
                g9  = s9 < 0 ? -1 : s9 <= 1 ? 0 : s9 <= 3 ? 1 : s9 == 4 ? 2 : s9 == 5 ? 3 : 4
                // ctxSig 0=M 1=H 2=U 4=G  ->  table slot 0=M 1=G 2=H 3=U
                sl9 = g9 == 0 ? 0 : g9 == 4 ? 1 : g9 == 1 ? 2 : g9 == 2 ? 3 : -1
                if sl9 >= 0
                    eb9 = strategy.closedtrades.entry_bar_index(i)
                    k9 = -1
                    for q = nCtx - 1 to 0
                        if array.get(_ctxBar, q) <= eb9 and array.get(_ctxSig, q) == g9
                            k9 := q
                            break
                    if k9 >= 0
                        mv9 = array.get(_ctxMfe,  k9)   // available move, pts
                        rg9 = array.get(_ctxRng,  k9)
                        a15 = array.get(_ctxAtr,  k9)
                        aDy = array.get(_ctxAtrD, k9)
                        gt9 = strategy.closedtrades.profit(i) / u9
                        // counted twice: into its own signal, and into ALL
                        for w = 0 to 1
                            sx = w == 0 ? sl9 : 4
                            array.set(aN,   sx, array.get(aN,   sx) + 1)
                            array.set(aSum, sx, array.get(aSum, sx) + mv9)
                            array.set(aGot, sx, array.get(aGot, sx) + gt9)
                            array.set(aRng, sx, array.get(aRng, sx) + rg9)
                            array.set(aAtD, sx, array.get(aAtD, sx) + (na(aDy) ? 0.0 : aDy))
                            if mv9 < array.get(aMin, sx)
                                array.set(aMin, sx, mv9)
                            if mv9 > array.get(aMax, sx)
                                array.set(aMax, sx, mv9)
                            for t9 = 0 to 9
                                if mv9 >= array.get(_tgTh, t9)
                                    ix9 = t9 * 5 + sx
                                    array.set(fHit, ix9, array.get(fHit, ix9) + 1)
                        // UNIT TEST — pooled. A unit is SKIPPED, not
                        // zero-filled, when its denominator is missing or
                        // zero: "we could not scale this" and "it scaled
                        // to nothing" are different facts.
                        for v9 = 0 to 3
                            den = v9 == 0 ? 1.0 : v9 == 1 ? rg9 : v9 == 2 ? a15 : aDy
                            if not na(den) and den > 0.0
                                z9 = mv9 / den
                                array.set(uS,  v9, array.get(uS,  v9) + z9)
                                array.set(uSS, v9, array.get(uSS, v9) + z9 * z9)
                                array.set(uN,  v9, array.get(uN,  v9) + 1)

    hT = color.new(#D4A017, 0)
    gT = color.new(color.gray, 10)
    wT = color.new(color.white, 20)

    // ─── BLOCK A ───────────────────────────────────────────────────
    aHd = array.from("AVAILABLE vs TAKEN", "N", "avgMOVE", "min", "max", "avgGOT", "CAP %", "MOVE÷rng", "MOVE÷ATRd")
    for cA = 0 to 8
        f_tc(t, cA, 0, array.get(aHd, cA), hT)
    for sA = 0 to 4
        nA = array.get(aN, sA)
        rA = sA + 1
        f_tc(t, 0, rA, array.get(_tgSg, sA), sA == 4 ? color.new(color.aqua, 0) : wT)
        if nA > 0
            mvA = array.get(aSum, sA) / nA
            gtA = array.get(aGot, sA) / nA
            cpA = mvA > 0 ? 100.0 * gtA / mvA : 0.0
            rgA = array.get(aRng, sA) / nA
            adA = array.get(aAtD, sA) / nA
            f_tc(t, 1, rA, str.tostring(nA), wT)
            f_tc(t, 2, rA, str.tostring(mvA, "#.#"), color.new(color.aqua, 0))
            f_tc(t, 3, rA, str.tostring(array.get(aMin, sA), "#.#"), gT)
            f_tc(t, 4, rA, str.tostring(array.get(aMax, sA), "#.#"), gT)
            f_tc(t, 5, rA, str.tostring(gtA, "#.##"), wT)
            f_tc(t, 6, rA, str.tostring(cpA, "#.#"), color.new(cpA < 25.0 ? color.orange : color.white, 10))
            f_tc(t, 7, rA, rgA > 0 ? str.tostring(mvA / rgA, "#.##") : "-", wT)
            f_tc(t, 8, rA, adA > 0 ? str.tostring(mvA / adA, "#.##") : "-", wT)
        else
            f_tc(t, 1, rA, "0", color.new(color.orange, 0))

    // ─── BLOCK B — THE UNIT TEST ───────────────────────────────────
    f_tc(t, 0, 6, "UNIT TEST  ·  which scale is the move constant in?", hT)
    f_tc(t, 1, 6, "n",    hT)
    f_tc(t, 2, 6, "mean", hT)
    f_tc(t, 3, 6, "sd",   hT)
    f_tc(t, 4, 6, "CV",   hT)
    f_tc(t, 5, 6, "lowest CV = the unit a TP belongs in", gT)
    bestV  = -1
    bestCv = 1.0e9
    for v1 = 0 to 3
        n1 = array.get(uN, v1)
        if n1 > 1
            mu1 = array.get(uS, v1) / n1
            va1 = array.get(uSS, v1) / n1 - mu1 * mu1
            sd1 = va1 > 0 ? math.sqrt(va1) : 0.0
            cv1 = mu1 != 0 ? sd1 / math.abs(mu1) : 1.0e9
            if cv1 < bestCv
                bestCv := cv1
                bestV  := v1
    for v2 = 0 to 3
        n2 = array.get(uN, v2)
        r2 = v2 + 7
        f_tc(t, 0, r2, array.get(_tgUn, v2), wT)
        if n2 > 1
            mu2 = array.get(uS, v2) / n2
            va2 = array.get(uSS, v2) / n2 - mu2 * mu2
            sd2 = va2 > 0 ? math.sqrt(va2) : 0.0
            cv2 = mu2 != 0 ? sd2 / math.abs(mu2) : 0.0
            cc2 = v2 == bestV ? color.new(color.lime, 0) : wT
            f_tc(t, 1, r2, str.tostring(n2), gT)
            f_tc(t, 2, r2, str.tostring(mu2, "#.###"), cc2)
            f_tc(t, 3, r2, str.tostring(sd2, "#.###"), gT)
            f_tc(t, 4, r2, str.tostring(cv2, "#.###"), cc2)
            f_tc(t, 5, r2, v2 == bestV ? "<<<  TIGHTEST" : "", cc2)
        else
            f_tc(t, 1, r2, "thin", color.new(color.orange, 0))

    // ─── BLOCK C — FEASIBILITY CEILING ─────────────────────────────
    f_tc(t, 0, 12, "REACHED T  (% of taken trades)", hT)
    f_tc(t, 1, 12, "M", hT)
    f_tc(t, 2, 12, "G", hT)
    f_tc(t, 3, 12, "H", hT)
    f_tc(t, 4, 12, "U", hT)
    f_tc(t, 5, 12, "ALL", hT)
    f_tc(t, 6, 12, "ptsCEIL", hT)
    f_tc(t, 7, 12, "T÷ATRd", hT)
    nAll = array.get(aN, 4)
    adAll = nAll > 0 ? array.get(aAtD, 4) / nAll : 0.0
    for tC = 0 to 9
        TT = array.get(_tgTh, tC)
        rC = tC + 13
        f_tc(t, 0, rC, str.tostring(TT, "#") + " pts", wT)
        for sC = 0 to 4
            nC = array.get(aN, sC)
            hC = array.get(fHit, tC * 5 + sC)
            pcC = nC > 0 ? 100.0 * hC / nC : 0.0
            ccC = nC == 0 ? gT : color.new(pcC >= 50.0 ? color.lime : pcC >= 25.0 ? color.white : color.gray, pcC >= 50.0 ? 0 : 20)
            f_tc(t, sC + 1, rC, nC > 0 ? str.tostring(pcC, "#") : "-", ccC)
        // ptsCEIL = reach share x T. The most points this distance could
        // have produced per trade if every reach were converted and no
        // trade were stopped first. A CEILING, as the footer says.
        pcA = nAll > 0 ? 1.0 * array.get(fHit, tC * 5 + 4) / nAll : 0.0
        f_tc(t, 6, rC, str.tostring(pcA * TT, "#.#"), color.new(color.aqua, 20))
        f_tc(t, 7, rC, adAll > 0 ? str.tostring(TT / adAll, "#.##") : "-", gT)

    // ─── FOOTERS ───────────────────────────────────────────────────
    // The SIGNAL POOL row covers every signal the detector saw, including
    // the ones a filter or a busy slot never let trade. It is the honest
    // denominator for "what does this clock slot offer", because the taken
    // subset above has already been selected by the gates.
    pTxt = ""
    for sF = 0 to 3
        wantF = sF == 0 ? 0 : sF == 1 ? 4 : sF == 2 ? 1 : 2
        nF = 0
        mF = 0.0
        if nCtx > 0
            for qF = 0 to nCtx - 1
                if array.get(_ctxSig, qF) == wantF
                    nF := nF + 1
                    mF := mF + array.get(_ctxMfe, qF)
        // NO LINE CONTINUATION HERE. A trailing operator only continues a
        // Pine statement while a parenthesis is still open; outside one the
        // next line must be indented a NON-multiple of 4, or it is read as a
        // new block -> "end of line without line continuation". Two
        // statements avoid the trap entirely.
        pTxt := pTxt + str.substring(array.get(_tgSg, sF), 0, 1) + " "
        pTxt := pTxt + (nF > 0 ? str.tostring(mF / nF, "#.#") : "-") + " (n" + str.tostring(nF) + ")   "
    f_tc(t, 0, 23, "SIGNAL POOL, every signal incl. never-traded  ·  avg move pts:  " + pTxt, gT)
    // Censoring banner. avgGOT and CAP% are only meaningful against the
    // exit that produced them, and under a fixed TP rung CAP% is capped by
    // construction - say so ON THE CHART rather than in a note nobody has.
    cenTxt = exitMode == "Ratchet (no TP)" ? "exit = RATCHET: avgGOT is a trailing-stop result, which TradingView GUESSES intrabar - treat CAP% as indicative only, never as a ratchet score" : "⚠ exit = " + exitMode + ": avgGOT is CAPPED BY THAT TARGET, so CAP% cannot exceed it by construction. avgMOVE is unaffected - it is measured independently of the exit."
    f_tc(t, 0, 24, cenTxt, color.new(exitMode == "Ratchet (no TP)" ? color.gray : color.orange, 0))
    f_tc(t, 0, 25, "horizon " + str.tostring(tgtHorizon) + " bars from the SIGNAL CLOSE (= the live MARKET entry ref)  ·  SCRIPT SAW " +
               str.format("{0,date,yyyy-MM-dd}", _ctxTimeFirst) + " to " + str.format("{0,date,yyyy-MM-dd}", _ctxTimeLast) +
               "  ·  ⚠ 'REACHED T' is a CEILING not an expectancy: path order is unknown, a trade that reached T may have been stopped first", gT)

if barstate.islast and showTgt and strategy.closedtrades > 0
    if na(tgTbl)
        tgTbl := table.new(position.top_right, 9, 26,
                  bgcolor=color.new(color.black, 55),
                  border_color=color.new(color.gray, 60), border_width=1,
                  frame_color=color.new(color.gray, 60), frame_width=1)
    f_drawTgtTable(tgTbl)

// SIGNAL FUNNEL TABLE - signals -> orders -> fills
// -------------------------------------------------------------------
// Three numbers per signal, and the gap between each pair has a different
// cause:
//   SIGNALS  conditions met. Independent of exit mode - this is the number
//            that must NOT move when only the exit changes.
//   ORDERED  strategy.entry actually called. signals - ordered = blocked by
//            `strategy.position_size == 0`, i.e. a trade was still open.
//   FILLED   the resting C2 limit actually filled and the trade closed.
//            ordered - filled = limits that expired at the session edge
//            without price coming back.
//
// If SIGNALS holds steady across exit modes while ORDERED collapses, the
// position slot is the whole story. If SIGNALS moves too, something else is
// going on and the explanation is wrong.
showSigCnt = input.bool(true, "Show signal funnel (signals -> orders -> fills)", group=G_SLR,
             tooltip="Counts every setup whose conditions were met, whether or not the position slot was free. Places no orders - it cannot change a single trade. Use it to separate 'the setup did not happen' from 'the setup happened and we could not take it'.")

var array<string> _sfLbl = array.from("M  Frankfurt", "H  NY", "G  London", "U  Sydney", "V  Tokyo", "W  Shanghai")
var table sfTbl = na

f_drawSigTable(table t) =>
    sigA = array.from(sigM, sigH, sigG, sigU, sigV, sigW)
    trdA = array.from(trdM, trdH, trdG, trdU, trdV, trdW)
    filA = array.new<int>(6, 0)
    // DIAGNOSTIC 2026-09-23. `filled` totalled 174 while the Tester showed 390
    // trades. Rather than argue about which number is wrong, record what the
    // unmatched trades are actually CALLED - that settles it in one run.
    unm  = 0
    uids = ""
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            idf = strategy.closedtrades.entry_id(i)
            fi = (idf == "FRB-L" or idf == "FRB-S") ? 0 : (idf == "NYORB-L" or idf == "NYORB-S") ? 1 : (idf == "ORB-L" or idf == "ORB-S") ? 2 : (idf == "SYD-L" or idf == "SYD-S") ? 3 : (idf == "TOK-L" or idf == "TOK-S") ? 4 : (idf == "SGE-L" or idf == "SGE-S") ? 5 : -1
            if fi >= 0
                array.set(filA, fi, array.get(filA, fi) + 1)
            else
                unm := unm + 1
                if str.length(uids) < 70 and not str.contains(uids, idf)
                    uids := uids + idf + "  "

    hS = color.new(#D4A017, 0)
    gS = color.new(color.gray, 10)
    wS = color.new(color.white, 20)
    table.cell(t, 0, 0, "SIGNAL FUNNEL", text_color=hS, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 0, "signals",   text_color=hS, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 0, "ordered",   text_color=hS, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 0, "filled",    text_color=hS, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 0, "blocked",   text_color=hS, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 0, "blocked%",  text_color=hS, text_size=size.tiny, text_halign=text.align_right)

    tS = 0
    tO = 0
    tF = 0
    for q = 0 to 5
        sq = array.get(sigA, q)
        oq = array.get(trdA, q)
        fq = array.get(filA, q)
        bq = sq - oq
        bp = sq > 0 ? 100.0 * bq / sq : 0.0
        tS := tS + sq
        tO := tO + oq
        tF := tF + fq
        rowS = sq == 0 ? gS : bp >= 50.0 ? color.new(color.orange, 0) : wS
        table.cell(t, 0, q + 1, array.get(_sfLbl, q), text_color=rowS, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, q + 1, str.tostring(sq),      text_color=wS,   text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, q + 1, str.tostring(oq),      text_color=wS,   text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, q + 1, str.tostring(fq),      text_color=wS,   text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, q + 1, str.tostring(bq),      text_color=rowS, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 5, q + 1, str.tostring(bp, "#.#"), text_color=rowS, text_size=size.tiny, text_halign=text.align_right)

    tB  = tS - tO
    tBp = tS > 0 ? 100.0 * tB / tS : 0.0
    cA  = color.new(color.aqua, 0)
    table.cell(t, 0, 7, "TOTAL",             text_color=cA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 7, str.tostring(tS),    text_color=cA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 7, str.tostring(tO),    text_color=cA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 7, str.tostring(tF),    text_color=cA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 7, str.tostring(tB),    text_color=cA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 7, str.tostring(tBp, "#.#"), text_color=cA, text_size=size.tiny, text_halign=text.align_right)

    table.cell(t, 0, 8, "signals = conditions met, position gate IGNORED. Should NOT change when only the exit mode changes.",
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 0, 9, "closedtrades " + str.tostring(strategy.closedtrades) + "  ·  ORB-matched " + str.tostring(tF) + "  ·  UNMATCHED " + str.tostring(unm) + (unm > 0 ? "  ->  " + uids : "  (none - every trade is an ORB trade)"),
               text_color=unm > 0 ? color.new(color.orange, 0) : color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 0, 10, "signals-ordered = slot busy (a trade was still open).   ordered-filled = C2 limit expired unfilled.",
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 0, 11, "SCRIPT SAW  bars " + str.tostring(bar_index + 1) + "   from " + str.format("{0,date,yyyy-MM-dd}", _firstBarT) + "  to " + str.format("{0,date,yyyy-MM-dd}", time) + "   <- compare with the Tester date range above",
               text_color=color.new(color.aqua, 0), text_size=size.tiny, text_halign=text.align_left)

if barstate.islast and showSigCnt
    if na(sfTbl)
        sfTbl := table.new(position.bottom_right, 6, 12,
                  bgcolor=color.new(color.black, 60),
                  border_color=color.new(color.gray, 60), border_width=1,
                  frame_color=color.new(color.gray, 60), frame_width=1)
    f_drawSigTable(sfTbl)




// ═══════════════════════════════════════════════════════════════════════
// LOSS AUTOPSY — one row per losing trade
// ═══════════════════════════════════════════════════════════════════════
// WHY THIS EXISTS. PF = (wins/losses) x (avgWin/avgLoss). The avgWin half
// was tested to destruction on 2026-09-27: at an IDENTICAL 76-pt stop and
// the same ratchet, TP1 ran 390 trades / 9 losses / PF 4.176, TP2 ran
// 326 / 32 / PF 2.074 and TP3 ran 277 / 47 / PF 1.576. Pushing the target
// multiplies avgWin by 2.3x and costs 23 losses to buy it. That closes the
// avgWin route and leaves the LOSS COUNT as the only lever left on PF.
//
// Nine losses is a readable sample. This prints all of them with the
// conditions they carried, so a filter can be aimed at something MEASURED
// instead of guessed. If five of the nine share a condition, PF 10 is
// real. If they are scattered over four signals and three years, it is
// not — and one run says which.
//
// READS NOTHING FROM THE FUTURE and places no orders. It cannot change a
// single trade.
//
// NOT SUBJECT TO THE PROFOND GAP the way the percentage tables are. Those
// report proportions over a biased ~45% slice. This one either finds a
// losing trade or it does not, and FOUND at the bottom tells you directly
// whether it saw them all — compare it against the Tester's own losing
// count (total trades minus profitable trades).
G_LOSS   = "Loss autopsy"
showLoss = input.bool(true, "Show loss autopsy (every losing trade, one row)", group=G_LOSS,
           tooltip="One row per losing trade, with the setup conditions recorded at SIGNAL time. Places no orders and reads no future data.\n\nCheck FOUND against the Tester's losing-trade count before trusting any pattern in the rows. If FOUND is short, the script is not seeing every trade and the sample is partial.\n\nA condition shared by most rows is a filter CANDIDATE. A condition spread evenly is noise. Confirm by RUNNING the filter, never by subtracting these rows from the trade list - this harness is path-dependent, so blocking a signal frees the slot and reshuffles everything downstream.")
lossMax  = input.int(30, "Max rows to print", group=G_LOSS, minval=5, maxval=60,
           tooltip="Rows print in trade order. FOUND still counts every loss even when more exist than are shown, so the summary block stays complete.")

var table lsTbl = na

f_drawLossTable(table t) =>
    pvL = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue
    hdrC = color.new(color.silver, 0)
    nFound = 0
    nShown = 0
    nNFP = 0
    nM = 0
    nH = 0
    nG = 0
    nU = 0
    nV = 0
    nLong = 0
    nAdr75 = 0
    nBiasOpp = 0
    nUnmatched = 0
    sumRng = 0.0
    sumMae = 0.0
    sumLoss = 0.0
    dowN = array.new<int>(8, 0)

    table.cell(t, 0, 0, "#", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 1, 0, "SIGNAL", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 2, 0, "DIR", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 3, 0, "DATE", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 4, 0, "DOW", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 5, 0, "NFP", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 6, 0, "ORB rng", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 7, 0, "ADR%", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 8, 0, "brk", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 9, 0, "D-bias", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 10, 0, "MAE pts", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 11, 0, "LOSS pts", text_color=hdrC, text_size=size.tiny)

    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            szL = math.abs(strategy.closedtrades.size(i))
            if szL > 0
                uL = szL * pvL
                pL = strategy.closedtrades.profit(i) / uL
                if pL < 0
                    nFound := nFound + 1
                    idL = strategy.closedtrades.entry_id(i)
                    // NYORB must be tested BEFORE ORB - "NYORB-L" contains "ORB".
                    sL = str.contains(idL, "FRB") ? 0 : str.contains(idL, "NYORB") ? 1 : str.contains(idL, "SYD") ? 2 : str.contains(idL, "TOK") ? 3 : str.contains(idL, "ORB") ? 4 : -1
                    dL = str.contains(idL, "-L") ? 1 : -1
                    ebL = strategy.closedtrades.entry_bar_index(i)
                    kL = -1
                    if sL >= 0 and array.size(_ctxBar) > 0
                        for q = array.size(_ctxBar) - 1 to 0
                            if array.get(_ctxBar, q) <= ebL and array.get(_ctxSig, q) == sL
                                kL := q
                                break
                    rngL = kL >= 0 ? array.get(_ctxRng, kL) : na
                    adrL = kL >= 0 ? array.get(_ctxAdr, kL) : na
                    strL = kL >= 0 ? array.get(_ctxStr, kL) : na
                    agrL = kL >= 0 ? array.get(_ctxAgr, kL) : -1
                    nfpL = kL >= 0 ? array.get(_ctxNFP, kL) : 0
                    tL = kL >= 0 ? array.get(_ctxTime, kL) : strategy.closedtrades.entry_time(i)
                    maeL = strategy.closedtrades.max_drawdown(i) / uL
                    dwL = dayofweek(tL, syminfo.timezone)
                    if kL < 0
                        nUnmatched := nUnmatched + 1
                    if nfpL == 1
                        nNFP := nNFP + 1
                    if dL == 1
                        nLong := nLong + 1
                    if not na(adrL) and adrL >= 0.75
                        nAdr75 := nAdr75 + 1
                    if agrL == 0
                        nBiasOpp := nBiasOpp + 1
                    if sL == 0
                        nM := nM + 1
                    if sL == 1
                        nH := nH + 1
                    if sL == 2
                        nU := nU + 1
                    if sL == 3
                        nV := nV + 1
                    if sL == 4
                        nG := nG + 1
                    array.set(dowN, dwL, array.get(dowN, dwL) + 1)
                    sumRng := sumRng + (na(rngL) ? 0.0 : rngL)
                    sumMae := sumMae + maeL
                    sumLoss := sumLoss + math.abs(pL)
                    if nShown < lossMax
                        nShown := nShown + 1
                        rw = nShown
                        sigNm = sL == 0 ? "M FRB" : sL == 1 ? "H NY" : sL == 2 ? "U SYD" : sL == 3 ? "V TOK" : sL == 4 ? "G LON" : "? " + idL
                        dowNm = dwL == 2 ? "Mon" : dwL == 3 ? "Tue" : dwL == 4 ? "Wed" : dwL == 5 ? "Thu" : dwL == 6 ? "Fri" : dwL == 7 ? "Sat" : "Sun"
                        rwC = nfpL == 1 ? color.new(color.orange, 0) : color.new(color.white, 0)
                        table.cell(t, 0, rw, str.tostring(rw), text_color=rwC, text_size=size.tiny)
                        table.cell(t, 1, rw, sigNm, text_color=rwC, text_size=size.tiny)
                        table.cell(t, 2, rw, dL == 1 ? "LONG" : "SHORT", text_color=rwC, text_size=size.tiny)
                        table.cell(t, 3, rw, str.format("{0,date,yyyy-MM-dd}", tL), text_color=rwC, text_size=size.tiny)
                        table.cell(t, 4, rw, dowNm, text_color=rwC, text_size=size.tiny)
                        table.cell(t, 5, rw, nfpL == 1 ? "YES" : "-", text_color=nfpL == 1 ? color.new(color.orange, 0) : color.new(color.gray, 0), text_size=size.tiny)
                        table.cell(t, 6, rw, na(rngL) ? "?" : str.tostring(rngL, "#.#"), text_color=rwC, text_size=size.tiny)
                        table.cell(t, 7, rw, na(adrL) ? "?" : str.tostring(adrL * 100, "#") + "%", text_color=rwC, text_size=size.tiny)
                        table.cell(t, 8, rw, na(strL) ? "?" : str.tostring(strL, "0.##"), text_color=rwC, text_size=size.tiny)
                        table.cell(t, 9, rw, agrL < 0 ? "?" : agrL == 1 ? "agree" : "OPPOSED", text_color=agrL == 0 ? color.new(color.orange, 0) : rwC, text_size=size.tiny)
                        table.cell(t, 10, rw, str.tostring(maeL, "#.#"), text_color=rwC, text_size=size.tiny)
                        table.cell(t, 11, rw, str.tostring(math.abs(pL), "#.#"), text_color=color.new(color.red, 0), text_size=size.tiny)
                        if showLog
                            log.warning("LOSS {0} | {1} {2} | {3} | ORB rng {4} | ADR {5}% | brk {6} | MAE {7} | -{8} pts",
                                        str.tostring(rw), sigNm, dL == 1 ? "LONG" : "SHORT",
                                        str.format("{0,date,yyyy-MM-dd}", tL),
                                        na(rngL) ? "?" : str.tostring(rngL, "#.#"),
                                        na(adrL) ? "?" : str.tostring(adrL * 100, "#"),
                                        na(strL) ? "?" : str.tostring(strL, "0.##"),
                                        str.tostring(maeL, "#.#"), str.tostring(math.abs(pL), "#.#"))

    bs = nShown + 2
    okC = nUnmatched == 0 and nFound > 0 ? color.new(color.lime, 0) : color.new(color.orange, 0)
    table.cell(t, 0, bs, "FOUND", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 1, bs, str.tostring(nFound) + " losses", text_color=okC, text_size=size.tiny)
    table.cell(t, 3, bs, "shown " + str.tostring(nShown), text_color=color.new(color.gray, 0), text_size=size.tiny)
    table.cell(t, 5, bs, "unmatched " + str.tostring(nUnmatched), text_color=okC, text_size=size.tiny)
    table.cell(t, 8, bs, "vs Tester", text_color=color.new(color.aqua, 0), text_size=size.tiny, text_halign=text.align_right)

    table.cell(t, 0, bs + 1, "SIGNAL", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 1, bs + 1, "M " + str.tostring(nM), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 2, bs + 1, "H " + str.tostring(nH), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 3, bs + 1, "G " + str.tostring(nG), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 4, bs + 1, "U " + str.tostring(nU), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 5, bs + 1, "V " + str.tostring(nV), text_color=color.new(color.white, 0), text_size=size.tiny)

    table.cell(t, 0, bs + 2, "DAY", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 1, bs + 2, "Mon " + str.tostring(array.get(dowN, 2)), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 2, bs + 2, "Tue " + str.tostring(array.get(dowN, 3)), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 3, bs + 2, "Wed " + str.tostring(array.get(dowN, 4)), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 4, bs + 2, "Thu " + str.tostring(array.get(dowN, 5)), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 5, bs + 2, "Fri " + str.tostring(array.get(dowN, 6)), text_color=color.new(color.white, 0), text_size=size.tiny)

    table.cell(t, 0, bs + 3, "FLAGS", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 1, bs + 3, "NFP " + str.tostring(nNFP), text_color=nNFP > 0 ? color.new(color.orange, 0) : color.new(color.gray, 0), text_size=size.tiny)
    table.cell(t, 2, bs + 3, "LONG " + str.tostring(nLong), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 3, bs + 3, "SHORT " + str.tostring(nFound - nLong), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 4, bs + 3, "ADR>=75% " + str.tostring(nAdr75), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(t, 5, bs + 3, "bias opp " + str.tostring(nBiasOpp), text_color=color.new(color.white, 0), text_size=size.tiny)

    avgN = nFound > 0 ? nFound : 1
    table.cell(t, 0, bs + 4, "AVG", text_color=hdrC, text_size=size.tiny)
    table.cell(t, 6, bs + 4, str.tostring(sumRng / avgN, "#.#"), text_color=color.new(color.gray, 0), text_size=size.tiny)
    table.cell(t, 10, bs + 4, str.tostring(sumMae / avgN, "#.#"), text_color=color.new(color.gray, 0), text_size=size.tiny)
    table.cell(t, 11, bs + 4, str.tostring(sumLoss / avgN, "#.#"), text_color=color.new(color.gray, 0), text_size=size.tiny)


if barstate.islast and showLoss
    if na(lsTbl)
        lsTbl := table.new(position.top_left, 12, lossMax + 8,
                  bgcolor=color.new(color.black, 60),
                  border_color=color.new(color.gray, 60), border_width=1,
                  frame_color=color.new(color.gray, 60), frame_width=1)
    f_drawLossTable(lsTbl)



// ═══════════════════════════════════════════════════════════════════════
// SIGNAL CONTRIBUTION — which signal actually earns the points
// ═══════════════════════════════════════════════════════════════════════
// Of M / H / G / U, which one carries the system and which is along for
// the ride. The A+ table accumulates per-signal points and never prints
// them; the condition study can only show one signal per run.
//
// THE COLUMN THAT DECIDES IS slot% vs NET%. Every signal holds the single
// position slot while it is open (pyramiding=0), so a signal returning a
// smaller share of the NET than it consumes of the SLOT is blocking the
// others — a net negative even at a perfect win rate. Those rows print
// ORANGE; the biggest net contributor gets an aqua star.
//
// pts/trade is the efficiency number. A signal with few trades and a high
// pts/trade is worth MORE slot, not less.
//
// UNITS ARE POINTS (1 point = 10 pips on gold), normalised per contract
// (profit / size / pointvalue) so percent_of_equity sizing cannot distort
// the comparison between signals.
//
// LAYOUT NOTE 2026-09-27: trimmed from 12 columns to 9 and the two long
// footer sentences removed. Both lived in column 0, which forced that
// column as wide as the sentence and pushed the whole table left into the
// loss autopsy at top_left. Gross+/gross- are derivable from NET and L,
// and heat already has a column in the A+ table.
G_CONTRIB   = "Signal contribution"
showContrib = input.bool(true, "Show per-signal point contribution", group=G_CONTRIB,
              tooltip="Net points earned per signal, so you can see which one carries the system. Places no orders and reads no future data.\n\nAQUA star = biggest net contributor. ORANGE = the signal takes a bigger share of the position SLOT than it returns in points, which is the one shape that makes a signal worth removing even at a high win rate.\n\nCheck the TRADES row against the Tester's trade count before trusting the shares. Units are POINTS (1 point = 10 pips on gold).")

var array<string> _pcLbl = array.from("M Frankfurt", "H NY", "G London", "U Sydney", "V Tokyo", "W Shanghai")
var table pcTbl = na

f_drawContribTable(table t) =>
    pvC = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue
    cN = array.new<int>(6, 0)
    cW = array.new<int>(6, 0)
    cL = array.new<int>(6, 0)
    cPos = array.new<float>(6, 0.0)
    cNeg = array.new<float>(6, 0.0)
    seenC = 0
    otherN = 0

    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            szC = math.abs(strategy.closedtrades.size(i))
            if szC > 0
                uC = szC * pvC
                pC = strategy.closedtrades.profit(i) / uC
                idC = strategy.closedtrades.entry_id(i)
                // NYORB must be tested BEFORE ORB - "NYORB-L" contains "ORB".
                sC = str.contains(idC, "FRB") ? 0 : str.contains(idC, "NYORB") ? 1 : str.contains(idC, "SGE") ? 5 : str.contains(idC, "ORB") ? 2 : str.contains(idC, "SYD") ? 3 : str.contains(idC, "TOK") ? 4 : -1
                if sC >= 0
                    seenC := seenC + 1
                    array.set(cN, sC, array.get(cN, sC) + 1)
                    if pC > 0
                        array.set(cW, sC, array.get(cW, sC) + 1)
                        array.set(cPos, sC, array.get(cPos, sC) + pC)
                    else
                        array.set(cL, sC, array.get(cL, sC) + 1)
                        array.set(cNeg, sC, array.get(cNeg, sC) + math.abs(pC))
                else
                    otherN := otherN + 1

    netTot = 0.0
    bestI = -1
    bestV = -1e12
    for q = 0 to 5
        nq = array.get(cPos, q) - array.get(cNeg, q)
        netTot := netTot + nq
        if array.get(cN, q) > 0 and nq > bestV
            bestV := nq
            bestI := q

    hP = color.new(#D4A017, 0)
    gP = color.new(color.gray, 10)
    wP = color.new(color.white, 20)
    table.cell(t, 0, 0, "SIGNAL", text_color=hP, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 0, "N", text_color=hP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 0, "slot%", text_color=hP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 0, "W", text_color=hP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 0, "L", text_color=hP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 0, "WR%", text_color=hP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 6, 0, "NET", text_color=hP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 7, 0, "pts/tr", text_color=hP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 8, 0, "NET%", text_color=hP, text_size=size.tiny, text_halign=text.align_right)

    for q = 0 to 5
        nq = array.get(cN, q)
        netq = array.get(cPos, q) - array.get(cNeg, q)
        wrq = nq > 0 ? 100.0 * array.get(cW, q) / nq : 0.0
        ptq = nq > 0 ? netq / nq : 0.0
        slotq = seenC > 0 ? 100.0 * nq / seenC : 0.0
        shq = netTot != 0 ? 100.0 * netq / netTot : 0.0
        drag = nq > 0 and shq < slotq - 5.0
        rowP = nq == 0 ? gP : q == bestI ? color.new(color.aqua, 0) : drag ? color.new(color.orange, 0) : wP
        nameq = (q == bestI and nq > 0 ? "★ " : "  ") + array.get(_pcLbl, q)
        table.cell(t, 0, q + 1, nameq, text_color=rowP, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, q + 1, str.tostring(nq), text_color=wP, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, q + 1, str.tostring(slotq, "#.#"), text_color=drag ? color.new(color.orange, 0) : gP, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, q + 1, str.tostring(array.get(cW, q)), text_color=wP, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, q + 1, str.tostring(array.get(cL, q)), text_color=array.get(cL, q) > 0 ? color.new(color.red, 0) : gP, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 5, q + 1, nq > 0 ? str.tostring(wrq, "#.#") : "-", text_color=rowP, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 6, q + 1, str.tostring(netq, "#"), text_color=rowP, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 7, q + 1, nq > 0 ? str.tostring(ptq, "#.#") : "-", text_color=rowP, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 8, q + 1, str.tostring(shq, "#.#"), text_color=rowP, text_size=size.tiny, text_halign=text.align_right)

    cAq = color.new(color.aqua, 0)
    table.cell(t, 0, 7, "TOTAL", text_color=cAq, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 7, str.tostring(seenC), text_color=cAq, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 6, 7, str.tostring(netTot, "#"), text_color=cAq, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 7, 7, seenC > 0 ? str.tostring(netTot / seenC, "#.#") : "-", text_color=cAq, text_size=size.tiny, text_halign=text.align_right)

    // Coverage split across cells instead of one long sentence in column 0 -
    // a wide string there sets the column width and shoves the table sideways
    // into whatever else is on screen.
    covOk = otherN == 0 and seenC == strategy.closedtrades
    covC = covOk ? color.new(color.lime, 0) : color.new(color.orange, 0)
    table.cell(t, 0, 8, "trades", text_color=gP, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 8, str.tostring(strategy.closedtrades), text_color=covC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 8, "ORB", text_color=gP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 8, str.tostring(seenC), text_color=covC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 8, "other", text_color=gP, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 8, str.tostring(otherN), text_color=covC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 6, 8, "vs Tester", text_color=color.new(color.aqua, 0), text_size=size.tiny, text_halign=text.align_right)

if barstate.islast and showContrib and strategy.closedtrades > 0
    if na(pcTbl)
        pcTbl := table.new(position.top_right, 9, 9,
                  bgcolor=color.new(color.black, 60),
                  border_color=color.new(color.gray, 60), border_width=1,
                  frame_color=color.new(color.gray, 60), frame_width=1)
    f_drawContribTable(pcTbl)



// ─── SESSION BACKGROUNDS ──────────────────────────────────────────────
bgcolor(in_asian   ? color.new(color.blue,   90) : na, title="Asian")
bgcolor(in_london  ? color.new(color.yellow, 90) : na, title="London KZ")
bgcolor(in_overlap ? color.new(color.orange, 88) : na, title="NY-Lon Overlap")
