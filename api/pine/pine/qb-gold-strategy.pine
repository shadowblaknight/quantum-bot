//@version=6
strategy("QB Gold Specialist — Strategy", "QB GOLD · STRAT", overlay=true,
         max_bars_back=500, max_labels_count=500, max_lines_count=300, max_boxes_count=300,
         default_qty_type=strategy.percent_of_equity, default_qty_value=1,
         commission_type=strategy.commission.percent, commission_value=0.0,
         slippage=2, pyramiding=0, calc_on_every_tick=false,
         close_entries_rule="ANY")

// ═══════════════════════════════════════════════════════════════════════
//  QB GOLD SPECIALIST — STRATEGY VERSION  (XAUUSD 15m)
//  ─────────────────────────────────────────────────────────────────────
//  Identical detection logic as the indicator.  alert() → strategy.entry()
//  / strategy.exit() so TradingView Strategy Tester computes the full
//  historical win rate instantly across up to ~1 year of 15m bars.
//
//  Exit is determined by WHICH LEVEL PRICE HITS FIRST after entry:
//    slP         → LOSS   (same stop as drawn on the indicator box)
//    tp1/tp2/tp3 → WIN    (select in "Strategy" input group)
//
//  One trade at a time (pyramiding=0).  A new signal is skipped while a
//  previous trade is still running — same behaviour as the live bot.
//
//  How to read results:
//    Open TradingView → Pine Editor → paste → Add to chart
//    Open the "Strategy Tester" tab at the bottom
//    Switch "Exit target" input to compare TP1 / TP2 / TP3 scenarios
// ═══════════════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────────────
G_CORE = "Core"
modFVG      = input.bool(true,  "A) FVG Signal (gold-fvg)",                        group=G_CORE)
modJudas    = input.bool(true,  "B) Judas Sweep (judas-swing)",                    group=G_CORE)
modSB       = input.bool(true,  "C) Silver Bullet (gold-sb)",                      group=G_CORE)
modPsych    = input.bool(true,  "D) Psych Level Bounce (reaction)",                group=G_CORE)
modPsychExt = input.bool(true,  "D2) Psych Extended / outside KZ (reaction-ext)", group=G_CORE)
modLB         = input.bool(false, "E) London Range Breakout",                        group=G_CORE)
lbBiasFilter  = input.bool(false, "E) Require H1 bias alignment",                   group=G_CORE)
modNY         = input.bool(false, "F) NY Session Breakout (London range)",           group=G_CORE)
modORB        = input.bool(false, "G) London ORB — 08:00-08:30 UTC (verified)",     group=G_CORE)
modNYORB      = input.bool(true,  "H) NY ORB — 14:00-14:30 UTC (verified)",         group=G_CORE)
modPDHL       = input.bool(false, "I) PDH/PDL Sweep — liquidity grab & reverse",    group=G_CORE)
modVWAP       = input.bool(false, "J) VWAP Extension Fade — mean reversion",        group=G_CORE)
modPWHL       = input.bool(false, "K) Prev Week H/L Sweep — weekly liquidity grab", group=G_CORE)
modMidnight   = input.bool(false, "L) Midnight Open (00:00 UTC) Bounce",             group=G_CORE)
modFRB        = input.bool(true,  "M) Frankfurt ORB — 07:00-07:30 UTC (pre-London)", group=G_CORE)
modPMFix      = input.bool(false, "N) PM Fix ORB — 12:00-12:30 UTC (gold fix)",     group=G_CORE)
modPreNY      = input.bool(false, "O) Pre-NY ORB — 13:00-13:30 UTC (pre-NY open)",  group=G_CORE)
modASFP       = input.bool(false, "P) Asian SFP — sweep+reverse (07:00-09:00 UTC)", group=G_CORE)
modQ          = input.bool(false, "Q) Triple-Bull Pullback Long — D+H4+H1 bull, 4-bar dip ≥0.69 ATR  [83% WR]", group=G_CORE)
modR          = input.bool(false, "R) Triple-Bear Rally Fade — D+H4+H1 bear, 4-bar bounce ≥0.38 ATR  [68% WR]", group=G_CORE)
modS          = input.bool(false, "S) Pre-NY Triple-Bear Short — D+H4+H1 bear, 13:00-14:30 UTC  [67% WR, PF 1.52]", group=G_CORE)
modT          = input.bool(false, "T) Frankfurt Triple-Bull Long — D+H4+H1 bull, 07:00-09:00 UTC  [64% WR, PF 1.33]", group=G_CORE)

G_STRAT = "Strategy"
exitMode  = input.string("TP1 · 1R", "Exit target",
            options=["TP1 · 1R", "TP2 · 2R", "TP3 · 3R", "Split TP1+TP2", "Trail after TP1", "Scale 30/75/150"],
            tooltip="TP1/TP2/TP3: fixed single-target exits. Split: 50% at TP1 + 50% at TP2. Trail: trail stop after TP1. Scale 30/75/150 (H/M only): 25% at 0.30×range, 50% at 0.75×range, 25% runner at 1.50×range — BE stop on remaining after TP1 hit. Python v4: WR 82.8%, PF 2.030.",
            group=G_STRAT)
showBoxes      = input.bool(true, "Show position boxes", group=G_STRAT)
orbSLMode      = input.string("Wide SL", "H/M) SL mode",
                 options=["Wide SL", "Tight SL + entry TPs", "Tight SL + OR-edge TPs"],
                 tooltip="Wide SL: SL at opposite OR extreme, TPs at OR multiples (baseline). Tight SL + entry TPs: SL at breakout level, TPs scale from entry (1:1 system). Tight SL + OR-edge TPs: tiny SL, original large TPs (asymmetric R:R).",
                 group=G_STRAT)
orbBiasFilter  = input.bool(true,  "H/M) HTF bias filter — skip trades against trend", group=G_STRAT)
orbBiasTF      = input.string("H1+H4", "H/M) Bias timeframe",
                 options=["H1", "H4", "Daily", "H1+H4", "H1+H4+D"],
                 tooltip="H4 = current baseline (PF 1.409). H1+H4 = both must align (PF 1.458, 293 trades). H1+H4+D = all three must align (strictest). H1 alone and Daily alone are reference points.",
                 group=G_STRAT)
nyorbDirFilter = input.string("Both", "H) Direction filter",  options=["Both", "Long only", "Short only"],
                 tooltip="London Bias study (54yr): the PM fix window (14:00 UTC) has a structural short tailwind. Test 'Short only' to isolate whether H shorts carry the PF.",
                 group=G_STRAT)
frbDirFilter   = input.string("Short only", "M) Direction filter",  options=["Both", "Long only", "Short only"], group=G_STRAT)
sDirFilter     = input.string("Short only", "S) Direction filter", options=["Both", "Long only", "Short only"],
                 tooltip="Short only = Pre-NY triple-bear (67% WR, PF 1.52 — the proven setup). Long only = Pre-NY triple-bull (untested inverse). Both = fire whichever side aligns.",
                 group=G_STRAT)
tDirFilter     = input.string("Long only",  "T) Direction filter", options=["Both", "Long only", "Short only"],
                 tooltip="Long only = Frankfurt triple-bull (64% WR, PF 1.33 — the proven setup). Short only = Frankfurt triple-bear (untested inverse). Both = fire whichever side aligns.",
                 group=G_STRAT)
orbTPMult      = input.float(0.75, "H/M) TP1 multiplier",    minval=0.25, maxval=2.0, step=0.25,
                 tooltip="1.0 = standard 1R (baseline PF 1.145). 0.75 = ¾R — raises WR at cost of smaller wins. Find the WR/PF sweet spot between 0.75 and 1.0.",
                 group=G_STRAT)
orbNFPFilter   = input.bool(false, "H/M) Skip first-Friday of month (NFP days)", group=G_STRAT)
orbADRGuard    = input.bool(false, "H/M) Skip when >90% ADR already consumed",   group=G_STRAT)
orbSeasonFilt  = input.bool(false, "H/M) Seasonal bias (Sep=Short only · Jan=Long only)",
                 tooltip="September is 90% bearish over 10yr (gold seasonal). January is 80% bullish. Blocks counter-seasonal trades in these two months only.",
                 group=G_STRAT)
orbBreakAsianLo = input.bool(true,  "M) Require entry closes below Asian low (WR 84.6%)",
                 tooltip="Frankfurt ORB SHORT only fires when entry bar closes below the Asian session low (00:00-07:00 UTC range). Sweeps overnight stop-losses = maximum bearish conviction. Python analysis: WR 84.6%, PF 1.655 (N=26/5.5yr ~ 5 trades/year vs 40/yr unfiltered).",
                 group=G_STRAT)
orbNYFRBCtxS   = input.bool(false, "H SHORT) Require Frankfurt SHORT today + H1 bear (WR 75%)",
                 tooltip="H SHORT only fires when Frankfurt ORB also broke SHORT today AND H1 is bearish at NY time. Python: WR 75.0%, PF 1.935 (N=64, ~12/yr). Continuation setup: Frankfurt+H1 both bear, NY confirms down.",
                 group=G_STRAT)
orbNYFRBCtxL   = input.bool(false, "H LONG) Require Frankfurt SHORT today + H1 bull (WR 73.6%)",
                 tooltip="H LONG only fires when Frankfurt ORB broke SHORT earlier today AND H1 has since flipped bullish. Python: WR 73.6%, PF 1.542 (N=91, ~17/yr). Reversal setup: Frankfurt exhausted sellers, NY sees fresh buyers.",
                 group=G_STRAT)
i_hm_useDow  = input.bool(true,  "H/M) Day of Week filter",  group=G_STRAT)
i_hm_dow_mon = input.bool(false, "H/M   Mon",                group=G_STRAT)
i_hm_dow_tue = input.bool(true,  "H/M   Tue",                group=G_STRAT)
i_hm_dow_wed = input.bool(false, "H/M   Wed",                group=G_STRAT)
i_hm_dow_thu = input.bool(false, "H/M   Thu",                group=G_STRAT)
i_hm_dow_fri = input.bool(false, "H/M   Fri",                group=G_STRAT)

G_FILT = "Filters"
adrFVGMax     = input.float(0.85, "FVG / SB max ADR consumed",     group=G_FILT, minval=0.50, maxval=1.50, step=0.05)
adrJudasMax   = input.float(0.90, "Judas max ADR consumed",        group=G_FILT, minval=0.50, maxval=1.50, step=0.05)
adrPsychMax   = input.float(1.20, "Psych bounce max ADR consumed", group=G_FILT, minval=0.70, maxval=2.50, step=0.05)
atrLength     = input.int(14,     "ATR period",                    group=G_FILT, minval=2,    maxval=50)
emaLength     = input.int(20,     "HTF bias EMA period",           group=G_FILT, minval=5,    maxval=100)
fvgMinGapATR  = input.float(0.10, "FVG min gap (× ATR)",           group=G_FILT, minval=0.03, step=0.03)
fvgMaxFillPct = input.float(0.50, "FVG max fill before entry",     group=G_FILT, minval=0.0,  maxval=1.0, step=0.05)
fvgMaxAgeBars = input.int(48,     "FVG max age (bars)",             group=G_FILT, minval=4,    maxval=200)
slMinH1ATR    = input.float(0.30, "SL min (× H1 ATR)",             group=G_FILT, minval=0.1,  step=0.05)
slMaxH1ATR    = input.float(3.00, "SL max (× H1 ATR)",             group=G_FILT, minval=1.0,  step=0.10)

// ─── HTF BIAS (H1 / H4 / D) ──────────────────────────────────────────
f_htfBias(int emaLen, int atrLen) =>
    e = ta.ema(close, emaLen)
    b = close[1] > e[1] ? 1 : close[1] < e[1] ? -1 : 0
    a = ta.atr(atrLen)
    [b, a]

[h1B, h1ATR] = request.security(syminfo.tickerid, "60",  f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[h4B, h4ATR] = request.security(syminfo.tickerid, "240", f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[hdB, hdATR] = request.security(syminfo.tickerid, "D",   f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)

atrVal = ta.atr(atrLength)

// Bias check helpers for H/M filter (resolved once per bar)
_orbBiasLong  = orbBiasTF == "H1" ? h1B >= 0 : orbBiasTF == "Daily" ? hdB >= 0 : orbBiasTF == "H1+H4" ? (h1B == 1 and h4B == 1) : orbBiasTF == "H1+H4+D" ? (h1B == 1 and h4B == 1 and hdB == 1) : h4B >= 0
_orbBiasShort = orbBiasTF == "H1" ? h1B <= 0 : orbBiasTF == "Daily" ? hdB <= 0 : orbBiasTF == "H1+H4" ? (h1B == -1 and h4B == -1) : orbBiasTF == "H1+H4+D" ? (h1B == -1 and h4B == -1 and hdB == -1) : h4B <= 0

// ─── SESSION CONTEXT ──────────────────────────────────────────────────
_hourUtc  = hour(time, "UTC")
_minOfDay = _hourUtc * 60 + minute(time, "UTC")
_newDay   = ta.change(time("D")) != 0

_atr14d     = request.security(syminfo.tickerid, "D", ta.atr(14))
_todayHigh  = request.security(syminfo.tickerid, "D", high)
_todayLow   = request.security(syminfo.tickerid, "D", low)
_todayOpen  = request.security(syminfo.tickerid, "D", open)
_priorClose = request.security(syminfo.tickerid, "D", close[1])
_pdh         = request.security(syminfo.tickerid, "D", high[1])
_pdl         = request.security(syminfo.tickerid, "D", low[1])
_pwh         = request.security(syminfo.tickerid, "W", high[1])
_pwl         = request.security(syminfo.tickerid, "W", low[1])
_newWeek     = ta.change(time("W")) != 0
vwapVal      = ta.vwap(hlc3)

var float _midnightOpen = na
if _newDay
    _midnightOpen := open

_adrConsumed   = _atr14d > 0 ? (_todayHigh - _todayLow) / _atr14d : 0.0
_adrQuiet      = _adrConsumed < 0.75
_adrRemainTo75 = math.max(0.0, _atr14d * 0.75 - (_todayHigh - _todayLow))

// H/M research gate helpers (placed here — needs _adrConsumed defined first)
_isNFP      = dayofweek == dayofweek.friday and dayofmonth <= 7
_ret4bar    = atrVal > 0 ? (close - close[4]) / atrVal : 0.0   // 4-bar momentum in ATR units
_mnth       = month(time)
_orbSeasonL = not orbSeasonFilt or _mnth != 9   // Sep blocks longs (90% bearish)
_orbSeasonS = not orbSeasonFilt or _mnth != 1   // Jan blocks shorts (80% bullish)
_orbGateOk  = (not orbADRGuard or _adrConsumed[1] < 0.90) and (not orbNFPFilter or not _isNFP)
_hm_dow     = dayofweek(time, "UTC")
_hm_dow_ok  = not i_hm_useDow or (_hm_dow == dayofweek.monday and i_hm_dow_mon) or (_hm_dow == dayofweek.tuesday and i_hm_dow_tue) or (_hm_dow == dayofweek.wednesday and i_hm_dow_wed) or (_hm_dow == dayofweek.thursday and i_hm_dow_thu) or (_hm_dow == dayofweek.friday and i_hm_dow_fri)

// ─── CVD ──────────────────────────────────────────────────────────────
_signedVol = close > open ? volume : close < open ? -volume : 0.0
var float _cvdRunning = 0.0
_cvdRunning := _cvdRunning + _signedVol
var float _cvdBase = 0.0
if _newDay
    _cvdBase := _cvdRunning - _signedVol
cvd   = _cvdRunning - _cvdBase
cvdMa = ta.ema(cvd, 14)

// ─── SESSION GATES (UTC) ──────────────────────────────────────────────
in_asian   = timeframe.isintraday and (_minOfDay >= 0   and _minOfDay < 480)
in_london  = timeframe.isintraday and (_minOfDay >= 480 and _minOfDay < 660)
in_overlap = timeframe.isintraday and (_minOfDay >= 780 and _minOfDay < 1020)
in_sb_win  = timeframe.isintraday and (_minOfDay >= 900 and _minOfDay < 960)
in_kz      = in_london or in_overlap

// ─── ADR GATES  (use [1] so the trigger bar's wick can't self-block) ──
adr_fvg_ok   = _adrConsumed[1] < adrFVGMax
adr_judas_ok = _adrConsumed[1] < adrJudasMax
adr_psych_ok = _adrConsumed[1] < adrPsychMax
adr_hard_ok  = _adrConsumed    < 2.50

// ─── ASIAN RANGE ──────────────────────────────────────────────────────
var float ar_hi    = na
var float ar_lo    = na
var bool  ar_locked = false

if _newDay
    ar_hi    := na
    ar_lo    := na
    ar_locked := false

if in_asian
    ar_hi := na(ar_hi) ? high : math.max(ar_hi, high)
    ar_lo := na(ar_lo) ? low  : math.min(ar_lo, low)

if not in_asian and in_asian[1] and not na(ar_hi)
    ar_locked := true

// ─── BOS TRACKING ─────────────────────────────────────────────────────
SWG = 3
var float _prev_sh   = na
var float _prev_sl   = na
var int   bos_bull_b = na
var int   bos_bear_b = na

_sh_now = ta.pivothigh(high, SWG, SWG)
_sl_now = ta.pivotlow(low,   SWG, SWG)

if not na(_sh_now)
    if not na(_prev_sh) and _sh_now > _prev_sh
        bos_bull_b := bar_index[SWG]
    _prev_sh := _sh_now

if not na(_sl_now)
    if not na(_prev_sl) and _sl_now < _prev_sl
        bos_bear_b := bar_index[SWG]
    _prev_sl := _sl_now

bos_bull_ok = not na(bos_bull_b) and (bar_index - bos_bull_b) <= 30
bos_bear_ok = not na(bos_bear_b) and (bar_index - bos_bear_b) <= 30

// ─── FVG POOL ─────────────────────────────────────────────────────────
var array<float> fU     = array.new<float>(0)
var array<float> fL     = array.new<float>(0)
var array<int>   fDir   = array.new<int>(0)
var array<int>   fBar   = array.new<int>(0)
var array<float> fFill  = array.new<float>(0)
var array<bool>  fFired = array.new<bool>(0)

if barstate.isconfirmed and atrVal > 0
    bull_fvg = low > high[2]
    bear_fvg = high < low[2]
    bull_gap = bull_fvg ? (low - high[2]) : 0.0
    bear_gap = bear_fvg ? (low[2] - high) : 0.0

    if bull_fvg and bull_gap >= atrVal * fvgMinGapATR
        array.push(fU,     low)
        array.push(fL,     high[2])
        array.push(fDir,   1)
        array.push(fBar,   bar_index - 1)
        array.push(fFill,  0.0)
        array.push(fFired, false)

    if bear_fvg and bear_gap >= atrVal * fvgMinGapATR
        array.push(fU,     low[2])
        array.push(fL,     high)
        array.push(fDir,   -1)
        array.push(fBar,   bar_index - 1)
        array.push(fFill,  0.0)
        array.push(fFired, false)

    while array.size(fU) > 25
        array.shift(fU)
        array.shift(fL)
        array.shift(fDir)
        array.shift(fBar)
        array.shift(fFill)
        array.shift(fFired)

if barstate.isconfirmed and array.size(fU) > 0
    for idx = array.size(fU) - 1 to 0
        u   = array.get(fU,   idx)
        l   = array.get(fL,   idx)
        d   = array.get(fDir, idx)
        gsz = u - l
        if gsz <= 0
            continue
        if d == 1 and low < u
            array.set(fFill, idx, math.min(1.0, math.max(0.0, u - math.max(l, low)) / gsz))
        if d == -1 and high > l
            array.set(fFill, idx, math.min(1.0, math.max(0.0, math.min(u, high) - l) / gsz))

// ─── POSITION BOX (same visual as indicator) ──────────────────────────
f_drawPosBox(float e, float slP, float tp3) =>
    if showBoxes
        r = bar_index + 40
        box.new(bar_index, math.max(e, tp3), r, math.min(e, tp3),
                border_color=color.new(color.teal, 50), bgcolor=color.new(color.teal, 88))
        box.new(bar_index, math.max(e, slP), r, math.min(e, slP),
                border_color=color.new(color.red, 55), bgcolor=color.new(color.red, 90))
        line.new(bar_index, e, r, e,
                 color=color.new(color.gray, 10), style=line.style_dashed, width=1)

// ─── EXIT LIMIT HELPER ────────────────────────────────────────────────
f_exitLim(float tp1, float tp2, float tp3) =>
    exitMode == "TP1 · 1R" ? tp1 : exitMode == "TP3 · 3R" ? tp3 : tp2

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL A — Gold FVG  (gold-fvg)
// ═══════════════════════════════════════════════════════════════════════
if modFVG and barstate.isconfirmed and in_kz and adr_fvg_ok and adr_hard_ok and not na(h1ATR) and h1ATR > 0 and array.size(fU) > 0 and strategy.position_size == 0
    firedA = false
    for idx = array.size(fU) - 1 to 0
        if firedA or array.get(fFired, idx)
            continue
        u       = array.get(fU,    idx)
        l       = array.get(fL,    idx)
        d       = array.get(fDir,  idx)
        birth   = array.get(fBar,  idx)
        fillPct = array.get(fFill, idx)

        if (bar_index - birth) > fvgMaxAgeBars or fillPct > fvgMaxFillPct
            continue

        touch = d == 1 ? (low <= u and high >= l) : (high >= l and low <= u)
        if not touch
            continue

        if not ((d == 1 and bos_bull_ok) or (d == -1 and bos_bear_ok))
            continue

        buf      = math.max(0.20 * atrVal, 0.08 * h1ATR)
        proximal = d == 1 ? u : l
        distal   = d == 1 ? l : u
        entryP   = proximal
        slP      = d == 1 ? distal - buf : distal + buf
        slDist   = math.abs(entryP - slP)

        if slDist <= 0
            continue

        tp1Mult = (_adrQuiet and _adrRemainTo75 > 0 and _adrRemainTo75 < slDist * 1.5) ? 0.75 : 1.0
        tp1 = d == 1 ? entryP + slDist * tp1Mult : entryP - slDist * tp1Mult
        tp2 = d == 1 ? entryP + slDist * 2.0     : entryP - slDist * 2.0
        tp3 = d == 1 ? entryP + slDist * 3.0     : entryP - slDist * 3.0

        if not ((d == 1 ? slP < entryP : slP > entryP) and (d == 1 ? tp1 > entryP : tp1 < entryP))
            continue

        array.set(fFired, idx, true)
        firedA := true

        eId = d == 1 ? "FVG-L" : "FVG-S"
        strategy.entry(eId, d == 1 ? strategy.long : strategy.short, comment="gold-fvg")
        strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=f_exitLim(tp1, tp2, tp3))
        f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL B — Judas Sweep  (judas-swing)
// Limit orders at the swept level — accurate R:R backtest
// ═══════════════════════════════════════════════════════════════════════
var bool judas_hi_done = false
var bool judas_lo_done = false

if _newDay
    judas_hi_done := false
    judas_lo_done := false
    strategy.cancel("JUDAS-S")
    strategy.cancel("JUDAS-L")

// Expire pending limit orders when London session ends
if not in_london and in_london[1]
    strategy.cancel("JUDAS-S")
    strategy.cancel("JUDAS-L")

if modJudas and barstate.isconfirmed and in_london and ar_locked and adr_judas_ok and adr_hard_ok and not na(ar_hi) and not na(ar_lo) and not na(h1ATR) and h1ATR > 0 and strategy.position_size == 0
    aRef = nz(atrVal, h1ATR)

    // SHORT — swept Asian high, closed back inside → LIMIT at ar_hi (retest entry)
    if not judas_hi_done and high > ar_hi and close < ar_hi and (high - ar_hi) >= aRef * 0.15
        buf    = aRef * 0.20
        slP    = high + buf
        entryP = ar_hi          // limit fills exactly at the swept level on retest
        slDist = slP - entryP   // sweep height + buf (small, precise SL)
        if slDist > 0
            tp1 = entryP - slDist * 1.0
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            judas_hi_done := true
            strategy.entry("JUDAS-S", strategy.short, limit=entryP, comment="judas-swing · SHORT")
            strategy.exit("JUDAS-S-X", from_entry="JUDAS-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "⚡ Judas SHORT",
                      style=label.style_label_down, color=color.new(color.red, 5),
                      textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

    // LONG — swept Asian low, closed back inside → LIMIT at ar_lo (retest entry)
    if not judas_lo_done and low < ar_lo and close > ar_lo and (ar_lo - low) >= aRef * 0.15 and strategy.position_size == 0
        buf    = aRef * 0.20
        slP    = low - buf
        entryP = ar_lo          // limit fills exactly at the swept level on retest
        slDist = entryP - slP   // sweep depth + buf (small, precise SL)
        if slDist > 0
            tp1 = entryP + slDist * 1.0
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            judas_lo_done := true
            strategy.entry("JUDAS-L", strategy.long, limit=entryP, comment="judas-swing · LONG")
            strategy.exit("JUDAS-L-X", from_entry="JUDAS-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "⚡ Judas LONG",
                      style=label.style_label_up, color=color.new(color.teal, 5),
                      textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL C — Silver Bullet  (gold-sb)
// ═══════════════════════════════════════════════════════════════════════
var bool sb_done = false

if _newDay
    sb_done := false

if modSB and barstate.isconfirmed and in_sb_win and not sb_done and adr_fvg_ok and adr_hard_ok and not na(h1ATR) and h1ATR > 0 and array.size(fU) > 0 and strategy.position_size == 0
    firedC = false
    for idx = array.size(fU) - 1 to 0
        if firedC or array.get(fFired, idx)
            continue
        u       = array.get(fU,    idx)
        l       = array.get(fL,    idx)
        d       = array.get(fDir,  idx)
        birth   = array.get(fBar,  idx)
        fillPct = array.get(fFill, idx)

        if (bar_index - birth) > 48 or fillPct > 0.50
            continue

        touch = d == 1 ? (low <= u and high >= l) : (high >= l and low <= u)
        if not touch
            continue

        buf      = math.max(0.20 * atrVal, 0.08 * h1ATR)
        proximal = d == 1 ? u : l
        distal   = d == 1 ? l : u
        entryP   = proximal
        slP      = d == 1 ? distal - buf : distal + buf
        slDist   = math.abs(entryP - slP)

        if slDist <= 0
            continue

        // Gold SB uses extended TPs: 1.5R / 2.5R / 4R
        tp1Mult_sb = (_adrQuiet and _adrRemainTo75 > 0 and _adrRemainTo75 < slDist * 1.5) ? 1.0 : 1.5
        tp1 = d == 1 ? entryP + slDist * tp1Mult_sb : entryP - slDist * tp1Mult_sb
        tp2 = d == 1 ? entryP + slDist * 2.5        : entryP - slDist * 2.5
        tp3 = d == 1 ? entryP + slDist * 4.0        : entryP - slDist * 4.0

        if not (d == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
            continue

        array.set(fFired, idx, true)
        sb_done := true
        firedC  := true

        eId = d == 1 ? "SB-L" : "SB-S"
        strategy.entry(eId, d == 1 ? strategy.long : strategy.short, comment="gold-sb")
        strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=f_exitLim(tp1, tp2, tp3))
        f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL D — Psychological Level Bounce  (reaction)
// ═══════════════════════════════════════════════════════════════════════
var bool psych_done = false

if _newDay
    psych_done := false

if modPsych and barstate.isconfirmed and in_kz and adr_psych_ok and adr_hard_ok and not psych_done and not na(h1ATR) and h1ATR > 0 and strategy.position_size == 0
    lvl50     = math.round(close / 50.0)  * 50.0
    lvl100    = math.round(close / 100.0) * 100.0
    nearLevel = math.abs(close - lvl50) <= math.abs(close - lvl100) ? lvl50 : lvl100
    tol       = atrVal * 0.25

    bounceLong  = low  <= nearLevel + tol and low  <= nearLevel and close > nearLevel
    bounceShort = high >= nearLevel - tol and high >= nearLevel and close < nearLevel
    dir = bounceLong and not bounceShort ? 1 : bounceShort and not bounceLong ? -1 : 0

    if dir != 0
        buf    = math.max(0.30 * atrVal, 0.10 * h1ATR)
        wick   = dir == 1 ? low : high
        entryP = nearLevel
        slP    = dir == 1 ? wick - buf : wick + buf
        slDist = math.abs(entryP - slP)
        slH1   = slDist / h1ATR

        if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
            tp1 = dir == 1 ? entryP + slDist * 1.0 : entryP - slDist * 1.0
            tp2 = dir == 1 ? entryP + slDist * 2.0 : entryP - slDist * 2.0
            tp3 = dir == 1 ? entryP + slDist * 3.0 : entryP - slDist * 3.0

            if (dir == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
                psych_done := true
                eId = dir == 1 ? "PSYCH-L" : "PSYCH-S"
                strategy.entry(eId, dir == 1 ? strategy.long : strategy.short, comment="reaction")
                strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=f_exitLim(tp1, tp2, tp3))
                lvlStr = str.tostring(math.round(nearLevel))
                label.new(bar_index, dir == 1 ? low : high,
                          lvlStr + " Psych " + (dir == 1 ? "Bounce" : "Reject"),
                          style=dir == 1 ? label.style_label_up : label.style_label_down,
                          color=color.new(color.purple, 10), textcolor=color.white, size=size.tiny)
                f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL D2 — Psych Extended  (reaction-ext)
// ═══════════════════════════════════════════════════════════════════════
var bool psych_ext_done = false

if _newDay
    psych_ext_done := false

if modPsychExt and barstate.isconfirmed and not in_kz and adr_psych_ok and adr_hard_ok and not psych_ext_done and not na(h1ATR) and h1ATR > 0 and strategy.position_size == 0
    nearLevel = math.round(close / 100.0) * 100.0
    tol       = atrVal * 0.25

    bounceLong  = low  <= nearLevel + tol and low  <= nearLevel and close > nearLevel
    bounceShort = high >= nearLevel - tol and high >= nearLevel and close < nearLevel
    dir = bounceLong and not bounceShort ? 1 : bounceShort and not bounceLong ? -1 : 0

    if dir != 0
        h1ok       = h1B == dir
        h4ok       = h4B == dir
        hdok       = hdB == dir
        alignCount = (h1ok ? 1 : 0) + (h4ok ? 1 : 0) + (hdok ? 1 : 0)

        if alignCount >= 2
            buf    = math.max(0.30 * atrVal, 0.10 * h1ATR)
            wick   = dir == 1 ? low : high
            entryP = nearLevel
            slP    = dir == 1 ? wick - buf : wick + buf
            slDist = math.abs(entryP - slP)
            slH1   = slDist / h1ATR

            if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
                tp1 = dir == 1 ? entryP + slDist * 1.0 : entryP - slDist * 1.0
                tp2 = dir == 1 ? entryP + slDist * 2.0 : entryP - slDist * 2.0
                tp3 = dir == 1 ? entryP + slDist * 3.0 : entryP - slDist * 3.0

                if (dir == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
                    psych_ext_done := true
                    eId = dir == 1 ? "EXT-L" : "EXT-S"
                    strategy.entry(eId, dir == 1 ? strategy.long : strategy.short, comment="reaction-ext")
                    strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=f_exitLim(tp1, tp2, tp3))
                    lvlStr = str.tostring(math.round(nearLevel))
                    label.new(bar_index, dir == 1 ? low : high,
                              "⚡ " + lvlStr + " [EXT] " + (dir == 1 ? "Bounce" : "Reject"),
                              style=dir == 1 ? label.style_label_up : label.style_label_down,
                              color=color.new(color.orange, 10), textcolor=color.white, size=size.tiny)
                    f_drawPosBox(entryP, slP, tp3)

// ─── LONDON SESSION RANGE (for Signal F) ─────────────────────────────
var float lon_hi     = na
var float lon_lo     = na
var bool  lon_locked = false

if _newDay
    lon_hi     := na
    lon_lo     := na
    lon_locked := false

if in_london
    lon_hi := na(lon_hi) ? high : math.max(lon_hi, high)
    lon_lo := na(lon_lo) ? low  : math.min(lon_lo, low)

if not in_london and in_london[1] and not na(lon_hi)
    lon_locked := true

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL E — London Range Breakout
// No daily limit — can re-fire after a stop-out while still in London.
// ATR-based SL (1.5×ATR) — independent of session range width.
// ADR gate: skip if day already consumed 80% of its average range.
// ═══════════════════════════════════════════════════════════════════════
if modLB and barstate.isconfirmed and in_london and ar_locked and _adrConsumed < 0.80 and not na(ar_hi) and not na(ar_lo) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    ar_range = ar_hi - ar_lo
    if ar_range > atrVal * 0.15
        slAtr = 1.5 * atrVal
        // LONG — bar closed above Asian high
        if close > ar_hi and (not lbBiasFilter or h1B == 1)
            entryP = close
            slP    = entryP - slAtr
            tp1    = entryP + slAtr
            tp2    = entryP + slAtr * 2.0
            tp3    = entryP + slAtr * 3.0
            strategy.entry("LB-L", strategy.long, comment="london-breakout · LONG")
            strategy.exit("LB-L-X", from_entry="LB-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "LB L", style=label.style_label_up,
                      color=color.new(color.green, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

        // SHORT — bar closed below Asian low
        else if close < ar_lo and (not lbBiasFilter or h1B == -1)
            entryP = close
            slP    = entryP + slAtr
            tp1    = entryP - slAtr
            tp2    = entryP - slAtr * 2.0
            tp3    = entryP - slAtr * 3.0
            strategy.entry("LB-S", strategy.short, comment="london-breakout · SHORT")
            strategy.exit("LB-S-X", from_entry="LB-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "LB S", style=label.style_label_down,
                      color=color.new(color.red, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL F — NY Session Breakout (of London range)
// ATR-based SL. No daily limit — can re-fire after a stop-out.
// ═══════════════════════════════════════════════════════════════════════
if modNY and barstate.isconfirmed and in_overlap and lon_locked and _adrConsumed < 0.80 and not na(lon_hi) and not na(lon_lo) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    lon_range = lon_hi - lon_lo
    if lon_range > atrVal * 0.15
        slAtr = 1.5 * atrVal
        if close > lon_hi
            entryP = close
            slP    = entryP - slAtr
            tp1    = entryP + slAtr
            tp2    = entryP + slAtr * 2.0
            tp3    = entryP + slAtr * 3.0
            strategy.entry("NY-L", strategy.long, comment="ny-breakout · LONG")
            strategy.exit("NY-L-X", from_entry="NY-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "NY L", style=label.style_label_up,
                      color=color.new(color.lime, 5), textcolor=color.black, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

        else if close < lon_lo
            entryP = close
            slP    = entryP + slAtr
            tp1    = entryP - slAtr
            tp2    = entryP - slAtr * 2.0
            tp3    = entryP - slAtr * 3.0
            strategy.entry("NY-S", strategy.short, comment="ny-breakout · SHORT")
            strategy.exit("NY-S-X", from_entry="NY-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "NY S", style=label.style_label_down,
                      color=color.new(color.orange, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ─── OPENING RANGE TRACKERS ───────────────────────────────────────────
// Frankfurt ORB: 07:00–07:30 UTC (pre-London institutional open)
in_frb_window  = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 450)
in_frb_trade   = timeframe.isintraday and (_minOfDay >= 450 and _minOfDay < 660)
var float frb_hi = na
var float frb_lo = na
var bool  frb_locked = false
var bool  frb_done   = false
var bool  frb_short_today = false  // true if Frankfurt ORB fired SHORT today (used by Signal H)

// Pre-Frankfurt Asian low (00:00-07:00 UTC, before FRB window opens)
var float ar_lo_prefrb = na

// London ORB: 08:00–08:30 UTC (first 2 bars of London on 15M)
in_lorb_window = in_london and _minOfDay < 510
var float lorb_hi = na
var float lorb_lo = na
var bool  lorb_locked = false
var bool  lorb_done   = false

// PM Fix ORB: 12:00–12:30 UTC (London PM gold fix window)
in_pmfix_window = timeframe.isintraday and (_minOfDay >= 720 and _minOfDay < 750)
in_pmfix_trade  = timeframe.isintraday and (_minOfDay >= 750 and _minOfDay < 840)
var float pmfix_hi = na
var float pmfix_lo = na
var bool  pmfix_locked = false
var bool  pmfix_done   = false

// Pre-NY ORB: 13:00–13:30 UTC (pre-NY quiet window; breakout amplified by NY open at 14:00)
in_preny_window = timeframe.isintraday and (_minOfDay >= 780 and _minOfDay < 810)
in_preny_trade  = timeframe.isintraday and (_minOfDay >= 810 and _minOfDay < 960)
var float preny_hi = na
var float preny_lo = na
var bool  preny_locked = false
var bool  preny_done   = false

// NY ORB: 14:00–14:30 UTC (first 2 bars of NY on 15M)
in_nyorb_window = timeframe.isintraday and (_minOfDay >= 840 and _minOfDay < 870)
var float nyorb_hi = na
var float nyorb_lo = na
var bool  nyorb_locked = false
var bool  nyorb_done   = false

if _newDay
    frb_hi         := na
    frb_lo         := na
    frb_locked     := false
    frb_done       := false
    frb_short_today := false
    ar_lo_prefrb   := na
    lorb_hi     := na
    lorb_lo     := na
    lorb_locked := false
    lorb_done   := false
    pmfix_hi     := na
    pmfix_lo     := na
    pmfix_locked := false
    pmfix_done   := false
    preny_hi     := na
    preny_lo     := na
    preny_locked := false
    preny_done   := false
    nyorb_hi     := na
    nyorb_lo     := na
    nyorb_locked := false
    nyorb_done   := false

// Track Asian low BEFORE Frankfurt ORB window (strictly 00:00-07:00 UTC)
if _minOfDay >= 0 and _minOfDay < 420
    ar_lo_prefrb := na(ar_lo_prefrb) ? low : math.min(ar_lo_prefrb, low)

if in_frb_window
    frb_hi := na(frb_hi) ? high : math.max(frb_hi, high)
    frb_lo := na(frb_lo) ? low  : math.min(frb_lo, low)

if not in_frb_window and in_frb_window[1] and not na(frb_hi)
    frb_locked := true

if in_lorb_window
    lorb_hi := na(lorb_hi) ? high : math.max(lorb_hi, high)
    lorb_lo := na(lorb_lo) ? low  : math.min(lorb_lo, low)

if not in_lorb_window and in_lorb_window[1] and not na(lorb_hi)
    lorb_locked := true

if in_pmfix_window
    pmfix_hi := na(pmfix_hi) ? high : math.max(pmfix_hi, high)
    pmfix_lo := na(pmfix_lo) ? low  : math.min(pmfix_lo, low)

if not in_pmfix_window and in_pmfix_window[1] and not na(pmfix_hi)
    pmfix_locked := true

if in_preny_window
    preny_hi := na(preny_hi) ? high : math.max(preny_hi, high)
    preny_lo := na(preny_lo) ? low  : math.min(preny_lo, low)

if not in_preny_window and in_preny_window[1] and not na(preny_hi)
    preny_locked := true

if in_nyorb_window
    nyorb_hi := na(nyorb_hi) ? high : math.max(nyorb_hi, high)
    nyorb_lo := na(nyorb_lo) ? low  : math.min(nyorb_lo, low)

if not in_nyorb_window and in_nyorb_window[1] and not na(nyorb_hi)
    nyorb_locked := true

// ─── SCALE 30/75/150 — BE STOP MANAGEMENT ────────────────────────────
// Tracks open multi-TP positions (H/M only). When TP1 fires (position
// shrinks by ≥15%), cancels original X2/X3 and re-issues them with
// stop=entry (breakeven), preventing a TP1 winner from turning into a loss.
var float  _mtp_px   = na      // entry price stored at trade open
var float  _mtp_tp2  = na      // TP2 level stored at trade open
var float  _mtp_run  = na      // runner level stored at trade open
var string _mtp_id   = na      // entry order ID ("FRB-S", "NYORB-L", etc.)
var bool   _mtp_be   = false   // true once BE stop has been re-issued
var float  _mtp_prev = 0.0     // position size at end of previous bar

_mtp_cur = strategy.position_size
if not na(_mtp_id) and _mtp_cur != 0 and not _mtp_be
    if math.abs(_mtp_cur) < math.abs(_mtp_prev) * 0.85  // TP1 fired
        _mtp_be := true
        strategy.cancel(_mtp_id + "-X2")
        strategy.cancel(_mtp_id + "-X3")
        if _mtp_cur < 0  // remaining short: re-issue X2/X3 with BE stop
            strategy.exit(_mtp_id + "-X2b", from_entry=_mtp_id, qty_percent=67, stop=_mtp_px, limit=_mtp_tp2)
            strategy.exit(_mtp_id + "-X3b", from_entry=_mtp_id, stop=_mtp_px, limit=_mtp_run)
        else             // remaining long
            strategy.exit(_mtp_id + "-X2b", from_entry=_mtp_id, qty_percent=67, stop=_mtp_px, limit=_mtp_tp2)
            strategy.exit(_mtp_id + "-X3b", from_entry=_mtp_id, stop=_mtp_px, limit=_mtp_run)
if _mtp_cur == 0
    _mtp_id := na
    _mtp_be := false
_mtp_prev := _mtp_cur

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL M — Frankfurt ORB (Opening Range Breakout 07:00-07:30 UTC)
// Frankfurt/ECB open — European banks begin gold programs.  Same ORB
// logic as G and H but fires 1 hour before London, in a completely
// separate time window so it never conflicts with G or H.
// ═══════════════════════════════════════════════════════════════════════
if modFRB and barstate.isconfirmed and in_frb_trade and frb_locked and not frb_done and not na(frb_hi) and not na(frb_lo) and _orbGateOk and _hm_dow_ok and strategy.position_size == 0
    orb_range = frb_hi - frb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range > 0.50
        if close > frb_hi and (not orbBiasFilter or _orbBiasLong) and frbDirFilter != "Short only" and _orbSeasonL
            entryP = close
            slP    = orbSLMode == "Wide SL" ? (frb_lo - buf) : (frb_hi - buf)
            slDist = entryP - slP
            tp1    = orbSLMode == "Tight SL + entry TPs" ? entryP + slDist * orbTPMult : frb_hi + orb_range * orbTPMult
            tp2    = orbSLMode == "Tight SL + entry TPs" ? entryP + slDist * 2.0       : frb_hi + orb_range * 2.0
            tp3    = orbSLMode == "Tight SL + entry TPs" ? entryP + slDist * 3.0       : frb_hi + orb_range * 3.0
            frb_done := true
            strategy.entry("FRB-L", strategy.long, comment="frankfurt-orb · LONG")
            if exitMode == "Trail after TP1"
                strategy.exit("FRB-L-X", from_entry="FRB-L", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("FRB-L-X1", from_entry="FRB-L", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("FRB-L-X2", from_entry="FRB-L", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = frb_hi + orb_range * 0.30
                sc2 = frb_hi + orb_range * 0.75
                sc3 = frb_hi + orb_range * 1.50
                strategy.exit("FRB-L-X1", from_entry="FRB-L", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("FRB-L-X2", from_entry="FRB-L", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("FRB-L-X3", from_entry="FRB-L", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "FRB-L"
                _mtp_be  := false
            else
                strategy.exit("FRB-L-X", from_entry="FRB-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

        else if close < frb_lo and (not orbBiasFilter or _orbBiasShort) and frbDirFilter != "Long only" and _orbSeasonS and (not orbBreakAsianLo or (not na(ar_lo_prefrb) and close < ar_lo_prefrb))
            entryP = close
            slP    = orbSLMode == "Wide SL" ? (frb_hi + buf) : (frb_lo + buf)
            slDist = slP - entryP
            tp1    = orbSLMode == "Tight SL + entry TPs" ? entryP - slDist * orbTPMult : frb_lo - orb_range * orbTPMult
            tp2    = orbSLMode == "Tight SL + entry TPs" ? entryP - slDist * 2.0       : frb_lo - orb_range * 2.0
            tp3    = orbSLMode == "Tight SL + entry TPs" ? entryP - slDist * 3.0       : frb_lo - orb_range * 3.0
            frb_done       := true
            frb_short_today := true
            strategy.entry("FRB-S", strategy.short, comment="frankfurt-orb · SHORT")
            if exitMode == "Trail after TP1"
                strategy.exit("FRB-S-X", from_entry="FRB-S", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("FRB-S-X1", from_entry="FRB-S", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("FRB-S-X2", from_entry="FRB-S", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = frb_lo - orb_range * 0.30
                sc2 = frb_lo - orb_range * 0.75
                sc3 = frb_lo - orb_range * 1.50
                strategy.exit("FRB-S-X1", from_entry="FRB-S", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("FRB-S-X2", from_entry="FRB-S", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("FRB-S-X3", from_entry="FRB-S", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "FRB-S"
                _mtp_be  := false
            else
                strategy.exit("FRB-S-X", from_entry="FRB-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL G — London ORB (Opening Range Breakout 08:00-08:30 UTC)
// The most documented professional gold setup.  OR = first 30 min.
// After 08:30: trade first bar that closes outside the OR.
// SL at opposite OR extreme; TP targets are multiples of OR width.
// ═══════════════════════════════════════════════════════════════════════
if modORB and barstate.isconfirmed and in_london and lorb_locked and not lorb_done and not na(lorb_hi) and not na(lorb_lo) and strategy.position_size == 0
    orb_range = lorb_hi - lorb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range > 0.50
        if close > lorb_hi
            entryP = close
            slP    = lorb_lo - buf
            lorb_done := true
            strategy.entry("ORB-L", strategy.long, comment="orb · LONG")
            strategy.exit("ORB-L-X", from_entry="ORB-L", stop=slP,
                          limit=f_exitLim(lorb_hi + orb_range, lorb_hi + orb_range * 2.0, lorb_hi + orb_range * 3.0))
            f_drawPosBox(entryP, slP, lorb_hi + orb_range * 3.0)

        else if close < lorb_lo
            entryP = close
            slP    = lorb_hi + buf
            lorb_done := true
            strategy.entry("ORB-S", strategy.short, comment="orb · SHORT")
            strategy.exit("ORB-S-X", from_entry="ORB-S", stop=slP,
                          limit=f_exitLim(lorb_lo - orb_range, lorb_lo - orb_range * 2.0, lorb_lo - orb_range * 3.0))
            f_drawPosBox(entryP, slP, lorb_lo - orb_range * 3.0)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL N — PM Fix ORB (Opening Range 12:00-12:30 UTC)
// The London PM Gold Fix is the most important gold benchmark in the
// world — major banks settle positions here.  Price often makes a clean
// directional break after the fix window closes.  Trade window: 12:30–14:00.
// ═══════════════════════════════════════════════════════════════════════
if modPMFix and barstate.isconfirmed and in_pmfix_trade and pmfix_locked and not pmfix_done and not na(pmfix_hi) and not na(pmfix_lo) and strategy.position_size == 0
    orb_range = pmfix_hi - pmfix_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range > 0.50
        if close > pmfix_hi
            entryP = close
            slP    = pmfix_lo - buf
            pmfix_done := true
            strategy.entry("PMF-L", strategy.long, comment="pm-fix · LONG")
            strategy.exit("PMF-L-X", from_entry="PMF-L", stop=slP,
                          limit=f_exitLim(pmfix_hi + orb_range, pmfix_hi + orb_range * 2.0, pmfix_hi + orb_range * 3.0))
            f_drawPosBox(entryP, slP, pmfix_hi + orb_range * 3.0)

        else if close < pmfix_lo
            entryP = close
            slP    = pmfix_hi + buf
            pmfix_done := true
            strategy.entry("PMF-S", strategy.short, comment="pm-fix · SHORT")
            strategy.exit("PMF-S-X", from_entry="PMF-S", stop=slP,
                          limit=f_exitLim(pmfix_lo - orb_range, pmfix_lo - orb_range * 2.0, pmfix_lo - orb_range * 3.0))
            f_drawPosBox(entryP, slP, pmfix_lo - orb_range * 3.0)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL O — Pre-NY ORB (Opening Range 13:00-13:30 UTC)
// Mirror of Signal M: quiet pre-NY window (13:00-13:30) followed by
// the NY open momentum burst at 14:00.  If the Frankfurt-pre-London
// hypothesis holds, this should also outperform in-session ORBs.
// Trade window: 13:30–16:00 UTC.
// ═══════════════════════════════════════════════════════════════════════
if modPreNY and barstate.isconfirmed and in_preny_trade and preny_locked and not preny_done and not na(preny_hi) and not na(preny_lo) and strategy.position_size == 0
    orb_range = preny_hi - preny_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range > 0.50
        if close > preny_hi
            entryP = close
            slP    = preny_lo - buf
            preny_done := true
            strategy.entry("PRENY-L", strategy.long, comment="pre-ny-orb · LONG")
            strategy.exit("PRENY-L-X", from_entry="PRENY-L", stop=slP,
                          limit=f_exitLim(preny_hi + orb_range, preny_hi + orb_range * 2.0, preny_hi + orb_range * 3.0))
            f_drawPosBox(entryP, slP, preny_hi + orb_range * 3.0)

        else if close < preny_lo
            entryP = close
            slP    = preny_hi + buf
            preny_done := true
            strategy.entry("PRENY-S", strategy.short, comment="pre-ny-orb · SHORT")
            strategy.exit("PRENY-S-X", from_entry="PRENY-S", stop=slP,
                          limit=f_exitLim(preny_lo - orb_range, preny_lo - orb_range * 2.0, preny_lo - orb_range * 3.0))
            f_drawPosBox(entryP, slP, preny_lo - orb_range * 3.0)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL H — NY ORB (Opening Range Breakout 14:00-14:30 UTC)
// Same concept for the NY open — second major institutional opportunity.
// ═══════════════════════════════════════════════════════════════════════
if modNYORB and barstate.isconfirmed and nyorb_locked and not nyorb_done and not na(nyorb_hi) and not na(nyorb_lo) and _orbGateOk and _hm_dow_ok and strategy.position_size == 0
    orb_range = nyorb_hi - nyorb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range > 0.50
        if close > nyorb_hi and (not orbBiasFilter or _orbBiasLong) and nyorbDirFilter != "Short only" and _orbSeasonL and (not orbNYFRBCtxL or (frb_short_today and h1B == 1))
            entryP = close
            slP    = orbSLMode == "Wide SL" ? (nyorb_lo - buf) : (nyorb_hi - buf)
            slDist = entryP - slP
            tp1    = orbSLMode == "Tight SL + entry TPs" ? entryP + slDist * orbTPMult : nyorb_hi + orb_range * orbTPMult
            tp2    = orbSLMode == "Tight SL + entry TPs" ? entryP + slDist * 2.0       : nyorb_hi + orb_range * 2.0
            tp3    = orbSLMode == "Tight SL + entry TPs" ? entryP + slDist * 3.0       : nyorb_hi + orb_range * 3.0
            nyorb_done := true
            strategy.entry("NYORB-L", strategy.long, comment="ny-orb · LONG")
            if exitMode == "Trail after TP1"
                strategy.exit("NYORB-L-X", from_entry="NYORB-L", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("NYORB-L-X1", from_entry="NYORB-L", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("NYORB-L-X2", from_entry="NYORB-L", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = nyorb_hi + orb_range * 0.30
                sc2 = nyorb_hi + orb_range * 0.75
                sc3 = nyorb_hi + orb_range * 1.50
                strategy.exit("NYORB-L-X1", from_entry="NYORB-L", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("NYORB-L-X2", from_entry="NYORB-L", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("NYORB-L-X3", from_entry="NYORB-L", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "NYORB-L"
                _mtp_be  := false
            else
                strategy.exit("NYORB-L-X", from_entry="NYORB-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

        else if close < nyorb_lo and (not orbBiasFilter or _orbBiasShort) and nyorbDirFilter != "Long only" and _orbSeasonS and (not orbNYFRBCtxS or (frb_short_today and h1B == -1))
            entryP = close
            slP    = orbSLMode == "Wide SL" ? (nyorb_hi + buf) : (nyorb_lo + buf)
            slDist = slP - entryP
            tp1    = orbSLMode == "Tight SL + entry TPs" ? entryP - slDist * orbTPMult : nyorb_lo - orb_range * orbTPMult
            tp2    = orbSLMode == "Tight SL + entry TPs" ? entryP - slDist * 2.0       : nyorb_lo - orb_range * 2.0
            tp3    = orbSLMode == "Tight SL + entry TPs" ? entryP - slDist * 3.0       : nyorb_lo - orb_range * 3.0
            nyorb_done := true
            strategy.entry("NYORB-S", strategy.short, comment="ny-orb · SHORT")
            if exitMode == "Trail after TP1"
                strategy.exit("NYORB-S-X", from_entry="NYORB-S", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("NYORB-S-X1", from_entry="NYORB-S", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("NYORB-S-X2", from_entry="NYORB-S", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = nyorb_lo - orb_range * 0.30
                sc2 = nyorb_lo - orb_range * 0.75
                sc3 = nyorb_lo - orb_range * 1.50
                strategy.exit("NYORB-S-X1", from_entry="NYORB-S", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("NYORB-S-X2", from_entry="NYORB-S", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("NYORB-S-X3", from_entry="NYORB-S", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "NYORB-S"
                _mtp_be  := false
            else
                strategy.exit("NYORB-S-X", from_entry="NYORB-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL I — Previous Day High/Low Sweep  (pdh-sweep / pdl-sweep)
// Gold sweeps PDH or PDL to grab resting liquidity, then reverses hard.
// Documented by Linda Raschke (Turtle Soup), Larry Williams, ICT.
// Fires at most once per level per day, during kill zones only.
// ═══════════════════════════════════════════════════════════════════════
var bool pdh_done = false
var bool pdl_done = false

if _newDay
    pdh_done := false
    pdl_done := false

if modPDHL and barstate.isconfirmed and in_kz and not na(_pdh) and not na(_pdl) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    buf = atrVal * 0.15

    // Swept above PDH, closed back below → SHORT
    if not pdh_done and high > _pdh and close < _pdh and (high - _pdh) >= atrVal * 0.10
        entryP = close
        slP    = high + buf
        slDist = slP - entryP
        if slDist > 0
            tp1 = entryP - slDist
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            pdh_done := true
            strategy.entry("PDH-S", strategy.short, comment="pdh-sweep · SHORT")
            strategy.exit("PDH-S-X", from_entry="PDH-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "PDH ↓", style=label.style_label_down,
                      color=color.new(color.maroon, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

    // Swept below PDL, closed back above → LONG
    if not pdl_done and low < _pdl and close > _pdl and (_pdl - low) >= atrVal * 0.10 and strategy.position_size == 0
        entryP = close
        slP    = low - buf
        slDist = entryP - slP
        if slDist > 0
            tp1 = entryP + slDist
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            pdl_done := true
            strategy.entry("PDL-L", strategy.long, comment="pdl-sweep · LONG")
            strategy.exit("PDL-L-X", from_entry="PDL-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "PDL ↑", style=label.style_label_up,
                      color=color.new(color.teal, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL J — VWAP Extension Fade  (vwap-fade)
// When gold extends > 1.5×ATR from session VWAP and prints a reversal bar
// (bearish above / bullish below), it tends to snap back.  Used by
// professional intraday gold traders as a mean-reversion scalp.
// No daily limit — re-fires after stop-outs while extension persists.
// ═══════════════════════════════════════════════════════════════════════
if modVWAP and barstate.isconfirmed and in_kz and not na(vwapVal) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    vwapDist = close - vwapVal
    bearExt  = vwapDist >  atrVal * 1.5 and close < open
    bullExt  = vwapDist < -atrVal * 1.5 and close > open

    if bearExt
        entryP = close
        slP    = high + atrVal * 0.15
        slDist = slP - entryP
        if slDist > 0
            tp1 = entryP - slDist
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            strategy.entry("VWAP-S", strategy.short, comment="vwap-fade · SHORT")
            strategy.exit("VWAP-S-X", from_entry="VWAP-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

    else if bullExt
        entryP = close
        slP    = low - atrVal * 0.15
        slDist = entryP - slP
        if slDist > 0
            tp1 = entryP + slDist
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            strategy.entry("VWAP-L", strategy.long, comment="vwap-fade · LONG")
            strategy.exit("VWAP-L-X", from_entry="VWAP-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL K — Previous Week High/Low Sweep  (pwh-sweep / pwl-sweep)
// Same turtle-soup concept as Signal I but at the weekly timeframe.
// Weekly extremes hold 5× more resting liquidity than daily levels —
// the reversal after a sweep is typically stronger and higher-probability.
// Fires at most once per level per week, during kill zones only.
// ═══════════════════════════════════════════════════════════════════════
var bool pwh_done = false
var bool pwl_done = false

if _newWeek
    pwh_done := false
    pwl_done := false

if modPWHL and barstate.isconfirmed and in_kz and not na(_pwh) and not na(_pwl) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    buf = atrVal * 0.20

    if not pwh_done and high > _pwh and close < _pwh and (high - _pwh) >= atrVal * 0.15
        entryP = close
        slP    = high + buf
        slDist = slP - entryP
        if slDist > 0
            tp1 = entryP - slDist
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            pwh_done := true
            strategy.entry("PWH-S", strategy.short, comment="pwh-sweep · SHORT")
            strategy.exit("PWH-S-X", from_entry="PWH-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "PWH ↓", style=label.style_label_down,
                      color=color.new(color.purple, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

    if not pwl_done and low < _pwl and close > _pwl and (_pwl - low) >= atrVal * 0.15 and strategy.position_size == 0
        entryP = close
        slP    = low - buf
        slDist = entryP - slP
        if slDist > 0
            tp1 = entryP + slDist
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            pwl_done := true
            strategy.entry("PWL-L", strategy.long, comment="pwl-sweep · LONG")
            strategy.exit("PWL-L-X", from_entry="PWL-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "PWL ↑", style=label.style_label_up,
                      color=color.new(color.purple, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL L — Midnight Open (00:00 UTC) Bounce
// ICT's primary gold reference level: the 00:00 UTC daily open price.
// During London session, price retesting this level and showing a
// confirmed reversal bar is a high-conviction institutional entry.
// Fires at most once per direction per day, London session only.
// ═══════════════════════════════════════════════════════════════════════
var bool midnight_long_done  = false
var bool midnight_short_done = false

if _newDay
    midnight_long_done  := false
    midnight_short_done := false

if modMidnight and barstate.isconfirmed and in_london and not na(_midnightOpen) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    tol = atrVal * 0.25

    bounceLong  = low <= _midnightOpen + tol and low <= _midnightOpen and close > _midnightOpen and close > open
    bounceShort = high >= _midnightOpen - tol and high >= _midnightOpen and close < _midnightOpen and close < open

    if not midnight_long_done and bounceLong and not bounceShort
        wick   = low
        entryP = close
        buf    = atrVal * 0.15
        slP    = wick - buf
        slDist = entryP - slP
        if slDist > 0 and slP < entryP
            tp1 = entryP + slDist
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            midnight_long_done := true
            strategy.entry("MID-L", strategy.long, comment="midnight-open · LONG")
            strategy.exit("MID-L-X", from_entry="MID-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

    if not midnight_short_done and bounceShort and not bounceLong
        wick   = high
        entryP = close
        buf    = atrVal * 0.15
        slP    = wick + buf
        slDist = slP - entryP
        if slDist > 0 and slP > entryP
            tp1 = entryP - slDist
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            midnight_short_done := true
            strategy.entry("MID-S", strategy.short, comment="midnight-open · SHORT")
            strategy.exit("MID-S-X", from_entry="MID-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL P — Asian SFP (Swing Failure Pattern on Asian Range)
// Asian session (00:00-07:00 UTC) builds a range. At the Frankfurt/London
// open (07:00-09:00 UTC), institutions sweep one boundary to grab resting
// liquidity then reverse hard. Price pierces the Asian high or low but
// closes back inside — classic SFP. Enter at bar close in the reversal
// direction, target the opposite Asian boundary.
// Research source: 70%+ of trading days London sweeps one Asian extreme.
// ═══════════════════════════════════════════════════════════════════════
in_asfp_win = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 540)
var bool asfp_hi_done = false
var bool asfp_lo_done = false

if _newDay
    asfp_hi_done := false
    asfp_lo_done := false

if modASFP and barstate.isconfirmed and in_asfp_win and ar_locked and not na(ar_hi) and not na(ar_lo) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    asfpBuf = atrVal * 0.20
    // SHORT: swept above Asian high, closed back inside → reverse down
    if not asfp_hi_done and high > ar_hi and close < ar_hi and (high - ar_hi) < atrVal * 1.5
        entryP  = close
        slP     = high + asfpBuf
        slDist  = slP - entryP
        tgtDist = math.max(entryP - ar_lo, slDist)   // at least 1R, ideally opposite boundary
        if slDist > 0 and entryP > ar_lo
            tp1 = entryP - tgtDist
            tp2 = entryP - tgtDist * 1.5
            tp3 = entryP - tgtDist * 2.0
            asfp_hi_done := true
            strategy.entry("ASFP-S", strategy.short, comment="asian-sfp · SHORT")
            strategy.exit("ASFP-S-X", from_entry="ASFP-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "P↓", style=label.style_label_down,
                      color=color.new(color.red, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)
    // LONG: swept below Asian low, closed back inside → reverse up
    if not asfp_lo_done and low < ar_lo and close > ar_lo and (ar_lo - low) < atrVal * 1.5 and strategy.position_size == 0
        entryP  = close
        slP     = low - asfpBuf
        slDist  = entryP - slP
        tgtDist = math.max(ar_hi - entryP, slDist)   // at least 1R, ideally opposite boundary
        if slDist > 0 and entryP < ar_hi
            tp1 = entryP + tgtDist
            tp2 = entryP + tgtDist * 1.5
            tp3 = entryP + tgtDist * 2.0
            asfp_lo_done := true
            strategy.entry("ASFP-L", strategy.long, comment="asian-sfp · LONG")
            strategy.exit("ASFP-L-X", from_entry="ASFP-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "P↑", style=label.style_label_up,
                      color=color.new(color.teal, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL Q — Triple-Bull Trend Pullback Long
// ─────────────────────────────────────────────────────────────────────
// Source: 128K-bar global structure analysis — D↑H4↑H1↑ + 4-bar dip ≥0.69 ATR
// Triple alignment (D+H4+H1 all bull) confirmed as the dominant long state
// (62.5% WR, PF 1.252 over 5.5 years, N=44,487). The 4-bar pullback threshold
// filters to dip-buy entries within the running trend.
// SL = 1.0 × ATR below entry.  TP1 = 0.75 × ATR.
// ═══════════════════════════════════════════════════════════════════════
if modQ and barstate.isconfirmed and atrVal > 0 and h1B == 1 and h4B == 1 and hdB == 1 and _ret4bar < -0.69 and strategy.position_size == 0
    slQ  = close - 1.0  * atrVal
    tp1Q = close + 0.75 * atrVal
    tp2Q = close + 1.5  * atrVal
    tp3Q = close + 2.0  * atrVal
    if tp1Q > close and slQ < close
        strategy.entry("Q-L", strategy.long, comment="Q · pullback · LONG")
        strategy.exit("Q-L-X", from_entry="Q-L", stop=slQ, limit=f_exitLim(tp1Q, tp2Q, tp3Q))
        label.new(bar_index, low, "Q↑", style=label.style_label_up,
                  color=color.new(color.teal, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slQ, tp3Q)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL R — Triple-Bear Rally Fade Short
// ─────────────────────────────────────────────────────────────────────
// Source: 128K-bar global structure analysis — D↓H4↓H1↓ + 4-bar bounce ≥0.38 ATR
// Triple bear (D+H4+H1 all bearish) = 62.3% short WR, PF 1.239, N=30,066 bars.
// The 4-bar bounce filter times entry to fading counter-trend pops.
// Upgraded from H1-only to triple alignment to remove low-confidence states.
// SL = 1.0 × ATR above entry.  TP1 = 0.75 × ATR below.
// ═══════════════════════════════════════════════════════════════════════
_inRWin = _minOfDay > 37 and _minOfDay < 607   // 00:37 – 10:07 UTC

if modR and barstate.isconfirmed and atrVal > 0 and h1B == -1 and h4B == -1 and hdB == -1 and _ret4bar > 0.38 and _inRWin and strategy.position_size == 0
    slR  = close + 1.0  * atrVal
    tp1R = close - 0.75 * atrVal
    tp2R = close - 1.5  * atrVal
    tp3R = close - 2.0  * atrVal
    if tp1R < close and slR > close
        strategy.entry("R-S", strategy.short, comment="R · bear-rally · SHORT")
        strategy.exit("R-S-X", from_entry="R-S", stop=slR, limit=f_exitLim(tp1R, tp2R, tp3R))
        label.new(bar_index, high, "R↓", style=label.style_label_down,
                  color=color.new(color.red, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slR, tp3R)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL S — Pre-NY Triple-Alignment
// ─────────────────────────────────────────────────────────────────────
// Source: 128K-bar global structure analysis — #1 ranked single combination
// SHORT: D↓ H4↓ H1↓ + Pre-NY (13:00-14:30 UTC) → 67% WR, PF 1.52 ★★★
// LONG:  D↑ H4↑ H1↑ + Pre-NY (13:00-14:30 UTC) → untested inverse
// Five and a half years of data, consistent across every year 2020-2025.
// Fires on the first qualifying bar (close < open for short, close > open for long) once per day.
// SL = 1.0 × ATR from entry.  TP1 = 0.75 × ATR.
// ═══════════════════════════════════════════════════════════════════════
_inPreNYS = timeframe.isintraday and (_minOfDay >= 780 and _minOfDay < 870)   // 13:00 – 14:30 UTC
var bool s_short_done = false
var bool s_long_done  = false
if _newDay
    s_short_done := false
    s_long_done  := false

if modS and barstate.isconfirmed and atrVal > 0 and not s_short_done and _inPreNYS and sDirFilter != "Long only" and h1B == -1 and h4B == -1 and hdB == -1 and close < open and strategy.position_size == 0
    slS  = close + 1.0  * atrVal
    tp1S = close - 0.75 * atrVal
    tp2S = close - 1.5  * atrVal
    tp3S = close - 2.0  * atrVal
    if tp1S < close and slS > close
        s_short_done := true
        strategy.entry("S-S", strategy.short, comment="S · pre-ny-bear · SHORT")
        strategy.exit("S-S-X", from_entry="S-S", stop=slS, limit=f_exitLim(tp1S, tp2S, tp3S))
        label.new(bar_index, high, "S↓", style=label.style_label_down,
                  color=color.new(color.purple, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slS, tp3S)

if modS and barstate.isconfirmed and atrVal > 0 and not s_long_done and _inPreNYS and sDirFilter != "Short only" and h1B == 1 and h4B == 1 and hdB == 1 and close > open and strategy.position_size == 0
    slS  = close - 1.0  * atrVal
    tp1S = close + 0.75 * atrVal
    tp2S = close + 1.5  * atrVal
    tp3S = close + 2.0  * atrVal
    if tp1S > close and slS < close
        s_long_done := true
        strategy.entry("S-L", strategy.long, comment="S · pre-ny-bull · LONG")
        strategy.exit("S-L-X", from_entry="S-L", stop=slS, limit=f_exitLim(tp1S, tp2S, tp3S))
        label.new(bar_index, low, "S↑", style=label.style_label_up,
                  color=color.new(color.purple, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slS, tp3S)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL T — Frankfurt Triple-Alignment
// ─────────────────────────────────────────────────────────────────────
// Source: 128K-bar global structure analysis — #2 ranked single combination
// LONG:  D↑ H4↑ H1↑ + Frankfurt/London (07:00-09:00 UTC) → 64% WR, PF 1.33 ★★
// SHORT: D↓ H4↓ H1↓ + Frankfurt/London (07:00-09:00 UTC) → untested inverse
// European banks open their gold programs into this window. Triple alignment
// confirms structural momentum. Fires on the first qualifying bar once per day.
// SL = 1.0 × ATR from entry.  TP1 = 0.75 × ATR.
// ═══════════════════════════════════════════════════════════════════════
_inFrankT = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 540)   // 07:00 – 09:00 UTC
var bool t_long_done  = false
var bool t_short_done = false
if _newDay
    t_long_done  := false
    t_short_done := false

if modT and barstate.isconfirmed and atrVal > 0 and not t_long_done and _inFrankT and tDirFilter != "Short only" and h1B == 1 and h4B == 1 and hdB == 1 and close > open and strategy.position_size == 0
    slT  = close - 1.0  * atrVal
    tp1T = close + 0.75 * atrVal
    tp2T = close + 1.5  * atrVal
    tp3T = close + 2.0  * atrVal
    if tp1T > close and slT < close
        t_long_done := true
        strategy.entry("T-L", strategy.long, comment="T · frank-bull · LONG")
        strategy.exit("T-L-X", from_entry="T-L", stop=slT, limit=f_exitLim(tp1T, tp2T, tp3T))
        label.new(bar_index, low, "T↑", style=label.style_label_up,
                  color=color.new(color.lime, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slT, tp3T)

if modT and barstate.isconfirmed and atrVal > 0 and not t_short_done and _inFrankT and tDirFilter != "Long only" and h1B == -1 and h4B == -1 and hdB == -1 and close < open and strategy.position_size == 0
    slT  = close + 1.0  * atrVal
    tp1T = close - 0.75 * atrVal
    tp2T = close - 1.5  * atrVal
    tp3T = close - 2.0  * atrVal
    if tp1T < close and slT > close
        t_short_done := true
        strategy.entry("T-S", strategy.short, comment="T · frank-bear · SHORT")
        strategy.exit("T-S-X", from_entry="T-S", stop=slT, limit=f_exitLim(tp1T, tp2T, tp3T))
        label.new(bar_index, high, "T↓", style=label.style_label_down,
                  color=color.new(color.lime, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slT, tp3T)

// ─── SESSION BACKGROUNDS ──────────────────────────────────────────────
bgcolor(in_asian   ? color.new(color.blue,   90) : na, title="Asian")
bgcolor(in_london  ? color.new(color.yellow, 90) : na, title="London KZ")
bgcolor(in_overlap ? color.new(color.orange, 88) : na, title="NY-Lon Overlap")
bgcolor(in_sb_win  ? color.new(color.lime,   75) : na, title="Silver Bullet")
