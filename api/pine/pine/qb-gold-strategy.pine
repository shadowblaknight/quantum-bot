//@version=6
strategy("QB Gold Specialist — Strategy", "QB GOLD · STRAT", overlay=true,
         max_bars_back=500, max_labels_count=500, max_lines_count=300, max_boxes_count=300,
         default_qty_type=strategy.percent_of_equity, default_qty_value=1,
         commission_type=strategy.commission.percent, commission_value=0.0,
         slippage=2, pyramiding=0, calc_on_every_tick=false,
         close_entries_rule="ANY")

// ═══════════════════════════════════════════════════════════════════════
//  QB GOLD SPECIALIST — STRATEGY VERSION  (XAUUSD 15m)
//  ─────────────────────────────────────────────────────────────────────
//  Identical detection logic as the indicator.  alert() → strategy.entry()
//  / strategy.exit() so TradingView Strategy Tester computes the full
//  historical win rate instantly across up to ~1 year of 15m bars.
//
//  Exit is determined by WHICH LEVEL PRICE HITS FIRST after entry:
//    slP         → LOSS   (same stop as drawn on the indicator box)
//    tp1/tp2/tp3 → WIN    (select in "Strategy" input group)
//
//  One trade at a time (pyramiding=0).  A new signal is skipped while a
//  previous trade is still running — same behaviour as the live bot.
//
//  How to read results:
//    Open TradingView → Pine Editor → paste → Add to chart
//    Open the "Strategy Tester" tab at the bottom
//    Switch "Exit target" input to compare TP1 / TP2 / TP3 scenarios
// ═══════════════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────────────
G_WIN = "0 · Test window"
// Added 2026-09-21 after a batch of six runs came back on 3 Nov 2023 - 21 Sep 2026
// while the recorded baseline was measured on 16 Sep 2023 - 16 Sep 2026. TradingView
// serves however much deep history it feels like on a 15m chart, so the start date
// MOVES between loads. Two runs compared across that drift are two different
// populations and part of the trade-count difference is just data supply.
useTestWin = input.bool(false, "Pin the backtest window (turn ON for any A/B)", group=G_WIN,
             tooltip="OFF = use every bar TradingView supplies, which is what every run before 2026-09-21 did. The loaded start date drifts between chart loads, so two runs taken on different days are NOT directly comparable - trade counts differ partly because the data supply differed.\n\nON = only bars inside the fixed window below can open a trade. Turn this ON before comparing anything to anything, and leave the dates alone for the whole comparison. Every run in the set then covers identical bars, so a trade-count difference is caused by the change you made and nothing else.\n\nDefaults sit inside the range TradingView reliably serves, so the window stays fully populated even on a short load.")
twStart    = input.time(timestamp("01 Jan 2024 00:00 +0000"), "  Window start", group=G_WIN)
twEnd      = input.time(timestamp("01 Sep 2026 00:00 +0000"), "  Window end",   group=G_WIN)
_testWinOk = not useTestWin or (time >= twStart and time <= twEnd)

G_CORE = "Core"
modFVG      = input.bool(true,  "A) FVG Signal (gold-fvg)",                        group=G_CORE)
modJudas    = input.bool(true,  "B) Judas Sweep (judas-swing)",                    group=G_CORE)
modSB       = input.bool(true,  "C) Silver Bullet (gold-sb)",                      group=G_CORE)
modPsych    = input.bool(true,  "D) Psych Level Bounce (reaction)",                group=G_CORE)
modPsychExt = input.bool(true,  "D2) Psych Extended / outside KZ (reaction-ext)", group=G_CORE)
modLB         = input.bool(false, "E) London Range Breakout",                        group=G_CORE)
lbBiasFilter  = input.bool(false, "E) Require H1 bias alignment",                   group=G_CORE)
modNY         = input.bool(false, "F) NY Session Breakout (London range)",           group=G_CORE)
modORB        = input.bool(false, "G) London ORB — 08:00-08:30 UTC (verified)",     group=G_CORE)
modNYORB      = input.bool(true,  "H) NY ORB — 14:00-14:30 UTC (verified)",         group=G_CORE)
modNYORBP     = input.bool(false, "H') NY ORB PRIME — restrict H to a 14:30-16:00 trade window", group=G_CORE,
              tooltip="LEAVE OFF — TESTED AND REJECTED 2026-09-18. Kept so the negative result stays attached to the code.\n\nMEASURED 3y (16 Sep 2023 - 16 Sep 2026), full baseline H+M+U+V both arms:\n  OFF  218 trades  99.08% WR  PF 6.335  +4148 USD  DD 710  (19.03 per trade)\n  ON   141 trades  99.29% WR  PF 5.906  +2342 USD  DD 787  (16.61 per trade)\n\nThe window removed ~77 trades and 44% of net profit while RAISING drawdown. Win rate barely moved (+0.21pp), so it removed volume, not risk.\n\nTHE LATE BREAKS ARE THE BETTER TRADES. The ~77 trades the window removed accounted for ~1806 USD, about 23.45 each, against 16.61 for the trades it kept. A genuine quality filter lifts per-trade profit; this lowered it. So NY ORB breaks that fire after 16:00 UTC are MORE profitable than the ones inside the opening window, not less. The hypothesis was exactly backwards.\n\n(Path-dependence caveat: blocking H frees the position slot for other signals, so the 141 are not the 218 minus a fixed 77. The per-trade figures are net inferences. The direction is not in doubt.)\n\nWHAT THIS MEANS. Lateness costs FILLS, not edge. A backtest cannot see a fill problem - here a limit either fills or it does not; there is no 'the alert arrived after the move and the order sat unfilled'. Do not block late signals. Fix the entry router so a signal whose price has already run past the limit is taken at market or skipped, instead of resting on an order that cannot fill.\n\nORIGINAL RATIONALE BELOW, kept because the lateness measurement is still correct.\n\nOFF = Signal H exactly as it runs today. ON = H may only fire inside 14:30-16:00 UTC.\n\nWHY THIS EXISTS. Signal M is gated by in_frb_trade (07:30-11:00). Signal H was never given the equivalent, so it waits for the first 15m close outside the 14:00-14:30 range FOR THE REST OF THE DAY. Measured on the live account, every NY ORB signal fired:\n  16 Sep 14:45  +0.3h after the range closed\n  03 Sep 15:00  +0.5h\n  24 Aug 15:30  +1.0h\n  21 Aug 15:45  +1.3h\n  08 Sep 16:15  +1.8h\n  01 Sep 16:30  +2.0h\n  18 Sep 17:15  +2.8h\nMedian 1.3 hours late. By then the ORB level is stale, price has wandered, and when it finally breaks it tends to run without ever retesting — so the C2 limit rests unfilled while the move happens without you.\n\nThis window keeps the first four and blocks the last three.\n\nALSO CHANGES ORDER EXPIRY. When ON, a NYORB limit is cancelled at 16:00 instead of surviving to the daily roll, mirroring how M cancels at the end of its own window. Otherwise a limit armed at 15:55 could still fill hours later against a level that is long dead — the same disease in a different place.\n\nEXPECT FEWER TRADES. This harness is path-dependent: blocking a signal frees the position slot for a later one, so the trade list reshuffles rather than simply shrinking. Judge it on net P&L and trade count, not on win rate alone.")
modPDHL       = input.bool(false, "I) PDH/PDL Sweep — liquidity grab & reverse",    group=G_CORE)
modVWAP       = input.bool(false, "J) VWAP Extension Fade — mean reversion",        group=G_CORE)
modPWHL       = input.bool(false, "K) Prev Week H/L Sweep — weekly liquidity grab", group=G_CORE)
modMidnight   = input.bool(false, "L) Midnight Open (00:00 UTC) Bounce",             group=G_CORE)
modFRB        = input.bool(true,  "M) Frankfurt ORB — 07:00-07:30 UTC (pre-London)", group=G_CORE)
modPMFix      = input.bool(false, "N) PM Fix ORB — 12:00-12:30 UTC (gold fix)",     group=G_CORE)
modPreNY      = input.bool(false, "O) Pre-NY ORB — 13:00-13:30 UTC (pre-NY open)",  group=G_CORE)
modASFP       = input.bool(false, "P) Asian SFP — sweep+reverse (07:00-09:00 UTC)", group=G_CORE)
modQ          = input.bool(false, "Q) Triple-Bull Pullback Long — D+H4+H1 bull, 4-bar dip ≥0.69 ATR  [83% WR]", group=G_CORE)
modR          = input.bool(false, "R) Triple-Bear Rally Fade — D+H4+H1 bear, 4-bar bounce ≥0.38 ATR  [68% WR]", group=G_CORE)
modS          = input.bool(false, "S) Pre-NY Triple-Bear Short — D+H4+H1 bear, 13:00-14:30 UTC  [67% WR, PF 1.52]", group=G_CORE)
modT          = input.bool(false, "T) Frankfurt Triple-Bull Long — D+H4+H1 bull, 07:00-09:00 UTC  [64% WR, PF 1.33]", group=G_CORE)
modSYD        = input.bool(true,  "U) Sydney ORB — session open, same C2 architecture as M/H  [UNTESTED]", group=G_CORE)
modTOK        = input.bool(true,  "V) Tokyo ORB — REJECTED, kept only so the 218-trade baseline reproduces",  group=G_CORE,
              tooltip="TESTED AND REJECTED ~2026-09-07. Tokyo does not perform like Sydney.\n\nNot live: the indicator has no modTOK input and the webhook's SPECIALIST_ALLOWED_ZONES is ['FRB','NYORB','SYD'], so a V alert would be dropped as specialist-zone-inactive even if one fired.\n\nIt contributed ZERO trades to the 96-trade sample the A+ table measured — Tokyo hours are too thin to clear the 5-pt min-range floor, exactly as predicted. Left ON only because the 218-trade baseline was recorded with it on; since it fires essentially never, that baseline is effectively M+H+U.\n\nDo not re-propose enabling V live.")

G_ASIA = "U/V — Asian session ORBs"
sydOpenHr   = input.int(22, "U) Sydney open (UTC hour)", group=G_ASIA, minval=18, maxval=23,
              tooltip="Sydney is UTC+10 (AEST) / UTC+11 (AEDT), so 07:00 local lands on 21:00 or 22:00 UTC depending on DST.\n\nDefault 22 also keeps the ORB window clear of the broker's daily rollover (21:00/22:00 UTC on XAUUSD) — if the range were built BEFORE the rollover, the daily reset would wipe it mid-trade-window.\n\nSweep 21 vs 22 and compare.")
sydOrbMins  = input.int(30, "U) Sydney ORB length (mins)", group=G_ASIA, minval=15, maxval=120, step=15)
sydTradeMins= input.int(90, "U) Sydney trade window after ORB (mins)", group=G_ASIA, minval=30, maxval=300, step=30)
tokOpenHr   = input.int(0,  "V) Tokyo open (UTC hour)", group=G_ASIA, minval=0, maxval=23,
              tooltip="Tokyo is UTC+9 with NO daylight saving, so 09:00 local = 00:00 UTC year-round. This one is unambiguous.")
tokOrbMins  = input.int(30, "V) Tokyo ORB length (mins)", group=G_ASIA, minval=15, maxval=120, step=15)
tokTradeMins= input.int(180,"V) Tokyo trade window after ORB (mins)", group=G_ASIA, minval=30, maxval=420, step=30)
c2MinRangeASIA = input.float(5.0, "U/V) Min ORB range to trade (pts)", group=G_ASIA, step=1.0,
              tooltip="Asian sessions are thin — ranges are typically much smaller than Frankfurt or NY. If this filter blocks nearly every signal, that is the finding: the setup does not exist on gold in Asian hours.")

G_STRAT = "Strategy"
exitMode  = input.string("TP1 · 1R", "Exit target",
            options=["TP1 · 1R", "TP2 · 2R", "TP3 · 3R", "Split TP1+TP2", "Trail after TP1", "Scale 30/75/150", "Ratchet (no TP)"],
            tooltip="TP1/TP2/TP3: fixed single-target exits. Split: 50% at TP1 + 50% at TP2. Trail: trail stop after TP1. Scale 30/75/150 (H/M only): 25% at 0.30×range, 50% at 0.75×range, 25% runner at 1.50×range — BE stop on remaining after TP1 hit. Python v4: WR 82.8%, PF 2.030.",
            group=G_STRAT)
showBoxes      = input.bool(true, "Show position boxes", group=G_STRAT)
trailArm  = input.float(0.75, "Ratchet: arm trail after (x ORB range)", group=G_STRAT, minval=0.05, maxval=10.0, step=0.05,
            tooltip="How far price must travel past the ORB level before the trail takes over from the original stop. 0.75 = the old TP1 distance.")
trailKeep = input.float(0.75, "Ratchet: fraction of reach locked", group=G_STRAT, minval=0.10, maxval=0.95, step=0.05,
            tooltip="Stop sits at this fraction of the furthest excursion, so it locks PROFIT rather than returning to entry. reach 0.75 -> locks 0.56 · reach 1.00 -> locks 0.75 · reach 2.00 -> locks 1.50 · reach 10.0 -> locks 7.50. Giveback is (1 - this). Capped at 0.95 because a stop sitting exactly on the extreme is taken out by the first tick of noise.")
orbSLMode      = input.string("Wide SL", "H/M) SL mode",
                 options=["Wide SL", "Tight SL + entry TPs", "Tight SL + OR-edge TPs"],
                 tooltip="Wide SL: SL at opposite OR extreme, TPs at OR multiples (baseline). Tight SL + entry TPs: SL at breakout level, TPs scale from entry (1:1 system). Tight SL + OR-edge TPs: tiny SL, original large TPs (asymmetric R:R).",
                 group=G_STRAT)
orbBiasFilter  = input.bool(true,  "H/M) HTF bias filter — skip trades against trend", group=G_STRAT)
orbBiasTF      = input.string("H1+H4", "H/M) Bias timeframe",
                 options=["H1", "H4", "Daily", "H1+H4", "H1+H4+D", "M15", "M15+H1", "M15+H1+H4"],
                 tooltip="H1+H4 = the 218-trade baseline. H4 alone = older baseline (PF 1.409). H1+H4+D = all three align (strictest).\n\nM15 options added 2026-09-18. The premise: the ORB is a 15m structure, so gating it on H4 may be asking a 4-hour trend to approve a 15-minute decision. M15+H1 keeps the confirmation on timeframes that actually move inside the trade window.\n\nThe 15m bias reads close[1] vs EMA[1], deliberately NOT the signal bar — a bar that closes past the ORB level has almost certainly closed past its own 15m EMA, so scoring the current bar would grade the breakout against itself and produce a filter that looks predictive while measuring nothing.",
                 group=G_STRAT)
nyorbDirFilter = input.string("Both", "H) Direction filter",  options=["Both", "Long only", "Short only"],
                 tooltip="London Bias study (54yr): the PM fix window (14:00 UTC) has a structural short tailwind. Test 'Short only' to isolate whether H shorts carry the PF.",
                 group=G_STRAT)
frbDirFilter   = input.string("Both", "M) Direction filter",  options=["Both", "Long only", "Short only"], group=G_STRAT)
sDirFilter     = input.string("Short only", "S) Direction filter", options=["Both", "Long only", "Short only"],
                 tooltip="Short only = Pre-NY triple-bear (67% WR, PF 1.52 — the proven setup). Long only = Pre-NY triple-bull (untested inverse). Both = fire whichever side aligns.",
                 group=G_STRAT)
tDirFilter     = input.string("Long only",  "T) Direction filter", options=["Both", "Long only", "Short only"],
                 tooltip="Long only = Frankfurt triple-bull (64% WR, PF 1.33 — the proven setup). Short only = Frankfurt triple-bear (untested inverse). Both = fire whichever side aligns.",
                 group=G_STRAT)
orbTPMult      = input.float(0.75, "H/M) TP1 multiplier",    minval=0.25, maxval=2.0, step=0.25,
                 tooltip="1.0 = standard 1R (baseline PF 1.145). 0.75 = ¾R — raises WR at cost of smaller wins. Find the WR/PF sweet spot between 0.75 and 1.0.",
                 group=G_STRAT)
orbNFPFilter   = input.bool(false, "H/M) Skip first-Friday of month (NFP days)", group=G_STRAT)
orbADRGuard    = input.bool(true,  "U/V) Skip when >90% ADR already consumed",   group=G_STRAT,
                 tooltip="Now applies to U and V ONLY. M and H have their own switches below — see why.")
// SPLIT 2026-09-21. This was ONE toggle gating M, H, U and V through _orbGateOk.
// Measured: the ADR guard HURTS M and HELPS H. A shared switch therefore had to
// be wrong for one of them no matter how it was set, and it was set ON — which
// means every baseline run so far carried a filter that costs Frankfurt money.
// Both default TRUE so the existing baseline still reproduces; set frbADRGuard
// OFF to take the measured improvement.
frbADRGuard    = input.bool(true,  "M) Skip when >90% ADR already consumed",     group=G_STRAT,
                 tooltip="MEASURED BAD FOR M (2026-09-21). Frankfurt fires at 07:30-11:00, early in the session, when little of the day's range is normally spent — so a >90% ADR reading at that hour is not an exhausted market, it is an unusually violent overnight. Those are exactly the days Frankfurt continuation works. Turn OFF.")
nyADRGuard     = input.bool(true,  "H) Skip when >90% ADR already consumed",     group=G_STRAT,
                 tooltip="MEASURED GOOD FOR H (2026-09-21). NY fires at 14:30+, by which point 90% of the average range genuinely is spent, so the guard is reading real exhaustion rather than an early-session anomaly. Keep ON.")
orbSeasonFilt  = input.bool(false, "H/M) Seasonal bias (Sep=Short only · Jan=Long only)",
                 tooltip="September is 90% bearish over 10yr (gold seasonal). January is 80% bullish. Blocks counter-seasonal trades in these two months only.",
                 group=G_STRAT)
orbBreakAsianLo = input.bool(true,  "M) Require entry closes below Asian low (WR 84.6%)",
                 tooltip="Frankfurt ORB SHORT only fires when entry bar closes below the Asian session low (00:00-07:00 UTC range). Sweeps overnight stop-losses = maximum bearish conviction. Python analysis: WR 84.6%, PF 1.655 (N=26/5.5yr ~ 5 trades/year vs 40/yr unfiltered).",
                 group=G_STRAT)
orbBreakAsianHi = input.bool(true,  "M) Require entry closes above Asian high (LONG, symmetric filter)",
                 tooltip="Frankfurt ORB LONG only fires when entry bar closes above the Asian session high (00:00-07:00 UTC range). Symmetric to the SHORT Asian-lo filter — tests whether breaking above overnight liquidity gives the same edge on the long side.",
                 group=G_STRAT)
orbNYFRBCtxS   = input.bool(false, "H SHORT) Require Frankfurt SHORT today + H1 bear (WR 75%)",
                 tooltip="H SHORT only fires when Frankfurt ORB also broke SHORT today AND H1 is bearish at NY time. Python: WR 75.0%, PF 1.935 (N=64, ~12/yr). Continuation setup: Frankfurt+H1 both bear, NY confirms down.",
                 group=G_STRAT)
orbNYFRBCtxL   = input.bool(false, "H LONG) Require Frankfurt SHORT today + H1 bull (WR 73.6%)",
                 tooltip="H LONG only fires when Frankfurt ORB broke SHORT earlier today AND H1 has since flipped bullish. Python: WR 73.6%, PF 1.542 (N=91, ~17/yr). Reversal setup: Frankfurt exhausted sellers, NY sees fresh buyers.",
                 group=G_STRAT)
orbNYLonHiFilter = input.bool(false, "H LONG)  Require close above London session HIGH (theorem filter)",
                 tooltip="NY ORB LONG only fires when the breakout bar also closes above the London session high (08:00-14:00 UTC). Mirrors the FRB Asian-extreme gate — theorem predicts WR ≈ 97-98%.",
                 group=G_STRAT)
orbNYLonLoFilter = input.bool(false, "H SHORT) Require close below London session LOW (theorem filter)",
                 tooltip="NY ORB SHORT only fires when the breakout bar also closes below the London session low (08:00-14:00 UTC). Mirrors the FRB Asian-extreme gate — theorem predicts WR ≈ 97-98%.",
                 group=G_STRAT)
asianBiasFilter  = input.bool(false, "H/M) Asian cascade — only trade in Asian close direction (T-1: z=+3.68, all sessions significant)",
                 tooltip="T-1 Theorem: Asian session direction (close vs open, 00:00-07:00 UTC) cascades to Frankfurt (65.7%, z=3.03★), London (61.7%, z=3.63★) and NY (64.6%, z=3.68★). When ON, blocks ORB trades that oppose the Asian session close direction. Default OFF — turn ON to test the cascade filter independently.",
                 group=G_STRAT)
i_hm_useDow  = input.bool(false, "H/M) Day of Week filter",  group=G_STRAT)
i_hm_dow_mon = input.bool(false, "H/M   Mon",                group=G_STRAT)
i_hm_dow_tue = input.bool(true,  "H/M   Tue",                group=G_STRAT)
i_hm_dow_wed = input.bool(false, "H/M   Wed",                group=G_STRAT)
i_hm_dow_thu = input.bool(false, "H/M   Thu",                group=G_STRAT)
i_hm_dow_fri = input.bool(false, "H/M   Fri",                group=G_STRAT)

G_LON = "G — London ORB"
lonUseC2 = input.bool(true, "G) Use C2 retest architecture (same as M/H)", group=G_LON,
           tooltip="OFF = the legacy Signal G: MARKET entry at the signal bar's close, SL at the OPPOSITE OR extreme, TPs at 1/2/3x the OR width from the broken level.\n\nON = the architecture M and H actually use: a LIMIT resting back at the broken ORB level (shifted by c2RetestDepth), SL = level +/- the C2 stop, TPs = range x orbTPMult x {1,2,3}.\n\nThat is the single biggest difference between G and the two signals that produce the 99% baseline. G has never been given it — this is the A/B.")
c2MinRangeLON = input.float(5.0, "G) Min London ORB range to trade (pts)", group=G_LON, step=1.0,
           tooltip="Only applies in C2 mode. Legacy mode keeps its original 0.50 floor. Matches the 5.0 floor M and H use — with a 150-pt stop a 2-pt opening range is not a tradeable structure.")
lonDirFilter = input.string("Both", "G) Direction filter", options=["Both", "Long only", "Short only"], group=G_LON)
lonBiasFilter = input.bool(false, "G) Require HTF bias alignment", group=G_LON,
           tooltip="Uses the same bias timeframe selected for H/M above, so G can be compared against them on equal terms.")
lonADRGuard = input.bool(false, "G) Skip when >90% ADR already consumed", group=G_LON,
           tooltip="The M/H ADR guard, given its own switch for G. Reads _adrConsumed[1] so the trigger bar's own wick cannot self-block.")
lonBreakAsianHi = input.bool(false, "G LONG) Require close above Asian high", group=G_LON,
           tooltip="The direct analogue of M's orbBreakAsianHi, but measured against the FULL Asian session (00:00-08:00) rather than M's 00:00-07:00 window — because each session's filter should use the Asian range up to ITS OWN open, and London opens an hour after Frankfurt.\n\nNote what this means at 08:30: Frankfurt has already traded 07:00-08:00, so the Asian extreme may have been swept before London even opened. That is a real difference from M and part of what the test measures.")
lonBreakAsianLo = input.bool(false, "G SHORT) Require close below Asian low", group=G_LON,
           tooltip="Symmetric to the LONG filter above.")
lonAsianCascade = input.bool(false, "G) Asian cascade — only trade in the Asian close direction", group=G_LON,
           tooltip="Blocks G trades opposing the Asian session's own direction (close vs open, 00:00-07:00 UTC). T-1 theorem measured London at 61.7%, z=3.63. Independent of the H/M asianBiasFilter so the two can be tested separately.\n\nCORRECTION 2026-09-21: this tooltip previously said 00:00-08:00. It is wrong — _asianBias is accumulated in the `_minOfDay < 420` block, i.e. 00:00-07:00, the same window M uses. The 377-trade baseline was measured with 07:00. Port that, not 08:00.")

G_LIFE = "Order life (limit expiry)"
// Added 2026-09-21. These windows were HARDCODED, which meant the one number that
// decides "how long does an unfilled limit stay alive" could not be measured.
//
// WHAT AN EXPIRY CAN AND CANNOT DO. It cancels an order that NEVER FILLED. It
// cannot touch a filled position — once you are in, SL/TP own the trade. So a
// shorter expiry can never cut a winner short mid-trade. What it CAN do is
// cancel a limit that would have filled later and won. That is the real cost,
// and these inputs exist to price it: shorten one, re-run, read the trade count
// and WR.
//
// PATH-DEPENDENCE WARNING: cancelling early also FREES the position slot early,
// so a shorter expiry can ADD trades from other signals. The trade list
// reshuffles. Judge on net P&L and WR together, never on count alone.
frbTradeMins = input.int(210, "M) Frankfurt limit life (mins from 07:30)", group=G_LIFE, minval=15, maxval=600, step=15,
               tooltip="210 = expires 11:00 UTC, the value used in the 377-trade / 99.47% baseline. Shorten to measure what late Frankfurt fills are worth.")
lonTradeMins = input.int(150, "G) London limit life (mins from 08:30)",    group=G_LIFE, minval=15, maxval=600, step=15,
               tooltip="150 = expires 11:00 UTC, the baseline value. G overlaps M's window (M runs 07:30-11:00), so these two compete for the single position slot — shortening one hands trades to the other.")
nyOrderMins  = input.int(0,   "H) NY limit life (mins from 14:30, 0 = none)", group=G_LIFE, minval=0, maxval=600, step=15,
               tooltip="0 = the BASELINE behaviour: the NY limit is cancelled only at the daily roll (21:00/22:00 UTC), so it can rest ~7 hours against a level that stopped being the opening range long before. H is the only signal with an effectively unbounded order.\n\nThat unbounded life is part of what produced 99.47%, which is the uncomfortable part — the H' test already showed late NY breaks are the BETTER trades, so a tight expiry here may cost real money. Set a value and measure before assuming shorter is safer.")

G_C2 = "C2 — OCO (Signal M + H)"
c2SLBuf   = input.float(76.0,  "SL beyond C2 structural level (pts)", group=G_C2, step=0.5,
            tooltip="Tight SL placed this many pts beyond the C2 retest level — not from the C1 close.\nFRB SHORT → SL = frb_lo + 8.  NYORB LONG → SL = nyorb_hi - 8.\nTP targets still use orbTPMult × ORB range measured from the C2 level.")
c2SLMode  = input.string("Absolute points", "SL mode", options=["Absolute points", "x ORB range", "x ATR"], group=G_C2,
            tooltip="How the C2 stop distance is derived. Applies to M, H, U and V.\n\nABSOLUTE POINTS — the historical behaviour: a flat c2SLBuf regardless of instrument or volatility. The problem: 150 pts is 3.43% of gold's price but 1.97% of SP500's, and 6.25x gold's ORB range vs 9.04x SP500's. It is one number pretending to be one strategy across instruments that differ 3-10x.\n\nx ORB RANGE — stop = k x that day's own opening range. Self-scales across instruments AND across volatility regimes (gold's ranges doubled as it ran 1,900 -> 4,370 while the flat 150 stayed put).\n\nx ATR — stop = k x entry-TF ATR. Similar self-scaling, but keyed to general volatility rather than the specific range being traded.\n\nDefault is Absolute points so the existing baseline reproduces unchanged.")
c2SLRangeMult = input.float(2.0, "SL = k x ORB range", group=G_C2, minval=0.25, maxval=15.0, step=0.25,
            tooltip="Only used when SL mode = 'x ORB range'.\n\nReference points (using 1y average ranges - gold 24 pts, SP500 16.6 pts):\n  k=6.25 -> gold 150, SP500 104  (reproduces gold's current stop)\n  k=3.00 -> gold 72,  SP500 50\n  k=2.00 -> gold 48,  SP500 33   <- 3R becomes reachable\n  k=1.50 -> gold 36,  SP500 25\n\nWhy it matters: TP1 is 0.75 x range, so at k=6.25 TP1 is only 0.12R and a 3R target sits ~450 pts away - several daily ranges. Lower k shrinks R until 3R is a normal day's move, which is what makes an R-based ladder fire at all.")
c2SLAtrMult = input.float(3.0, "SL = k x ATR", group=G_C2, minval=0.25, maxval=20.0, step=0.25,
            tooltip="Only used when SL mode = 'x ATR'. Stop = k x the entry-timeframe ATR(atrLength).")
c2MinRangeFRB  = input.float(5.0,  "M) Min Frankfurt ORB range to trade (pts)", group=G_C2, step=1.0,
               tooltip="Skip FRB (Signal M) if the 07:00-07:30 UTC ORB range is below this. Frankfurt ranges tend to be tighter than NY — tune separately. Breakeven at SL=8pt, TP mult=0.75: range > 10.67pt.")
c2MinRangeNY   = input.float(5.0,  "H) Min NY ORB range to trade (pts)",         group=G_C2, step=1.0,
               tooltip="Skip NYORB (Signal H) if the 14:00-14:30 UTC ORB range is below this. NY ranges expand with US session volatility — tune separately. Breakeven at SL=8pt, TP mult=0.75: range > 10.67pt.")
c2MinBreakStr = input.float(0.0, "C2 min break strength (x ORB range)", group=G_C2, minval=0.0, maxval=1.00, step=0.05,
               tooltip="Requires the signal bar to close at least this far BEYOND the ORB level, in range units. LEAVE AT 0.00 — TESTED AND REJECTED 2026-09-18. Keep the input only so the negative result stays attached to the code.\n\nMEASURED 3y (16 Sep 2023 - 16 Sep 2026):\n  0.00   218 trades   99.08% WR   PF 6.335   +4148 USD\n  0.10   200 trades   98.50% WR   PF 3.849   +2832 USD\n  0.15   189 trades   97.88% WR   PF 2.585   +2143 USD\nMonotonically worse on every metric. Losses went 2 -> 3 -> 4 and max drawdown rose 710 -> 714 -> 722.\n\nTHE HYPOTHESIS WAS SOUND AND STILL FAILED. The observation was real: among trades actually taken, breaks weaker than 0.10 range stayed under 20 pts of heat only 50.0% of the time vs 83.8% for the rest (z = -3.43, p ~ 0.0006, n=96). Filtering on it made the system worse anyway.\n\nWHY IT DID NOT TRANSFER — two reasons, both structural:\n\n1. THE TRADE LIST IS PATH-DEPENDENT. pyramiding=0 and every entry gated on strategy.position_size == 0, so blocking a signal FREES THE SLOT for a later signal that would otherwise have been skipped. The filtered run is not the baseline minus 18 trades — it is a different, reshuffled population. That is why losses can go UP while trades go DOWN, which is arithmetically impossible under a nested subset. Any MAE study that re-prices the taken list silently assumes the list is fixed. It is not.\n\n2. WEAK BREAKS ARE THE FREE FILLS. At c2RetestDepth 0.25 the long limit rests at level + 0.25 x range. A break of strength 0.05 closes BELOW that limit, so it fills instantly at a favourable price. A break of strength 0.50 closes above it and needs a genuine pullback that may never arrive. So this filter preferentially deletes the cheapest, most certain fills and keeps the ones contingent on a retest.\n\nHEAT IS NOT LOSS. Weak breaks carried more adverse excursion and still won, at 99% WR. Optimising away excursion optimised away profit.")
c2LiqGrab = input.string("Off", "C2) Liquidity grab required before break", options=["Off", "Sweep own ORB opposite", "Sweep prior session pool", "Either sweep"], group=G_C2,
               tooltip="Only take the breakout if a pool of resting stops on the OPPOSITE side was run first. A long break wants the downside swept; a short break wants the upside swept.\n\nApplies to M (Frankfurt), H (NY) and U (Sydney). V (Tokyo) is deliberately left alone so it stays identical in both arms of the comparison.\n\nSWEEP OWN ORB OPPOSITE — price traded beyond the far side of this session's own opening range before breaking the near side. The classic ORB fakeout: the first break fails, traps traders, and the second one runs.\n\nSWEEP PRIOR SESSION POOL — price traded beyond the previous session's extreme. M sweeps the ASIAN range (00:00-07:00), H sweeps the LONDON range (08:00-14:00), U sweeps the NY range (14:00 to the Sydney open).\n\nEITHER SWEEP — passes if either pool was run. Keeps the most trades.\n\nTracking starts at each session's ORB window open and resets on the rising edge of that same window, never on the daily roll, because the broker day turns over at 21:00/22:00 UTC — directly on top of the Sydney open and the NY pool window.\n\nThis is distinct from the orbBreakAsianHi/Lo filters above, which demand the break CLOSE BEYOND the prior extreme. That is expansion. This is a sweep and reclaim, which is the opposite shape.")
c2RetestDepth = input.float(0.0, "C2 partial retest depth (x ORB range)", group=G_C2, minval=0.0, maxval=0.70, step=0.05,
               tooltip="How far the limit sits from the ORB level, TOWARD current price. Only meaningful in Retest (limit) mode.\n\n0.00 = limit exactly at the ORB level (the backtested baseline). Needs a FULL retest, so runaway breakouts are never taken.\n0.25 = limit a quarter-range closer to price — fills on a shallow bounce.\n0.50 = half a range closer. Fills far more often, entry price worse.\n\nSL and TP stay anchored to the ORB level, so trade geometry is unchanged — only fill probability and entry price move. This is the middle ground between a full-retest limit and chasing at market.\n\nWhy it exists: the breakouts a full-retest limit misses are the ones that travel furthest (they never come back). Sweep 0 / 0.25 / 0.50 and look for the knee.\n\nAuto-clamped below the TP multiplier so the entry can never sit past its own target.")
c2EntryMode = input.string("Retest (limit)", "C2 entry type", options=["Retest (limit)", "Immediate (market)"], group=G_C2,
               tooltip="A/B test for signals M + H.\n\nRETEST (limit) — the backtested baseline. Order rests AT the ORB level; fills only if price returns to it. Breakouts that run away are never taken.\n\nIMMEDIATE (market) — fills at the signal bar close, which is ALREADY past the level. Takes every signal, including runaways, but entry is worse: SL and TP stay anchored to the ORB level, so each win banks less and each loss costs more.\n\nBreakeven WR rises from ~90.9% to ~92.7% at 1:10 R:R. Baseline runs 97.5% — verify the blended WR stays above ~95% before switching live.")

G_APLUS = "A+ tier (sub-baseline — sizing only)"
// Added 2026-09-22. THE BASELINE IS NOT TOUCHED. This is a second tier that
// rides on top of it: the same signals, the same entries, the same trade list.
// Only the STOP changes, and only on the setups that have earned it.
//
// WHY THIS IS SAFE WHERE FILTERING WAS NOT. Every filter tried on this system
// failed because blocking a signal frees the position slot and reshuffles the
// whole downstream population. Sizing does not block anything — the trade list
// is identical — so an A+ tier can be measured honestly where a filter could
// not. That is the entire reason to build it this way round.
//
// WHAT A+ MEANS: a SMALL opening range. Measured across 172 trades, an ORB
// under 10 pts stayed inside 20 pts of heat 89.7% of the time; over 30 pts,
// only 46.7%. Straight line between. A quiet opening range is a market that
// goes where it is going without shaking you out first.
//
// HOW IT BECOMES SIZE: live sizing is risk-based, lot = riskDollars / stopDist.
// So a tighter stop buys a bigger position at IDENTICAL dollar risk — no A+ lot
// multiplier is needed anywhere, and none should be added. On $100,100 at 4.27%:
//     normal  85.5 pt stop -> 0.50 lots
//     A+      28.5 pt stop -> 1.50 lots
// Same money at risk on both. The lot moves only because the stop moved.
//
// DEFAULT OFF so the baseline reproduces byte-for-byte until this is measured.
aplusTightSL  = input.bool(false, "A+) Tighter stop when the ORB range is small", group=G_APLUS,
                tooltip="OFF = every trade uses the normal stop; the baseline is unchanged.\n\nON = trades whose opening range is at or below the A+ threshold get aplusSLBuf instead of c2SLBuf. Nothing else changes: same signals, same entries, same trade count. Only the stop distance on the small-range subset.\n\nWHAT TO WATCH: the win rate on the A+ subset. If it holds, the tier is real and the bigger lot is earned. If it drops, the tight stop is sitting inside the noise and the answer is no — a losing A+ trade costs 3x a normal one.")
aplusMaxRange = input.float(15.0, "A+) Max ORB range to qualify (pts)", group=G_APLUS, step=1.0,
                tooltip="At or below this range = A+. 15 is the first guess, taken from where the heat data stops improving: <10 pts held 89.7% under 20 pts of heat, 10-15 held 70.8%, and everything above 15 sits flat around 68% until it collapses to 46.7% past 30.\n\nSweep 10 / 12 / 15 / 20 and read the A+ subset's win rate, not the headline.")
aplusSLBuf    = input.float(25.0, "A+) Stop beyond the level on A+ trades (pts)", group=G_APLUS, step=1.0,
                tooltip="25 pts from the LEVEL, which is ~28 from the entry once the retest offset is added — the distance that turns 4.27% risk into 1.5 lots.\n\nJustified by heat, not by the lot size it produces: small-range trades stayed inside 20 pts of heat ~90% of the time, so a 28-pt stop should clear most of them. That is the claim this run tests.\n\nNOTE the asymmetry it creates. An A+ loss is 1.5 lots x 28.5 pts = the same dollars as a normal loss, by construction. But three A+ losses in a row is 12.8% of the account, versus 12.8% for three normal ones — identical. The danger is not the size, it is being wrong about which trades are quiet.")

G_FILT = "Filters"
adrFVGMax     = input.float(0.85, "FVG / SB max ADR consumed",     group=G_FILT, minval=0.50, maxval=1.50, step=0.05)
adrJudasMax   = input.float(0.90, "Judas max ADR consumed",        group=G_FILT, minval=0.50, maxval=1.50, step=0.05)
adrPsychMax   = input.float(1.20, "Psych bounce max ADR consumed", group=G_FILT, minval=0.70, maxval=2.50, step=0.05)
atrLength     = input.int(14,     "ATR period",                    group=G_FILT, minval=2,    maxval=50)
emaLength     = input.int(20,     "HTF bias EMA period",           group=G_FILT, minval=5,    maxval=100)
fvgMinGapATR  = input.float(0.10, "FVG min gap (× ATR)",           group=G_FILT, minval=0.03, step=0.03)
fvgMaxFillPct = input.float(0.50, "FVG max fill before entry",     group=G_FILT, minval=0.0,  maxval=1.0, step=0.05)
fvgMaxAgeBars = input.int(48,     "FVG max age (bars)",             group=G_FILT, minval=4,    maxval=200)
slMinH1ATR    = input.float(0.30, "SL min (× H1 ATR)",             group=G_FILT, minval=0.1,  step=0.05)
slMaxH1ATR    = input.float(3.00, "SL max (× H1 ATR)",             group=G_FILT, minval=1.0,  step=0.10)

// ─── HTF BIAS (H1 / H4 / D) ──────────────────────────────────────────
f_htfBias(int emaLen, int atrLen) =>
    e = ta.ema(close, emaLen)
    b = close[1] > e[1] ? 1 : close[1] < e[1] ? -1 : 0
    a = ta.atr(atrLen)
    [b, a]

[h1B, h1ATR] = request.security(syminfo.tickerid, "60",  f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[h4B, h4ATR] = request.security(syminfo.tickerid, "240", f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[hdB, hdATR] = request.security(syminfo.tickerid, "D",   f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)

atrVal = ta.atr(atrLength)

// 15m bias — the ORB's OWN timeframe. Computed natively (no request.security);
// the chart is 15m, so this is just EMA(emaLength) on this series.
//
// CRITICAL: it reads close[1] vs ema[1], NOT the current bar. On the signal bar
// the break condition is `close > frb_hi`, and a bar that closes above the ORB
// high has almost certainly closed above its own 15m EMA too. Scoring the bias
// on the current bar would therefore be scoring the breakout against itself —
// the filter would look predictive while measuring nothing. Reading [1] asks
// the real question: was the 15m already trending up BEFORE this bar broke?
_m15ema = ta.ema(close, emaLength)
m15B    = close[1] > _m15ema[1] ? 1 : close[1] < _m15ema[1] ? -1 : 0

// Partial-retest depth, clamped so the limit can never sit at or past its own
// TP (which would make the trade nonsensical). At depth >= orbTPMult the entry
// would be beyond tp1; 0.9x keeps a margin.
_c2Depth = math.min(c2RetestDepth, orbTPMult * 0.9)

// C2 stop distance. A flat point value is NOT comparable across instruments —
// 150 pts is 6.25x gold's ORB range but 9.04x SP500's, so the same number is
// two different strategies. Range/ATR modes derive the stop from the
// instrument's own volatility instead.
// Floored at one tick so a degenerate range can never produce SL == entry.
// A+ TIER hooks in HERE, at the single point every signal already asks for its
// stop — M, H, U, V and G all call this, so the tier reaches all of them with
// no per-signal edits and no chance of one drifting out of sync.
f_c2SL(float rng) =>
    base = c2SLMode == "x ORB range" ? rng * c2SLRangeMult : c2SLMode == "x ATR" ? atrVal * c2SLAtrMult : c2SLBuf
    d    = (aplusTightSL and rng <= aplusMaxRange) ? aplusSLBuf : base
    math.max(d, syminfo.mintick)

// Bias check helpers for H/M filter (resolved once per bar)
_orbBiasLong  = orbBiasTF == "H1" ? h1B >= 0 : orbBiasTF == "Daily" ? hdB >= 0 : orbBiasTF == "H1+H4" ? (h1B == 1 and h4B == 1) : orbBiasTF == "H1+H4+D" ? (h1B == 1 and h4B == 1 and hdB == 1) : orbBiasTF == "M15" ? m15B == 1 : orbBiasTF == "M15+H1" ? (m15B == 1 and h1B == 1) : orbBiasTF == "M15+H1+H4" ? (m15B == 1 and h1B == 1 and h4B == 1) : h4B >= 0
_orbBiasShort = orbBiasTF == "H1" ? h1B <= 0 : orbBiasTF == "Daily" ? hdB <= 0 : orbBiasTF == "H1+H4" ? (h1B == -1 and h4B == -1) : orbBiasTF == "H1+H4+D" ? (h1B == -1 and h4B == -1 and hdB == -1) : orbBiasTF == "M15" ? m15B == -1 : orbBiasTF == "M15+H1" ? (m15B == -1 and h1B == -1) : orbBiasTF == "M15+H1+H4" ? (m15B == -1 and h1B == -1 and h4B == -1) : h4B <= 0

// ─── SESSION CONTEXT ──────────────────────────────────────────────────
_hourUtc  = hour(time, "UTC")
_minOfDay = _hourUtc * 60 + minute(time, "UTC")
_newDay   = ta.change(time("D")) != 0

_atr14d     = request.security(syminfo.tickerid, "D", ta.atr(14))
_todayHigh  = request.security(syminfo.tickerid, "D", high)
_todayLow   = request.security(syminfo.tickerid, "D", low)
_todayOpen  = request.security(syminfo.tickerid, "D", open)
_priorClose = request.security(syminfo.tickerid, "D", close[1])
_pdh         = request.security(syminfo.tickerid, "D", high[1])
_pdl         = request.security(syminfo.tickerid, "D", low[1])
_pwh         = request.security(syminfo.tickerid, "W", high[1])
_pwl         = request.security(syminfo.tickerid, "W", low[1])
_newWeek     = ta.change(time("W")) != 0
vwapVal      = ta.vwap(hlc3)

var float _midnightOpen = na
if _newDay
    _midnightOpen := open

_adrConsumed   = _atr14d > 0 ? (_todayHigh - _todayLow) / _atr14d : 0.0
_adrQuiet      = _adrConsumed < 0.75
_adrRemainTo75 = math.max(0.0, _atr14d * 0.75 - (_todayHigh - _todayLow))

// H/M research gate helpers (placed here — needs _adrConsumed defined first)
_isNFP      = dayofweek == dayofweek.friday and dayofmonth <= 7
_ret4bar    = atrVal > 0 ? (close - close[4]) / atrVal : 0.0   // 4-bar momentum in ATR units
_mnth       = month(time)
_orbSeasonL = not orbSeasonFilt or _mnth != 9   // Sep blocks longs (90% bearish)
_orbSeasonS = not orbSeasonFilt or _mnth != 1   // Jan blocks shorts (80% bullish)
_nfpOk      = (not orbNFPFilter or not _isNFP) and _testWinOk
_orbGateOk  = (not orbADRGuard or _adrConsumed[1] < 0.90) and _nfpOk   // U / V
_orbGateFRB = (not frbADRGuard or _adrConsumed[1] < 0.90) and _nfpOk   // M — ADR measured HARMFUL here
_orbGateNY  = (not nyADRGuard  or _adrConsumed[1] < 0.90) and _nfpOk   // H — ADR measured HELPFUL here
_hm_dow     = dayofweek(time, "UTC")
_hm_dow_ok  = not i_hm_useDow or (_hm_dow == dayofweek.monday and i_hm_dow_mon) or (_hm_dow == dayofweek.tuesday and i_hm_dow_tue) or (_hm_dow == dayofweek.wednesday and i_hm_dow_wed) or (_hm_dow == dayofweek.thursday and i_hm_dow_thu) or (_hm_dow == dayofweek.friday and i_hm_dow_fri)

// ─── CVD ──────────────────────────────────────────────────────────────
_signedVol = close > open ? volume : close < open ? -volume : 0.0
var float _cvdRunning = 0.0
_cvdRunning := _cvdRunning + _signedVol
var float _cvdBase = 0.0
if _newDay
    _cvdBase := _cvdRunning - _signedVol
cvd   = _cvdRunning - _cvdBase
cvdMa = ta.ema(cvd, 14)

// ─── SESSION GATES (UTC) ──────────────────────────────────────────────
in_asian   = timeframe.isintraday and (_minOfDay >= 0   and _minOfDay < 480)
in_london  = timeframe.isintraday and (_minOfDay >= 480 and _minOfDay < 660)
in_overlap = timeframe.isintraday and (_minOfDay >= 780 and _minOfDay < 1020)
in_sb_win  = timeframe.isintraday and (_minOfDay >= 900 and _minOfDay < 960)
in_kz      = in_london or in_overlap

// ─── ADR GATES  (use [1] so the trigger bar's wick can't self-block) ──
adr_fvg_ok   = _adrConsumed[1] < adrFVGMax
adr_judas_ok = _adrConsumed[1] < adrJudasMax
adr_psych_ok = _adrConsumed[1] < adrPsychMax
adr_hard_ok  = _adrConsumed    < 2.50

// ─── ASIAN RANGE ──────────────────────────────────────────────────────
var float ar_hi    = na
var float ar_lo    = na
var bool  ar_locked = false

if _newDay
    ar_hi    := na
    ar_lo    := na
    ar_locked := false

if in_asian
    ar_hi := na(ar_hi) ? high : math.max(ar_hi, high)
    ar_lo := na(ar_lo) ? low  : math.min(ar_lo, low)

if not in_asian and in_asian[1] and not na(ar_hi)
    ar_locked := true

// ─── BOS TRACKING ─────────────────────────────────────────────────────
SWG = 3
var float _prev_sh   = na
var float _prev_sl   = na
var int   bos_bull_b = na
var int   bos_bear_b = na

_sh_now = ta.pivothigh(high, SWG, SWG)
_sl_now = ta.pivotlow(low,   SWG, SWG)

if not na(_sh_now)
    if not na(_prev_sh) and _sh_now > _prev_sh
        bos_bull_b := bar_index[SWG]
    _prev_sh := _sh_now

if not na(_sl_now)
    if not na(_prev_sl) and _sl_now < _prev_sl
        bos_bear_b := bar_index[SWG]
    _prev_sl := _sl_now

bos_bull_ok = not na(bos_bull_b) and (bar_index - bos_bull_b) <= 30
bos_bear_ok = not na(bos_bear_b) and (bar_index - bos_bear_b) <= 30

// ─── FVG POOL ─────────────────────────────────────────────────────────
var array<float> fU     = array.new<float>(0)
var array<float> fL     = array.new<float>(0)
var array<int>   fDir   = array.new<int>(0)
var array<int>   fBar   = array.new<int>(0)
var array<float> fFill  = array.new<float>(0)
var array<bool>  fFired = array.new<bool>(0)

if barstate.isconfirmed and atrVal > 0
    bull_fvg = low > high[2]
    bear_fvg = high < low[2]
    bull_gap = bull_fvg ? (low - high[2]) : 0.0
    bear_gap = bear_fvg ? (low[2] - high) : 0.0

    if bull_fvg and bull_gap >= atrVal * fvgMinGapATR
        array.push(fU,     low)
        array.push(fL,     high[2])
        array.push(fDir,   1)
        array.push(fBar,   bar_index - 1)
        array.push(fFill,  0.0)
        array.push(fFired, false)

    if bear_fvg and bear_gap >= atrVal * fvgMinGapATR
        array.push(fU,     low[2])
        array.push(fL,     high)
        array.push(fDir,   -1)
        array.push(fBar,   bar_index - 1)
        array.push(fFill,  0.0)
        array.push(fFired, false)

    while array.size(fU) > 25
        array.shift(fU)
        array.shift(fL)
        array.shift(fDir)
        array.shift(fBar)
        array.shift(fFill)
        array.shift(fFired)

if barstate.isconfirmed and array.size(fU) > 0
    for idx = array.size(fU) - 1 to 0
        u   = array.get(fU,   idx)
        l   = array.get(fL,   idx)
        d   = array.get(fDir, idx)
        gsz = u - l
        if gsz <= 0
            continue
        if d == 1 and low < u
            array.set(fFill, idx, math.min(1.0, math.max(0.0, u - math.max(l, low)) / gsz))
        if d == -1 and high > l
            array.set(fFill, idx, math.min(1.0, math.max(0.0, math.min(u, high) - l) / gsz))

// ─── POSITION BOX (same visual as indicator) ──────────────────────────
f_drawPosBox(float e, float slP, float tp3) =>
    if showBoxes
        r = bar_index + 40
        box.new(bar_index, math.max(e, tp3), r, math.min(e, tp3),
                border_color=color.new(color.teal, 50), bgcolor=color.new(color.teal, 88))
        box.new(bar_index, math.max(e, slP), r, math.min(e, slP),
                border_color=color.new(color.red, 55), bgcolor=color.new(color.red, 90))
        line.new(bar_index, e, r, e,
                 color=color.new(color.gray, 10), style=line.style_dashed, width=1)

// ─── EXIT LIMIT HELPER ────────────────────────────────────────────────
// BUG FIX: "Ratchet (no TP)" used to fall through this ternary's final `: tp2`,
// so every signal that is NOT M/H/U/V silently had its target DOUBLED from 1R
// to 2R the moment ratchet mode was selected. That is not a ratchet — it is a
// wider TP — and it drags the blended win rate down for no reason. Signals A-T
// have R-based targets, not ORB-range ones, so the ratchet cannot apply to
// them: hold them at their proven TP1 instead.
f_exitLim(float tp1, float tp2, float tp3) =>
    exitMode == "TP1 · 1R" ? tp1 : exitMode == "TP3 · 3R" ? tp3 : exitMode == "Ratchet (no TP)" ? tp1 : tp2

// Shared C2 exit router — used by G, U and V. "Scale 30/75/150" needs the _mtp
// state machine wired per-signal, so those signals fall through to the
// single-target exit for it. Defined here (rather than beside U/V, where it
// used to live) because Signal G sits earlier in the file and Pine requires a
// function to be defined before every use.
f_c2Exit(string id, float slP, float tp1, float tp2, float tp3, float rng) =>
    if exitMode == "Trail after TP1"
        strategy.exit(id + "-X", from_entry=id, stop=slP, trail_price=tp1, trail_offset=math.round(rng / syminfo.mintick))
    else if exitMode == "Split TP1+TP2"
        strategy.exit(id + "-X1", from_entry=id, qty_percent=50, stop=slP, limit=tp1)
        strategy.exit(id + "-X2", from_entry=id, stop=slP, limit=tp2)
    else if exitMode == "Ratchet (no TP)"
        strategy.exit(id + "-X", from_entry=id, stop=slP)
    else
        strategy.exit(id + "-X", from_entry=id, stop=slP, limit=f_exitLim(tp1, tp2, tp3))

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL A — Gold FVG  (gold-fvg)
// ═══════════════════════════════════════════════════════════════════════
if modFVG and barstate.isconfirmed and _testWinOk and in_kz and adr_fvg_ok and adr_hard_ok and not na(h1ATR) and h1ATR > 0 and array.size(fU) > 0 and strategy.position_size == 0
    firedA = false
    for idx = array.size(fU) - 1 to 0
        if firedA or array.get(fFired, idx)
            continue
        u       = array.get(fU,    idx)
        l       = array.get(fL,    idx)
        d       = array.get(fDir,  idx)
        birth   = array.get(fBar,  idx)
        fillPct = array.get(fFill, idx)

        if (bar_index - birth) > fvgMaxAgeBars or fillPct > fvgMaxFillPct
            continue

        touch = d == 1 ? (low <= u and high >= l) : (high >= l and low <= u)
        if not touch
            continue

        if not ((d == 1 and bos_bull_ok) or (d == -1 and bos_bear_ok))
            continue

        buf      = math.max(0.20 * atrVal, 0.08 * h1ATR)
        proximal = d == 1 ? u : l
        distal   = d == 1 ? l : u
        entryP   = proximal
        slP      = d == 1 ? distal - buf : distal + buf
        slDist   = math.abs(entryP - slP)

        if slDist <= 0
            continue

        tp1Mult = (_adrQuiet and _adrRemainTo75 > 0 and _adrRemainTo75 < slDist * 1.5) ? 0.75 : 1.0
        tp1 = d == 1 ? entryP + slDist * tp1Mult : entryP - slDist * tp1Mult
        tp2 = d == 1 ? entryP + slDist * 2.0     : entryP - slDist * 2.0
        tp3 = d == 1 ? entryP + slDist * 3.0     : entryP - slDist * 3.0

        if not ((d == 1 ? slP < entryP : slP > entryP) and (d == 1 ? tp1 > entryP : tp1 < entryP))
            continue

        array.set(fFired, idx, true)
        firedA := true

        eId = d == 1 ? "FVG-L" : "FVG-S"
        strategy.entry(eId, d == 1 ? strategy.long : strategy.short, comment="gold-fvg")
        strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=f_exitLim(tp1, tp2, tp3))
        f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL B — Judas Sweep  (judas-swing)
// Limit orders at the swept level — accurate R:R backtest
// ═══════════════════════════════════════════════════════════════════════
var bool judas_hi_done = false
var bool judas_lo_done = false

if _newDay
    judas_hi_done := false
    judas_lo_done := false
    strategy.cancel("JUDAS-S")
    strategy.cancel("JUDAS-L")

// Expire pending limit orders when London session ends
if not in_london and in_london[1]
    strategy.cancel("JUDAS-S")
    strategy.cancel("JUDAS-L")

if modJudas and barstate.isconfirmed and _testWinOk and in_london and ar_locked and adr_judas_ok and adr_hard_ok and not na(ar_hi) and not na(ar_lo) and not na(h1ATR) and h1ATR > 0 and strategy.position_size == 0
    aRef = nz(atrVal, h1ATR)

    // SHORT — swept Asian high, closed back inside → LIMIT at ar_hi (retest entry)
    if not judas_hi_done and high > ar_hi and close < ar_hi and (high - ar_hi) >= aRef * 0.15
        buf    = aRef * 0.20
        slP    = high + buf
        entryP = ar_hi          // limit fills exactly at the swept level on retest
        slDist = slP - entryP   // sweep height + buf (small, precise SL)
        if slDist > 0
            tp1 = entryP - slDist * 1.0
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            judas_hi_done := true
            strategy.entry("JUDAS-S", strategy.short, limit=entryP, comment="judas-swing · SHORT")
            strategy.exit("JUDAS-S-X", from_entry="JUDAS-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "⚡ Judas SHORT",
                      style=label.style_label_down, color=color.new(color.red, 5),
                      textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

    // LONG — swept Asian low, closed back inside → LIMIT at ar_lo (retest entry)
    if not judas_lo_done and low < ar_lo and close > ar_lo and (ar_lo - low) >= aRef * 0.15 and strategy.position_size == 0
        buf    = aRef * 0.20
        slP    = low - buf
        entryP = ar_lo          // limit fills exactly at the swept level on retest
        slDist = entryP - slP   // sweep depth + buf (small, precise SL)
        if slDist > 0
            tp1 = entryP + slDist * 1.0
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            judas_lo_done := true
            strategy.entry("JUDAS-L", strategy.long, limit=entryP, comment="judas-swing · LONG")
            strategy.exit("JUDAS-L-X", from_entry="JUDAS-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "⚡ Judas LONG",
                      style=label.style_label_up, color=color.new(color.teal, 5),
                      textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL C — Silver Bullet  (gold-sb)
// ═══════════════════════════════════════════════════════════════════════
var bool sb_done = false

if _newDay
    sb_done := false

if modSB and barstate.isconfirmed and _testWinOk and in_sb_win and not sb_done and adr_fvg_ok and adr_hard_ok and not na(h1ATR) and h1ATR > 0 and array.size(fU) > 0 and strategy.position_size == 0
    firedC = false
    for idx = array.size(fU) - 1 to 0
        if firedC or array.get(fFired, idx)
            continue
        u       = array.get(fU,    idx)
        l       = array.get(fL,    idx)
        d       = array.get(fDir,  idx)
        birth   = array.get(fBar,  idx)
        fillPct = array.get(fFill, idx)

        if (bar_index - birth) > 48 or fillPct > 0.50
            continue

        touch = d == 1 ? (low <= u and high >= l) : (high >= l and low <= u)
        if not touch
            continue

        buf      = math.max(0.20 * atrVal, 0.08 * h1ATR)
        proximal = d == 1 ? u : l
        distal   = d == 1 ? l : u
        entryP   = proximal
        slP      = d == 1 ? distal - buf : distal + buf
        slDist   = math.abs(entryP - slP)

        if slDist <= 0
            continue

        // Gold SB uses extended TPs: 1.5R / 2.5R / 4R
        tp1Mult_sb = (_adrQuiet and _adrRemainTo75 > 0 and _adrRemainTo75 < slDist * 1.5) ? 1.0 : 1.5
        tp1 = d == 1 ? entryP + slDist * tp1Mult_sb : entryP - slDist * tp1Mult_sb
        tp2 = d == 1 ? entryP + slDist * 2.5        : entryP - slDist * 2.5
        tp3 = d == 1 ? entryP + slDist * 4.0        : entryP - slDist * 4.0

        if not (d == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
            continue

        array.set(fFired, idx, true)
        sb_done := true
        firedC  := true

        eId = d == 1 ? "SB-L" : "SB-S"
        strategy.entry(eId, d == 1 ? strategy.long : strategy.short, comment="gold-sb")
        strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=f_exitLim(tp1, tp2, tp3))
        f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL D — Psychological Level Bounce  (reaction)
// ═══════════════════════════════════════════════════════════════════════
var bool psych_done = false

if _newDay
    psych_done := false

if modPsych and barstate.isconfirmed and _testWinOk and in_kz and adr_psych_ok and adr_hard_ok and not psych_done and not na(h1ATR) and h1ATR > 0 and strategy.position_size == 0
    lvl50     = math.round(close / 50.0)  * 50.0
    lvl100    = math.round(close / 100.0) * 100.0
    nearLevel = math.abs(close - lvl50) <= math.abs(close - lvl100) ? lvl50 : lvl100
    tol       = atrVal * 0.25

    bounceLong  = low  <= nearLevel + tol and low  <= nearLevel and close > nearLevel
    bounceShort = high >= nearLevel - tol and high >= nearLevel and close < nearLevel
    dir = bounceLong and not bounceShort ? 1 : bounceShort and not bounceLong ? -1 : 0

    if dir != 0
        buf    = math.max(0.30 * atrVal, 0.10 * h1ATR)
        wick   = dir == 1 ? low : high
        entryP = nearLevel
        slP    = dir == 1 ? wick - buf : wick + buf
        slDist = math.abs(entryP - slP)
        slH1   = slDist / h1ATR

        if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
            tp1 = dir == 1 ? entryP + slDist * 1.0 : entryP - slDist * 1.0
            tp2 = dir == 1 ? entryP + slDist * 2.0 : entryP - slDist * 2.0
            tp3 = dir == 1 ? entryP + slDist * 3.0 : entryP - slDist * 3.0

            if (dir == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
                psych_done := true
                eId = dir == 1 ? "PSYCH-L" : "PSYCH-S"
                strategy.entry(eId, dir == 1 ? strategy.long : strategy.short, comment="reaction")
                strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=f_exitLim(tp1, tp2, tp3))
                lvlStr = str.tostring(math.round(nearLevel))
                label.new(bar_index, dir == 1 ? low : high,
                          lvlStr + " Psych " + (dir == 1 ? "Bounce" : "Reject"),
                          style=dir == 1 ? label.style_label_up : label.style_label_down,
                          color=color.new(color.purple, 10), textcolor=color.white, size=size.tiny)
                f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL D2 — Psych Extended  (reaction-ext)
// ═══════════════════════════════════════════════════════════════════════
var bool psych_ext_done = false

if _newDay
    psych_ext_done := false

if modPsychExt and barstate.isconfirmed and _testWinOk and not in_kz and adr_psych_ok and adr_hard_ok and not psych_ext_done and not na(h1ATR) and h1ATR > 0 and strategy.position_size == 0
    nearLevel = math.round(close / 100.0) * 100.0
    tol       = atrVal * 0.25

    bounceLong  = low  <= nearLevel + tol and low  <= nearLevel and close > nearLevel
    bounceShort = high >= nearLevel - tol and high >= nearLevel and close < nearLevel
    dir = bounceLong and not bounceShort ? 1 : bounceShort and not bounceLong ? -1 : 0

    if dir != 0
        h1ok       = h1B == dir
        h4ok       = h4B == dir
        hdok       = hdB == dir
        alignCount = (h1ok ? 1 : 0) + (h4ok ? 1 : 0) + (hdok ? 1 : 0)

        if alignCount >= 2
            buf    = math.max(0.30 * atrVal, 0.10 * h1ATR)
            wick   = dir == 1 ? low : high
            entryP = nearLevel
            slP    = dir == 1 ? wick - buf : wick + buf
            slDist = math.abs(entryP - slP)
            slH1   = slDist / h1ATR

            if slDist > 0 and slH1 >= slMinH1ATR and slH1 <= slMaxH1ATR
                tp1 = dir == 1 ? entryP + slDist * 1.0 : entryP - slDist * 1.0
                tp2 = dir == 1 ? entryP + slDist * 2.0 : entryP - slDist * 2.0
                tp3 = dir == 1 ? entryP + slDist * 3.0 : entryP - slDist * 3.0

                if (dir == 1 ? (slP < entryP and tp1 > entryP) : (slP > entryP and tp1 < entryP))
                    psych_ext_done := true
                    eId = dir == 1 ? "EXT-L" : "EXT-S"
                    strategy.entry(eId, dir == 1 ? strategy.long : strategy.short, comment="reaction-ext")
                    strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=f_exitLim(tp1, tp2, tp3))
                    lvlStr = str.tostring(math.round(nearLevel))
                    label.new(bar_index, dir == 1 ? low : high,
                              "⚡ " + lvlStr + " [EXT] " + (dir == 1 ? "Bounce" : "Reject"),
                              style=dir == 1 ? label.style_label_up : label.style_label_down,
                              color=color.new(color.orange, 10), textcolor=color.white, size=size.tiny)
                    f_drawPosBox(entryP, slP, tp3)

// ─── LONDON SESSION RANGE (for Signal F) ─────────────────────────────
var float lon_hi     = na
var float lon_lo     = na
var bool  lon_locked = false

if _newDay
    lon_hi     := na
    lon_lo     := na
    lon_locked := false

if in_london
    lon_hi := na(lon_hi) ? high : math.max(lon_hi, high)
    lon_lo := na(lon_lo) ? low  : math.min(lon_lo, low)

if not in_london and in_london[1] and not na(lon_hi)
    lon_locked := true

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL E — London Range Breakout
// No daily limit — can re-fire after a stop-out while still in London.
// ATR-based SL (1.5×ATR) — independent of session range width.
// ADR gate: skip if day already consumed 80% of its average range.
// ═══════════════════════════════════════════════════════════════════════
if modLB and barstate.isconfirmed and _testWinOk and in_london and ar_locked and _adrConsumed < 0.80 and not na(ar_hi) and not na(ar_lo) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    ar_range = ar_hi - ar_lo
    if ar_range > atrVal * 0.15
        slAtr = 1.5 * atrVal
        // LONG — bar closed above Asian high
        if close > ar_hi and (not lbBiasFilter or h1B == 1)
            entryP = close
            slP    = entryP - slAtr
            tp1    = entryP + slAtr
            tp2    = entryP + slAtr * 2.0
            tp3    = entryP + slAtr * 3.0
            strategy.entry("LB-L", strategy.long, comment="london-breakout · LONG")
            strategy.exit("LB-L-X", from_entry="LB-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "LB L", style=label.style_label_up,
                      color=color.new(color.green, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

        // SHORT — bar closed below Asian low
        else if close < ar_lo and (not lbBiasFilter or h1B == -1)
            entryP = close
            slP    = entryP + slAtr
            tp1    = entryP - slAtr
            tp2    = entryP - slAtr * 2.0
            tp3    = entryP - slAtr * 3.0
            strategy.entry("LB-S", strategy.short, comment="london-breakout · SHORT")
            strategy.exit("LB-S-X", from_entry="LB-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "LB S", style=label.style_label_down,
                      color=color.new(color.red, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL F — NY Session Breakout (of London range)
// ATR-based SL. No daily limit — can re-fire after a stop-out.
// ═══════════════════════════════════════════════════════════════════════
if modNY and barstate.isconfirmed and _testWinOk and in_overlap and lon_locked and _adrConsumed < 0.80 and not na(lon_hi) and not na(lon_lo) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    lon_range = lon_hi - lon_lo
    if lon_range > atrVal * 0.15
        slAtr = 1.5 * atrVal
        if close > lon_hi
            entryP = close
            slP    = entryP - slAtr
            tp1    = entryP + slAtr
            tp2    = entryP + slAtr * 2.0
            tp3    = entryP + slAtr * 3.0
            strategy.entry("NY-L", strategy.long, comment="ny-breakout · LONG")
            strategy.exit("NY-L-X", from_entry="NY-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "NY L", style=label.style_label_up,
                      color=color.new(color.lime, 5), textcolor=color.black, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

        else if close < lon_lo
            entryP = close
            slP    = entryP + slAtr
            tp1    = entryP - slAtr
            tp2    = entryP - slAtr * 2.0
            tp3    = entryP - slAtr * 3.0
            strategy.entry("NY-S", strategy.short, comment="ny-breakout · SHORT")
            strategy.exit("NY-S-X", from_entry="NY-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "NY S", style=label.style_label_down,
                      color=color.new(color.orange, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ─── OPENING RANGE TRACKERS ───────────────────────────────────────────
// Frankfurt ORB: 07:00–07:30 UTC (pre-London institutional open)
in_frb_window  = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 450)
in_frb_trade   = timeframe.isintraday and (_minOfDay >= 450 and _minOfDay < 450 + frbTradeMins)
var float frb_hi = na
var float frb_lo = na
var bool  frb_locked = false
var bool  frb_done   = false
var bool  frb_short_today = false  // true if Frankfurt ORB fired SHORT today (used by Signal H)

// Pre-Frankfurt Asian range (00:00-07:00 UTC, before FRB window opens)
var float ar_lo_prefrb = na
var float ar_hi_prefrb = na

// Asian session direction (open vs close) for T-1 cascade filter
var float _asian_sess_open  = na
var float _asian_sess_close = na

// London ORB: 08:00–08:30 UTC (first 2 bars of London on 15M)
in_lorb_window = in_london and _minOfDay < 510
// G trade window: 08:30–11:00 UTC. Previously G was gated on `in_london` alone,
// which is the whole 08:00–11:00 session; lorb_locked made it behave as 08:30+
// anyway, but naming it explicitly lets the C2 limit expire at the window edge
// the way M's does, instead of resting against a dead level all day.
in_lorb_trade  = timeframe.isintraday and (_minOfDay >= 510 and _minOfDay < 510 + lonTradeMins)
var float lorb_hi = na
var float lorb_lo = na
var bool  lorb_locked = false
var bool  lorb_done   = false

// PM Fix ORB: 12:00–12:30 UTC (London PM gold fix window)
in_pmfix_window = timeframe.isintraday and (_minOfDay >= 720 and _minOfDay < 750)
in_pmfix_trade  = timeframe.isintraday and (_minOfDay >= 750 and _minOfDay < 840)
var float pmfix_hi = na
var float pmfix_lo = na
var bool  pmfix_locked = false
var bool  pmfix_done   = false

// Pre-NY ORB: 13:00–13:30 UTC (pre-NY quiet window; breakout amplified by NY open at 14:00)
in_preny_window = timeframe.isintraday and (_minOfDay >= 780 and _minOfDay < 810)
in_preny_trade  = timeframe.isintraday and (_minOfDay >= 810 and _minOfDay < 960)
var float preny_hi = na
var float preny_lo = na
var bool  preny_locked = false
var bool  preny_done   = false

// NY ORB: 14:00–14:30 UTC (first 2 bars of NY on 15M)
in_nyorb_window = timeframe.isintraday and (_minOfDay >= 840 and _minOfDay < 870)
// H' trade window: 14:30–16:00 UTC. The direct analogue of in_frb_trade, which
// Signal H has always been missing. Only consulted when modNYORBP is ON.
in_nyorb_trade  = timeframe.isintraday and (_minOfDay >= 870 and _minOfDay < 960)
// Optional NY limit expiry, independent of H'. When nyOrderMins is 0 this stays
// permanently TRUE, so the falling-edge cancel below can never fire and the
// baseline (cancel at the daily roll only) is reproduced exactly.
in_ny_orderlife = nyOrderMins <= 0 or (_minOfDay >= 870 and _minOfDay < 870 + nyOrderMins)

// ─── U/V: ASIAN SESSION ORBs (Sydney + Tokyo) ────────────────────────
// Same C2 architecture as M (Frankfurt) and H (NY): build a 30-min opening
// range at the session open, then take the first close outside it as a
// breakout and rest a limit back at the level.
//
// Window maths uses a wrap-safe helper because both sessions can straddle
// 00:00 UTC, where _minOfDay resets to 0 while the BROKER day (which drives
// the var resets below) rolls at 21:00/22:00 UTC instead.
_sydOrbStart = sydOpenHr * 60
_sydOrbEnd   = _sydOrbStart + sydOrbMins
_tokOrbStart = tokOpenHr * 60
_tokOrbEnd   = _tokOrbStart + tokOrbMins

f_inWin(int startMin, int endMin) =>
    s = startMin % 1440
    e = endMin % 1440
    timeframe.isintraday and (e > s ? (_minOfDay >= s and _minOfDay < e) : (_minOfDay >= s or _minOfDay < e))

in_syd_window = f_inWin(_sydOrbStart, _sydOrbEnd)
in_syd_trade  = f_inWin(_sydOrbEnd,   _sydOrbEnd + sydTradeMins)
in_tok_window = f_inWin(_tokOrbStart, _tokOrbEnd)
in_tok_trade  = f_inWin(_tokOrbEnd,   _tokOrbEnd + tokTradeMins)

var float syd_hi = na
var float syd_lo = na
var bool  syd_locked = false
var bool  syd_done   = false
var float tok_hi = na
var float tok_lo = na
var bool  tok_locked = false
var bool  tok_done   = false
var float nyorb_hi = na
var float nyorb_lo = na
var bool  nyorb_locked = false
var bool  nyorb_done   = false

// London extreme before NY ORB (08:00-14:00 UTC) — theorem London filter for Signal H
var float lon_hi_preny = na
var float lon_lo_preny = na

if _newDay
    frb_hi         := na
    frb_lo         := na
    frb_locked     := false
    frb_done       := false
    frb_short_today := false
    ar_lo_prefrb   := na
    ar_hi_prefrb   := na
    _asian_sess_open  := na
    _asian_sess_close := na
    lorb_hi     := na
    lorb_lo     := na
    lorb_locked := false
    lorb_done   := false
    pmfix_hi     := na
    pmfix_lo     := na
    pmfix_locked := false
    pmfix_done   := false
    preny_hi     := na
    preny_lo     := na
    preny_locked := false
    preny_done   := false
    nyorb_hi     := na
    nyorb_lo     := na
    nyorb_locked := false
    nyorb_done   := false
    lon_hi_preny := na
    lon_lo_preny := na
    syd_hi       := na
    syd_lo       := na
    syd_locked   := false
    syd_done     := false
    tok_hi       := na
    tok_lo       := na
    tok_locked   := false
    tok_done     := false

// Track Asian range BEFORE Frankfurt ORB window (strictly 00:00-07:00 UTC)
// Also capture first/last close for T-1 cascade direction
if _minOfDay >= 0 and _minOfDay < 420
    ar_lo_prefrb := na(ar_lo_prefrb) ? low  : math.min(ar_lo_prefrb, low)
    ar_hi_prefrb := na(ar_hi_prefrb) ? high : math.max(ar_hi_prefrb, high)
    if na(_asian_sess_open)
        _asian_sess_open := open
    _asian_sess_close := close

_asianBias = na(_asian_sess_open) or na(_asian_sess_close) ? 0 : _asian_sess_close > _asian_sess_open ? 1 : _asian_sess_close < _asian_sess_open ? -1 : 0

if in_frb_window
    frb_hi := na(frb_hi) ? high : math.max(frb_hi, high)
    frb_lo := na(frb_lo) ? low  : math.min(frb_lo, low)

if not in_frb_window and in_frb_window[1] and not na(frb_hi)
    frb_locked := true

if in_lorb_window
    lorb_hi := na(lorb_hi) ? high : math.max(lorb_hi, high)
    lorb_lo := na(lorb_lo) ? low  : math.min(lorb_lo, low)

if not in_lorb_window and in_lorb_window[1] and not na(lorb_hi)
    lorb_locked := true

if in_pmfix_window
    pmfix_hi := na(pmfix_hi) ? high : math.max(pmfix_hi, high)
    pmfix_lo := na(pmfix_lo) ? low  : math.min(pmfix_lo, low)

if not in_pmfix_window and in_pmfix_window[1] and not na(pmfix_hi)
    pmfix_locked := true

if in_preny_window
    preny_hi := na(preny_hi) ? high : math.max(preny_hi, high)
    preny_lo := na(preny_lo) ? low  : math.min(preny_lo, low)

if not in_preny_window and in_preny_window[1] and not na(preny_hi)
    preny_locked := true

if in_nyorb_window
    nyorb_hi := na(nyorb_hi) ? high : math.max(nyorb_hi, high)
    nyorb_lo := na(nyorb_lo) ? low  : math.min(nyorb_lo, low)

if not in_nyorb_window and in_nyorb_window[1] and not na(nyorb_hi)
    nyorb_locked := true

// London + Overlap extreme accumulated BEFORE the NYORB window (08:00-14:00 UTC)
if _minOfDay >= 480 and _minOfDay < 840
    lon_hi_preny := na(lon_hi_preny) ? high : math.max(lon_hi_preny, high)
    lon_lo_preny := na(lon_lo_preny) ? low  : math.min(lon_lo_preny, low)

// U/V range building + lock, mirroring the FRB/NYORB trackers
if in_syd_window
    syd_hi := na(syd_hi) ? high : math.max(syd_hi, high)
    syd_lo := na(syd_lo) ? low  : math.min(syd_lo, low)
if not in_syd_window and in_syd_window[1] and not na(syd_hi)
    syd_locked := true

if in_tok_window
    tok_hi := na(tok_hi) ? high : math.max(tok_hi, high)
    tok_lo := na(tok_lo) ? low  : math.min(tok_lo, low)
if not in_tok_window and in_tok_window[1] and not na(tok_hi)
    tok_locked := true

// ═══════════════════════════════════════════════════════════════════════
// LIQUIDITY-GRAB TRACKING  (Signals M / H / U)
// ─────────────────────────────────────────────────────────────────────
// Gold's most-cited intraday behaviour is the stop run: price pushes through
// a pool of resting orders, fails to hold, and reverses hard the other way.
// A breakout that fires AFTER the opposite side has been swept is a different
// animal from one that fires cold — the fuel (trapped traders on the wrong
// side, plus the liquidity their stops just provided) is already in place.
//
// Two pools tracked per session, from that session's ORB window open onward:
//
//   OWN ORB OPPOSITE — price traded beyond the far side of this session's own
//     opening range before breaking the near side. The classic ORB fakeout.
//
//   PRIOR SESSION POOL — price traded beyond the previous session's extreme:
//     M (Frankfurt) sweeps the ASIAN range   00:00-07:00
//     H (NY)        sweeps the LONDON range  08:00-14:00
//     U (Sydney)    sweeps the NY range      14:00 -> Sydney open
//
// A LONG break wants the DOWNSIDE pool swept first, and vice versa.
//
// NOT applied to V (Tokyo): the request was NY / Frankfurt / Sydney, and
// leaving V untouched keeps it identical in both arms. That matters here —
// this harness is path-dependent (see c2MinBreakStr), so anything that is not
// held fixed between runs contaminates the comparison.
//
// Distinct from orbBreakAsianHi/Lo, which require the break to CLOSE BEYOND
// the prior extreme. That is expansion. This is sweep-and-reclaim — the
// opposite shape, and never tested before.
//
// Every reset rides the rising edge of the session's OWN window, never
// _newDay: the broker day rolls at 21:00/22:00 UTC, directly on top of both
// the Sydney open and the NY pool window.
// ═══════════════════════════════════════════════════════════════════════

// NY session extreme feeding Signal U. Ends where the Sydney ORB begins.
in_ny_pool = f_inWin(840, _sydOrbStart)
var float ny_hi_presyd = na
var float ny_lo_presyd = na
if in_ny_pool and not in_ny_pool[1]
    ny_hi_presyd := na
    ny_lo_presyd := na
if in_ny_pool
    ny_hi_presyd := na(ny_hi_presyd) ? high : math.max(ny_hi_presyd, high)
    ny_lo_presyd := na(ny_lo_presyd) ? low  : math.min(ny_lo_presyd, low)

var bool frb_sw_lo   = false
var bool frb_sw_hi   = false
var bool frb_pool_lo = false
var bool frb_pool_hi = false
var bool nyo_sw_lo   = false
var bool nyo_sw_hi   = false
var bool nyo_pool_lo = false
var bool nyo_pool_hi = false
var bool syd_sw_lo   = false
var bool syd_sw_hi   = false
var bool syd_pool_lo = false
var bool syd_pool_hi = false

// M — Frankfurt. Own range can only be pierced after it locks at 07:30; the
// Asian pool can be pierced from 07:00 onward, so both start at the window open.
if in_frb_window and not in_frb_window[1]
    frb_sw_lo   := false
    frb_sw_hi   := false
    frb_pool_lo := false
    frb_pool_hi := false
if in_frb_window or in_frb_trade
    if frb_locked and not na(frb_lo) and low < frb_lo
        frb_sw_lo := true
    if frb_locked and not na(frb_hi) and high > frb_hi
        frb_sw_hi := true
    if not na(ar_lo_prefrb) and low < ar_lo_prefrb
        frb_pool_lo := true
    if not na(ar_hi_prefrb) and high > ar_hi_prefrb
        frb_pool_hi := true

// H — NY. Signal H carries no explicit trade-window gate (it may fire any time
// after the 14:30 lock), so track from 14:00 to the end of the session day.
if in_nyorb_window and not in_nyorb_window[1]
    nyo_sw_lo   := false
    nyo_sw_hi   := false
    nyo_pool_lo := false
    nyo_pool_hi := false
if timeframe.isintraday and _minOfDay >= 840
    if nyorb_locked and not na(nyorb_lo) and low < nyorb_lo
        nyo_sw_lo := true
    if nyorb_locked and not na(nyorb_hi) and high > nyorb_hi
        nyo_sw_hi := true
    if not na(lon_lo_preny) and low < lon_lo_preny
        nyo_pool_lo := true
    if not na(lon_hi_preny) and high > lon_hi_preny
        nyo_pool_hi := true

// U — Sydney.
if in_syd_window and not in_syd_window[1]
    syd_sw_lo   := false
    syd_sw_hi   := false
    syd_pool_lo := false
    syd_pool_hi := false
if in_syd_window or in_syd_trade
    if syd_locked and not na(syd_lo) and low < syd_lo
        syd_sw_lo := true
    if syd_locked and not na(syd_hi) and high > syd_hi
        syd_sw_hi := true
    if not na(ny_lo_presyd) and low < ny_lo_presyd
        syd_pool_lo := true
    if not na(ny_hi_presyd) and high > ny_hi_presyd
        syd_pool_hi := true

// V — Tokyo. Tracked for CLASSIFICATION ONLY: the A+ table has to be able to
// label every ORB trade in the baseline, and V is part of that baseline. The
// f_liqOk gates below are deliberately NOT extended to V, so turning the
// filter on still changes exactly the same three signals the two test runs
// used. Pool = the Sydney session, i.e. Sydney open -> Tokyo open.
in_tok_pool = f_inWin(_sydOrbStart, _tokOrbStart)
var float syd_hi_pretok = na
var float syd_lo_pretok = na
if in_tok_pool and not in_tok_pool[1]
    syd_hi_pretok := na
    syd_lo_pretok := na
if in_tok_pool
    syd_hi_pretok := na(syd_hi_pretok) ? high : math.max(syd_hi_pretok, high)
    syd_lo_pretok := na(syd_lo_pretok) ? low  : math.min(syd_lo_pretok, low)

var bool tok_sw_lo   = false
var bool tok_sw_hi   = false
var bool tok_pool_lo = false
var bool tok_pool_hi = false
if in_tok_window and not in_tok_window[1]
    tok_sw_lo   := false
    tok_sw_hi   := false
    tok_pool_lo := false
    tok_pool_hi := false
if in_tok_window or in_tok_trade
    if tok_locked and not na(tok_lo) and low < tok_lo
        tok_sw_lo := true
    if tok_locked and not na(tok_hi) and high > tok_hi
        tok_sw_hi := true
    if not na(syd_lo_pretok) and low < syd_lo_pretok
        tok_pool_lo := true
    if not na(syd_hi_pretok) and high > syd_hi_pretok
        tok_pool_hi := true

// ═══════════════════════════════════════════════════════════════════════
// STRUCTURAL ANCHOR TRACKING  (instrumentation only — places no stop)
// ─────────────────────────────────────────────────────────────────────
// Added 2026-09-22. Every stop this system has ever used is a FITTED NUMBER:
// 150 because it worked, then 80 because it worked better. Neither describes
// anything about the market. A structural stop is different in kind — it sits
// where the trade thesis is falsified, so it survives a regime change that
// kills a constant.
//
// It also solves sizing for free. Risk-based lot = riskDollars / slDist, so a
// structurally TIGHT setup automatically gets a BIGGER position at identical
// dollar risk. That is the A+ mechanism arising from the geometry instead of
// being bolted on as a tag-and-multiply rule.
//
// THIS BLOCK CHANGES NO TRADE. It records, per signal, how far each candidate
// anchor sits from the entry, so the distributions can be read before anything
// is wired to a real stop. Building placement first would mean a full re-run
// per anchor (path dependence), and most anchors can be killed for free.
//
// The session extreme below does double duty: it is the SWEEP WICK (the low of
// the move that ran the liquidity) and the session's own extreme so far. The
// sweep BOOLEANS above were built for the liquidity-grab filter, which was
// rejected. But there are two different questions here: do-not-trade-unless-
// liquidity-was-swept, and put-the-stop-below-the-wick-that-swept-it. Only the
// first one has been answered.
var float frb_ext_lo  = na
var float frb_ext_hi  = na
var float nyo_ext_lo  = na
var float nyo_ext_hi  = na
var float syd_ext_lo  = na
var float syd_ext_hi  = na
var float lorb_ext_lo = na
var float lorb_ext_hi = na

// Each resets on the rising edge of its OWN window, never _newDay — the broker
// day rolls at 21:00/22:00 UTC, directly on top of the Sydney open.
if in_frb_window and not in_frb_window[1]
    frb_ext_lo := na
    frb_ext_hi := na
if in_frb_window or in_frb_trade
    frb_ext_lo := na(frb_ext_lo) ? low  : math.min(frb_ext_lo, low)
    frb_ext_hi := na(frb_ext_hi) ? high : math.max(frb_ext_hi, high)

if in_nyorb_window and not in_nyorb_window[1]
    nyo_ext_lo := na
    nyo_ext_hi := na
if timeframe.isintraday and _minOfDay >= 840
    nyo_ext_lo := na(nyo_ext_lo) ? low  : math.min(nyo_ext_lo, low)
    nyo_ext_hi := na(nyo_ext_hi) ? high : math.max(nyo_ext_hi, high)

if in_syd_window and not in_syd_window[1]
    syd_ext_lo := na
    syd_ext_hi := na
if in_syd_window or in_syd_trade
    syd_ext_lo := na(syd_ext_lo) ? low  : math.min(syd_ext_lo, low)
    syd_ext_hi := na(syd_ext_hi) ? high : math.max(syd_ext_hi, high)

if in_lorb_window and not in_lorb_window[1]
    lorb_ext_lo := na
    lorb_ext_hi := na
if in_lorb_window or in_lorb_trade
    lorb_ext_lo := na(lorb_ext_lo) ? low  : math.min(lorb_ext_lo, low)
    lorb_ext_hi := na(lorb_ext_hi) ? high : math.max(lorb_ext_hi, high)

// Pure resolver — reads the mode, assigns nothing, so it is safe as a function.
f_liqOk(bool ownSw, bool poolSw) =>
    c2LiqGrab == "Off" ? true : c2LiqGrab == "Sweep own ORB opposite" ? ownSw : c2LiqGrab == "Sweep prior session pool" ? poolSw : (ownSw or poolSw)

// ─── RATCHET (NO TP) — unlimited runner, stop-only exit ──────────────
// No take-profit order at all. The position closes ONLY when the ratcheting
// stop is hit, so a trade that keeps going keeps going — 10R, 20R, no cap.
//
// Rungs are spaced in ORB-RANGE units, NOT R. R here is the 150-pt stop while
// the ORB range is ~24 pts, so an R-spaced ladder would put its first rung
// ~112 pts away — 1.5-3 daily ranges — and would essentially never arm. Range
// units put rung 1 at ~18 pts, where price actually trades.
//
//   reach r (>= trailArm) -> stop to (r * trailKeep) x step beyond the level
//   giveback is always (1 - trailKeep) of the furthest excursion, so the stop
//   locks PROFIT and never returns to entry. Unbounded above.
//
// step = orb_range * orbTPMult, i.e. the same spacing as tp1/tp2/tp3.
//
// TIMING CAVEAT — this is why the ratchet cannot hold the TP1 win rate.
// Under "TP1 · 1R" the exit is a LIMIT order, which TradingView fills the
// instant the bar's high touches it, INTRABAR. The trail below recalculates
// only at bar close and the new stop is live from the NEXT bar. So a 15m bar
// that spikes past the arm level and closes back below is a WIN under TP1 and
// can still be a full LOSS here. With step ~18 pts, a single gold 15m bar
// routinely covers the whole distance. That gap is real trading behaviour,
// not a modelling artifact — it is the price of removing the take-profit.

// ─── C2 PENDING-ORDER EXPIRY ─────────────────────────────────────────
// A strategy.entry limit stays live until it fills or is cancelled, and none
// of the C2 limits were ever cancelled. An FRB-S limit armed on Monday could
// therefore still fill on Thursday against Monday's ORB level. In Ratchet mode
// that is worse than a stale entry: _rt_lvl would be days old, so `reach`
// comes out enormous and the trail slams the stop far past current price.
// Bound every C2 limit to its own session.
if not in_frb_trade and in_frb_trade[1]
    strategy.cancel("FRB-L")
    strategy.cancel("FRB-S")
// G in C2 mode rests a limit, so it needs the same expiry M has — otherwise an
// ORB-L armed at 10:55 still fills at 19:00 against a level that stopped being
// the London opening range hours earlier.
if not in_lorb_trade and in_lorb_trade[1]
    strategy.cancel("ORB-L")
    strategy.cancel("ORB-S")
if not in_syd_trade and in_syd_trade[1]
    strategy.cancel("SYD-L")
    strategy.cancel("SYD-S")
if not in_tok_trade and in_tok_trade[1]
    strategy.cancel("TOK-L")
    strategy.cancel("TOK-S")
if _newDay
    strategy.cancel("NYORB-L")
    strategy.cancel("NYORB-S")
// H' only: expire the NYORB limit at the end of its own window, the way M does.
// Without this a limit armed at 15:55 still rests all evening against a level
// that stopped being the opening range hours earlier.
if modNYORBP and not in_nyorb_trade and in_nyorb_trade[1]
    strategy.cancel("NYORB-L")
    strategy.cancel("NYORB-S")
// Standalone NY expiry (nyOrderMins > 0). Separate from H' on purpose: H' also
// blocks the SIGNAL to a 14:30-16:00 window and was rejected for that reason,
// whereas this only bounds how long an already-armed LIMIT may rest. Late NY
// breaks were measured as the BETTER trades, so the two must be testable apart.
if not in_ny_orderlife and in_ny_orderlife[1]
    strategy.cancel("NYORB-L")
    strategy.cancel("NYORB-S")

var float  _rt_lvl   = na     // ORB structural level the rungs measure from
var float  _rt_entry = na     // actual fill reference (level +/- _c2Depth)
var float  _rt_rng   = na     // ORB range captured at signal time
var int    _rt_dir   = 0      // +1 long, -1 short, 0 idle
var string _rt_id    = na     // entry order id
var float  _rt_sl    = na     // current stop
var float  _rt_reach = 0.0    // furthest excursion reached, in step units

if exitMode == "Ratchet (no TP)" and _rt_dir != 0 and not na(_rt_lvl) and strategy.position_size != 0
    step = _rt_rng * orbTPMult
    if step > 0
        // Excursion beyond the ORB level, in step units (1.0 = one TP step).
        reach = _rt_dir == 1 ? (high - _rt_lvl) / step : (_rt_lvl - low) / step
        if reach > _rt_reach
            _rt_reach := reach
        if _rt_reach >= trailArm
            // Stop sits at a FRACTION of the furthest excursion, so it locks
            // PROFIT rather than returning to entry: reach 0.75 with keep 0.75
            // locks 0.5625. Never gives back more than (1 - trailKeep).
            cand = _rt_lvl + _rt_dir * (_rt_reach * trailKeep) * step
            better = _rt_dir == 1 ? cand > _rt_sl : cand < _rt_sl
            if better
                _rt_sl := cand
        // stop only — no limit arg means no take-profit is ever placed
        strategy.exit(_rt_id + "-X", from_entry=_rt_id, stop=_rt_sl)

// Clear ratchet state only on an ACTUAL close (was in a position, now flat).
// Testing position_size == 0 alone would wipe the state of a C2 limit that is
// armed but not yet filled — every retest entry sits flat before it fills.
var float _rt_prevSize = 0.0
if strategy.position_size == 0 and _rt_prevSize != 0
    _rt_dir  := 0
    _rt_reach := 0.0
    _rt_lvl  := na
    _rt_sl   := na
_rt_prevSize := strategy.position_size

// ─── SCALE 30/75/150 — BE STOP MANAGEMENT ────────────────────────────
// Tracks open multi-TP positions (H/M only). When TP1 fires (position
// shrinks by ≥15%), cancels original X2/X3 and re-issues them with
// stop=entry (breakeven), preventing a TP1 winner from turning into a loss.
var float  _mtp_px   = na      // entry price stored at trade open
var float  _mtp_tp2  = na      // TP2 level stored at trade open
var float  _mtp_run  = na      // runner level stored at trade open
var string _mtp_id   = na      // entry order ID ("FRB-S", "NYORB-L", etc.)
var bool   _mtp_be   = false   // true once BE stop has been re-issued
var float  _mtp_prev = 0.0     // position size at end of previous bar

_mtp_cur = strategy.position_size
if not na(_mtp_id) and _mtp_cur != 0 and not _mtp_be
    if math.abs(_mtp_cur) < math.abs(_mtp_prev) * 0.85  // TP1 fired
        _mtp_be := true
        strategy.cancel(_mtp_id + "-X2")
        strategy.cancel(_mtp_id + "-X3")
        if _mtp_cur < 0  // remaining short: re-issue X2/X3 with BE stop
            strategy.exit(_mtp_id + "-X2b", from_entry=_mtp_id, qty_percent=67, stop=_mtp_px, limit=_mtp_tp2)
            strategy.exit(_mtp_id + "-X3b", from_entry=_mtp_id, stop=_mtp_px, limit=_mtp_run)
        else             // remaining long
            strategy.exit(_mtp_id + "-X2b", from_entry=_mtp_id, qty_percent=67, stop=_mtp_px, limit=_mtp_tp2)
            strategy.exit(_mtp_id + "-X3b", from_entry=_mtp_id, stop=_mtp_px, limit=_mtp_run)
if _mtp_cur == 0
    _mtp_id := na
    _mtp_be := false
_mtp_prev := _mtp_cur

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL M — Frankfurt ORB (Opening Range Breakout 07:00-07:30 UTC)
// Frankfurt/ECB open — European banks begin gold programs.  Same ORB
// logic as G and H but fires 1 hour before London, in a completely
// separate time window so it never conflicts with G or H.
// ═══════════════════════════════════════════════════════════════════════
if modFRB and barstate.isconfirmed and _testWinOk and in_frb_trade and frb_locked and not frb_done and not na(frb_hi) and not na(frb_lo) and _orbGateFRB and _hm_dow_ok and strategy.position_size == 0
    orb_range = frb_hi - frb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range >= c2MinRangeFRB
        if close > frb_hi and (close - frb_hi) >= orb_range * c2MinBreakStr and f_liqOk(frb_sw_lo, frb_pool_lo) and (not orbBiasFilter or _orbBiasLong) and frbDirFilter != "Short only" and _orbSeasonL and (not orbBreakAsianHi or (not na(ar_hi_prefrb) and close > ar_hi_prefrb)) and (not asianBiasFilter or _asianBias >= 0)
            // C2 retest: BUY LIMIT at frb_hi (broken ORB high retests as support).
            // Depth > 0 lifts the limit toward price so a shallow bounce fills it;
            // SL/TP stay on the ORB level, so only entry price and fill odds move.
            entryP = frb_hi + orb_range * _c2Depth
            slP    = frb_hi - f_c2SL(orb_range)
            slDist = math.abs(entryP - slP)
            tp1    = frb_hi + orb_range * orbTPMult
            tp2    = frb_hi + orb_range * orbTPMult * 2.0
            tp3    = frb_hi + orb_range * orbTPMult * 3.0
            frb_done := true
            // limit=na → market fill at this bar's close. SL/TP stay anchored to
            // the ORB level either way, so only the entry price differs.
            c2LimFL = c2EntryMode == "Retest (limit)" ? entryP : na
            strategy.entry("FRB-L", strategy.long, limit=c2LimFL, comment="frankfurt-orb · C2 LONG")
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := frb_hi
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := 1
                _rt_id    := "FRB-L"
                _rt_sl    := slP
                _rt_reach := 0.0
            if exitMode == "Trail after TP1"
                strategy.exit("FRB-L-X", from_entry="FRB-L", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("FRB-L-X1", from_entry="FRB-L", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("FRB-L-X2", from_entry="FRB-L", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = frb_hi + orb_range * 0.30
                sc2 = frb_hi + orb_range * 0.75
                sc3 = frb_hi + orb_range * 1.50
                strategy.exit("FRB-L-X1", from_entry="FRB-L", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("FRB-L-X2", from_entry="FRB-L", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("FRB-L-X3", from_entry="FRB-L", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "FRB-L"
                _mtp_be  := false
            else if exitMode == "Ratchet (no TP)"
                strategy.exit("FRB-L-X", from_entry="FRB-L", stop=slP)
            else
                strategy.exit("FRB-L-X", from_entry="FRB-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

        else if close < frb_lo and (frb_lo - close) >= orb_range * c2MinBreakStr and f_liqOk(frb_sw_hi, frb_pool_hi) and (not orbBiasFilter or _orbBiasShort) and frbDirFilter != "Long only" and _orbSeasonS and (not orbBreakAsianLo or (not na(ar_lo_prefrb) and close < ar_lo_prefrb)) and (not asianBiasFilter or _asianBias <= 0)
            // C2 retest: SELL LIMIT at frb_lo (broken ORB low retests as resistance).
            // Depth > 0 drops the limit toward price so a shallow bounce fills it.
            entryP = frb_lo - orb_range * _c2Depth
            slP    = frb_lo + f_c2SL(orb_range)
            slDist = math.abs(slP - entryP)
            tp1    = frb_lo - orb_range * orbTPMult
            tp2    = frb_lo - orb_range * orbTPMult * 2.0
            tp3    = frb_lo - orb_range * orbTPMult * 3.0
            frb_done       := true
            frb_short_today := true
            c2LimFS = c2EntryMode == "Retest (limit)" ? entryP : na
            strategy.entry("FRB-S", strategy.short, limit=c2LimFS, comment="frankfurt-orb · C2 SHORT")
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := frb_lo
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := -1
                _rt_id    := "FRB-S"
                _rt_sl    := slP
                _rt_reach := 0.0
            if exitMode == "Trail after TP1"
                strategy.exit("FRB-S-X", from_entry="FRB-S", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("FRB-S-X1", from_entry="FRB-S", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("FRB-S-X2", from_entry="FRB-S", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = frb_lo - orb_range * 0.30
                sc2 = frb_lo - orb_range * 0.75
                sc3 = frb_lo - orb_range * 1.50
                strategy.exit("FRB-S-X1", from_entry="FRB-S", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("FRB-S-X2", from_entry="FRB-S", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("FRB-S-X3", from_entry="FRB-S", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "FRB-S"
                _mtp_be  := false
            else if exitMode == "Ratchet (no TP)"
                strategy.exit("FRB-S-X", from_entry="FRB-S", stop=slP)
            else
                strategy.exit("FRB-S-X", from_entry="FRB-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL G — London ORB (Opening Range Breakout 08:00-08:30 UTC)
// The most documented professional gold setup.  OR = first 30 min.
// After 08:30: trade first bar that closes outside the OR.
// SL at opposite OR extreme; TP targets are multiples of OR width.
// ═══════════════════════════════════════════════════════════════════════
// REWORKED 2026-09-21. G was the last ORB still running the ORIGINAL
// architecture — market entry at the close, SL at the opposite OR extreme, no
// bias gate, no ADR gate, no min-range floor, no Asian filters. M and H have all
// of those and produce the 99% baseline; G had none and was left OFF.
//
// Now switchable to the identical C2 geometry, with each requested filter on its
// own toggle so they can be isolated one at a time rather than all at once.
// Every filter defaults OFF, so turning modORB on alone reproduces C2-G bare.
if modORB and barstate.isconfirmed and in_lorb_trade and lorb_locked and not lorb_done and not na(lorb_hi) and not na(lorb_lo) and (not lonADRGuard or _adrConsumed[1] < 0.90) and _testWinOk and _hm_dow_ok and strategy.position_size == 0
    orb_range = lorb_hi - lorb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range >= (lonUseC2 ? c2MinRangeLON : 0.50)
        if close > lorb_hi and lonDirFilter != "Short only" and (not lonBiasFilter or _orbBiasLong) and (not lonBreakAsianHi or (not na(ar_hi) and close > ar_hi)) and (not lonAsianCascade or _asianBias >= 0)
            // C2: BUY LIMIT back at lorb_hi (broken ORB high retests as support).
            // Legacy: market fill at this bar's close, SL at the opposite extreme.
            entryP = lonUseC2 ? lorb_hi + orb_range * _c2Depth : close
            slP    = lonUseC2 ? lorb_hi - f_c2SL(orb_range)    : lorb_lo - buf
            tp1    = lonUseC2 ? lorb_hi + orb_range * orbTPMult       : lorb_hi + orb_range
            tp2    = lonUseC2 ? lorb_hi + orb_range * orbTPMult * 2.0 : lorb_hi + orb_range * 2.0
            tp3    = lonUseC2 ? lorb_hi + orb_range * orbTPMult * 3.0 : lorb_hi + orb_range * 3.0
            lorb_done := true
            c2LimGL = (lonUseC2 and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("ORB-L", strategy.long, limit=c2LimGL, comment="london-orb · LONG")
            // Ratchet state — without this, f_c2Exit's ratchet branch places a
            // naked stop with no TP and no trail: a guaranteed full loss. Same
            // bug U and V carried until it was found.
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := lorb_hi
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := 1
                _rt_id    := "ORB-L"
                _rt_sl    := slP
                _rt_reach := 0.0
            f_c2Exit("ORB-L", slP, tp1, tp2, tp3, orb_range)
            f_drawPosBox(entryP, slP, tp3)

        else if close < lorb_lo and lonDirFilter != "Long only" and (not lonBiasFilter or _orbBiasShort) and (not lonBreakAsianLo or (not na(ar_lo) and close < ar_lo)) and (not lonAsianCascade or _asianBias <= 0)
            entryP = lonUseC2 ? lorb_lo - orb_range * _c2Depth : close
            slP    = lonUseC2 ? lorb_lo + f_c2SL(orb_range)    : lorb_hi + buf
            tp1    = lonUseC2 ? lorb_lo - orb_range * orbTPMult       : lorb_lo - orb_range
            tp2    = lonUseC2 ? lorb_lo - orb_range * orbTPMult * 2.0 : lorb_lo - orb_range * 2.0
            tp3    = lonUseC2 ? lorb_lo - orb_range * orbTPMult * 3.0 : lorb_lo - orb_range * 3.0
            lorb_done := true
            c2LimGS = (lonUseC2 and c2EntryMode == "Retest (limit)") ? entryP : na
            strategy.entry("ORB-S", strategy.short, limit=c2LimGS, comment="london-orb · SHORT")
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := lorb_lo
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := -1
                _rt_id    := "ORB-S"
                _rt_sl    := slP
                _rt_reach := 0.0
            f_c2Exit("ORB-S", slP, tp1, tp2, tp3, orb_range)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL N — PM Fix ORB (Opening Range 12:00-12:30 UTC)
// The London PM Gold Fix is the most important gold benchmark in the
// world — major banks settle positions here.  Price often makes a clean
// directional break after the fix window closes.  Trade window: 12:30–14:00.
// ═══════════════════════════════════════════════════════════════════════
if modPMFix and barstate.isconfirmed and _testWinOk and in_pmfix_trade and pmfix_locked and not pmfix_done and not na(pmfix_hi) and not na(pmfix_lo) and strategy.position_size == 0
    orb_range = pmfix_hi - pmfix_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range > 0.50
        if close > pmfix_hi
            entryP = close
            slP    = pmfix_lo - buf
            pmfix_done := true
            strategy.entry("PMF-L", strategy.long, comment="pm-fix · LONG")
            strategy.exit("PMF-L-X", from_entry="PMF-L", stop=slP,
                          limit=f_exitLim(pmfix_hi + orb_range, pmfix_hi + orb_range * 2.0, pmfix_hi + orb_range * 3.0))
            f_drawPosBox(entryP, slP, pmfix_hi + orb_range * 3.0)

        else if close < pmfix_lo
            entryP = close
            slP    = pmfix_hi + buf
            pmfix_done := true
            strategy.entry("PMF-S", strategy.short, comment="pm-fix · SHORT")
            strategy.exit("PMF-S-X", from_entry="PMF-S", stop=slP,
                          limit=f_exitLim(pmfix_lo - orb_range, pmfix_lo - orb_range * 2.0, pmfix_lo - orb_range * 3.0))
            f_drawPosBox(entryP, slP, pmfix_lo - orb_range * 3.0)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL O — Pre-NY ORB (Opening Range 13:00-13:30 UTC)
// Mirror of Signal M: quiet pre-NY window (13:00-13:30) followed by
// the NY open momentum burst at 14:00.  If the Frankfurt-pre-London
// hypothesis holds, this should also outperform in-session ORBs.
// Trade window: 13:30–16:00 UTC.
// ═══════════════════════════════════════════════════════════════════════
if modPreNY and barstate.isconfirmed and _testWinOk and in_preny_trade and preny_locked and not preny_done and not na(preny_hi) and not na(preny_lo) and strategy.position_size == 0
    orb_range = preny_hi - preny_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range > 0.50
        if close > preny_hi
            entryP = close
            slP    = preny_lo - buf
            preny_done := true
            strategy.entry("PRENY-L", strategy.long, comment="pre-ny-orb · LONG")
            strategy.exit("PRENY-L-X", from_entry="PRENY-L", stop=slP,
                          limit=f_exitLim(preny_hi + orb_range, preny_hi + orb_range * 2.0, preny_hi + orb_range * 3.0))
            f_drawPosBox(entryP, slP, preny_hi + orb_range * 3.0)

        else if close < preny_lo
            entryP = close
            slP    = preny_hi + buf
            preny_done := true
            strategy.entry("PRENY-S", strategy.short, comment="pre-ny-orb · SHORT")
            strategy.exit("PRENY-S-X", from_entry="PRENY-S", stop=slP,
                          limit=f_exitLim(preny_lo - orb_range, preny_lo - orb_range * 2.0, preny_lo - orb_range * 3.0))
            f_drawPosBox(entryP, slP, preny_lo - orb_range * 3.0)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL H — NY ORB (Opening Range Breakout 14:00-14:30 UTC)
// Same concept for the NY open — second major institutional opportunity.
// ═══════════════════════════════════════════════════════════════════════
if modNYORB and barstate.isconfirmed and _testWinOk and (not modNYORBP or in_nyorb_trade) and nyorb_locked and not nyorb_done and not na(nyorb_hi) and not na(nyorb_lo) and _orbGateNY and _hm_dow_ok and strategy.position_size == 0
    orb_range = nyorb_hi - nyorb_lo
    buf       = math.max(atrVal * 0.10, 0.50)
    if orb_range >= c2MinRangeNY
        if close > nyorb_hi and (close - nyorb_hi) >= orb_range * c2MinBreakStr and f_liqOk(nyo_sw_lo, nyo_pool_lo) and (not orbBiasFilter or _orbBiasLong) and nyorbDirFilter != "Short only" and _orbSeasonL and (not orbNYFRBCtxL or (frb_short_today and h1B == 1)) and (not orbNYLonHiFilter or (not na(lon_hi_preny) and close > lon_hi_preny)) and (not asianBiasFilter or _asianBias >= 0)
            // C2 retest: BUY LIMIT at nyorb_hi (broken ORB high retests as support).
            // Depth > 0 lifts the limit toward price so a shallow bounce fills it.
            entryP = nyorb_hi + orb_range * _c2Depth
            slP    = nyorb_hi - f_c2SL(orb_range)
            slDist = math.abs(entryP - slP)
            tp1    = nyorb_hi + orb_range * orbTPMult
            tp2    = nyorb_hi + orb_range * orbTPMult * 2.0
            tp3    = nyorb_hi + orb_range * orbTPMult * 3.0
            nyorb_done := true
            c2LimNL = c2EntryMode == "Retest (limit)" ? entryP : na
            strategy.entry("NYORB-L", strategy.long, limit=c2LimNL, comment="ny-orb · C2 LONG")
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := nyorb_hi
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := 1
                _rt_id    := "NYORB-L"
                _rt_sl    := slP
                _rt_reach := 0.0
            if exitMode == "Trail after TP1"
                strategy.exit("NYORB-L-X", from_entry="NYORB-L", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("NYORB-L-X1", from_entry="NYORB-L", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("NYORB-L-X2", from_entry="NYORB-L", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = nyorb_hi + orb_range * 0.30
                sc2 = nyorb_hi + orb_range * 0.75
                sc3 = nyorb_hi + orb_range * 1.50
                strategy.exit("NYORB-L-X1", from_entry="NYORB-L", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("NYORB-L-X2", from_entry="NYORB-L", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("NYORB-L-X3", from_entry="NYORB-L", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "NYORB-L"
                _mtp_be  := false
            else if exitMode == "Ratchet (no TP)"
                strategy.exit("NYORB-L-X", from_entry="NYORB-L", stop=slP)
            else
                strategy.exit("NYORB-L-X", from_entry="NYORB-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

        else if close < nyorb_lo and (nyorb_lo - close) >= orb_range * c2MinBreakStr and f_liqOk(nyo_sw_hi, nyo_pool_hi) and (not orbBiasFilter or _orbBiasShort) and nyorbDirFilter != "Long only" and _orbSeasonS and (not orbNYFRBCtxS or (frb_short_today and h1B == -1)) and (not orbNYLonLoFilter or (not na(lon_lo_preny) and close < lon_lo_preny)) and (not asianBiasFilter or _asianBias <= 0)
            // C2 retest: SELL LIMIT at nyorb_lo (broken ORB low retests as resistance).
            // Depth > 0 drops the limit toward price so a shallow bounce fills it.
            entryP = nyorb_lo - orb_range * _c2Depth
            slP    = nyorb_lo + f_c2SL(orb_range)
            slDist = math.abs(slP - entryP)
            tp1    = nyorb_lo - orb_range * orbTPMult
            tp2    = nyorb_lo - orb_range * orbTPMult * 2.0
            tp3    = nyorb_lo - orb_range * orbTPMult * 3.0
            nyorb_done := true
            c2LimNS = c2EntryMode == "Retest (limit)" ? entryP : na
            strategy.entry("NYORB-S", strategy.short, limit=c2LimNS, comment="ny-orb · C2 SHORT")
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := nyorb_lo
                _rt_entry := entryP
                _rt_rng   := orb_range
                _rt_dir   := -1
                _rt_id    := "NYORB-S"
                _rt_sl    := slP
                _rt_reach := 0.0
            if exitMode == "Trail after TP1"
                strategy.exit("NYORB-S-X", from_entry="NYORB-S", stop=slP, trail_price=tp1, trail_offset=math.round(orb_range / syminfo.mintick))
            else if exitMode == "Split TP1+TP2"
                strategy.exit("NYORB-S-X1", from_entry="NYORB-S", qty_percent=50, stop=slP, limit=tp1)
                strategy.exit("NYORB-S-X2", from_entry="NYORB-S", stop=slP, limit=tp2)
            else if exitMode == "Scale 30/75/150"
                sc1 = nyorb_lo - orb_range * 0.30
                sc2 = nyorb_lo - orb_range * 0.75
                sc3 = nyorb_lo - orb_range * 1.50
                strategy.exit("NYORB-S-X1", from_entry="NYORB-S", qty_percent=25, stop=slP, limit=sc1)
                strategy.exit("NYORB-S-X2", from_entry="NYORB-S", qty_percent=67, stop=slP, limit=sc2)
                strategy.exit("NYORB-S-X3", from_entry="NYORB-S", stop=slP, limit=sc3)
                _mtp_px  := entryP
                _mtp_tp2 := sc2
                _mtp_run := sc3
                _mtp_id  := "NYORB-S"
                _mtp_be  := false
            else if exitMode == "Ratchet (no TP)"
                strategy.exit("NYORB-S-X", from_entry="NYORB-S", stop=slP)
            else
                strategy.exit("NYORB-S-X", from_entry="NYORB-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNALS U + V — Asian session ORBs  (Sydney / Tokyo)
// ─────────────────────────────────────────────────────────────────────
// M and H are really just "session-open ORB" applied to Frankfurt and NY.
// U and V apply the identical C2 architecture to the two Asian opens:
//   U) Sydney — 22:00 UTC default (UTC+10/+11, DST-dependent)
//   V) Tokyo  — 00:00 UTC (UTC+9, no DST, so this one is exact)
//
// Identical to M/H in every respect: 30-min opening range, first close
// outside it is the breakout, limit rests back at the level (shifted by
// _c2Depth), SL = level ± f_c2SL(range), TPs = range × orbTPMult × {1,2,3},
// H1+H4 bias must align, min-range floor, ADR gate, one shot per day.
//
// UNTESTED. Asian sessions carry a fraction of Frankfurt/NY liquidity, so
// the honest prior is that ranges rarely clear the 5pt floor and that any
// breakout mean-reverts rather than extends. The min-range filter blocking
// most signals IS a result — it would mean the setup does not exist here.
// ═══════════════════════════════════════════════════════════════════════

// f_c2Exit moved UP to just after f_exitLim — Signal G now uses it too, and G
// sits earlier in the file than this block did. Pine requires a function to be
// defined before every use.

// ─── SIGNAL U — Sydney ORB ───────────────────────────────────────────
if modSYD and barstate.isconfirmed and _testWinOk and in_syd_trade and syd_locked and not syd_done and not na(syd_hi) and not na(syd_lo) and _orbGateOk and _hm_dow_ok and strategy.position_size == 0
    rngU = syd_hi - syd_lo
    if rngU >= c2MinRangeASIA
        if close > syd_hi and (close - syd_hi) >= rngU * c2MinBreakStr and f_liqOk(syd_sw_lo, syd_pool_lo) and (not orbBiasFilter or _orbBiasLong)
            entryP = syd_hi + rngU * _c2Depth
            slP    = syd_hi - f_c2SL(rngU)
            tp1    = syd_hi + rngU * orbTPMult
            tp2    = syd_hi + rngU * orbTPMult * 2.0
            tp3    = syd_hi + rngU * orbTPMult * 3.0
            syd_done := true
            c2LimUL = c2EntryMode == "Retest (limit)" ? entryP : na
            strategy.entry("SYD-L", strategy.long, limit=c2LimUL, comment="sydney-orb · C2 LONG")
            // BUG FIX: U/V never registered ratchet state, so f_c2Exit's ratchet
            // branch placed a NAKED stop with no TP and no trail. Every filled
            // Sydney/Tokyo trade could then only ever exit at its original stop —
            // a guaranteed full loss, 100% of the time.
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := syd_hi
                _rt_entry := entryP
                _rt_rng   := rngU
                _rt_dir   := 1
                _rt_id    := "SYD-L"
                _rt_sl    := slP
                _rt_reach := 0.0
            f_c2Exit("SYD-L", slP, tp1, tp2, tp3, rngU)
            label.new(bar_index, low, "U↑", style=label.style_label_up,
                      color=color.new(color.blue, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

        else if close < syd_lo and (syd_lo - close) >= rngU * c2MinBreakStr and f_liqOk(syd_sw_hi, syd_pool_hi) and (not orbBiasFilter or _orbBiasShort)
            entryP = syd_lo - rngU * _c2Depth
            slP    = syd_lo + f_c2SL(rngU)
            tp1    = syd_lo - rngU * orbTPMult
            tp2    = syd_lo - rngU * orbTPMult * 2.0
            tp3    = syd_lo - rngU * orbTPMult * 3.0
            syd_done := true
            c2LimUS = c2EntryMode == "Retest (limit)" ? entryP : na
            strategy.entry("SYD-S", strategy.short, limit=c2LimUS, comment="sydney-orb · C2 SHORT")
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := syd_lo
                _rt_entry := entryP
                _rt_rng   := rngU
                _rt_dir   := -1
                _rt_id    := "SYD-S"
                _rt_sl    := slP
                _rt_reach := 0.0
            f_c2Exit("SYD-S", slP, tp1, tp2, tp3, rngU)
            label.new(bar_index, high, "U↓", style=label.style_label_down,
                      color=color.new(color.blue, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ─── SIGNAL V — Tokyo ORB ────────────────────────────────────────────
if modTOK and barstate.isconfirmed and _testWinOk and in_tok_trade and tok_locked and not tok_done and not na(tok_hi) and not na(tok_lo) and _orbGateOk and _hm_dow_ok and strategy.position_size == 0
    rngV = tok_hi - tok_lo
    if rngV >= c2MinRangeASIA
        if close > tok_hi and (close - tok_hi) >= rngV * c2MinBreakStr and (not orbBiasFilter or _orbBiasLong)
            entryP = tok_hi + rngV * _c2Depth
            slP    = tok_hi - f_c2SL(rngV)
            tp1    = tok_hi + rngV * orbTPMult
            tp2    = tok_hi + rngV * orbTPMult * 2.0
            tp3    = tok_hi + rngV * orbTPMult * 3.0
            tok_done := true
            c2LimVL = c2EntryMode == "Retest (limit)" ? entryP : na
            strategy.entry("TOK-L", strategy.long, limit=c2LimVL, comment="tokyo-orb · C2 LONG")
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := tok_hi
                _rt_entry := entryP
                _rt_rng   := rngV
                _rt_dir   := 1
                _rt_id    := "TOK-L"
                _rt_sl    := slP
                _rt_reach := 0.0
            f_c2Exit("TOK-L", slP, tp1, tp2, tp3, rngV)
            label.new(bar_index, low, "V↑", style=label.style_label_up,
                      color=color.new(color.fuchsia, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

        else if close < tok_lo and (tok_lo - close) >= rngV * c2MinBreakStr and (not orbBiasFilter or _orbBiasShort)
            entryP = tok_lo - rngV * _c2Depth
            slP    = tok_lo + f_c2SL(rngV)
            tp1    = tok_lo - rngV * orbTPMult
            tp2    = tok_lo - rngV * orbTPMult * 2.0
            tp3    = tok_lo - rngV * orbTPMult * 3.0
            tok_done := true
            c2LimVS = c2EntryMode == "Retest (limit)" ? entryP : na
            strategy.entry("TOK-S", strategy.short, limit=c2LimVS, comment="tokyo-orb · C2 SHORT")
            if exitMode == "Ratchet (no TP)"
                _rt_lvl   := tok_lo
                _rt_entry := entryP
                _rt_rng   := rngV
                _rt_dir   := -1
                _rt_id    := "TOK-S"
                _rt_sl    := slP
                _rt_reach := 0.0
            f_c2Exit("TOK-S", slP, tp1, tp2, tp3, rngV)
            label.new(bar_index, high, "V↓", style=label.style_label_down,
                      color=color.new(color.fuchsia, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL I — Previous Day High/Low Sweep  (pdh-sweep / pdl-sweep)
// Gold sweeps PDH or PDL to grab resting liquidity, then reverses hard.
// Documented by Linda Raschke (Turtle Soup), Larry Williams, ICT.
// Fires at most once per level per day, during kill zones only.
// ═══════════════════════════════════════════════════════════════════════
var bool pdh_done = false
var bool pdl_done = false

if _newDay
    pdh_done := false
    pdl_done := false

if modPDHL and barstate.isconfirmed and _testWinOk and in_kz and not na(_pdh) and not na(_pdl) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    buf = atrVal * 0.15

    // Swept above PDH, closed back below → SHORT
    if not pdh_done and high > _pdh and close < _pdh and (high - _pdh) >= atrVal * 0.10
        entryP = close
        slP    = high + buf
        slDist = slP - entryP
        if slDist > 0
            tp1 = entryP - slDist
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            pdh_done := true
            strategy.entry("PDH-S", strategy.short, comment="pdh-sweep · SHORT")
            strategy.exit("PDH-S-X", from_entry="PDH-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "PDH ↓", style=label.style_label_down,
                      color=color.new(color.maroon, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

    // Swept below PDL, closed back above → LONG
    if not pdl_done and low < _pdl and close > _pdl and (_pdl - low) >= atrVal * 0.10 and strategy.position_size == 0
        entryP = close
        slP    = low - buf
        slDist = entryP - slP
        if slDist > 0
            tp1 = entryP + slDist
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            pdl_done := true
            strategy.entry("PDL-L", strategy.long, comment="pdl-sweep · LONG")
            strategy.exit("PDL-L-X", from_entry="PDL-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "PDL ↑", style=label.style_label_up,
                      color=color.new(color.teal, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL J — VWAP Extension Fade  (vwap-fade)
// When gold extends > 1.5×ATR from session VWAP and prints a reversal bar
// (bearish above / bullish below), it tends to snap back.  Used by
// professional intraday gold traders as a mean-reversion scalp.
// No daily limit — re-fires after stop-outs while extension persists.
// ═══════════════════════════════════════════════════════════════════════
if modVWAP and barstate.isconfirmed and _testWinOk and in_kz and not na(vwapVal) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    vwapDist = close - vwapVal
    bearExt  = vwapDist >  atrVal * 1.5 and close < open
    bullExt  = vwapDist < -atrVal * 1.5 and close > open

    if bearExt
        entryP = close
        slP    = high + atrVal * 0.15
        slDist = slP - entryP
        if slDist > 0
            tp1 = entryP - slDist
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            strategy.entry("VWAP-S", strategy.short, comment="vwap-fade · SHORT")
            strategy.exit("VWAP-S-X", from_entry="VWAP-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

    else if bullExt
        entryP = close
        slP    = low - atrVal * 0.15
        slDist = entryP - slP
        if slDist > 0
            tp1 = entryP + slDist
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            strategy.entry("VWAP-L", strategy.long, comment="vwap-fade · LONG")
            strategy.exit("VWAP-L-X", from_entry="VWAP-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL K — Previous Week High/Low Sweep  (pwh-sweep / pwl-sweep)
// Same turtle-soup concept as Signal I but at the weekly timeframe.
// Weekly extremes hold 5× more resting liquidity than daily levels —
// the reversal after a sweep is typically stronger and higher-probability.
// Fires at most once per level per week, during kill zones only.
// ═══════════════════════════════════════════════════════════════════════
var bool pwh_done = false
var bool pwl_done = false

if _newWeek
    pwh_done := false
    pwl_done := false

if modPWHL and barstate.isconfirmed and _testWinOk and in_kz and not na(_pwh) and not na(_pwl) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    buf = atrVal * 0.20

    if not pwh_done and high > _pwh and close < _pwh and (high - _pwh) >= atrVal * 0.15
        entryP = close
        slP    = high + buf
        slDist = slP - entryP
        if slDist > 0
            tp1 = entryP - slDist
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            pwh_done := true
            strategy.entry("PWH-S", strategy.short, comment="pwh-sweep · SHORT")
            strategy.exit("PWH-S-X", from_entry="PWH-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "PWH ↓", style=label.style_label_down,
                      color=color.new(color.purple, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

    if not pwl_done and low < _pwl and close > _pwl and (_pwl - low) >= atrVal * 0.15 and strategy.position_size == 0
        entryP = close
        slP    = low - buf
        slDist = entryP - slP
        if slDist > 0
            tp1 = entryP + slDist
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            pwl_done := true
            strategy.entry("PWL-L", strategy.long, comment="pwl-sweep · LONG")
            strategy.exit("PWL-L-X", from_entry="PWL-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "PWL ↑", style=label.style_label_up,
                      color=color.new(color.purple, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL L — Midnight Open (00:00 UTC) Bounce
// ICT's primary gold reference level: the 00:00 UTC daily open price.
// During London session, price retesting this level and showing a
// confirmed reversal bar is a high-conviction institutional entry.
// Fires at most once per direction per day, London session only.
// ═══════════════════════════════════════════════════════════════════════
var bool midnight_long_done  = false
var bool midnight_short_done = false

if _newDay
    midnight_long_done  := false
    midnight_short_done := false

if modMidnight and barstate.isconfirmed and _testWinOk and in_london and not na(_midnightOpen) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    tol = atrVal * 0.25

    bounceLong  = low <= _midnightOpen + tol and low <= _midnightOpen and close > _midnightOpen and close > open
    bounceShort = high >= _midnightOpen - tol and high >= _midnightOpen and close < _midnightOpen and close < open

    if not midnight_long_done and bounceLong and not bounceShort
        wick   = low
        entryP = close
        buf    = atrVal * 0.15
        slP    = wick - buf
        slDist = entryP - slP
        if slDist > 0 and slP < entryP
            tp1 = entryP + slDist
            tp2 = entryP + slDist * 2.0
            tp3 = entryP + slDist * 3.0
            midnight_long_done := true
            strategy.entry("MID-L", strategy.long, comment="midnight-open · LONG")
            strategy.exit("MID-L-X", from_entry="MID-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

    if not midnight_short_done and bounceShort and not bounceLong
        wick   = high
        entryP = close
        buf    = atrVal * 0.15
        slP    = wick + buf
        slDist = slP - entryP
        if slDist > 0 and slP > entryP
            tp1 = entryP - slDist
            tp2 = entryP - slDist * 2.0
            tp3 = entryP - slDist * 3.0
            midnight_short_done := true
            strategy.entry("MID-S", strategy.short, comment="midnight-open · SHORT")
            strategy.exit("MID-S-X", from_entry="MID-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL P — Asian SFP (Swing Failure Pattern on Asian Range)
// Asian session (00:00-07:00 UTC) builds a range. At the Frankfurt/London
// open (07:00-09:00 UTC), institutions sweep one boundary to grab resting
// liquidity then reverse hard. Price pierces the Asian high or low but
// closes back inside — classic SFP. Enter at bar close in the reversal
// direction, target the opposite Asian boundary.
// Research source: 70%+ of trading days London sweeps one Asian extreme.
// ═══════════════════════════════════════════════════════════════════════
in_asfp_win = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 540)
var bool asfp_hi_done = false
var bool asfp_lo_done = false

if _newDay
    asfp_hi_done := false
    asfp_lo_done := false

if modASFP and barstate.isconfirmed and _testWinOk and in_asfp_win and ar_locked and not na(ar_hi) and not na(ar_lo) and not na(atrVal) and atrVal > 0 and strategy.position_size == 0
    asfpBuf = atrVal * 0.20
    // SHORT: swept above Asian high, closed back inside → reverse down
    if not asfp_hi_done and high > ar_hi and close < ar_hi and (high - ar_hi) < atrVal * 1.5
        entryP  = close
        slP     = high + asfpBuf
        slDist  = slP - entryP
        tgtDist = math.max(entryP - ar_lo, slDist)   // at least 1R, ideally opposite boundary
        if slDist > 0 and entryP > ar_lo
            tp1 = entryP - tgtDist
            tp2 = entryP - tgtDist * 1.5
            tp3 = entryP - tgtDist * 2.0
            asfp_hi_done := true
            strategy.entry("ASFP-S", strategy.short, comment="asian-sfp · SHORT")
            strategy.exit("ASFP-S-X", from_entry="ASFP-S", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, high, "P↓", style=label.style_label_down,
                      color=color.new(color.red, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)
    // LONG: swept below Asian low, closed back inside → reverse up
    if not asfp_lo_done and low < ar_lo and close > ar_lo and (ar_lo - low) < atrVal * 1.5 and strategy.position_size == 0
        entryP  = close
        slP     = low - asfpBuf
        slDist  = entryP - slP
        tgtDist = math.max(ar_hi - entryP, slDist)   // at least 1R, ideally opposite boundary
        if slDist > 0 and entryP < ar_hi
            tp1 = entryP + tgtDist
            tp2 = entryP + tgtDist * 1.5
            tp3 = entryP + tgtDist * 2.0
            asfp_lo_done := true
            strategy.entry("ASFP-L", strategy.long, comment="asian-sfp · LONG")
            strategy.exit("ASFP-L-X", from_entry="ASFP-L", stop=slP, limit=f_exitLim(tp1, tp2, tp3))
            label.new(bar_index, low, "P↑", style=label.style_label_up,
                      color=color.new(color.teal, 5), textcolor=color.white, size=size.small)
            f_drawPosBox(entryP, slP, tp3)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL Q — Triple-Bull Trend Pullback Long
// ─────────────────────────────────────────────────────────────────────
// Source: 128K-bar global structure analysis — D↑H4↑H1↑ + 4-bar dip ≥0.69 ATR
// Triple alignment (D+H4+H1 all bull) confirmed as the dominant long state
// (62.5% WR, PF 1.252 over 5.5 years, N=44,487). The 4-bar pullback threshold
// filters to dip-buy entries within the running trend.
// SL = 1.0 × ATR below entry.  TP1 = 0.75 × ATR.
// ═══════════════════════════════════════════════════════════════════════
if modQ and barstate.isconfirmed and _testWinOk and atrVal > 0 and h1B == 1 and h4B == 1 and hdB == 1 and _ret4bar < -0.69 and strategy.position_size == 0
    slQ  = close - 1.0  * atrVal
    tp1Q = close + 0.75 * atrVal
    tp2Q = close + 1.5  * atrVal
    tp3Q = close + 2.0  * atrVal
    if tp1Q > close and slQ < close
        strategy.entry("Q-L", strategy.long, comment="Q · pullback · LONG")
        strategy.exit("Q-L-X", from_entry="Q-L", stop=slQ, limit=f_exitLim(tp1Q, tp2Q, tp3Q))
        label.new(bar_index, low, "Q↑", style=label.style_label_up,
                  color=color.new(color.teal, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slQ, tp3Q)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL R — Triple-Bear Rally Fade Short
// ─────────────────────────────────────────────────────────────────────
// Source: 128K-bar global structure analysis — D↓H4↓H1↓ + 4-bar bounce ≥0.38 ATR
// Triple bear (D+H4+H1 all bearish) = 62.3% short WR, PF 1.239, N=30,066 bars.
// The 4-bar bounce filter times entry to fading counter-trend pops.
// Upgraded from H1-only to triple alignment to remove low-confidence states.
// SL = 1.0 × ATR above entry.  TP1 = 0.75 × ATR below.
// ═══════════════════════════════════════════════════════════════════════
_inRWin = _minOfDay > 37 and _minOfDay < 607   // 00:37 – 10:07 UTC

if modR and barstate.isconfirmed and _testWinOk and atrVal > 0 and h1B == -1 and h4B == -1 and hdB == -1 and _ret4bar > 0.38 and _inRWin and strategy.position_size == 0
    slR  = close + 1.0  * atrVal
    tp1R = close - 0.75 * atrVal
    tp2R = close - 1.5  * atrVal
    tp3R = close - 2.0  * atrVal
    if tp1R < close and slR > close
        strategy.entry("R-S", strategy.short, comment="R · bear-rally · SHORT")
        strategy.exit("R-S-X", from_entry="R-S", stop=slR, limit=f_exitLim(tp1R, tp2R, tp3R))
        label.new(bar_index, high, "R↓", style=label.style_label_down,
                  color=color.new(color.red, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slR, tp3R)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL S — Pre-NY Triple-Alignment
// ─────────────────────────────────────────────────────────────────────
// Source: 128K-bar global structure analysis — #1 ranked single combination
// SHORT: D↓ H4↓ H1↓ + Pre-NY (13:00-14:30 UTC) → 67% WR, PF 1.52 ★★★
// LONG:  D↑ H4↑ H1↑ + Pre-NY (13:00-14:30 UTC) → untested inverse
// Five and a half years of data, consistent across every year 2020-2025.
// Fires on the first qualifying bar (close < open for short, close > open for long) once per day.
// SL = 1.0 × ATR from entry.  TP1 = 0.75 × ATR.
// ═══════════════════════════════════════════════════════════════════════
_inPreNYS = timeframe.isintraday and (_minOfDay >= 780 and _minOfDay < 870)   // 13:00 – 14:30 UTC
var bool s_short_done = false
var bool s_long_done  = false
if _newDay
    s_short_done := false
    s_long_done  := false

if modS and barstate.isconfirmed and _testWinOk and atrVal > 0 and not s_short_done and _inPreNYS and sDirFilter != "Long only" and h1B == -1 and h4B == -1 and hdB == -1 and close < open and strategy.position_size == 0
    slS  = close + 1.0  * atrVal
    tp1S = close - 0.75 * atrVal
    tp2S = close - 1.5  * atrVal
    tp3S = close - 2.0  * atrVal
    if tp1S < close and slS > close
        s_short_done := true
        strategy.entry("S-S", strategy.short, comment="S · pre-ny-bear · SHORT")
        strategy.exit("S-S-X", from_entry="S-S", stop=slS, limit=f_exitLim(tp1S, tp2S, tp3S))
        label.new(bar_index, high, "S↓", style=label.style_label_down,
                  color=color.new(color.purple, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slS, tp3S)

if modS and barstate.isconfirmed and _testWinOk and atrVal > 0 and not s_long_done and _inPreNYS and sDirFilter != "Short only" and h1B == 1 and h4B == 1 and hdB == 1 and close > open and strategy.position_size == 0
    slS  = close - 1.0  * atrVal
    tp1S = close + 0.75 * atrVal
    tp2S = close + 1.5  * atrVal
    tp3S = close + 2.0  * atrVal
    if tp1S > close and slS < close
        s_long_done := true
        strategy.entry("S-L", strategy.long, comment="S · pre-ny-bull · LONG")
        strategy.exit("S-L-X", from_entry="S-L", stop=slS, limit=f_exitLim(tp1S, tp2S, tp3S))
        label.new(bar_index, low, "S↑", style=label.style_label_up,
                  color=color.new(color.purple, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slS, tp3S)

// ═══════════════════════════════════════════════════════════════════════
// SIGNAL T — Frankfurt Triple-Alignment
// ─────────────────────────────────────────────────────────────────────
// Source: 128K-bar global structure analysis — #2 ranked single combination
// LONG:  D↑ H4↑ H1↑ + Frankfurt/London (07:00-09:00 UTC) → 64% WR, PF 1.33 ★★
// SHORT: D↓ H4↓ H1↓ + Frankfurt/London (07:00-09:00 UTC) → untested inverse
// European banks open their gold programs into this window. Triple alignment
// confirms structural momentum. Fires on the first qualifying bar once per day.
// SL = 1.0 × ATR from entry.  TP1 = 0.75 × ATR.
// ═══════════════════════════════════════════════════════════════════════
_inFrankT = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 540)   // 07:00 – 09:00 UTC
var bool t_long_done  = false
var bool t_short_done = false
if _newDay
    t_long_done  := false
    t_short_done := false

if modT and barstate.isconfirmed and _testWinOk and atrVal > 0 and not t_long_done and _inFrankT and tDirFilter != "Short only" and h1B == 1 and h4B == 1 and hdB == 1 and close > open and strategy.position_size == 0
    slT  = close - 1.0  * atrVal
    tp1T = close + 0.75 * atrVal
    tp2T = close + 1.5  * atrVal
    tp3T = close + 2.0  * atrVal
    if tp1T > close and slT < close
        t_long_done := true
        strategy.entry("T-L", strategy.long, comment="T · frank-bull · LONG")
        strategy.exit("T-L-X", from_entry="T-L", stop=slT, limit=f_exitLim(tp1T, tp2T, tp3T))
        label.new(bar_index, low, "T↑", style=label.style_label_up,
                  color=color.new(color.lime, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slT, tp3T)

if modT and barstate.isconfirmed and _testWinOk and atrVal > 0 and not t_short_done and _inFrankT and tDirFilter != "Long only" and h1B == -1 and h4B == -1 and hdB == -1 and close < open and strategy.position_size == 0
    slT  = close + 1.0  * atrVal
    tp1T = close - 0.75 * atrVal
    tp2T = close - 1.5  * atrVal
    tp3T = close - 2.0  * atrVal
    if tp1T < close and slT > close
        t_short_done := true
        strategy.entry("T-S", strategy.short, comment="T · frank-bear · SHORT")
        strategy.exit("T-S-X", from_entry="T-S", stop=slT, limit=f_exitLim(tp1T, tp2T, tp3T))
        label.new(bar_index, high, "T↓", style=label.style_label_down,
                  color=color.new(color.lime, 5), textcolor=color.white, size=size.small)
        f_drawPosBox(close, slT, tp3T)

// ═══════════════════════════════════════════════════════════════════════
// A+ CONTEXT CAPTURE — recorded at SIGNAL time, not fill time
// ─────────────────────────────────────────────────────────────────────
// WHY THIS CHANGED. The previous version captured on the bar a position
// OPENED, which is blind to any trade that opens and closes inside one bar.
// That lost 24 of 96 trades, and NOT at random: every one of them had MAE
// <= 20. The context analysis was running on the harder three quarters of
// the list, biasing every percentage in it downward.
//
// Capturing on the SIGNAL bar fixes the coverage (a signal always precedes
// or equals its fill) AND unlocks the feature the break-and-retest research
// points at hardest: RETEST LATENCY, the gap in bars between the break and
// the limit filling. The literature is consistent that a fast, shallow
// pullback holding the level is healthy continuation, while a slow drift
// back into the range is a breakout that already died. Latency is that idea
// as a number, and it is known by the time the trade fills.
//
// Two more features that cost nothing to record:
//   BREAK STRENGTH — how far beyond the level the signal bar closed, in
//     range units. A marginal break is a weak break.
//   DAILY AGREEMENT — the H/M gate requires H1+H4 to align but says nothing
//     about the Daily, so hdB varies trade to trade and has never been tested.
//
// NOT captured: relative volume. The 2026 ORB study found volume does not
// predict follow-through in either direction, so the "high volume = conviction"
// heuristic is not worth a column here.
//
// Detection rides the rising edge of each signal's own `done` flag, so the
// eight entry blocks need no edits and cannot drift out of sync with this.
var array<int>   _ctxBar = array.new<int>(0)   // signal bar index
var array<float> _ctxRng = array.new<float>(0) // ORB range, points
var array<float> _ctxStr = array.new<float>(0) // break strength, in range units
var array<float> _ctxAdr = array.new<float>(0) // ADR consumed at signal
var array<int>   _ctxAgr = array.new<int>(0)   // 1 = Daily bias agrees with the break
var array<int>   _ctxSig = array.new<int>(0)   // 0=FRB 1=NYORB 2=SYD 3=TOK
var array<int>   _ctxPool= array.new<int>(0)   // 1 = prior-session pool swept on the break's far side
var array<int>   _ctxM15 = array.new<int>(0)   // 1 = 15m bias agrees with the break
var array<float> _ctxAtr = array.new<float>(0) // entry-TF ATR at signal — the third stop normalizer

// ─── STRUCTURAL ANCHOR DISTANCES (points from ENTRY, added 2026-09-22) ──
// All four measure entry -> the level where the thesis is falsified, on the
// LOSING side of the trade. na = that anchor did not exist for this signal, or
// sat on the wrong side of entry (which is itself a finding: an anchor that is
// routinely unusable is dead regardless of how well it performs when present).
//
// Recorded at SIGNAL time from data known at signal time. _prev_sl/_prev_sh use
// ta.pivotlow/high(3,3), so they were confirmed three bars ago — stale, but not
// lookahead.
var array<float> _ancOrb   = array.new<float>(0) // opposite ORB extreme  (the dead orbSLMode "Wide SL")
var array<float> _ancSwing = array.new<float>(0) // last confirmed pivot against the trade
var array<float> _ancSess  = array.new<float>(0) // session extreme so far = the sweep wick
var array<float> _ancPrior = array.new<float>(0) // prior session's extreme (Asian for M/G, London for H, NY for U)

// Anchor distance, entry -> falsification level, in points. PURE: it reads and
// returns, assigns no global, so it is safe as a function (unlike the array
// pushes below, which must stay inline).
//
// Returns na when the anchor is missing OR sits on the wrong side of entry. A
// wrong-side anchor is not a small stop, it is a NONSENSE stop — the thesis
// would already be falsified at entry — so it must be excluded, not clamped.
// How often that happens is itself a result.
f_ancDist(int dir, float entryPx, float anchorPx) =>
    float d = na(anchorPx) ? na : dir * (entryPx - anchorPx)
    na(d) or d <= 0 ? na : d

// Inlined per signal rather than wrapped in a helper: Pine functions may not
// assign to globals, and mutating a global array from inside one is a rule I
// would rather not lean on in code that decides real stops.
if frb_done and not frb_done[1] and not na(frb_hi) and not na(frb_lo) and frb_hi > frb_lo
    dirF = close > frb_hi ? 1 : -1
    lvlF = dirF == 1 ? frb_hi : frb_lo
    rngF = frb_hi - frb_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngF)
    array.push(_ctxStr, math.abs(close - lvlF) / rngF)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirF ? 1 : 0)
    array.push(_ctxSig, 0)
    array.push(_ctxPool, (dirF == 1 ? frb_pool_lo : frb_pool_hi) ? 1 : 0)
    array.push(_ctxM15, m15B == dirF ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    entF = lvlF + dirF * rngF * _c2Depth
    array.push(_ancOrb,   f_ancDist(dirF, entF, dirF == 1 ? frb_lo : frb_hi))
    array.push(_ancSwing, f_ancDist(dirF, entF, dirF == 1 ? _prev_sl : _prev_sh))
    array.push(_ancSess,  f_ancDist(dirF, entF, dirF == 1 ? frb_ext_lo : frb_ext_hi))
    array.push(_ancPrior, f_ancDist(dirF, entF, dirF == 1 ? ar_lo_prefrb : ar_hi_prefrb))

if nyorb_done and not nyorb_done[1] and not na(nyorb_hi) and not na(nyorb_lo) and nyorb_hi > nyorb_lo
    dirN = close > nyorb_hi ? 1 : -1
    lvlN = dirN == 1 ? nyorb_hi : nyorb_lo
    rngN = nyorb_hi - nyorb_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngN)
    array.push(_ctxStr, math.abs(close - lvlN) / rngN)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirN ? 1 : 0)
    array.push(_ctxSig, 1)
    array.push(_ctxPool, (dirN == 1 ? nyo_pool_lo : nyo_pool_hi) ? 1 : 0)
    array.push(_ctxM15, m15B == dirN ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    entN = lvlN + dirN * rngN * _c2Depth
    array.push(_ancOrb,   f_ancDist(dirN, entN, dirN == 1 ? nyorb_lo : nyorb_hi))
    array.push(_ancSwing, f_ancDist(dirN, entN, dirN == 1 ? _prev_sl : _prev_sh))
    array.push(_ancSess,  f_ancDist(dirN, entN, dirN == 1 ? nyo_ext_lo : nyo_ext_hi))
    array.push(_ancPrior, f_ancDist(dirN, entN, dirN == 1 ? lon_lo_preny : lon_hi_preny))

if syd_done and not syd_done[1] and not na(syd_hi) and not na(syd_lo) and syd_hi > syd_lo
    dirS = close > syd_hi ? 1 : -1
    lvlS = dirS == 1 ? syd_hi : syd_lo
    rngS = syd_hi - syd_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngS)
    array.push(_ctxStr, math.abs(close - lvlS) / rngS)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirS ? 1 : 0)
    array.push(_ctxSig, 2)
    array.push(_ctxPool, (dirS == 1 ? syd_pool_lo : syd_pool_hi) ? 1 : 0)
    array.push(_ctxM15, m15B == dirS ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    entS = lvlS + dirS * rngS * _c2Depth
    array.push(_ancOrb,   f_ancDist(dirS, entS, dirS == 1 ? syd_lo : syd_hi))
    array.push(_ancSwing, f_ancDist(dirS, entS, dirS == 1 ? _prev_sl : _prev_sh))
    array.push(_ancSess,  f_ancDist(dirS, entS, dirS == 1 ? syd_ext_lo : syd_ext_hi))
    array.push(_ancPrior, f_ancDist(dirS, entS, dirS == 1 ? ny_lo_presyd : ny_hi_presyd))

if tok_done and not tok_done[1] and not na(tok_hi) and not na(tok_lo) and tok_hi > tok_lo
    dirT = close > tok_hi ? 1 : -1
    lvlT = dirT == 1 ? tok_hi : tok_lo
    rngT = tok_hi - tok_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngT)
    array.push(_ctxStr, math.abs(close - lvlT) / rngT)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirT ? 1 : 0)
    array.push(_ctxSig, 3)
    array.push(_ctxPool, (dirT == 1 ? tok_pool_lo : tok_pool_hi) ? 1 : 0)
    array.push(_ctxM15, m15B == dirT ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    entT = lvlT + dirT * rngT * _c2Depth
    array.push(_ancOrb,   f_ancDist(dirT, entT, dirT == 1 ? tok_lo : tok_hi))
    array.push(_ancSwing, f_ancDist(dirT, entT, dirT == 1 ? _prev_sl : _prev_sh))
    array.push(_ancSess,  f_ancDist(dirT, entT, dirT == 1 ? tok_lo : tok_hi))
    array.push(_ancPrior, f_ancDist(dirT, entT, dirT == 1 ? syd_lo_pretok : syd_hi_pretok))

// SIGNAL G — was missing entirely. Without this block every London ORB trade is
// invisible to the A+ table: ctxSig has no code for it, so the matcher below
// finds nothing and G is silently dropped from every split. Since G is now the
// biggest contributor to the baseline, that gap would have hidden exactly the
// signal this study most needs to see.
if lorb_done and not lorb_done[1] and not na(lorb_hi) and not na(lorb_lo) and lorb_hi > lorb_lo
    dirG = close > lorb_hi ? 1 : -1
    lvlG = dirG == 1 ? lorb_hi : lorb_lo
    rngG = lorb_hi - lorb_lo
    array.push(_ctxBar, bar_index)
    array.push(_ctxRng, rngG)
    array.push(_ctxStr, math.abs(close - lvlG) / rngG)
    array.push(_ctxAdr, _adrConsumed)
    array.push(_ctxAgr, hdB == dirG ? 1 : 0)
    array.push(_ctxSig, 4)
    // G has no pool tracking of its own — the liquidity-grab filter was never
    // extended to it. Recorded as 0 rather than left out, so the array lengths
    // stay locked together; read the POOL rows as M/H/U only.
    array.push(_ctxPool, 0)
    array.push(_ctxM15, m15B == dirG ? 1 : 0)
    array.push(_ctxAtr, atrVal)
    entG = lvlG + dirG * rngG * _c2Depth
    array.push(_ancOrb,   f_ancDist(dirG, entG, dirG == 1 ? lorb_lo : lorb_hi))
    array.push(_ancSwing, f_ancDist(dirG, entG, dirG == 1 ? _prev_sl : _prev_sh))
    array.push(_ancSess,  f_ancDist(dirG, entG, dirG == 1 ? lorb_ext_lo : lorb_ext_hi))
    // G's prior pool is the Asian session, same as M — London opens an hour later
    // but the Asian range is still the liquidity sitting under it.
    array.push(_ancPrior, f_ancDist(dirG, entG, dirG == 1 ? ar_lo_prefrb : ar_hi_prefrb))

// ═══════════════════════════════════════════════════════════════════════
// SL RESEARCH — MAE-driven stop sweep  (answers "how small can c2SLBuf go?")
// ─────────────────────────────────────────────────────────────────────
// The 150-pt stop is ~6-19x the ORB range, so a win banks ~0.06R while a loss
// costs 1R. Live sizing is risk-based, so a smaller stop buys a bigger position
// for the same dollars: halve the stop and each ~12-pt win pays roughly double.
// The only thing stopping you is how many winners a tighter stop would kill.
//
// This table answers that directly from MAXIMUM ADVERSE EXCURSION — how far
// each trade went against you before it resolved. For each candidate stop S:
//   - a winner whose MAE <= S still wins, and banks its actual points
//   - a winner whose MAE >  S is CONVERTED to a loss of S
//   - a trade that already lost simply loses S instead of the old stop
// Net R = net points / S, which is the unit that matters under risk-based
// sizing (TradingView's dollar P&L is NOT comparable across stop widths).
//
// READ IT AS: the smallest S where "Net R" is still climbing is your floor.
// Below that, converted winners eat the gain from the larger R multiple.
//
// IMPORTANT — S is measured from the ENTRY, while c2SLBuf is measured from the
// ORB LEVEL, and the entry sits c2RetestDepth x range past the level. So set
//     c2SLBuf  =  S  -  (c2RetestDepth x ORB range)      [~0.25 x range]
// Then re-run with that c2SLBuf to confirm the real number.
//
// CAVEAT: this re-prices the SAME trade list. It cannot show trades a tighter
// stop would have let you re-enter, and it assumes a converted winner stops at
// exactly S. Treat it as the shortlist, not the final answer — confirm the
// winner by actually setting c2SLBuf and re-running.
// ═══════════════════════════════════════════════════════════════════════
G_SLR   = "SL research"
showSLR = input.bool(true, "Show MAE stop-sweep table", group=G_SLR,
          tooltip="Re-prices every closed trade in this run against a range of candidate stop sizes, using each trade's own maximum adverse excursion. Turn off once you have settled on a stop.")

// Thresholds concentrated in the WR-PRESERVING zone. The first sweep ran
// 10-40 pts, which trades win rate for R — rejected. What matters is the band
// just above the worst winner's excursion, where nothing is killed at all.
var array<float> _slrTh = array.from(50.0, 60.0, 70.0, 80.0, 90.0, 100.0, 110.0, 120.0, 130.0, 150.0)
var table slrTbl = na

// The table is built whenever showSLR is on, even with zero usable trades, and
// the bottom row always reports trade count + point value. A table that renders
// nothing at all is indistinguishable from a script that failed to load, which
// is exactly the debugging hole this avoids.
// Hoisted into a function 2026-09-22: TradingView rejected the script
// with "main body of the script is too long". Pine compiles function
// bodies separately from the main body, so moving the render here buys
// back the headroom. The table object is PASSED IN because a Pine
// function may not assign to a global - creation stays at the call site.
f_drawSlrTable(table t) =>
    // syminfo.pointvalue is na or 0 on some feeds. Previously that emptied the
    // array and the whole table silently disappeared; fall back to 1.0 instead,
    // which is correct for XAUUSD (1 contract x 1.00 price move = 1 currency).
    pv = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

    // Pass 1 — pull each closed trade's MAE and P&L into POINTS per contract.
    // max_drawdown() and profit() are both in currency, so divide by the trade's
    // own size: percent_of_equity means size differs from trade to trade.
    mae  = array.new<float>(0)
    pnl  = array.new<float>(0)
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            sz = math.abs(strategy.closedtrades.size(i))
            if sz > 0
                unit = sz * pv
                array.push(mae, strategy.closedtrades.max_drawdown(i) / unit)
                array.push(pnl, strategy.closedtrades.profit(i) / unit)

    table.cell(t, 0, 15, "closed trades: " + str.tostring(strategy.closedtrades) + "  ·  usable: " + str.tostring(array.size(mae)) + "  ·  pointvalue: " + str.tostring(pv, "#.####"),
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)

    // ─── WINNER-ONLY MAE — the WR-preserving answer ──────────────────
    // A stop only costs win rate when it sits INSIDE a winner's adverse
    // excursion. So the smallest stop that changes the win rate by exactly
    // nothing is (worst winner's MAE + a tick of margin). Everything above
    // that line is free: same trades, same wins, smaller R denominator.
    // p99/p95/p90 are there for the next decision — how much WR you would
    // trade away to shrink the stop further, priced one winner at a time.
    if array.size(mae) > 0
        wmae = array.new<float>(0)
        for j = 0 to array.size(mae) - 1
            if array.get(pnl, j) > 0
                array.push(wmae, array.get(mae, j))
        if array.size(wmae) > 0
            // percentile_linear_interpolation REQUIRES the array to be sorted
            // first. Passing an unsorted array returns a meaningless number
            // with no error and no warning — sort before reading percentiles.
            array.sort(wmae, order.ascending)
            wMax  = array.max(wmae)
            w99   = array.percentile_linear_interpolation(wmae, 99)
            w95   = array.percentile_linear_interpolation(wmae, 95)
            w90   = array.percentile_linear_interpolation(wmae, 90)
            zeroS = math.ceil(wMax) + 2
            wCol  = color.new(color.aqua, 0)
            table.cell(t, 0, 12, "WINNER MAE (n=" + str.tostring(array.size(wmae)) + ")", text_color=wCol, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 12, "max " + str.tostring(wMax, "#.#"), text_color=color.new(color.white, 15), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, 12, "p99 " + str.tostring(w99,  "#.#"), text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, 12, "p95 " + str.tostring(w95,  "#.#"), text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, 12, "p90 " + str.tostring(w90,  "#.#"), text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)

            table.cell(t, 0, 13, "ZERO-WR-COST STOP", text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 13, str.tostring(zeroS, "#") + " pts", text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, 13, "WR unchanged", text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, 13, "c2SLBuf ~", text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, 13, str.tostring(zeroS - 6, "#"), text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_right)

            // Cost of going tighter, priced in winners lost rather than percent.
            table.cell(t, 0, 14, "tighter costs:", text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 14, "p99 loses ~1 win", text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, 14, "p95 ~5%", text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, 14, "p90 ~10%", text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, 14, "of wins", text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)

    if array.size(mae) > 0
        hCol = color.new(#D4A017, 0)
        table.cell(t, 0, 0, "Stop (from entry)", text_color=hCol, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, 0, "Wins killed",       text_color=hCol, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, 0, "WR %",              text_color=hCol, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, 0, "Net pts",           text_color=hCol, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, 0, "Net R",             text_color=hCol, text_size=size.tiny, text_halign=text.align_right)

        // Pass 2 — re-price the whole trade list against each candidate stop.
        bestR   = -1e12
        bestS   = 0.0
        for ti = 0 to array.size(_slrTh) - 1
            S       = array.get(_slrTh, ti)
            netPts  = 0.0
            wins    = 0
            losses  = 0
            killed  = 0
            for j = 0 to array.size(mae) - 1
                m = array.get(mae, j)
                p = array.get(pnl, j)
                if p > 0
                    if m > S
                        killed := killed + 1
                        losses := losses + 1
                        netPts := netPts - S
                    else
                        wins   := wins + 1
                        netPts := netPts + p
                else
                    losses := losses + 1
                    netPts := netPts - S
            tot  = wins + losses
            wr   = tot > 0 ? wins * 100.0 / tot : 0.0
            netR = S > 0 ? netPts / S : 0.0
            if netR > bestR
                bestR := netR
                bestS := S
            rCol = netR > 0 ? color.lime : color.red
            table.cell(t, 0, ti + 1, str.tostring(S, "#") + " pts",      text_color=color.new(color.white, 15), text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, ti + 1, str.tostring(killed),                text_color=color.new(killed > 0 ? color.orange : color.gray, 0), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, ti + 1, str.tostring(wr, "#.##"),            text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, ti + 1, str.tostring(netPts, "#"),           text_color=color.new(color.white, 25), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, ti + 1, str.tostring(netR, "#.#"),           text_color=color.new(rCol, 0),         text_size=size.tiny, text_halign=text.align_right)

        table.cell(t, 0, 11, "BEST: " + str.tostring(bestS, "#") + " pts", text_color=color.new(color.aqua, 0), text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, 11, "n=" + str.tostring(array.size(mae)),         text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, 11, "",                                            text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, 11, "max R",                                       text_color=color.new(color.gray, 10), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, 11, str.tostring(bestR, "#.#"),                    text_color=color.new(color.aqua, 0),  text_size=size.tiny, text_halign=text.align_right)

// ═══════════════════════════════════════════════════════════════════════

if barstate.islast and showSLR
    if na(slrTbl)
        slrTbl := table.new(position.middle_right, 5, 16,
                   bgcolor=color.new(color.black, 60),
                   border_color=color.new(color.gray, 60), border_width=1,
                   frame_color=color.new(color.gray, 60), frame_width=1)

    f_drawSlrTable(slrTbl)

// A+ SETUP ANALYSIS — which trades never need a wide stop
// ─────────────────────────────────────────────────────────────────────
// The stop sweep answers "one stop for everything". This answers a better
// question: WHICH setups never go far against you, so those can be sized up
// on a tight stop while the rest keep the wide one.
//
// Three views of the same closed-trade list:
//   1. MAE BUCKETS — how far each trade went against you before resolving.
//      "straight to TP" = never went more than 1 pt offside. The cumulative
//      column is the headline: what share of trades never exceeded 20 pts.
//   2. BY SIGNAL — the same split per signal and direction. If one signal
//      supplies most of the low-MAE trades, that is the A+ candidate.
//   3. BY WEEKDAY — same split per day.
//
// avg MFE is how far each bucket ran in your favour. A bucket with low MAE
// and high MFE is the ideal: little heat, large reach.
//
// WHAT THIS CANNOT SEE YET: ORB range and ADR at entry, which are the two
// most likely real discriminators. They live in bar context at signal time,
// not in the trade record, so they need separate capture. If the tables below
// show a signal or day that concentrates the low-MAE trades, that is worth
// wiring next — a split that shows nothing means the edge is not categorical.
// ═══════════════════════════════════════════════════════════════════════
showAplus = input.bool(true, "Show A+ setup analysis", group=G_SLR,
            tooltip="Buckets every closed trade by how far it went against you, then splits the same trades by signal and by weekday. Use it to find setups that never need a wide stop.")

var array<string> _apbLbl = array.from("straight to TP (<1)", "1 - 5 pts", "5 - 10 pts", "10 - 20 pts", "20 - 40 pts", "40 - 80 pts", "80 + pts")
var array<string> _apsLbl = array.from("M  FRB-L", "M  FRB-S", "H  NYORB-L", "H  NYORB-S", "U  SYD", "V  TOK", "G  LORB")
var array<string> _apdLbl = array.from("Mon", "Tue", "Wed", "Thu", "Fri")
var array<string> _aprLbl = array.from("< 10 pts", "10 - 15", "15 - 20", "20 - 30", "30 + pts")
// A+ CLASSIFICATION — the 2x2 that decides lot size.
// Ordered so index 3 (both conditions met) is the A+ cell.
var array<string> _apaLbl = array.from("neither", "M15 only", "pool only", "A+ pool + M15")
// The pool marginal — "pool + whatever bias this run is gated on".
var array<string> _appLbl = array.from("NO pool", "POOL + run bias")
// Daily-bias split dropped: measured p ~ 0.36, null and backwards. Cols 12-14
// are better spent deciding what the stop should actually be measured against.
var table apTbl = na

// Hoisted into a function 2026-09-22: TradingView rejected the script
// with "main body of the script is too long". Pine compiles function
// bodies separately from the main body, so moving the render here buys
// back the headroom. The table object is PASSED IN because a Pine
// function may not assign to a global - creation stays at the call site.
f_drawAplusTable(table t) =>
    pv2 = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

    bN   = array.new<int>(7, 0)
    bPts = array.new<float>(7, 0.0)
    bMfe = array.new<float>(7, 0.0)
    sN   = array.new<int>(7, 0)
    sLow = array.new<int>(7, 0)
    sPts = array.new<float>(7, 0.0)
    sMae = array.new<float>(7, 0.0)
    dN   = array.new<int>(5, 0)
    dLow = array.new<int>(5, 0)
    dPts = array.new<float>(5, 0.0)
    dMae = array.new<float>(5, 0.0)
    rN   = array.new<int>(5, 0)
    rLow = array.new<int>(5, 0)
    aN   = array.new<int>(4, 0)
    aWin = array.new<int>(4, 0)
    aLow = array.new<int>(4, 0)
    aPts = array.new<float>(4, 0.0)
    aRng = array.new<float>(4, 0.0)
    // POOL MARGINAL — index 1 = pool swept, 0 = not. This is the combination
    // actually tested live (pool + the baseline H1+H4 bias), which the 2x2
    // above splits across two cells and therefore never names on its own.
    pN   = array.new<int>(2, 0)
    pWin = array.new<int>(2, 0)
    pLow = array.new<int>(2, 0)
    pPts = array.new<float>(2, 0.0)
    pRng = array.new<float>(2, 0.0)
    // WINNER MAE IN RANGE UNITS — the number that sets k for "SL = k x ORB range".
    // A flat 150-pt stop is a different animal on a 9-pt range than on a 30-pt
    // one. Expressed per unit of range, the worst winner's excursion tells you
    // the smallest k that kills no winner at all.
    // Three normalizers measured side by side on the SAME winners:
    //   wmp = MAE in points      (flat stop)
    //   wmr = MAE / ORB range    (SL = k x range)
    //   wma = MAE / ATR          (SL = k x ATR)
    // The right basis for a stop is the one whose distribution is TIGHTEST —
    // lowest max, smallest max-to-p95 spread — because that is the basis on
    // which heat is actually predictable.
    wmp  = array.new<float>(0)
    wmr  = array.new<float>(0)
    wma  = array.new<float>(0)
    // Average ATR over matched trades — without it, "k x ATR" is a multiplier
    // with no way to convert into points, so the three bases cannot be compared
    // on the one axis that decides R: the actual stop distance.
    atrSum = 0.0
    totAll = 0
    lowAll = 0
    matched = 0
    orbTot = 0

    for i = 0 to strategy.closedtrades - 1
        sz = math.abs(strategy.closedtrades.size(i))
        if sz > 0
            unit = sz * pv2
            m = strategy.closedtrades.max_drawdown(i) / unit
            p = strategy.closedtrades.profit(i)       / unit
            f = strategy.closedtrades.max_runup(i)    / unit
            bi = m < 1.0 ? 0 : m < 5.0 ? 1 : m < 10.0 ? 2 : m < 20.0 ? 3 : m < 40.0 ? 4 : m < 80.0 ? 5 : 6
            array.set(bN,   bi, array.get(bN,   bi) + 1)
            array.set(bPts, bi, array.get(bPts, bi) + p)
            array.set(bMfe, bi, array.get(bMfe, bi) + f)
            totAll := totAll + 1
            if m <= 20.0
                lowAll := lowAll + 1

            // entry_id carries the signal AND direction, so no extra plumbing.
            // Exact equality rather than a substring helper: these ids are the
            // literals this script passes to strategy.entry, so == is provably
            // correct and depends on no string function being available.
            // Signals A-T map to -1 and are excluded from the per-signal table
            // (they are still counted in the bucket and weekday sections).
            id = strategy.closedtrades.entry_id(i)
            si = id == "FRB-L" ? 0 : id == "FRB-S" ? 1 : id == "NYORB-L" ? 2 : id == "NYORB-S" ? 3 : (id == "SYD-L" or id == "SYD-S") ? 4 : (id == "TOK-L" or id == "TOK-S") ? 5 : (id == "ORB-L" or id == "ORB-S") ? 6 : -1
            if si >= 0
                array.set(sN,   si, array.get(sN,   si) + 1)
                array.set(sPts, si, array.get(sPts, si) + p)
                array.set(sMae, si, array.get(sMae, si) + m)
                if m <= 20.0
                    array.set(sLow, si, array.get(sLow, si) + 1)

            dw = dayofweek(strategy.closedtrades.entry_time(i), "UTC")
            di = dw == dayofweek.monday ? 0 : dw == dayofweek.tuesday ? 1 : dw == dayofweek.wednesday ? 2 : dw == dayofweek.thursday ? 3 : dw == dayofweek.friday ? 4 : -1
            if di >= 0
                array.set(dN,   di, array.get(dN,   di) + 1)
                array.set(dPts, di, array.get(dPts, di) + p)
                array.set(dMae, di, array.get(dMae, di) + m)
                if m <= 20.0
                    array.set(dLow, di, array.get(dLow, di) + 1)

            // Match to the last signal OF THIS TRADE'S OWN SIGNAL captured at or
            // before its entry bar.
            //
            // BUG FIX: the previous version matched the last capture from ANY
            // signal, so a Signal A/B/C/D trade — which records no context at
            // all — silently inherited whatever ORB fired before it, and every
            // split below was polluted with another setup's context. Scoping the
            // scan to _ctxSig makes non-ORB trades match nothing, which is the
            // correct answer, and makes orbTot the honest denominator.
            sigGrp = si < 0 ? -1 : si <= 1 ? 0 : si <= 3 ? 1 : si == 4 ? 2 : si == 5 ? 3 : 4
            ebi = strategy.closedtrades.entry_bar_index(i)
            k = -1
            if sigGrp >= 0
                orbTot := orbTot + 1
                for q = array.size(_ctxBar) - 1 to 0
                    if array.get(_ctxBar, q) <= ebi and array.get(_ctxSig, q) == sigGrp
                        k := q
                        break
            if k >= 0
                matched := matched + 1
                rawRng = array.get(_ctxRng, k)
                agr    = array.get(_ctxAgr, k)
                pool   = array.get(_ctxPool, k)
                m15a   = array.get(_ctxM15, k)

                ri = rawRng < 10.0 ? 0 : rawRng < 15.0 ? 1 : rawRng < 20.0 ? 2 : rawRng < 30.0 ? 3 : 4
                array.set(rN, ri, array.get(rN, ri) + 1)
                if m <= 20.0
                    array.set(rLow, ri, array.get(rLow, ri) + 1)

                // THE A+ CELL. Note what is NOT in it: H1+H4. In the baseline the
                // bias gate is already H1+H4, so every trade here satisfies it and
                // it discriminates nothing. Within this run the only two free
                // variables are the pool sweep and the 15m agreement.
                ai = (pool == 1 ? 2 : 0) + (m15a == 1 ? 1 : 0)
                array.set(aN, ai, array.get(aN, ai) + 1)
                if p > 0
                    array.set(aWin, ai, array.get(aWin, ai) + 1)
                if m <= 20.0
                    array.set(aLow, ai, array.get(aLow, ai) + 1)
                array.set(aPts, ai, array.get(aPts, ai) + p)
                // Average ORB range per class. THE CONFOUND CHECK: TP1 is
                // 0.75 x range, so "avg pts" is very nearly a readout of range.
                // If A+ simply lands on bigger-range days, its extra points are
                // not an edge from the liquidity sweep at all — they are range,
                // which is known at signal time and needs none of this
                // machinery to exploit.
                array.set(aRng, ai, array.get(aRng, ai) + rawRng)

                // Pool marginal, collapsing the M15 axis.
                pi = pool == 1 ? 1 : 0
                array.set(pN, pi, array.get(pN, pi) + 1)
                if p > 0
                    array.set(pWin, pi, array.get(pWin, pi) + 1)
                if m <= 20.0
                    array.set(pLow, pi, array.get(pLow, pi) + 1)
                array.set(pPts, pi, array.get(pPts, pi) + p)
                array.set(pRng, pi, array.get(pRng, pi) + rawRng)

                // Winners only: a stop only costs win rate where it sits inside
                // a WINNER's excursion. Losers already lost.
                atrRaw = array.get(_ctxAtr, k)
                atrSum := atrSum + atrRaw
                if p > 0
                    array.push(wmp, m)
                    if rawRng > 0
                        array.push(wmr, m / rawRng)
                    if atrRaw > 0
                        array.push(wma, m / atrRaw)

    hC = color.new(#D4A017, 0)
    gC = color.new(color.gray, 10)
    wC = color.new(color.white, 20)

    table.cell(t, 0, 0, "MAE bucket", text_color=hC, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 0, "N",          text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 0, "%",          text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 0, "cum %",      text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 0, "avg pts",    text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 0, "avg MFE",    text_color=hC, text_size=size.tiny, text_halign=text.align_right)

    cum = 0
    for bi = 0 to 6
        n   = array.get(bN, bi)
        cum := cum + n
        pct = totAll > 0 ? n * 100.0 / totAll : 0.0
        cpc = totAll > 0 ? cum * 100.0 / totAll : 0.0
        ap  = n > 0 ? array.get(bPts, bi) / n : 0.0
        af  = n > 0 ? array.get(bMfe, bi) / n : 0.0
        rowC = bi <= 3 ? color.new(color.lime, 0) : color.new(color.orange, 20)
        table.cell(t, 0, bi + 1, array.get(_apbLbl, bi), text_color=rowC, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, bi + 1, str.tostring(n),        text_color=wC,   text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, bi + 1, str.tostring(pct, "#.#"), text_color=wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, bi + 1, str.tostring(cpc, "#.#"), text_color=gC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, bi + 1, str.tostring(ap,  "#.#"), text_color=wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 5, bi + 1, str.tostring(af,  "#.#"), text_color=wC, text_size=size.tiny, text_halign=text.align_right)

    lowPct = totAll > 0 ? lowAll * 100.0 / totAll : 0.0
    table.cell(t, 0, 8, "NEVER EXCEEDED 20 pts", text_color=color.new(color.aqua, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 8, str.tostring(lowAll),    text_color=color.new(color.aqua, 0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 8, str.tostring(lowPct, "#.#") + "%", text_color=color.new(color.aqua, 0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 8, "of " + str.tostring(totAll), text_color=gC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 8, "", text_color=gC, text_size=size.tiny)
    table.cell(t, 5, 8, "", text_color=gC, text_size=size.tiny)

    // Five splits sharing one row band: signal (0-2), ORB range (3-5),
    // retest latency (6-8), break strength (9-11), daily bias (12-14).
    // Weekday is dropped from the table — already measured at p ~ 0.044 and
    // the column space is better spent on features never tested.
    // ADR is dropped outright: p ~ 0.93, as null as a result gets.
    table.cell(t, 0,  9, "By signal",  text_color=hC, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1,  9, "N",          text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2,  9, "<=20 %",     text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3,  9, "ORB rng",    text_color=hC, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 4,  9, "N",          text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5,  9, "<=20 %",     text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 6,  9, "A+ class",   text_color=hC, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 7,  9, "N",          text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 8,  9, "WR %",       text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 9,  9, "<=20 %",     text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 10, 9, "avg pts",    text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 11, 9, "avg rng",    text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 12, 9, "STOP BASIS", text_color=hC, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 13, 9, "max",        text_color=hC, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 14, 9, "p95",        text_color=hC, text_size=size.tiny, text_halign=text.align_right)

    // Coverage, now measured against ORB trades only. Signals A-T record no
    // context and are correctly excluded, so the denominator is orbTot, not
    // totAll. matched < orbTot means an ORB trade filled before its own signal
    // was recorded, which should be impossible — investigate if it appears.
    table.cell(t, 6, 8, "ctx matched: " + str.tostring(matched) + " / " + str.tostring(orbTot) + " ORB  (" + str.tostring(totAll) + " total)",
               text_color=matched < orbTot ? color.new(color.orange, 0) : color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_left)

    for si = 0 to 6
        n = array.get(sN, si)
        l = array.get(sLow, si)
        pc = n > 0 ? l * 100.0 / n : 0.0
        rowC = n == 0 ? gC : pc >= 80.0 ? color.new(color.lime, 0) : wC
        table.cell(t, 0, si + 10, array.get(_apsLbl, si), text_color=rowC, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, si + 10, str.tostring(n),         text_color=wC,   text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, si + 10, str.tostring(pc, "#.#"), text_color=rowC, text_size=size.tiny, text_halign=text.align_right)

    for rq = 0 to 4
        n = array.get(rN, rq)
        l = array.get(rLow, rq)
        pc = n > 0 ? l * 100.0 / n : 0.0
        rowC = n == 0 ? gC : pc >= 80.0 ? color.new(color.lime, 0) : wC
        table.cell(t, 3, rq + 10, array.get(_aprLbl, rq), text_color=rowC, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 4, rq + 10, str.tostring(n),         text_color=wC,   text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 5, rq + 10, str.tostring(pc, "#.#"), text_color=rowC, text_size=size.tiny, text_halign=text.align_right)

    // A+ cross-tab, best cell first so the A+ row sits at the top.
    for aq = 0 to 3
        idx = 3 - aq
        n  = array.get(aN,  idx)
        w  = array.get(aWin, idx)
        l  = array.get(aLow, idx)
        wr = n > 0 ? w * 100.0 / n : 0.0
        pc = n > 0 ? l * 100.0 / n : 0.0
        ap = n > 0 ? array.get(aPts, idx) / n : 0.0
        ar = n > 0 ? array.get(aRng, idx) / n : 0.0
        rowC = n == 0 ? gC : idx == 3 ? color.new(color.aqua, 0) : wC
        table.cell(t, 6,  aq + 10, array.get(_apaLbl, idx), text_color=rowC, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 7,  aq + 10, str.tostring(n),          text_color=wC,   text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 8,  aq + 10, str.tostring(wr, "#.##"), text_color=n > 0 and wr >= 100.0 ? color.new(color.lime, 0) : wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 9,  aq + 10, str.tostring(pc, "#.#"),  text_color=rowC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 10, aq + 10, str.tostring(ap, "#.#"),  text_color=wC,   text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 11, aq + 10, str.tostring(ar, "#.#"),  text_color=wC,   text_size=size.tiny, text_halign=text.align_right)

    // POOL MARGINAL, rows 14-15 — pool-swept first, then everything else, so
    // the two lines sit next to each other and the comparison is direct.
    // THIS is the combination that was tested live; the 2x2 above splits it.
    for pq = 0 to 1
        pdx = 1 - pq
        n2  = array.get(pN,  pdx)
        w2  = array.get(pWin, pdx)
        l2  = array.get(pLow, pdx)
        wr2 = n2 > 0 ? w2 * 100.0 / n2 : 0.0
        pc2 = n2 > 0 ? l2 * 100.0 / n2 : 0.0
        ap2 = n2 > 0 ? array.get(pPts, pdx) / n2 : 0.0
        ar2 = n2 > 0 ? array.get(pRng, pdx) / n2 : 0.0
        rowC2 = n2 == 0 ? gC : pdx == 1 ? color.new(color.aqua, 0) : color.new(color.orange, 20)
        table.cell(t, 6,  pq + 14, array.get(_appLbl, pdx),   text_color=rowC2, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 7,  pq + 14, str.tostring(n2) + "/" + str.tostring(orbTot), text_color=rowC2, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 8,  pq + 14, str.tostring(wr2, "#.##"), text_color=rowC2, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 9,  pq + 14, "L " + str.tostring(n2 - w2), text_color=n2 - w2 == 0 ? color.new(color.lime, 0) : color.new(color.orange, 0), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 10, pq + 14, str.tostring(ap2, "#.#"),  text_color=rowC2, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 11, pq + 14, str.tostring(ar2, "#.#"),  text_color=rowC2, text_size=size.tiny, text_halign=text.align_right)

    // ─── WHAT SHOULD THE STOP BE MEASURED AGAINST? ───────────────────
    // Rows 10-12 are the winner-MAE distribution under three normalizers.
    // Rows 13-15 convert each into the setting that kills NO winner.
    //
    // Geometry. The stop sits beyond the LEVEL; MAE is measured from the ENTRY;
    // the entry sits _c2Depth x range past the level. So entry-to-stop is
    //   flat    : c2SLBuf      + depth x rng
    //   k x rng : (k + depth)  x rng          -> k_min = max(MAE/rng) - depth   [exact]
    //   k x ATR : k x ATR      + depth x rng  -> k_min ~ max(MAE/ATR)           [conservative,
    //                                            it ignores the extra depth room]
    //
    // READ IT AS: the basis with the smallest max, and the smallest gap between
    // max and p95, is the one where heat is predictable. A basis with a long
    // right tail (max >> p95) forces a wide stop to protect a handful of trades.
    if array.size(wmp) > 0
        array.sort(wmp, order.ascending)          // percentile REQUIRES sorted
        pMax = array.max(wmp)
        p95p = array.percentile_linear_interpolation(wmp, 95)
        table.cell(t, 12, 10, "MAE pts (flat)", text_color=wC, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 13, 10, str.tostring(pMax, "#.#"), text_color=wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 14, 10, str.tostring(p95p, "#.#"), text_color=wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 12, 13, "flat stop pts", text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 13, 13, str.tostring(math.ceil(pMax) + 2, "#"), text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 14, 13, str.tostring(math.ceil(p95p) + 2, "#"), text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)

    if array.size(wmr) > 0
        array.sort(wmr, order.ascending)
        rMax = array.max(wmr)
        r95  = array.percentile_linear_interpolation(wmr, 95)
        table.cell(t, 12, 11, "MAE / ORB rng", text_color=wC, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 13, 11, str.tostring(rMax, "#.##"), text_color=wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 14, 11, str.tostring(r95, "#.##"),  text_color=wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 12, 14, "k x rng", text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 13, 14, str.tostring(math.max(0.25, rMax - _c2Depth), "#.##"), text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 14, 14, str.tostring(math.max(0.25, r95 - _c2Depth), "#.##"), text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)

    if array.size(wma) > 0
        array.sort(wma, order.ascending)
        aMax = array.max(wma)
        a95  = array.percentile_linear_interpolation(wma, 95)
        table.cell(t, 12, 12, "MAE / ATR (atr " + str.tostring(matched > 0 ? atrSum / matched : 0.0, "#.#") + ")", text_color=wC, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 13, 12, str.tostring(aMax, "#.##"), text_color=wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 14, 12, str.tostring(a95, "#.##"),  text_color=wC, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 12, 15, "k x ATR", text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 13, 15, str.tostring(aMax, "#.##"), text_color=color.new(color.lime, 0), text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 14, 15, str.tostring(a95, "#.##"),  text_color=color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)

    // Blank the cells the shorter columns do not reach, so the grid stays square.
    for cq = 3 to 5
        table.cell(t, cq, 15, "", text_color=gC, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════

if barstate.islast and showAplus and strategy.closedtrades > 0
    if na(apTbl)
        apTbl := table.new(position.middle_left, 15, 17,
                  bgcolor=color.new(color.black, 60),
                  border_color=color.new(color.gray, 60), border_width=1,
                  frame_color=color.new(color.gray, 60), frame_width=1)

    f_drawAplusTable(apTbl)

// STRUCTURAL ANCHOR STUDY — is a thesis-based stop viable, and is tight
// structure the A+ setup?
// ─────────────────────────────────────────────────────────────────────
// CHANGES NO TRADE. It reports what four candidate stops WOULD have been, so
// the dead ones can be eliminated without a re-run each.
//
// HOW TO READ EACH COLUMN
//   valid%    how often the anchor existed AND sat on the correct side of
//             entry. An anchor that is missing a third of the time is
//             unusable no matter how well it scores elsewhere — you cannot
//             place a stop at a level that is not there.
//   p5/med/p95/max   the distance distribution in points. This is the number
//             that sets LOT SIZE: risk-based sizing means lot = risk / dist,
//             so p5 tells you the biggest position this anchor would ever
//             hand you, and max tells you the smallest. A p5 near zero is a
//             blow-up risk, not an opportunity.
//   survive%  share of WINNERS whose MAE never reached the anchor, i.e. the
//             stop would not have killed them.
//   tight/wide  trades split at the anchor's own MEDIAN distance. THIS IS THE
//             A+ TEST: if structurally tight setups really are the good ones,
//             tight WR > wide WR and tight MAE < wide MAE. If the two halves
//             look the same, tight structure carries no information and the
//             whole idea collapses to "a smaller stop lets you size bigger",
//             which is just leverage, not edge.
//
// THE CAVEAT, THIRD TIME: survive% re-prices the CURRENT trade list. A real
// structural stop changes exit timing, which frees the position slot at a
// different moment, which changes which later signals are taken. So this
// SCREENS anchors — it cannot crown one. Only a full re-run can.
// ═══════════════════════════════════════════════════════════════════════
showAnchors = input.bool(true, "Show structural anchor study", group=G_SLR,
              tooltip="Records, for every matched ORB trade, how far four structural stop levels sat from the entry. Changes nothing about the trades — it only measures what a thesis-based stop would have looked like, including whether tight structure predicts quality.")

var array<string> _ancLbl = array.from("Opposite ORB extreme", "Prior swing (pivot 3/3)", "Session extreme (sweep wick)", "Prior session extreme")
var table ancTbl = na

// Hoisted into a function 2026-09-22: TradingView rejected the script
// with "main body of the script is too long". Pine compiles function
// bodies separately from the main body, so moving the render here buys
// back the headroom. The table object is PASSED IN because a Pine
// function may not assign to a global - creation stays at the call site.
f_drawAnchorTable(table t) =>
    pv3 = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

    // Flat collection: one row per (anchor, trade) pair, tagged with the anchor
    // index. Four parallel arrays instead of twelve.
    aIdx = array.new<int>(0)
    aDst = array.new<float>(0)
    aMae = array.new<float>(0)
    aWin = array.new<int>(0)
    orbSeen = 0

    // A+ TIER SPLIT — index 1 = A+ (small range), 0 = normal. This is the whole
    // decision: does the small-range subset still win once its stop is tight?
    // Reported whether or not aplusTightSL is on, so the subset can be sized up
    // only after it has been watched at the normal stop first.
    apN   = array.new<int>(2, 0)
    apWin = array.new<int>(2, 0)
    apMae = array.new<float>(2, 0.0)
    apMax = array.new<float>(2, 0.0)
    apRng = array.new<float>(2, 0.0)

    for i = 0 to strategy.closedtrades - 1
        sz = math.abs(strategy.closedtrades.size(i))
        if sz > 0
            unit3 = sz * pv3
            m3 = strategy.closedtrades.max_drawdown(i) / unit3
            p3 = strategy.closedtrades.profit(i)       / unit3
            id3 = strategy.closedtrades.entry_id(i)
            si3 = id3 == "FRB-L" ? 0 : id3 == "FRB-S" ? 1 : id3 == "NYORB-L" ? 2 : id3 == "NYORB-S" ? 3 : (id3 == "SYD-L" or id3 == "SYD-S") ? 4 : (id3 == "TOK-L" or id3 == "TOK-S") ? 5 : (id3 == "ORB-L" or id3 == "ORB-S") ? 6 : -1
            grp3 = si3 < 0 ? -1 : si3 <= 1 ? 0 : si3 <= 3 ? 1 : si3 == 4 ? 2 : si3 == 5 ? 3 : 4
            ebi3 = strategy.closedtrades.entry_bar_index(i)
            k3 = -1
            if grp3 >= 0
                orbSeen := orbSeen + 1
                for q = array.size(_ctxBar) - 1 to 0
                    if array.get(_ctxBar, q) <= ebi3 and array.get(_ctxSig, q) == grp3
                        k3 := q
                        break
            if k3 >= 0
                for a = 0 to 3
                    d = a == 0 ? array.get(_ancOrb, k3) : a == 1 ? array.get(_ancSwing, k3) : a == 2 ? array.get(_ancSess, k3) : array.get(_ancPrior, k3)
                    if not na(d)
                        array.push(aIdx, a)
                        array.push(aDst, d)
                        array.push(aMae, m3)
                        array.push(aWin, p3 > 0 ? 1 : 0)
                rng3 = array.get(_ctxRng, k3)
                ti3  = rng3 <= aplusMaxRange ? 1 : 0
                array.set(apN,   ti3, array.get(apN,   ti3) + 1)
                array.set(apWin, ti3, array.get(apWin, ti3) + (p3 > 0 ? 1 : 0))
                array.set(apMae, ti3, array.get(apMae, ti3) + m3)
                array.set(apRng, ti3, array.get(apRng, ti3) + rng3)
                if m3 > array.get(apMax, ti3)
                    array.set(apMax, ti3, m3)

    hA = color.new(#D4A017, 0)
    gA = color.new(color.gray, 10)
    wA = color.new(color.white, 20)
    table.cell(t, 0, 0, "STRUCTURAL ANCHOR", text_color=hA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 0, "N",        text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 0, "valid%",   text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 0, "p5",       text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 0, "med",      text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 0, "p95",      text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 6, 0, "max",      text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 7, 0, "survive%", text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 8, 0, "tight WR", text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 9, 0, "wide WR",  text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 10, 0, "tightMAE", text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 11, 0, "wideMAE",  text_color=hA, text_size=size.tiny, text_halign=text.align_right)

    for a = 0 to 3
        // Pull this anchor's distances out, sorted, for the percentiles.
        dd = array.new<float>(0)
        for j = 0 to array.size(aIdx) - 1
            if array.get(aIdx, j) == a
                array.push(dd, array.get(aDst, j))
        nA = array.size(dd)
        if nA > 0
            array.sort(dd, order.ascending)   // percentile REQUIRES sorted
            p5A  = array.percentile_linear_interpolation(dd, 5)
            medA = array.percentile_linear_interpolation(dd, 50)
            p95A = array.percentile_linear_interpolation(dd, 95)
            maxA = array.max(dd)

            // survive% over WINNERS only — a stop can only cost win rate where
            // it sits inside a winner's excursion. Losers already lost.
            wTot = 0
            wSurv = 0
            tN = 0
            tW = 0
            wN = 0
            wW = 0
            tMaeSum = 0.0
            wMaeSum = 0.0
            for j = 0 to array.size(aIdx) - 1
                if array.get(aIdx, j) == a
                    dj = array.get(aDst, j)
                    mj = array.get(aMae, j)
                    wj = array.get(aWin, j)
                    if wj == 1
                        wTot := wTot + 1
                        if mj < dj
                            wSurv := wSurv + 1
                    if dj <= medA
                        tN := tN + 1
                        tW := tW + wj
                        tMaeSum := tMaeSum + mj
                    else
                        wN := wN + 1
                        wW := wW + wj
                        wMaeSum := wMaeSum + mj

            survPct = wTot > 0 ? 100.0 * wSurv / wTot : 0.0
            validPct = orbSeen > 0 ? 100.0 * nA / orbSeen : 0.0
            tWR = tN > 0 ? 100.0 * tW / tN : 0.0
            wWR = wN > 0 ? 100.0 * wW / wN : 0.0
            tMae = tN > 0 ? tMaeSum / tN : 0.0
            wMae = wN > 0 ? wMaeSum / wN : 0.0
            // Green when the A+ hypothesis holds for this anchor: the tight half
            // wins MORE and bleeds LESS than the wide half.
            aPlus = tWR >= wWR and tMae <= wMae
            rowA  = validPct < 80.0 ? color.new(color.orange, 20) : aPlus ? color.new(color.aqua, 0) : wA

            table.cell(t, 0, a + 1, array.get(_ancLbl, a),        text_color=rowA, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, a + 1, str.tostring(nA),             text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, a + 1, str.tostring(validPct, "#.#"), text_color=validPct < 80.0 ? color.new(color.orange, 0) : wA, text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, a + 1, str.tostring(p5A,  "#.#"),    text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, a + 1, str.tostring(medA, "#.#"),    text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 5, a + 1, str.tostring(p95A, "#.#"),    text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 6, a + 1, str.tostring(maxA, "#.#"),    text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 7, a + 1, str.tostring(survPct, "#.#"), text_color=survPct >= 97.0 ? color.new(color.lime, 0) : color.new(color.orange, 20), text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 8, a + 1, str.tostring(tWR, "#.##"),    text_color=rowA, text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 9, a + 1, str.tostring(wWR, "#.##"),    text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 10, a + 1, str.tostring(tMae, "#.#"),   text_color=rowA, text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 11, a + 1, str.tostring(wMae, "#.#"),   text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
        else
            table.cell(t, 0, a + 1, array.get(_ancLbl, a) + "  — never valid", text_color=color.new(color.red, 0), text_size=size.tiny, text_halign=text.align_left)

    table.cell(t, 0, 5, "matched ORB trades: " + str.tostring(orbSeen) + "   ·   current flat stop for reference: " + str.tostring(c2SLBuf, "#") + " pts from level, " + str.tostring(c2SLBuf + 22.0 * _c2Depth, "#.#") + " from entry",
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 0, 6, "AQUA row = tight half wins more AND bleeds less (A+ hypothesis holds).  ORANGE valid% = anchor too often missing to use.",
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 0, 7, "survive% re-prices THIS trade list — it screens anchors, it cannot pick one. Confirm any winner with a full re-run.",
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)

    // ─── A+ TIER — the sizing decision, stated plainly ───────────────
    // Unlike everything above, this is NOT re-priced: it splits the trades this
    // run actually took. Sizing changes no trade, so the split is honest.
    //
    // maxMAE is the column that decides it. If the A+ subset's worst heat is
    // below the A+ stop distance, the tight stop kills nothing and the bigger
    // lot is free. If it is above, the tight stop converts winners into losses
    // at THREE TIMES the size, which is the one way this tier can hurt you.
    table.cell(t, 0, 8, "A+ TIER  (rng <= " + str.tostring(aplusMaxRange, "#") + ")", text_color=hA, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 8, "N",       text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 8, "WR %",    text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 8, "avg rng", text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 8, "avgMAE",  text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 8, "maxMAE",  text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 6, 8, "stop",    text_color=hA, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 7, 8, "verdict", text_color=hA, text_size=size.tiny, text_halign=text.align_left)

    for tq = 0 to 1
        tdx  = 1 - tq                       // A+ row first
        nT   = array.get(apN, tdx)
        if nT > 0
            wrT   = 100.0 * array.get(apWin, tdx) / nT
            maeT  = array.get(apMae, tdx) / nT
            mxT   = array.get(apMax, tdx)
            rngT  = array.get(apRng, tdx) / nT
            // Entry-to-stop, which is what MAE is measured against and what
            // divides into the risk dollars to give the lot.
            bufT  = (tdx == 1 and aplusTightSL) ? aplusSLBuf : c2SLBuf
            stopT = bufT + rngT * _c2Depth
            safe  = mxT <= stopT
            rowT  = tdx == 1 ? (safe ? color.new(color.aqua, 0) : color.new(color.red, 0)) : wA
            table.cell(t, 0, tq + 9, tdx == 1 ? "A+  small range" : "normal", text_color=rowT, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, tq + 9, str.tostring(nT),            text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 2, tq + 9, str.tostring(wrT,  "#.##"),  text_color=rowT, text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 3, tq + 9, str.tostring(rngT, "#.#"),   text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 4, tq + 9, str.tostring(maeT, "#.#"),   text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 5, tq + 9, str.tostring(mxT,  "#.#"),   text_color=rowT, text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 6, tq + 9, str.tostring(stopT, "#.#"),  text_color=wA,   text_size=size.tiny, text_halign=text.align_right)
            table.cell(t, 7, tq + 9, tdx == 0 ? "" : (safe ? "worst heat fits inside the stop" : "worst heat EXCEEDS the stop — tier not earned"),
                       text_color=rowT, text_size=size.tiny, text_halign=text.align_left)

// ═══════════════════════════════════════════════════════════════════════
// CONDITION STUDY — grade the baseline, do not try to beat it
// ─────────────────────────────────────────────────────────────────────
// Added 2026-09-22 on the user's reframe, which is the right one: THE
// BASELINE IS THE A+ SETUP. Six attempts to beat it have failed (break
// strength, liquidity grab, range-scaled stops, H-prime, Tokyo, and the
// tight-stop A+ tier). Stop trying to beat it. Grade it instead.
//
// This table breaks ONE signal at a time into its condition buckets, because
// the signals do not share conditions — already proven: the ADR guard HELPS H
// and HURTS M. A study that pools them averages that away and finds nothing.
//
// WHAT IT IS FOR: a RISK LADDER. Rank the buckets by win rate and heat, then
// set risk percent per grade. The LOT follows from risk / stopDist, so the same
// ladder produces 0.5 lots on a 100k account and 2.0 on a 400k one with no
// change to the rule.
//
// WHY GRADING IS SAFE WHERE FILTERING IS NOT: changing the SIZE of a trade does
// not change WHICH trades fire, so the trade list is identical and the buckets
// are an honest split. Blocking a signal frees the position slot and reshuffles
// everything downstream - which is exactly why every filter above failed.
//
// READ IT AS: a bucket earns a higher rung only if BOTH its win rate holds AND
// its heat stays low. A bucket with a great win rate and high heat is a bucket
// that survived by luck on a wide stop, and it will not survive being sized up.
// ═══════════════════════════════════════════════════════════════════════
G_COND = "Condition study (per signal)"
condSig = input.string("ALL", "Signal to break down", options=["ALL", "M  Frankfurt", "H  NY", "G  London", "U  Sydney"], group=G_COND,
          tooltip="Study ONE signal at a time. Conditions are not shared between signals - the ADR guard is measured GOOD for H and BAD for M - so pooling them averages the real effects away.\n\nRun this four times, once per signal, and write down the buckets that hold both a high win rate AND low heat. Those are the rungs of the risk ladder.")
showCond = input.bool(true, "Show condition study", group=G_COND)

var array<string> _cdLbl = array.from("ORB rng  < 10", "ORB rng  10-15", "ORB rng  15-20", "ORB rng  20-30", "ORB rng  30 +", "ADR  < 50%", "ADR  50-75%", "ADR  75-90%", "ADR  90% +", "dir  LONG", "dir  SHORT", "Daily bias AGREES", "Daily bias opposes", "M15 bias AGREES", "M15 bias opposes", "pool SWEPT", "pool not swept", "break weak  < .10", "break mid  .10-.25", "break strong > .25")
var table cdTbl = na

f_drawCondTable(table t) =>
    pv4 = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue
    // 20 buckets, five families. Parallel arrays keep it flat and readable.
    cN   = array.new<int>(20, 0)
    cWin = array.new<int>(20, 0)
    cLow = array.new<int>(20, 0)
    cMae = array.new<float>(20, 0.0)
    cPts = array.new<float>(20, 0.0)
    seen = 0
    // Pre-allocated ONCE. Building this with array.from() inside the trade loop
    // would allocate a fresh array per trade and can hit Pine's object ceiling
    // on a long backtest; reusing seven slots costs nothing.
    bIdx = array.new<int>(7, 0)

    // Which _ctxSig this run is studying. -1 = pool everything.
    want = condSig == "M  Frankfurt" ? 0 : condSig == "H  NY" ? 1 : condSig == "U  Sydney" ? 2 : condSig == "G  London" ? 4 : -1

    for i = 0 to strategy.closedtrades - 1
        sz4 = math.abs(strategy.closedtrades.size(i))
        if sz4 > 0
            u4  = sz4 * pv4
            m4  = strategy.closedtrades.max_drawdown(i) / u4
            p4  = strategy.closedtrades.profit(i)       / u4
            id4 = strategy.closedtrades.entry_id(i)
            s4  = id4 == "FRB-L" ? 0 : id4 == "FRB-S" ? 1 : id4 == "NYORB-L" ? 2 : id4 == "NYORB-S" ? 3 : (id4 == "SYD-L" or id4 == "SYD-S") ? 4 : (id4 == "TOK-L" or id4 == "TOK-S") ? 5 : (id4 == "ORB-L" or id4 == "ORB-S") ? 6 : -1
            g4  = s4 < 0 ? -1 : s4 <= 1 ? 0 : s4 <= 3 ? 1 : s4 == 4 ? 2 : s4 == 5 ? 3 : 4
            if g4 >= 0 and (want < 0 or g4 == want)
                eb4 = strategy.closedtrades.entry_bar_index(i)
                k4 = -1
                for q = array.size(_ctxBar) - 1 to 0
                    if array.get(_ctxBar, q) <= eb4 and array.get(_ctxSig, q) == g4
                        k4 := q
                        break
                if k4 >= 0
                    seen := seen + 1
                    rg = array.get(_ctxRng, k4)
                    ad = array.get(_ctxAdr, k4)
                    st = array.get(_ctxStr, k4)
                    // Direction comes from the entry id, not the context - the
                    // id is the literal this script passed to strategy.entry.
                    isLong4 = id4 == "FRB-L" or id4 == "NYORB-L" or id4 == "SYD-L" or id4 == "TOK-L" or id4 == "ORB-L"
                    // Bucket ids, one per family. -1 never happens; the ranges
                    // are exhaustive by construction.
                    bRng = rg < 10.0 ? 0 : rg < 15.0 ? 1 : rg < 20.0 ? 2 : rg < 30.0 ? 3 : 4
                    bAdr = ad < 0.50 ? 5 : ad < 0.75 ? 6 : ad < 0.90 ? 7 : 8
                    bDir = isLong4 ? 9 : 10
                    bAgr = array.get(_ctxAgr, k4) == 1 ? 11 : 12
                    bM15 = array.get(_ctxM15, k4) == 1 ? 13 : 14
                    bPul = array.get(_ctxPool, k4) == 1 ? 15 : 16
                    bStr = st < 0.10 ? 17 : st < 0.25 ? 18 : 19
                    // Each trade lands in exactly one bucket per family, so it
                    // is counted seven times across seven independent splits.
                    array.set(bIdx, 0, bRng)
                    array.set(bIdx, 1, bAdr)
                    array.set(bIdx, 2, bDir)
                    array.set(bIdx, 3, bAgr)
                    array.set(bIdx, 4, bM15)
                    array.set(bIdx, 5, bPul)
                    array.set(bIdx, 6, bStr)
                    for bi7 = 0 to 6
                        b = array.get(bIdx, bi7)
                        array.set(cN,   b, array.get(cN,   b) + 1)
                        array.set(cWin, b, array.get(cWin, b) + (p4 > 0 ? 1 : 0))
                        array.set(cMae, b, array.get(cMae, b) + m4)
                        array.set(cPts, b, array.get(cPts, b) + p4)
                        if m4 <= 20.0
                            array.set(cLow, b, array.get(cLow, b) + 1)

    hD = color.new(#D4A017, 0)
    gD = color.new(color.gray, 10)
    wD = color.new(color.white, 20)
    table.cell(t, 0, 0, "CONDITION  ·  " + condSig, text_color=hD, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 0, "N",       text_color=hD, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 2, 0, "WR %",    text_color=hD, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 3, 0, "avgMAE",  text_color=hD, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 4, 0, "<=20 %",  text_color=hD, text_size=size.tiny, text_halign=text.align_right)
    table.cell(t, 5, 0, "avg pts", text_color=hD, text_size=size.tiny, text_halign=text.align_right)

    for b = 0 to 19
        n5 = array.get(cN, b)
        wr5  = n5 > 0 ? 100.0 * array.get(cWin, b) / n5 : 0.0
        mae5 = n5 > 0 ? array.get(cMae, b) / n5 : 0.0
        low5 = n5 > 0 ? 100.0 * array.get(cLow, b) / n5 : 0.0
        pts5 = n5 > 0 ? array.get(cPts, b) / n5 : 0.0
        // A bucket earns a higher rung only if the win rate holds AND heat is
        // low. High WR with high heat means it survived on stop width, not on
        // quality, and it will not survive being sized up.
        good = n5 >= 10 and wr5 >= 97.0 and low5 >= 80.0
        thin = n5 < 10
        rowD = thin ? gD : good ? color.new(color.aqua, 0) : wD
        table.cell(t, 0, b + 1, array.get(_cdLbl, b),      text_color=rowD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(t, 1, b + 1, str.tostring(n5),           text_color=thin ? color.new(color.orange, 0) : wD, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 2, b + 1, str.tostring(wr5,  "#.##"), text_color=rowD, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 3, b + 1, str.tostring(mae5, "#.#"),  text_color=rowD, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 4, b + 1, str.tostring(low5, "#.#"),  text_color=rowD, text_size=size.tiny, text_halign=text.align_right)
        table.cell(t, 5, b + 1, str.tostring(pts5, "#.#"),  text_color=wD,   text_size=size.tiny, text_halign=text.align_right)

    table.cell(t, 0, 21, "n=" + str.tostring(seen) + " trades in this signal   ·   AQUA = n>=10, WR>=97%, heat<=20 on 80%+   ·   ORANGE n = too thin to read",
               text_color=color.new(color.gray, 0), text_size=size.tiny, text_halign=text.align_left)

if barstate.islast and showCond and strategy.closedtrades > 0
    if na(cdTbl)
        cdTbl := table.new(position.bottom_left, 6, 22,
                  bgcolor=color.new(color.black, 60),
                  border_color=color.new(color.gray, 60), border_width=1,
                  frame_color=color.new(color.gray, 60), frame_width=1)

    f_drawCondTable(cdTbl)

if barstate.islast and showAnchors and strategy.closedtrades > 0
    if na(ancTbl)
        ancTbl := table.new(position.top_center, 12, 11,
                   bgcolor=color.new(color.black, 60),
                   border_color=color.new(color.gray, 60), border_width=1,
                   frame_color=color.new(color.gray, 60), frame_width=1)

    f_drawAnchorTable(ancTbl)

// ─── SESSION BACKGROUNDS ──────────────────────────────────────────────
bgcolor(in_asian   ? color.new(color.blue,   90) : na, title="Asian")
bgcolor(in_london  ? color.new(color.yellow, 90) : na, title="London KZ")
bgcolor(in_overlap ? color.new(color.orange, 88) : na, title="NY-Lon Overlap")
bgcolor(in_sb_win  ? color.new(color.lime,   75) : na, title="Silver Bullet")
