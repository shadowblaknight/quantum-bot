//@version=6
indicator("Quantum Bot — BTC CME Gap Specialist", "QB BTC-GAP", overlay=true,
          max_bars_back=500, max_labels_count=100, max_lines_count=50, max_boxes_count=50)

// ═══════════════════════════════════════════════════════════════════════
//  QUANTUM BOT — BTC CME GAP FILL SPECIALIST  (BTC1! or BTCUSDT, 1h)
//  ─────────────────────────────────────────────────────────────────────
//  CME Bitcoin futures close Friday ~21:00 UTC and reopen Sunday
//  ~22:00 UTC. The gap between Friday close and Sunday open fills
//  at 92% when gap < $700 (2020–2025 dataset).
//
//  Strategy:
//    — Detects first bar of the trading week
//    — Calculates gap = |open - prev_close|
//    — If gap < maxGapSize: fire alert to fill the gap
//    — Direction: gap UP → SHORT to fill; gap DOWN → LONG to fill
//    — Entry: current open (market order at gap level)
//    — TP1: prev Friday close (100% gap fill)
//    — TP2: 1.5× gap beyond fill (overshoot capture)
//    — TP3: 2× gap beyond fill (runner)
//    — SL: slBuffer structural beyond Sunday open
//
//  HTF Bias filter (optional): H1+H4 EMA alignment adds confidence.
//  Run on BTC1! (CME Bitcoin futures) for true gap visibility.
//  Also works on BTCUSD/BTCUSDT spot if exchange shows Sunday gaps.
// ═══════════════════════════════════════════════════════════════════════

WEBHOOK_KEY = "x5YFG4TDJKqi2fVEbBHO0r3vUPgmZACk"

// ─── INPUTS ──────────────────────────────────────────────────────────
G_GAP = "Gap Parameters"
maxGapSize  = input.float(700.0,  "Max gap size ($) to trade",    group=G_GAP, step=50.0,
              tooltip="92% fill rate for gaps < $700 (2020-2025 data). Reduce to $500 for higher selectivity.")
minGapSize  = input.float(100.0,  "Min gap size ($) to trade",    group=G_GAP, step=25.0,
              tooltip="Ignore micro-gaps that are noise rather than true CME gaps.")
slBuffer    = input.float(750.0,  "SL structural buffer ($)",     group=G_GAP, step=50.0,
              tooltip="SL placed this far beyond Sunday open. $750 covers ~1× gap + buffer.")

G_FILT = "Filters"
requireBias = input.bool(true, "Require H1+H4 bias alignment with fill direction", group=G_FILT,
              tooltip="If gap UP → fill is SHORT → require H1/H4 bearish bias. Adds confidence at cost of frequency.")
emaLength   = input.int(20, "HTF bias EMA period", group=G_FILT, minval=5, maxval=100)
atrLength   = input.int(14, "ATR period",          group=G_FILT, minval=2, maxval=50)

G_VIS = "Visuals"
showPosBox    = input.bool(true, "Position box on fire",     group=G_VIS)
posBoxBars    = input.int(60,   "Position box width (bars)", group=G_VIS, minval=5, maxval=300)
showStatusTbl = input.bool(true, "Corner status table",      group=G_VIS)
showGapLine   = input.bool(true, "Gap fill target line",     group=G_VIS)

// ─── HTF BIAS ─────────────────────────────────────────────────────────
f_htfBias(int emaLen, int atrLen) =>
    e = ta.ema(close, emaLen)
    b = close[1] > e[1] ? 1 : close[1] < e[1] ? -1 : 0
    a = ta.atr(atrLen)
    [b, a]

[h1B, h1ATR] = request.security(syminfo.tickerid, "60",  f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[h4B, h4ATR] = request.security(syminfo.tickerid, "240", f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[hdB, hdATR] = request.security(syminfo.tickerid, "D",   f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)

atrVal = ta.atr(atrLength)

// ─── CVD ──────────────────────────────────────────────────────────────
_signedVol  = close > open ? volume : close < open ? -volume : 0.0
_newDay     = ta.change(time("D")) != 0
var float _cvdRunning = 0.0
_cvdRunning := _cvdRunning + _signedVol
var float _cvdBase = 0.0
if _newDay
    _cvdBase := _cvdRunning - _signedVol
cvd      = _cvdRunning - _cvdBase
cvdMa    = ta.ema(cvd, 14)
cvdSlope = cvd > cvd[1] and cvd > cvdMa ? "rising" : cvd < cvd[1] and cvd < cvdMa ? "falling" : "flat"

// ─── GAP DETECTION ────────────────────────────────────────────────────
// First bar of the week. On CME futures (BTC1!), this is Sunday ~22:00 UTC.
// On spot charts, this may appear as Monday open or a Sunday session start.
_newWeek = ta.change(time("W")) != 0

// Gap = distance between current open and previous bar's close
_gapRaw  = open - close[1]
_gapAbs  = math.abs(_gapRaw)
_gapUp   = _gapRaw > 0   // opened above Friday close → gap up → fill = SHORT
_gapDown = _gapRaw < 0   // opened below Friday close → gap down → fill = LONG

// Fill direction is OPPOSITE to gap direction
_fillDir = _gapUp ? -1 : 1  // -1 = SHORT to fill gap up; 1 = LONG to fill gap down

// Bias check: fill direction must align with H1+H4
_biasOk = not requireBias or (_fillDir == 1 ? (h1B == 1 or h4B == 1) : (h1B == -1 or h4B == -1))

// ─── DRAW FUNCTIONS ───────────────────────────────────────────────────
f_drawPosBox(float e, float slP, float tp3) =>
    r = bar_index + posBoxBars
    box.new(bar_index, math.max(e, tp3), r, math.min(e, tp3),
            border_color=color.new(color.teal, 50), bgcolor=color.new(color.teal, 88))
    box.new(bar_index, math.max(e, slP), r, math.min(e, slP),
            border_color=color.new(color.red,  55), bgcolor=color.new(color.red,  90))
    line.new(bar_index, e, r, e, color=color.new(color.gray, 10), style=line.style_dashed, width=1)

// ─── ALERT BUILDER ────────────────────────────────────────────────────
f_buildAlert(string dir, float entry, float slP,
             float tp1, float tp2, float tp3,
             float gapSize, float gapFillLevel) =>
    slRisk = math.abs(entry - slP)
    rr1    = slRisk > 0 ? math.abs(tp1 - entry) / slRisk : 0.0
    rr2    = slRisk > 0 ? math.abs(tp2 - entry) / slRisk : 0.0
    rr3    = slRisk > 0 ? math.abs(tp3 - entry) / slRisk : 0.0
    cvdOk  = dir == "LONG" ? cvdSlope == "rising" : cvdSlope == "falling"
    dEmoji = dir == "LONG" ? "🟢" : "🔴"
    readable = dEmoji + " " + syminfo.ticker + " · " + (dir == "LONG" ? "BUY" : "SELL") +
               " · BTC-CME-GAP · Gap $" + str.tostring(math.round(gapSize)) +
               " → fill target " + str.tostring(gapFillLevel, format.mintick) + "\n---\n"
    head   = "{\"version\":\"2.3\",\"action\":\"trade\",\"template\":\"btc-gap-fill\"" +
              ",\"direction\":\"" + dir +
              "\",\"symbol\":\"" + syminfo.tickerid +
              "\",\"timeframe\":\"" + timeframe.period +
              "\",\"timestamp\":" + str.tostring(time)
    prices = ",\"entry\":\""  + str.tostring(entry, format.mintick) +
              "\",\"sl\":\""  + str.tostring(slP,   format.mintick) +
              "\",\"tp1\":\"" + str.tostring(tp1,   format.mintick) +
              "\",\"tp2\":\"" + str.tostring(tp2,   format.mintick) +
              "\",\"tp3\":\"" + str.tostring(tp3,   format.mintick) +
              "\",\"rr1\":"   + str.tostring(rr1,   "0.00") +
              ",\"rr2\":"     + str.tostring(rr2,   "0.00") +
              ",\"rr3\":"     + str.tostring(rr3,   "0.00")
    zone   = ",\"zoneUpper\":\"" + str.tostring(math.max(entry, gapFillLevel), format.mintick) +
              "\",\"zoneLower\":\"" + str.tostring(math.min(entry, gapFillLevel), format.mintick) +
              "\",\"zoneType\":\"CME-GAP\""
    htf    = ",\"activeSession\":\"SUNDAY-OPEN\"" +
              ",\"htfTier\":\"A\"" +
              ",\"htfBias\":\"" + str.tostring(h1B) + "/" + str.tostring(h4B) + "/" + str.tostring(hdB) + "\"" +
              ",\"htfBiasAlign\":" + str.tostring(_biasOk) +
              ",\"htfConfluence\":\"gap-fill\""
    ctx    = ",\"gapSize\":\"" + str.tostring(gapSize, "0.00") + "\"" +
              ",\"gapFillLevel\":\"" + str.tostring(gapFillLevel, format.mintick) + "\"" +
              ",\"cvdSlope\":\"" + cvdSlope + "\"" +
              ",\"cvdConfirms\":" + str.tostring(cvdOk) +
              ",\"barOpen\":\""  + str.tostring(open,  format.mintick) + "\"" +
              ",\"barHigh\":\""  + str.tostring(high,  format.mintick) + "\"" +
              ",\"barLow\":\""   + str.tostring(low,   format.mintick) + "\"" +
              ",\"barClose\":\"" + str.tostring(close, format.mintick) + "\"" +
              ",\"apiKey\":\"" + WEBHOOK_KEY + "\"}"
    readable + head + prices + zone + htf + ctx

// ─── GAP FILL SIGNAL ──────────────────────────────────────────────────
var bool gap_fired     = false
var float gap_fill_lvl = na    // Friday close = gap fill target
var float gap_open_lvl = na    // Sunday open = entry reference
var float gap_size_ref = na

if _newWeek
    gap_fired     := false
    gap_fill_lvl  := na
    gap_open_lvl  := na
    gap_size_ref  := na

if barstate.isconfirmed and _newWeek and not gap_fired
    if _gapAbs >= minGapSize and _gapAbs < maxGapSize and _biasOk
        gapFillLevel = close[1]   // Friday close = 100% gap fill target
        entryP       = open       // enter at gap opening price

        slP = _fillDir == 1 ? entryP - slBuffer : entryP + slBuffer
        tp1 = gapFillLevel                                              // 100% gap fill
        tp2 = _fillDir == 1 ? gapFillLevel + _gapAbs * 0.50 : gapFillLevel - _gapAbs * 0.50  // overshoot
        tp3 = _fillDir == 1 ? gapFillLevel + _gapAbs * 1.00 : gapFillLevel - _gapAbs * 1.00  // runner

        // Sanity: SL and TP must be on correct sides of entry
        slOk = _fillDir == 1 ? slP < entryP : slP > entryP
        tpOk = _fillDir == 1 ? tp1 > entryP : tp1 < entryP

        if slOk and tpOk
            dirStr       = _fillDir == 1 ? "LONG" : "SHORT"
            gap_fired    := true
            gap_fill_lvl := gapFillLevel
            gap_open_lvl := entryP
            gap_size_ref := _gapAbs

            alert(f_buildAlert(dirStr, entryP, slP, tp1, tp2, tp3, _gapAbs, gapFillLevel),
                  alert.freq_once_per_bar)

            lblColor = _fillDir == 1 ? color.new(color.teal, 5) : color.new(color.red, 5)
            lblStyle = _fillDir == 1 ? label.style_label_up : label.style_label_down
            lblY     = _fillDir == 1 ? low : high
            label.new(bar_index, lblY,
                      "⚡ BTC GAP " + dirStr + "\n$" + str.tostring(math.round(_gapAbs)) + " gap → $" + str.tostring(math.round(gapFillLevel)),
                      style=lblStyle, color=lblColor, textcolor=color.white, size=size.normal)

            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

            if showGapLine
                line.new(bar_index, gapFillLevel, bar_index + posBoxBars, gapFillLevel,
                         color=color.new(color.yellow, 10), style=line.style_dashed, width=2)

// Rejected gap — too large or bias fails
if barstate.isconfirmed and _newWeek and not gap_fired and _gapAbs > 0
    if _gapAbs >= minGapSize
        rejectReason = _gapAbs >= maxGapSize ? "GAP $" + str.tostring(math.round(_gapAbs)) + " > MAX" :
                       not _biasOk           ? "GAP $" + str.tostring(math.round(_gapAbs)) + " BIAS-FAIL" : ""
        if str.length(rejectReason) > 0
            label.new(bar_index, high, "✗ " + rejectReason,
                      style=label.style_label_down, color=color.new(color.gray, 30),
                      textcolor=color.new(color.white, 30), size=size.tiny)

// ─── STATUS TABLE ─────────────────────────────────────────────────────
var table stTbl = na

if showStatusTbl and barstate.islast
    if na(stTbl)
        stTbl := table.new(position.top_right, 2, 9,
                           bgcolor=color.new(color.black, 70),
                           border_color=color.new(color.gray, 60), border_width=1,
                           frame_color=color.new(color.gray, 60), frame_width=1)

    h1Str = h1B == 1 ? "LONG" : h1B == -1 ? "SHORT" : "NEUT"
    h4Str = h4B == 1 ? "LONG" : h4B == -1 ? "SHORT" : "NEUT"
    hdStr = hdB == 1 ? "LONG" : hdB == -1 ? "SHORT" : "NEUT"
    h1Col = h1B == 1 ? color.lime : h1B == -1 ? color.red : color.gray
    h4Col = h4B == 1 ? color.lime : h4B == -1 ? color.red : color.gray
    hdCol = hdB == 1 ? color.lime : hdB == -1 ? color.red : color.gray

    thisWeekGap    = not na(gap_size_ref) ? "$" + str.tostring(math.round(gap_size_ref)) : "—"
    thisWeekStatus = gap_fired ? "FIRED" : "no signal"
    statusCol      = gap_fired ? color.lime : color.gray

    table.cell(stTbl, 0, 0, "QB BTC GAP",  text_color=color.new(#F7931A, 0), text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_left)
    table.cell(stTbl, 1, 0, syminfo.tickerid + " · " + timeframe.period + "m", text_color=color.new(color.white,20), text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_right)
    table.cell(stTbl, 0, 1, "Gap signal",  text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 1, thisWeekStatus, text_color=color.new(statusCol,0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 2, "Gap size",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 2, thisWeekGap,   text_color=color.new(color.yellow,0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 3, "Fill target", text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 3, not na(gap_fill_lvl) ? str.tostring(gap_fill_lvl, format.mintick) : "—",
               text_color=color.new(color.aqua,0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 4, "Bias req'd",  text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 4, requireBias ? "ON" : "OFF", text_color=color.new(requireBias ? color.lime : color.gray, 0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 5, "H1 bias",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 5, h1Str,         text_color=color.new(h1Col,0),       text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 6, "H4 bias",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 6, h4Str,         text_color=color.new(h4Col,0),       text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 7, "D bias",     text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 1, 7, hdStr,         text_color=color.new(hdCol,0),       text_size=size.tiny, text_halign=text.align_right)
    table.cell(stTbl, 0, 8, "Max gap",    text_color=color.new(color.gray,15), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 8, "$" + str.tostring(math.round(maxGapSize)),
               text_color=color.new(color.white,30), text_size=size.tiny, text_halign=text.align_right)

// Weekend background shading
_isWeekend = dayofweek(time, "UTC") == dayofweek.saturday or dayofweek(time, "UTC") == dayofweek.sunday
bgcolor(_isWeekend ? color.new(color.purple, 92) : na, title="Weekend")
