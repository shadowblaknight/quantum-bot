//@version=6
strategy("QB Gold S2 — Strategy (A/B/D)", "QB GOLD S2 · STRAT", overlay=true,
         max_bars_back=500, max_labels_count=500, max_lines_count=300, max_boxes_count=300,
         default_qty_type=strategy.percent_of_equity, default_qty_value=1,
         commission_type=strategy.commission.percent, commission_value=0.0,
         slippage=2, pyramiding=0, calc_on_every_tick=false,
         close_entries_rule="ANY")

// ═══════════════════════════════════════════════════════════════════════
//  QB GOLD SPECIALIST 2 — STRATEGY VERSION  (XAUUSD H1)
//  Identical detection logic as the indicator.  alert() → strategy.entry()
//  / strategy.exit() so TradingView Strategy Tester shows historical WR.
//
//  Setups:
//    A — FVG Retest + BOS (LIMIT entry at proximal edge of FVG)
//    B — Judas Sweep: Asian range sweep + reversal (LIMIT at swept level)
//    D — Psychological Level Bounce (MARKET entry at bar close)
//
//  How to use:
//    1. Paste into Pine Editor → Add to chart on XAUUSD H1
//    2. Open Strategy Tester tab
//    3. Toggle DOW filter to isolate Mon / Tue / Wed / Thu / Fri
//    4. Compare WR and PF per day to find best trading days
// ═══════════════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────────────
G_CORE = "── Setups ──"
modA = input.bool(true, "A  FVG Retest + BOS",        group=G_CORE)
modB = input.bool(true, "B  Judas Sweep",              group=G_CORE)
modD = input.bool(true, "D  Psych Level Bounce",       group=G_CORE)

G_STRAT = "── Strategy ──"
exitMode = input.string("TP1", "Exit target",
           options=["TP1", "TP2"],
           tooltip="TP1 = default multiplier (A:1R, B:1.5R, D:1.5R).  TP2 = double.",
           group=G_STRAT)
showBoxes = input.bool(true, "Show position boxes", group=G_STRAT)

G_DOW = "── Day of Week ──"
i_useDow = input.bool(true,  "Enable DOW filter",  group=G_DOW,
           tooltip="Turn OFF to run all 5 days.  Turn ON + toggle individual days to isolate a specific day.")
i_mon    = input.bool(true,  "Mon",                group=G_DOW)
i_tue    = input.bool(true,  "Tue",                group=G_DOW)
i_wed    = input.bool(false, "Wed",                group=G_DOW)
i_thu    = input.bool(true,  "Thu",                group=G_DOW)
i_fri    = input.bool(false, "Fri",                group=G_DOW)

G_FILT = "── Filters ──"
tpA      = input.float(1.0,  "A  TP multiplier (×R)",   group=G_FILT, minval=0.5, step=0.5)
tpB      = input.float(1.5,  "B  TP multiplier (×R)",   group=G_FILT, minval=0.5, step=0.5)
tpD      = input.float(1.5,  "D  TP multiplier (×R)",   group=G_FILT, minval=0.5, step=0.5)
htfA     = input.string("all3","A  HTF bias req.",       group=G_FILT, options=["any","2of3","all3"])
htfB_req = input.string("2of3","B  HTF bias req.",       group=G_FILT, options=["none","any","2of3","all3"])
htfD_req = input.string("all3","D  HTF bias req.",       group=G_FILT, options=["any","2of3","all3"])
atrLen   = input.int(14,     "ATR period",               group=G_FILT, minval=5)
emaLen   = input.int(20,     "EMA period",               group=G_FILT, minval=5)
swg      = input.int(3,      "Pivot SWG",                group=G_FILT, minval=2, maxval=5)
bosLB    = input.int(30,     "BOS alive (H1 bars)",      group=G_FILT, minval=5, maxval=100)
slBuf    = input.float(0.20, "SL buffer (×ATR)",         group=G_FILT, minval=0.05, step=0.05)
slMin    = input.float(0.30, "SL min (×ATR)",            group=G_FILT, minval=0.05, step=0.05)
slMax    = input.float(3.00, "SL max (×ATR)",            group=G_FILT, minval=1.0,  step=0.25)
fvgGap   = input.float(0.20, "FVG min gap (×ATR)",       group=G_FILT, minval=0.05, step=0.05)
fvgAge   = input.int(12,     "FVG max age (bars)",       group=G_FILT, minval=4, maxval=48)
fvgFill  = input.float(0.20, "FVG max fill",             group=G_FILT, minval=0.05, step=0.05)
adrFVG   = input.float(0.85, "ADR max (FVG)",            group=G_FILT, minval=0.5, maxval=1.5)
adrJudas = input.float(0.90, "ADR max (Judas)",          group=G_FILT, minval=0.5, maxval=1.5)
adrPsych = input.float(1.20, "ADR max (Psych)",          group=G_FILT, minval=0.5, maxval=2.0)

// ─── DAY OF WEEK GATE ─────────────────────────────────────────────────
_dow   = dayofweek(time, "UTC")
_dowOk = not i_useDow or
         (_dow == dayofweek.monday    and i_mon) or
         (_dow == dayofweek.tuesday   and i_tue) or
         (_dow == dayofweek.wednesday and i_wed) or
         (_dow == dayofweek.thursday  and i_thu) or
         (_dow == dayofweek.friday    and i_fri)

// ─── TIME ────────────────────────────────────────────────────────────
_H      = hour(time,      "UTC")
_newDay = ta.change(dayofmonth(time, "UTC")) != 0

isWD  = _dow >= 2 and _dow <= 6
inAs  = _H < 8  and isWD
inLon = _H >= 8  and _H <= 10 and isWD
inNY  = _H >= 13 and _H <= 16 and isWD
inKZ  = inLon or inNY

// ─── ATR + HTF BIAS ───────────────────────────────────────────────────
atr  = ta.atr(atrLen)
h1em = ta.ema(close, emaLen)
h1B  = close > h1em ? 1 : close < h1em ? -1 : 0

h4cl = request.security(syminfo.tickerid, "240", close,                 lookahead=barmerge.lookahead_off)
h4em = request.security(syminfo.tickerid, "240", ta.ema(close, emaLen), lookahead=barmerge.lookahead_off)
dcl  = request.security(syminfo.tickerid, "D",   close,                 lookahead=barmerge.lookahead_off)
dem  = request.security(syminfo.tickerid, "D",   ta.ema(close, emaLen), lookahead=barmerge.lookahead_off)

h4B = h4cl > h4em ? 1 : h4cl < h4em ? -1 : 0
dB  = dcl  > dem  ? 1 : dcl  < dem  ? -1 : 0

f_htfOk(dir, req) =>
    cnt = (h1B == dir ? 1 : 0) + (h4B == dir ? 1 : 0) + (dB == dir ? 1 : 0)
    req == "none" or (req == "any" and cnt >= 1) or (req == "2of3" and cnt >= 2) or cnt >= 3

f_htfTier(dir) =>
    cnt = (h1B == dir ? 1 : 0) + (h4B == dir ? 1 : 0) + (dB == dir ? 1 : 0)
    cnt >= 3 ? "A" : "B"

// ─── ADR ──────────────────────────────────────────────────────────────
dHi  = request.security(syminfo.tickerid, "D", high, lookahead=barmerge.lookahead_off)
dLo  = request.security(syminfo.tickerid, "D", low,  lookahead=barmerge.lookahead_off)
dATR = ta.ema(dHi - dLo, 14)[1]

var float rHi = na
var float rLo = na
if _newDay
    rHi := high[1]
    rLo := low[1]
rHi := math.max(nz(rHi, high[1]), high[1])
rLo := math.min(nz(rLo, low[1]),  low[1])
adrC = dATR > 0 ? (rHi - rLo) / dATR : 0.0

// ─── ASIAN RANGE ──────────────────────────────────────────────────────
var float arHi     = na
var float arLo     = na
var bool  arLocked = false

if _newDay
    arHi     := na
    arLo     := na
    arLocked := false

if inAs and barstate.isconfirmed
    arHi := na(arHi) ? high : math.max(arHi, high)
    arLo := na(arLo) ? low  : math.min(arLo, low)

if _H == 8 and not arLocked
    arLocked := true

// ─── BOS ──────────────────────────────────────────────────────────────
ph = ta.pivothigh(high, swg, swg)
pl = ta.pivotlow (low,  swg, swg)

var float prevPH    = na
var float prevPL    = na
var int   bosBullBi = na
var int   bosBearBi = na

if not na(ph)
    if not na(prevPH) and ph > prevPH
        bosBullBi := bar_index
    prevPH := ph

if not na(pl)
    if not na(prevPL) and pl < prevPL
        bosBearBi := bar_index
    prevPL := pl

bosBull = not na(bosBullBi) and (bar_index - bosBullBi) <= bosLB
bosBear = not na(bosBearBi) and (bar_index - bosBearBi) <= bosLB

// ─── FVG POOL ─────────────────────────────────────────────────────────
var float[] fU    = array.new_float()
var float[] fL    = array.new_float()
var int[]   fDir  = array.new_int()
var int[]   fBi   = array.new_int()
var float[] fFill = array.new_float()
var bool[]  fFire = array.new_bool()

if barstate.isconfirmed and bar_index >= 2 and atr > 0
    bGap = low - high[2]
    if bGap >= atr * fvgGap
        array.push(fU,    low)
        array.push(fL,    high[2])
        array.push(fDir,  1)
        array.push(fBi,   bar_index)
        array.push(fFill, 0.0)
        array.push(fFire, false)

    rGap = low[2] - high
    if rGap >= atr * fvgGap
        array.push(fU,    low[2])
        array.push(fL,    high)
        array.push(fDir,  -1)
        array.push(fBi,   bar_index)
        array.push(fFill, 0.0)
        array.push(fFire, false)

    while array.size(fU) > 25
        array.shift(fU)
        array.shift(fL)
        array.shift(fDir)
        array.shift(fBi)
        array.shift(fFill)
        array.shift(fFire)

if barstate.isconfirmed and array.size(fU) > 0
    for i = array.size(fU) - 1 to 0
        u   = array.get(fU,   i)
        l   = array.get(fL,   i)
        d   = array.get(fDir, i)
        gsz = u - l
        if gsz > 0
            if d == 1 and low < u
                array.set(fFill, i, math.min(1.0, math.max(array.get(fFill, i), (u - math.max(l, low)) / gsz)))
            if d == -1 and high > l
                array.set(fFill, i, math.min(1.0, math.max(array.get(fFill, i), (math.min(u, high) - l) / gsz)))

// ─── HELPERS ──────────────────────────────────────────────────────────
f_drawBox(float e, float sl, float tp) =>
    if showBoxes
        r = bar_index + 30
        box.new(bar_index, math.max(e, tp), r, math.min(e, tp),
                border_color=color.new(color.teal, 50), bgcolor=color.new(color.teal, 90))
        box.new(bar_index, math.max(e, sl), r, math.min(e, sl),
                border_color=color.new(color.red,  55), bgcolor=color.new(color.red,  92))
        line.new(bar_index, e, r, e, color=color.new(color.gray, 10), style=line.style_dashed)

// ═══════════════════════════════════════════════════════════════════════
// SETUP A — FVG Retest + BOS
// ═══════════════════════════════════════════════════════════════════════
var bool firedA = false

if _newDay
    firedA := false

if modA and barstate.isconfirmed and inKZ and not firedA and _dowOk and atr > 0 and adrC < adrFVG and array.size(fU) > 0 and strategy.position_size == 0
    for i = array.size(fU) - 1 to 0
        if firedA or array.get(fFire, i)
            continue
        u    = array.get(fU,    i)
        l    = array.get(fL,    i)
        d    = array.get(fDir,  i)
        bi   = array.get(fBi,   i)
        fill = array.get(fFill, i)
        age  = bar_index - bi

        if age == 0 or age > fvgAge or fill > fvgFill
            continue
        touch = d == 1 ? (low <= u and high >= l) : (high >= l and low <= u)
        if not touch
            continue
        if not ((d == 1 and bosBull) or (d == -1 and bosBear))
            continue
        if not f_htfOk(d, htfA)
            continue

        eP  = d == 1 ? u : l
        slP = d == 1 ? l - atr * slBuf : u + atr * slBuf
        slD = math.abs(eP - slP)
        if slD <= 0 or slD / atr < slMin or slD / atr > slMax
            continue

        tp1 = d == 1 ? eP + slD * tpA         : eP - slD * tpA
        tp2 = d == 1 ? eP + slD * tpA * 2.0   : eP - slD * tpA * 2.0
        tpL = exitMode == "TP2" ? tp2 : tp1

        array.set(fFire, i, true)
        firedA := true

        eId = d == 1 ? "A-L" : "A-S"
        strategy.entry(eId, d == 1 ? strategy.long : strategy.short, limit=eP, comment="S2-A")
        strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=tpL)
        f_drawBox(eP, slP, tpL)
        label.new(bar_index, d == 1 ? low : high, "A",
                  style=d == 1 ? label.style_label_up : label.style_label_down,
                  color=color.new(color.teal, 10), textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════
// SETUP B — Judas Sweep
// ═══════════════════════════════════════════════════════════════════════
var bool bHi = false
var bool bLo = false

if _newDay
    bHi := false
    bLo := false
    strategy.cancel("B-S-pend")
    strategy.cancel("B-L-pend")

if not inLon and inLon[1]
    strategy.cancel("B-S-pend")
    strategy.cancel("B-L-pend")

if modB and barstate.isconfirmed and inLon and _dowOk and arLocked and atr > 0 and adrC < adrJudas and not na(arHi) and not na(arLo) and strategy.position_size == 0

    if not bHi and high > arHi and close < arHi and (high - arHi) >= atr * 0.15
        eP  = arHi
        slP = high + atr * slBuf
        slD = slP - eP
        if slD > 0 and slD / atr >= slMin and slD / atr <= slMax and f_htfOk(-1, htfB_req)
            tp1 = eP - slD * tpB
            tp2 = eP - slD * tpB * 2.0
            tpL = exitMode == "TP2" ? tp2 : tp1
            bHi := true
            strategy.entry("B-S-pend", strategy.short, limit=eP, comment="S2-B SHORT")
            strategy.exit("B-S-X",     from_entry="B-S-pend", stop=slP, limit=tpL)
            f_drawBox(eP, slP, tpL)
            label.new(bar_index, high, "B", style=label.style_label_down,
                      color=color.new(color.orange, 10), textcolor=color.white, size=size.small)

    if not bLo and low < arLo and close > arLo and (arLo - low) >= atr * 0.15 and strategy.position_size == 0
        eP  = arLo
        slP = low - atr * slBuf
        slD = eP - slP
        if slD > 0 and slD / atr >= slMin and slD / atr <= slMax and f_htfOk(1, htfB_req)
            tp1 = eP + slD * tpB
            tp2 = eP + slD * tpB * 2.0
            tpL = exitMode == "TP2" ? tp2 : tp1
            bLo := true
            strategy.entry("B-L-pend", strategy.long,  limit=eP, comment="S2-B LONG")
            strategy.exit("B-L-X",     from_entry="B-L-pend", stop=slP, limit=tpL)
            f_drawBox(eP, slP, tpL)
            label.new(bar_index, low, "B", style=label.style_label_up,
                      color=color.new(color.orange, 10), textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════
// SETUP D — Psychological Level Bounce
// ═══════════════════════════════════════════════════════════════════════
var bool firedD = false

if _newDay
    firedD := false

if modD and barstate.isconfirmed and inKZ and not firedD and _dowOk and atr > 0 and adrC < adrPsych and strategy.position_size == 0
    lvl50   = math.round(close / 50.0)  * 50.0
    lvl100  = math.round(close / 100.0) * 100.0
    nearLvl = math.abs(close - lvl50) <= math.abs(close - lvl100) ? lvl50 : lvl100

    bLong  = low  <= nearLvl and close > nearLvl
    bShort = high >= nearLvl and close < nearLvl
    dir    = bLong and not bShort ? 1 : bShort and not bLong ? -1 : 0

    if dir != 0 and f_htfOk(dir, htfD_req)
        wick = dir == 1 ? low : high
        eP   = nearLvl
        buf2 = math.max(0.30 * atr, syminfo.mintick * 5)
        slP  = dir == 1 ? wick - buf2 : wick + buf2
        slD  = math.abs(eP - slP)
        if slD > 0 and slD / atr >= slMin and slD / atr <= slMax
            tp1 = dir == 1 ? eP + slD * tpD       : eP - slD * tpD
            tp2 = dir == 1 ? eP + slD * tpD * 2.0 : eP - slD * tpD * 2.0
            tpL = exitMode == "TP2" ? tp2 : tp1
            firedD := true
            eId = dir == 1 ? "D-L" : "D-S"
            strategy.entry(eId, dir == 1 ? strategy.long : strategy.short, comment="S2-D")
            strategy.exit(eId + "-X", from_entry=eId, stop=slP, limit=tpL)
            f_drawBox(eP, slP, tpL)
            label.new(bar_index, dir == 1 ? low : high,
                      str.tostring(math.round(nearLvl), "#"),
                      style=dir == 1 ? label.style_label_up : label.style_label_down,
                      color=color.new(color.purple, 10), textcolor=color.white, size=size.small)

// ─── VISUAL ───────────────────────────────────────────────────────────
plot(arLocked ? arHi : na, "Asian Hi", color.new(color.yellow, 50), 1, plot.style_stepline)
plot(arLocked ? arLo : na, "Asian Lo", color.new(color.yellow, 50), 1, plot.style_stepline)

bgcolor(inLon ? color.new(color.blue,   96) : na, title="London KZ")
bgcolor(inNY  ? color.new(color.orange, 96) : na, title="NY KZ")

// ─── STATUS TABLE ─────────────────────────────────────────────────────
var table _t = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 55), border_width=1)
if barstate.islast
    _dowStr = _dow == dayofweek.monday ? "Mon" : _dow == dayofweek.tuesday ? "Tue" : _dow == dayofweek.wednesday ? "Wed" : _dow == dayofweek.thursday ? "Thu" : "Fri"
    _dowC   = _dowOk ? color.lime : color.red
    table.cell(_t, 0, 0, "QB Gold S2",  text_color=color.new(color.yellow,0), text_size=size.tiny, bgcolor=color.new(color.black,50), text_halign=text.align_left)
    table.cell(_t, 1, 0, "H1",          text_color=color.new(color.white,25), text_size=size.tiny, bgcolor=color.new(color.black,50), text_halign=text.align_right)
    table.cell(_t, 0, 1, "Day",         text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(_t, 1, 1, _dowStr,       text_color=color.new(_dowC,0),        text_size=size.tiny, text_halign=text.align_right)
    table.cell(_t, 0, 2, "DOW filter",  text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(_t, 1, 2, i_useDow ? "ON" : "off", text_color=i_useDow ? color.new(color.lime,0) : color.new(color.gray,30), text_size=size.tiny, text_halign=text.align_right)
    table.cell(_t, 0, 3, "── A ──",    text_color=color.new(color.teal,10),   text_size=size.tiny, text_halign=text.align_left)
    table.cell(_t, 1, 3, modA ? "ON" : "off", text_color=modA ? color.new(color.lime,0) : color.new(color.gray,30), text_size=size.tiny, text_halign=text.align_right)
    table.cell(_t, 0, 4, "── B ──",    text_color=color.new(color.orange,10), text_size=size.tiny, text_halign=text.align_left)
    table.cell(_t, 1, 4, modB ? "ON" : "off", text_color=modB ? color.new(color.lime,0) : color.new(color.gray,30), text_size=size.tiny, text_halign=text.align_right)
    table.cell(_t, 0, 5, "── D ──",    text_color=color.new(color.purple,10), text_size=size.tiny, text_halign=text.align_left)
    table.cell(_t, 1, 5, modD ? "ON" : "off", text_color=modD ? color.new(color.lime,0) : color.new(color.gray,30), text_size=size.tiny, text_halign=text.align_right)
    table.cell(_t, 0, 6, "ADR",        text_color=color.new(color.gray,15),   text_size=size.tiny, text_halign=text.align_left)
    table.cell(_t, 1, 6, str.tostring(adrC, "#.##"), text_color=color.new(adrC < 0.85 ? color.lime : color.orange,0), text_size=size.tiny, text_halign=text.align_right)
    table.cell(_t, 0, 7, "Exit",       text_color=color.new(color.gray,15),   text_size=size.tiny, text_halign=text.align_left)
    table.cell(_t, 1, 7, exitMode,     text_color=color.new(color.white,20),  text_size=size.tiny, text_halign=text.align_right)
