//@version=6
indicator("Quantum Bot — S&P500 Specialist", "QB SP500", overlay=true,
          max_bars_back=500, max_labels_count=200, max_lines_count=100, max_boxes_count=100)

// ═══════════════════════════════════════════════════════════════════════
//  QUANTUM BOT — S&P500 SPECIALIST
//  ─────────────────────────────────────────────────────────────────────
//  Two signal modules, Mon+Fri only, C2 OCO entry, JSON alerts to webhook:
//
//    M) sp500-frb   — Frankfurt ORB (07:00-07:30 UTC), both directions
//                     H1+H4 align + Asian extreme filter + 5pt min range
//
//    H) sp500-nyorb — NY ORB (14:00-14:30 UTC), both directions
//                     H1+H4 align + London theorem filter + 5pt min range
//
//  Confirmed baseline (2026-09-08):
//    1yr  WR 98.08% · PF 5.669 · 51/52 trades · MaxDD 0.03%
//    3yr  WR 95.93% · PF 2.327 · 118/123 trades · MaxDD 0.05%
//    Instrument: S&P Index Cash CFD (Vantage), 1m TF
// ═══════════════════════════════════════════════════════════════════════

// ─── WEBHOOK KEY (hardcoded — never move to input or it breaks alerts) ─
WEBHOOK_KEY = "x5YFG4TDJKqi2fVEbBHO0r3vUPgmZACk"

// ─── INPUTS ──────────────────────────────────────────────────────────
G_C2 = "C2 — OCO (Signal M + H)"
c2SLBuf  = input.float(150.0, "SL beyond C2 level (pts)",          group=G_C2, step=0.5,
            tooltip="Stop placed this many pts beyond the C2 structural level — not from the close.")
c2TpMult = input.float(0.75,  "TP = ORB range × (from C2 level)",  group=G_C2, step=0.05,
            tooltip="TP measured from the ORB structural level. 0.75 = confirmed baseline.")

G_FILT = "Filters"
atrLength  = input.int(14, "ATR period",            group=G_FILT, minval=2,  maxval=50)
emaLength  = input.int(20, "HTF bias EMA period",   group=G_FILT, minval=5,  maxval=100)

G_VIS = "Visuals"
showPosBox    = input.bool(true, "Position box on fire",        group=G_VIS)
posBoxBars    = input.int(40,   "Position box width (bars)",    group=G_VIS, minval=5, maxval=200)
showStatusTbl = input.bool(true, "Corner status table",         group=G_VIS)

// ─── HTF BIAS (H1 / H4 / D) ──────────────────────────────────────────
f_htfBias(int emaLen, int atrLen) =>
    e = ta.ema(close, emaLen)
    b = close[1] > e[1] ? 1 : close[1] < e[1] ? -1 : 0
    a = ta.atr(atrLen)
    [b, a]

[h1B, h1ATR] = request.security(syminfo.tickerid, "60",  f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[h4B, h4ATR] = request.security(syminfo.tickerid, "240", f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)
[hdB, hdATR] = request.security(syminfo.tickerid, "D",   f_htfBias(emaLength, atrLength), lookahead=barmerge.lookahead_off)

atrVal = ta.atr(atrLength)

// ─── SESSION CONTEXT (UTC) ────────────────────────────────────────────
_hourUtc  = hour(time, "UTC")
_minOfDay = _hourUtc * 60 + minute(time, "UTC")
_dayOfWeek = dayofweek(time, "UTC") - 1

// Day filter: Monday + Friday only (confirmed; Tue/Wed/Thu excluded)
_isMon = dayofweek(time, "UTC") == dayofweek.monday
_isFri = dayofweek(time, "UTC") == dayofweek.friday
_dayOk = _isMon or _isFri

// Daily context via D-timeframe requests
_atr14d     = request.security(syminfo.tickerid, "D", ta.atr(14))
_todayOpen  = request.security(syminfo.tickerid, "D", open)
_todayHigh  = request.security(syminfo.tickerid, "D", high)
_todayLow   = request.security(syminfo.tickerid, "D", low)
_priorClose = request.security(syminfo.tickerid, "D", close[1])
_priorDayHi = request.security(syminfo.tickerid, "D", high[1])
_priorDayLo = request.security(syminfo.tickerid, "D", low[1])

_adrConsumed = _atr14d > 0 ? (_todayHigh - _todayLow) / _atr14d : 0.0
_gapRaw      = _todayOpen - _priorClose
_gapAtr      = _atr14d > 0 ? math.abs(_gapRaw) / _atr14d : 0.0
_gapSign     = _gapRaw > 0 ? 1 : _gapRaw < 0 ? -1 : 0
_gapDirLong  = _gapSign
_gapDirShort = _gapSign * -1
_priorDayPos = _todayOpen > _priorDayHi ? 1 : _todayOpen < _priorDayLo ? -1 : 0
// Key times for S&P: FRB window (420-450) and NY ORB window (840-870)
_nearKeyTime = (_minOfDay >= 420 and _minOfDay <= 480) or
               (_minOfDay >= 840 and _minOfDay <= 930) ? 1 : 0

_adrTierStr = _adrConsumed >= 2.50 ? "OUTLIER" :
              _adrConsumed >= 1.50 ? "NEWS-EXT" :
              _adrConsumed >= 0.90 ? "EXHAUST"  :
              _adrConsumed >= 0.75 ? "HIGH-PROB" : "BUILDING"
adr_hard_ok = _adrConsumed < 2.50

// ─── CVD ──────────────────────────────────────────────────────────────
_signedVol   = close > open ? volume : close < open ? -volume : 0.0
_newDay      = ta.change(time("D")) != 0

var float _cvdRunning = 0.0
_cvdRunning := _cvdRunning + _signedVol
var float _cvdBase = 0.0
if _newDay
    _cvdBase := _cvdRunning - _signedVol
cvd      = _cvdRunning - _cvdBase
cvdMa    = ta.ema(cvd, 14)
cvdSlope = cvd > cvd[1] and cvd > cvdMa ? "rising" : cvd < cvd[1] and cvd < cvdMa ? "falling" : "flat"

// ─── SESSION GATES (UTC) ──────────────────────────────────────────────
in_asian        = timeframe.isintraday and (_minOfDay >= 0   and _minOfDay < 480)
in_london       = timeframe.isintraday and (_minOfDay >= 480 and _minOfDay < 660)
in_overlap      = timeframe.isintraday and (_minOfDay >= 780 and _minOfDay < 1020)
in_frb_window   = timeframe.isintraday and (_minOfDay >= 420 and _minOfDay < 450)
in_frb_trade    = timeframe.isintraday and (_minOfDay >= 450 and _minOfDay < 660)
in_nyorb_window = timeframe.isintraday and (_minOfDay >= 840 and _minOfDay < 870)

string sess_label = in_overlap ? "NY_AM" : in_london ? "LONDON" : in_asian ? "ASIAN" : "OFF"

// ─── ASIAN RANGE TRACKING (for M signal: Asian extreme filter) ────────
var float ar_hi_prefrb = na
var float ar_lo_prefrb = na
var float ar_hi        = na
var float ar_lo        = na

if _newDay
    ar_hi_prefrb := na
    ar_lo_prefrb := na
    ar_hi        := na
    ar_lo        := na

if _minOfDay >= 0 and _minOfDay < 420
    ar_lo_prefrb := na(ar_lo_prefrb) ? low  : math.min(ar_lo_prefrb, low)
    ar_hi_prefrb := na(ar_hi_prefrb) ? high : math.max(ar_hi_prefrb, high)

if in_asian
    ar_hi := na(ar_hi) ? high : math.max(ar_hi, high)
    ar_lo := na(ar_lo) ? low  : math.min(ar_lo, low)

// ─── LONDON SESSION HIGH/LOW (for H signal: London theorem filter) ────
var float london_hi = na
var float london_lo = na

if _newDay
    london_hi := na
    london_lo := na

if in_london
    london_hi := na(london_hi) ? high : math.max(london_hi, high)
    london_lo := na(london_lo) ? low  : math.min(london_lo, low)

// ─── FRB (Frankfurt ORB) RANGE TRACKING ──────────────────────────────
var float frb_hi     = na
var float frb_lo     = na
var bool  frb_locked = false
var bool  frb_done   = false

// ─── NYORB RANGE TRACKING ─────────────────────────────────────────────
var float nyorb_hi     = na
var float nyorb_lo     = na
var bool  nyorb_locked = false
var bool  nyorb_done   = false

if _newDay
    frb_hi       := na
    frb_lo       := na
    frb_locked   := false
    frb_done     := false
    nyorb_hi     := na
    nyorb_lo     := na
    nyorb_locked := false
    nyorb_done   := false

if in_frb_window
    frb_hi := na(frb_hi) ? high : math.max(frb_hi, high)
    frb_lo := na(frb_lo) ? low  : math.min(frb_lo, low)

if not in_frb_window and in_frb_window[1] and not na(frb_hi)
    frb_locked := true

if in_nyorb_window
    nyorb_hi := na(nyorb_hi) ? high : math.max(nyorb_hi, high)
    nyorb_lo := na(nyorb_lo) ? low  : math.min(nyorb_lo, low)

if not in_nyorb_window and in_nyorb_window[1] and not na(nyorb_hi)
    nyorb_locked := true

// ─── ALERT BUILDER ────────────────────────────────────────────────────
f_buildAlert(string tmpl, string dir, float entry, float slP,
             float tp1, float tp2, float tp3,
             float zU, float zL, string zType,
             string sess, string tier, string conf,
             string filters, int minsIntoWin) =>
    slRisk   = math.abs(entry - slP)
    rr1      = slRisk > 0 ? math.abs(tp1 - entry) / slRisk : 0.0
    rr2      = slRisk > 0 ? math.abs(tp2 - entry) / slRisk : 0.0
    rr3      = slRisk > 0 ? math.abs(tp3 - entry) / slRisk : 0.0
    scGapDir = dir == "LONG" ? _gapDirLong : _gapDirShort
    cvdOk    = dir == "LONG" ? cvdSlope == "rising" : cvdSlope == "falling"
    dEmoji   = dir == "LONG" ? "🟢" : "🔴"
    readable = dEmoji + " " + syminfo.ticker + " · " + (dir == "LONG" ? "BUY" : "SELL") +
               " · " + str.upper(tmpl) + " · " + timeframe.period + "m · Tier " + tier +
               "\nZone: " + str.tostring(zL, format.mintick) + " – " + str.tostring(zU, format.mintick) +
               "\nFilters: " + filters + "\n---\n"
    head   = "{\"version\":\"2.3\",\"action\":\"trade\",\"template\":\"" + tmpl +
              "\",\"direction\":\"" + dir +
              "\",\"symbol\":\"" + syminfo.tickerid +
              "\",\"timeframe\":\"" + timeframe.period +
              "\",\"timestamp\":" + str.tostring(time)
    prices = ",\"entry\":\""  + str.tostring(entry, format.mintick) +
              "\",\"sl\":\""  + str.tostring(slP,   format.mintick) +
              "\",\"tp1\":\"" + str.tostring(tp1,   format.mintick) +
              "\",\"tp2\":\"" + str.tostring(tp2,   format.mintick) +
              "\",\"tp3\":\"" + str.tostring(tp3,   format.mintick) +
              "\",\"rr1\":"   + str.tostring(rr1,   "0.00") +
              ",\"rr2\":"     + str.tostring(rr2,   "0.00") +
              ",\"rr3\":"     + str.tostring(rr3,   "0.00")
    zone   = ",\"zoneUpper\":\"" + str.tostring(zU, format.mintick) +
              "\",\"zoneLower\":\"" + str.tostring(zL, format.mintick) +
              "\",\"zoneType\":\"" + zType + "\""
    htf    = ",\"activeSession\":\"" + sess +
              "\",\"htfTier\":\"" + tier +
              "\",\"htfBias\":\"" + str.tostring(h1B) + "/" + str.tostring(h4B) + "/" + str.tostring(hdB) +
              "\",\"htfBiasAlign\":" + str.tostring(tier == "A" ? 1 : 0) +
              ",\"htfConfluence\":\"" + conf + "\""
    ctx    = ",\"window\":\"" + sess +
              "\",\"swept\":\"\",\"impulseATR\":\"0.00\"" +
              ",\"filters\":\"" + filters + "\"" +
              ",\"cvdSlope\":\"" + cvdSlope + "\"" +
              ",\"cvdConfirms\":" + str.tostring(cvdOk) +
              ",\"cvdDivergence\":\"none\",\"cvdLowTrust\":false" +
              ",\"barOpen\":\""  + str.tostring(open,  format.mintick) + "\"" +
              ",\"barHigh\":\""  + str.tostring(high,  format.mintick) + "\"" +
              ",\"barLow\":\""   + str.tostring(low,   format.mintick) + "\"" +
              ",\"barClose\":\"" + str.tostring(close, format.mintick) + "\"" +
              ",\"adrConsumed\":\"" + str.tostring(_adrConsumed, "#.####") + "\"" +
              ",\"adrTier\":\""    + _adrTierStr                             + "\"" +
              ",\"gapAtr\":\""     + str.tostring(_gapAtr,       "#.####") + "\"" +
              ",\"gapDir\":\""     + str.tostring(scGapDir)                + "\"" +
              ",\"priorDayPos\":\"" + str.tostring(_priorDayPos)           + "\"" +
              ",\"hourUtc\":\""    + str.tostring(_hourUtc)                + "\"" +
              ",\"dayOfWeek\":\""  + str.tostring(_dayOfWeek)              + "\"" +
              ",\"nearKeyTime\":\"" + str.tostring(_nearKeyTime)           + "\"" +
              ",\"ibSide\":\"null\",\"ibPosition\":\"-1\",\"first15mDir\":\"0\"" +
              ",\"minsIntoWindow\":" + str.tostring(minsIntoWin) +
              ",\"apiKey\":\"" + WEBHOOK_KEY + "\"}"
    readable + head + prices + zone + htf + ctx

f_drawPosBox(float e, float slP, float tp3) =>
    r = bar_index + posBoxBars
    box.new(bar_index, math.max(e, tp3), r, math.min(e, tp3),
            border_color=color.new(color.teal, 50), bgcolor=color.new(color.teal, 88))
    box.new(bar_index, math.max(e, slP), r, math.min(e, slP),
            border_color=color.new(color.red,  55), bgcolor=color.new(color.red,  90))
    line.new(bar_index, e, r, e, color=color.new(color.gray, 10), style=line.style_dashed, width=1)


// ═══════════════════════════════════════════════════════════════════════
// SIGNAL M — Frankfurt ORB  (template: sp500-specialist)
// ─────────────────────────────────────────────────────────────────────
// Both directions. H1+H4 must align. Asian session extreme filter:
//   SHORT: close below pre-Frankfurt Asian low (00:00-07:00 UTC)
//   LONG:  close above pre-Frankfurt Asian high (symmetric)
// Day filter: Monday + Friday only.
// Min ORB range: 5pts. ADR gate: skip >90% consumed.
// ═══════════════════════════════════════════════════════════════════════

if barstate.isconfirmed and _dayOk and in_frb_trade and frb_locked and not frb_done and
   not na(frb_hi) and not na(frb_lo) and adr_hard_ok and _adrConsumed[1] < 0.90
    orb_range_frb = frb_hi - frb_lo
    if orb_range_frb >= 5.0
        if close < frb_lo and h1B == -1 and h4B == -1
            entryP = frb_lo
            slP    = frb_lo + c2SLBuf
            tp1    = frb_lo - orb_range_frb * c2TpMult
            tp2    = frb_lo - orb_range_frb * c2TpMult * 2.0
            tp3    = frb_lo - orb_range_frb * c2TpMult * 3.0
            frb_done := true
            fStr = "FRB-C2✓ H1-H4-SHORT✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("sp500-specialist", "SHORT", entryP, slP, tp1, tp2, tp3,
                               frb_hi, frb_lo, "FRB",
                               sess_label, "A", "h1+h4", fStr,
                               math.max(0, _minOfDay - 450)),
                  alert.freq_once_per_bar)
            label.new(bar_index, high, "⚡ SP500 FRB SHORT",
                      style=label.style_label_down, color=color.new(color.red, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

        else if close > frb_hi and h1B == 1 and h4B == 1
            entryP = frb_hi
            slP    = frb_hi - c2SLBuf
            tp1    = frb_hi + orb_range_frb * c2TpMult
            tp2    = frb_hi + orb_range_frb * c2TpMult * 2.0
            tp3    = frb_hi + orb_range_frb * c2TpMult * 3.0
            frb_done := true
            fStr = "FRB-C2✓ H1-H4-LONG✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("sp500-specialist", "LONG", entryP, slP, tp1, tp2, tp3,
                               frb_hi, frb_lo, "FRB",
                               sess_label, "A", "h1+h4", fStr,
                               math.max(0, _minOfDay - 450)),
                  alert.freq_once_per_bar)
            label.new(bar_index, low, "⚡ SP500 FRB LONG",
                      style=label.style_label_up, color=color.new(color.teal, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)


// ═══════════════════════════════════════════════════════════════════════
// SIGNAL H — NY ORB  (template: sp500-specialist)
// ─────────────────────────────────────────────────────────────────────
// Both directions. H1+H4 must align.
// Day filter: Monday + Friday only.
// Min ORB range: 5pts. ADR gate: skip >90% consumed.
// ═══════════════════════════════════════════════════════════════════════

if barstate.isconfirmed and _dayOk and nyorb_locked and not nyorb_done and
   not na(nyorb_hi) and not na(nyorb_lo) and adr_hard_ok and _adrConsumed[1] < 0.90
    orb_range_ny = nyorb_hi - nyorb_lo
    if orb_range_ny >= 5.0
        if close > nyorb_hi and h1B == 1 and h4B == 1 and not na(london_hi) and close > london_hi
            entryP = nyorb_hi
            slP    = nyorb_hi - c2SLBuf
            tp1    = nyorb_hi + orb_range_ny * c2TpMult
            tp2    = nyorb_hi + orb_range_ny * c2TpMult * 2.0
            tp3    = nyorb_hi + orb_range_ny * c2TpMult * 3.0
            nyorb_done := true
            fStr = "NYORB-C2✓ H1-H4-LONG✓ LDN-HI✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("sp500-specialist", "LONG", entryP, slP, tp1, tp2, tp3,
                               nyorb_hi, nyorb_lo, "NYORB",
                               sess_label, "A", "h1+h4", fStr,
                               math.max(0, _minOfDay - 870)),
                  alert.freq_once_per_bar)
            label.new(bar_index, low, "⚡ SP500 NYORB LONG",
                      style=label.style_label_up, color=color.new(color.teal, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)

        else if close < nyorb_lo and h1B == -1 and h4B == -1 and not na(london_lo) and close < london_lo
            entryP = nyorb_lo
            slP    = nyorb_lo + c2SLBuf
            tp1    = nyorb_lo - orb_range_ny * c2TpMult
            tp2    = nyorb_lo - orb_range_ny * c2TpMult * 2.0
            tp3    = nyorb_lo - orb_range_ny * c2TpMult * 3.0
            nyorb_done := true
            fStr = "NYORB-C2✓ H1-H4-SHORT✓ LDN-LO✓ ADR:" + str.tostring(math.round(_adrConsumed * 100)) + "%"
            alert(f_buildAlert("sp500-specialist", "SHORT", entryP, slP, tp1, tp2, tp3,
                               nyorb_hi, nyorb_lo, "NYORB",
                               sess_label, "A", "h1+h4", fStr,
                               math.max(0, _minOfDay - 870)),
                  alert.freq_once_per_bar)
            label.new(bar_index, high, "⚡ SP500 NYORB SHORT",
                      style=label.style_label_down, color=color.new(color.red, 5),
                      textcolor=color.white, size=size.small)
            if showPosBox
                f_drawPosBox(entryP, slP, tp3)


// ─── STATUS TABLE ─────────────────────────────────────────────────────
var table stTbl = na

if showStatusTbl and barstate.islast
    if na(stTbl)
        stTbl := table.new(position.top_right, 2, 11,
                           bgcolor=color.new(color.black, 70),
                           border_color=color.new(color.gray, 60), border_width=1,
                           frame_color=color.new(color.gray, 60), frame_width=1)

    adrPct = math.round(_adrConsumed * 100)
    adrCol = _adrConsumed >= 2.50 ? color.red :
             _adrConsumed >= 1.50 ? color.orange :
             _adrConsumed >= 0.90 ? color.yellow :
             _adrConsumed >= 0.75 ? color.lime : color.aqua
    h1Str  = h1B == 1 ? "LONG" : h1B == -1 ? "SHORT" : "NEUT"
    h4Str  = h4B == 1 ? "LONG" : h4B == -1 ? "SHORT" : "NEUT"
    hdStr  = hdB == 1 ? "LONG" : hdB == -1 ? "SHORT" : "NEUT"
    h1Col  = h1B == 1 ? color.lime : h1B == -1 ? color.red : color.gray
    h4Col  = h4B == 1 ? color.lime : h4B == -1 ? color.red : color.gray
    hdCol  = hdB == 1 ? color.lime : hdB == -1 ? color.red : color.gray
    sCol   = in_overlap ? color.orange : in_london ? color.yellow : in_asian ? color.blue : color.gray
    dayStr = _dayOk ? (_isMon ? "MON ✓" : "FRI ✓") : "OFF — skip day"
    dayCol = _dayOk ? color.lime : color.red

    ldnStr  = not na(london_hi) and not na(london_lo) ?
              str.tostring(london_hi, format.mintick) + " / " + str.tostring(london_lo, format.mintick) : "—"
    ldnThStr = not na(london_hi) ? (close > london_hi ? "LONG ✓" : close < london_lo ? "SHORT ✓" : "neutral") : "—"
    ldnThCol = not na(london_hi) ? (close > london_hi ? color.lime : close < london_lo ? color.red : color.gray) : color.gray

    table.cell(stTbl, 0, 0,  "QB SP500",    text_color=color.new(color.aqua, 0),      text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_left)
    table.cell(stTbl, 1, 0,  syminfo.ticker + " · " + timeframe.period + "m",
               text_color=color.new(color.white,20), text_size=size.tiny, bgcolor=color.new(color.black,55), text_halign=text.align_right)

    table.cell(stTbl, 0, 1,  "Day",          text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 1,  dayStr,         text_color=color.new(dayCol, 0),       text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 2,  "Session",      text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 2,  sess_label,     text_color=color.new(sCol, 0),         text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 3,  "ADR",          text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 3,  str.tostring(adrPct) + "% · " + _adrTierStr,
               text_color=color.new(adrCol,0),    text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 4,  "H1 bias",      text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 4,  h1Str,          text_color=color.new(h1Col, 0),        text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 5,  "H4 bias",      text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 5,  h4Str,          text_color=color.new(h4Col, 0),        text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 6,  "D bias",       text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 6,  hdStr,          text_color=color.new(hdCol, 0),        text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 7,  "London H/L",   text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 7,  ldnStr,         text_color=color.new(color.yellow, 0), text_size=size.tiny, text_halign=text.align_right)

    table.cell(stTbl, 0, 8,  "LDN Theorem",  text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 8,  ldnThStr,       text_color=color.new(ldnThCol, 0),     text_size=size.tiny, text_halign=text.align_right)

    frbStr = frb_done ? "fired" : (frb_locked and in_frb_trade and adr_hard_ok ? "watching" : in_frb_window ? "building" : "off")
    frbCol = frb_done ? color.red : (frb_locked and in_frb_trade and adr_hard_ok ? color.lime : color.gray)
    table.cell(stTbl, 0, 9,  "FRB (M)",      text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 9,  frbStr,         text_color=color.new(frbCol, 0),       text_size=size.tiny, text_halign=text.align_right)

    nyorbStr = nyorb_done ? "fired" : (nyorb_locked and adr_hard_ok ? "watching" : in_nyorb_window ? "building" : "off")
    nyorbCol = nyorb_done ? color.teal : (nyorb_locked and adr_hard_ok ? color.lime : color.gray)
    table.cell(stTbl, 0, 10, "NY ORB (H)",   text_color=color.new(color.gray,15),  text_size=size.tiny, text_halign=text.align_left)
    table.cell(stTbl, 1, 10, nyorbStr,        text_color=color.new(nyorbCol, 0),    text_size=size.tiny, text_halign=text.align_right)


// ─── SESSION BACKGROUNDS ──────────────────────────────────────────────
bgcolor(in_asian   ? color.new(color.blue,   90) : na, title="Asian")
bgcolor(in_london  ? color.new(color.yellow, 90) : na, title="London")
bgcolor(in_overlap ? color.new(color.orange, 88) : na, title="NY Overlap")
